## Ignore Visual Studio & .NET temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
.vscode/

# Environment and Secrets files (TUYỆT ĐỐI KHÔNG PUSH LÊN GIT)
.env
.env.*
*.env
*.env.*
appsettings*.local.json
appsettings.Production.json
appsettings.Development.local.json
secrets.json
*.secrets
*.credential
*.credentials
*.token

# Local documentation & database scripts (LƯU NỘI BỘ CỤC BỘ, KHÔNG PUSH LÊN GIT)
doc/
.env.example
AGENTS.md
sqlbtl.sql
*.sql

# SSL / TLS Certificates, Private Keys and Sensitive Credentials
*.key
*.pem
*.pfx
*.p12
*.cert
*.cer
*.crt
*.pub
id_rsa*
*.id_rsa
*.publishsettings

# SQL Server database dumps and backup files
*.bak
*.sql.bak
*.mdf
*.ldf
*.ndf

# Docker & Container local overrides
docker-compose.override.yml
*.dockerignore

# Node / Frontend dependencies & build
node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQL Server local database files (if any mdf/ldf generated locally)
*.mdf
*.ldf

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
