        <!-- Links Columns -->
        <div class="footer-grid">
            <div class="footer-col footer-col-about">
                <h3 class="col-title">VỀ CHÚNG TÔI</h3>
                <p class="brand-philosophy">
                    Phát triển theo triết lý thời trang <strong>"Mặc Bền - Mặc Mềm - Mặc Không Lỗi Mốt"</strong>. 
                    Mang đến những trang phục nam tôn dáng, chất lượng cao và bền bỉ theo thời gian.
                </p>
                <div class="hotline-box">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <span>Hotline CSKH:</span>
                    <strong class="hotline-number">1900 8888</strong>
                </div>
            </div>

            <div class="footer-col footer-col-categories">
                <h3 class="col-title">DANH MỤC QUẦN ÁO</h3>
                <ul class="footer-links">
                    <li><a href="/catalog?category=ao-thun">Áo Thun Cổ Tròn</a></li>
                    <li><a href="/catalog?category=polo">Áo Thun Polo</a></li>
                    <li><a href="/catalog?category=so-mi">Áo Sơ Mi Không Nhăn</a></li>
                    <li><a href="/catalog?category=jean">Quần Jeans Nam</a></li>
                    <li><a href="/catalog?category=tay">Quần Tây Công Sở</a></li>
                </ul>
            </div>

            <div class="footer-col footer-col-policies">
                <h3 class="col-title">CHÍNH SÁCH BÁN HÀNG</h3>
                <ul class="footer-links">
                    @if (_policies != null && _policies.Any())
                    {
                        @foreach (var p in _policies)
                        {
                            <li><a href="/policies/@p.Slug">@((MarkupString)p.TieuDe)</a></li>
                        }
                    }
                    else
                    {
                        <li><a href="/policies/chinh-sach-giao-hang">Chính sách giao hàng toàn quốc</a></li>
                        <li><a href="/policies/chinh-sach-doi-tra">Chính sách đổi trả hàng</a></li>
                        <li><a href="/policies/chinh-sach-bao-hanh">Chính sách bảo hành 365 ngày</a></li>
                        <li><a href="/policies/chinh-sach-thanh-vien-vip">Chính sách Thành viên VIP</a></li>
                        <li><a href="/policies/chinh-sach-bao-mat">Chính sách bảo mật thông tin</a></li>
                        <li><a href="/policies/dieu-khoan-dich-vu">Điều khoản dịch vụ</a></li>
                        <li><a href="/policies/khieu-nai-gop-y">Khiếu nại & Góp ý</a></li>
                    }
                </ul>
            </div>

            <div class="footer-col footer-col-stores">
                <h3 class="col-title">HỆ THỐNG CỬA HÀNG</h3>
                <p class="store-info">Hơn 40 cửa hàng trên toàn quốc mở cửa từ 8:30 - 22:00 mỗi ngày.</p>
                <div class="payment-methods">
                    <span>Thanh toán tiện lợi:</span>
                    <div class="payment-badges">
                        <span class="pay-badge">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                                <circle cx="12" cy="12" r="2"></circle>
                                <path d="M6 12h.01M18 12h.01"></path>
                            </svg>
                            Tiền mặt COD
                        </span>
                        <span class="pay-badge">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            Thẻ ATM / Visa
                        </span>
                        <span class="pay-badge">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            QR Banking
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="footer-bottom">
            <p>© 2026 QF Noir. Thiết kế theo tiêu chuẩn QF Noir Luxury & Minimalist.</p>
        </div>
    </div>
</footer>

@code {
    private List<PolicyDto> _policies = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var policyApi = ServiceProvider.GetService<IPolicyApiClient>();
            if (policyApi != null)
            {
                var list = await policyApi.GetActivePoliciesAsync();
                if (list != null && list.Any())
                {
                    _policies = list.OrderBy(p => p.ThuTu).ToList();
                }
            }
        }
        catch
        {
            // fallback gracefully to default hardcoded policies
        }
    }
}
