@using Frontend.Services
@implements IDisposable
@inject IToastService ToastService

<div class="yame-toast-container" aria-live="polite">
    @foreach (var toast in _toasts)
    {
        <div class="yame-toast @GetToastClass(toast.Level)" role="alert">
            <span class="toast-icon">
                @if (toast.Level == ToastLevel.Success)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                }
                else if (toast.Level == ToastLevel.Error)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                }
                else if (toast.Level == ToastLevel.Warning)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                }
            </span>
            <div class="toast-content">
                <p class="toast-message">@toast.Message</p>
            </div>
            <button class="toast-close" @onclick="() => RemoveToast(toast.Id)" aria-label="Đóng">&times;</button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleToastShow;
    }

    private void HandleToastShow(ToastMessage toast)
    {
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);

        // Tự động đóng toast sau 3.5 giây
        _ = AutoDismissAsync(toast.Id);
    }

    private async Task AutoDismissAsync(Guid toastId)
    {
        await Task.Delay(3500);
        RemoveToast(toastId);
    }

    private void RemoveToast(Guid toastId)
    {
        var existing = _toasts.FirstOrDefault(t => t.Id == toastId);
        if (existing != null)
        {
            _toasts.Remove(existing);
            InvokeAsync(StateHasChanged);
        }
    }

    private static string GetToastClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "toast-success",
        ToastLevel.Error => "toast-danger",
        ToastLevel.Warning => "toast-warning",
        _ => "toast-info"
    };


    public void Dispose()
    {
        ToastService.OnShow -= HandleToastShow;
    }
}
