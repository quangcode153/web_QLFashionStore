@code {
    [Parameter] public int CartCount { get; set; } = 0;
    [Parameter] public string? CurrentUserRole { get; set; }
    [Parameter] public string? CurrentUserName { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    [Inject] private ICatalogApiClient? CatalogApi { get; set; }

    private bool IsSearchExpanded = false;
    private string SearchText = string.Empty;
    private bool _showSuggestions = false;
    private List<ProductListItemDto> _suggestedProducts = new();
    private System.Threading.CancellationTokenSource? _searchCts;

    private async Task HandleLogoutClick()
    {
        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }
    }

    private void ToggleSearch()
    {
        if (IsSearchExpanded && !string.IsNullOrWhiteSpace(SearchText))
        {
            ExecuteSearch();
        }
        else
        {
            IsSearchExpanded = !IsSearchExpanded;
            if (!IsSearchExpanded)
            {
                _showSuggestions = false;
            }
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        if (CatalogApi == null || string.IsNullOrWhiteSpace(SearchText) || SearchText.Trim().Length < 2)
        {
            _suggestedProducts.Clear();
            _showSuggestions = false;
            return;
        }

        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(250, token);
            var result = await CatalogApi.GetProductsAsync(new ProductQueryParameters
            {
                Search = SearchText.Trim(),
                PageSize = 4
            });

            if (!token.IsCancellationRequested && result?.Items != null)
            {
                _suggestedProducts = result.Items.ToList();
                _showSuggestions = _suggestedProducts.Any();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        catch { }
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
        _suggestedProducts.Clear();
        _showSuggestions = false;
    }

    private void CloseSuggestions()
    {
        _showSuggestions = false;
    }

    private void ExecuteSearch()
    {
        _showSuggestions = false;
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            NavManager.NavigateTo($"/catalog?search={Uri.EscapeDataString(SearchText.Trim())}");
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
        else if (e.Key == "Escape")
        {
            CloseSuggestions();
        }
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/");
    }

    private bool _isMobileDrawerOpen = false;
    private string? _drawerOpenSub = null;

    private void ToggleMobileMenu()
    {
        _isMobileDrawerOpen = !_isMobileDrawerOpen;
    }

    private void CloseMobileDrawer()
    {
        _isMobileDrawerOpen = false;
        _drawerOpenSub = null;
    }

    private void ToggleDrawerSub(string key)
    {
        _drawerOpenSub = _drawerOpenSub == key ? null : key;
    }

    private void NavigateAndClose(string url)
    {
        CloseMobileDrawer();
        NavManager.NavigateTo(url);
    }

    private bool IsActiveTab(string url)
    {
        var current = NavManager?.Uri ?? string.Empty;
        if (url == "/" && (current.EndsWith("/") || current.EndsWith(":3000") || current.EndsWith(":5000"))) return true;
        return current.Contains(url, StringComparison.OrdinalIgnoreCase);
    }
}
