@page "/product/{id:int}"
@page "/products/{id:int}"
@namespace Frontend.Pages
@inject ICatalogApiClient CatalogApi
@inject ICartService CartService
@inject IToastService Toast
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="pdp-container">
    <!-- Breadcrumb Navigation -->
    <nav class="pdp-breadcrumb" aria-label="Đường dẫn">
        <a href="/" class="pdp-bc-link" @onclick="GoToHome" @onclick:preventDefault="true">Trang chủ</a>
        <span class="pdp-bc-sep">/</span>
        <a href="/catalog" class="pdp-bc-link" @onclick="GoToCatalog" @onclick:preventDefault="true">Bộ sưu tập thời trang</a>
        <span class="pdp-bc-sep">/</span>
        <span class="pdp-bc-curr">@ProductName</span>
    </nav>

    @if (IsLoading)
    {
        <div class="pdp-loading">
            <div class="spinner"></div>
            <p>Đang tải thông tin chi tiết sản phẩm...</p>
        </div>
    }
    else if (!Variants.Any())
    {
        <div class="pdp-not-found">
            <h2>Không tìm thấy sản phẩm</h2>
            <p>Sản phẩm không tồn tại hoặc đã ngừng kinh doanh.</p>
            <a href="/catalog" class="btn-back">Quay lại cửa hàng</a>
        </div>
    }
    else
    {
        <div class="pdp-grid">
            <!-- CỘT TRÁI: GALLERY ẢNH CHUẨN YAME TỰ ĐỘNG THEO SẢN PHẨM -->
            <div class="pdp-gallery">
                <div class="main-image-wrapper">
                    <img src="@ActiveImage" alt="@ProductName" class="main-image" 
                         fetchpriority="high"
                         loading="eager"
                         decoding="async"
                         onerror="this.onerror=null;this.src='/images/no-image.svg';" />
                    <span class="badge-brand">QF DESIGN</span>
                </div>
                @if (GalleryImages.Any())
                {
                    <div class="thumbnail-list">
                        @foreach (var img in GalleryImages)
                        {
                            <div class="thumb-item @(ActiveImage == img.DuongDanAnh ? "active" : "")" 
                                 @onclick="() => SetActiveImage(img.DuongDanAnh)">
                                <img src="@img.DuongDanAnh" alt="@ProductName" 
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='/images/no-image.svg';" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT & CHỌN BIẾN THỂ -->
            <div class="pdp-details">
                <div class="pdp-brand-cat">
                    <span>QF MODERN URBAN</span>
                </div>

                <h1 class="pdp-title">@ProductName</h1>

                <div class="pdp-price-box">
                    <span class="pdp-current-price">@DisplayPrice.ToString("N0") ₫</span>
                    @if (CurrentDiscountPercent > 0)
                    {
                        <span class="pdp-original-price" style="text-decoration: line-through; color: #94A3B8; font-size: 1.1rem; margin-left: 10px;">@OriginalPrice.ToString("N0") ₫</span>
                        <span class="badge-sale" style="background: #E11D48; color: #FFFFFF; font-weight: 800; font-size: 0.8rem; padding: 2px 8px; border-radius: 4px; margin-left: 8px;">-@CurrentDiscountPercent%</span>
                    }
                    else
                    {
                        <span class="pdp-price-tag">Cam kết giá xưởng</span>
                    }
                </div>

                <div class="pdp-sold-online-bar">
                    <span class="pdp-sold-text">Đã bán online @SoldOnlineCount</span>
                    <span class="pdp-sold-sep">•</span>
                    <span class="pdp-guarantee-text">Chính hãng 100%</span>
                </div>

                <!-- BỘ CHỌN MÀU SẮC -->
                <div class="pdp-option-group">
                    <label class="option-label">
                        Màu sắc: <strong>@(SelectedColor ?? "Vui lòng chọn màu")</strong>
                    </label>
                    <div class="swatches-container">
                        @foreach (var color in AvailableColors)
                        {
                            <button type="button" 
                                    class="swatch-color-btn @(string.Equals(SelectedColor, color, StringComparison.OrdinalIgnoreCase) ? "selected" : "")" 
                                    @onclick="() => SelectColor(color)">
                                @color
                            </button>
                        }
                    </div>
                </div>

                <!-- BỘ CHỌN KÍCH CỠ -->
                <div class="pdp-option-group">
                    <div class="option-header-row">
                        <label class="option-label">
                            Kích thước: <strong>@(SelectedSize ?? "Vui lòng chọn size")</strong>
                        </label>
                        <div class="size-helper-links">
                            <button type="button" class="stylist-ai-link" @onclick="ConsultStylistAi" title="Nhờ Stylist AI tư vấn chọn size & tồn kho">
                                Stylist AI tư vấn size
                            </button>
                            <span class="size-helper-sep">|</span>
                            <button type="button" class="size-guide-link" @onclick="() => _showSizeGuideModal = true">
                                Bảng quy đổi kích cỡ
                            </button>
                        </div>
                    </div>
                    <div class="swatches-container">
                        @foreach (var size in AvailableSizes)
                        {
                            <button type="button" 
                                    class="swatch-size-btn @(string.Equals(SelectedSize, size, StringComparison.OrdinalIgnoreCase) ? "selected" : "")" 
                                    @onclick="() => SelectSize(size)">
                                @size
                            </button>
                        }
                    </div>
                </div>

                <!-- THÔNG TIN TỒN KHO & SKU TỨC THÌ -->
                <div class="pdp-stock-status">
                    @if (SelectedVariant != null)
                    {
                        <div class="sku-info">
                            <span>Mã SKU: <strong class="sku-code">@SelectedVariant.MaSku</strong></span>
                        </div>
                        @if (SelectedVariant.SoLuongTon > 0)
                        {
                            <div class="stock-available" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="stock-dot in-stock"></span>
                                    <span>Tồn kho Online: Còn lại @SelectedVariant.SoLuongTon sản phẩm</span>
                                </div>
                                <button type="button" class="btn-branch-stock" @onclick="OpenBranchStockModal" style="background: none; border: 1px solid #CBD5E1; border-radius: 4px; padding: 4px 10px; font-size: 0.75rem; color: #334155; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    Tra cứu tồn kho các chi nhánh
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="stock-out" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="stock-dot out-of-stock"></span>
                                    <span class="text-danger">Kho Online: Hết hàng</span>
                                </div>
                                <button type="button" class="btn-branch-stock" @onclick="OpenBranchStockModal" style="background: none; border: 1px solid #CBD5E1; border-radius: 4px; padding: 4px 10px; font-size: 0.75rem; color: #334155; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    Tra cứu tồn kho các chi nhánh
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="stock-prompt">
                            <span>Vui lòng chọn Màu sắc và Kích cỡ để kiểm tra tình trạng hàng</span>
                        </div>
                    }
                </div>

                <!-- BỘ CHỌN SỐ LƯỢNG -->
                <div class="pdp-quantity-row">
                    <label class="option-label">Số lượng:</label>
                    <div class="quantity-control">
                        <button type="button" class="btn-qty" disabled="@(Quantity <= 1)" @onclick="DecreaseQuantity">-</button>
                        <input type="number" class="qty-input" value="@Quantity" readonly />
                        <button type="button" class="btn-qty" disabled="@(SelectedVariant == null || Quantity >= SelectedVariant.SoLuongTon)" @onclick="IncreaseQuantity">+</button>
                    </div>
                </div>

                @if (!CanAddToCart)
                {
                    <div class="pdp-selection-hint" style="background: #FFFBEB; border: 1px solid #FCD34D; color: #92400E; padding: 10px 14px; border-radius: 6px; font-size: 0.85rem; margin-top: 1rem; display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>Vui lòng click chọn <strong>Màu sắc</strong> và <strong>Kích cỡ</strong> ở trên để kích hoạt nút Đặt hàng.</span>
                    </div>
                }

                <!-- CẶP NÚT MUA HÀNG -->
                <div class="pdp-action-buttons" @onclick="HandleContainerClick">
                    <button type="button" 
                            class="btn-add-to-cart" 
                            disabled="@(!CanAddToCart)" 
                            @onclick="AddToCart">
                        Thêm vào giỏ hàng
                    </button>
                    <button type="button" 
                            class="btn-buy-now" 
                            disabled="@(!CanAddToCart)" 
                            @onclick="BuyNow">
                        Mua ngay
                    </button>
                </div>

                <!-- CAM KẾT DỊCH VỤ CHUẨN YAME -->
                <div class="pdp-commitments">
                    <div class="commit-item">
                        <span class="commit-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="3" width="15" height="13"></rect>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                            </svg>
                        </span>
                        <div>
                            <strong>Giao hàng toàn quốc</strong>
                            <p>Miễn phí đơn từ 500k</p>
                        </div>
                    </div>
                    <div class="commit-item">
                        <span class="commit-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <polyline points="1 20 1 14 7 14"></polyline>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                            </svg>
                        </span>
                        <div>
                            <strong>Đổi hàng trong 14 ngày</strong>
                            <p>Tại bất kỳ cửa hàng nào trên toàn quốc</p>
                        </div>
                    </div>
                    <div class="commit-item">
                        <span class="commit-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>
                        </span>
                        <div>
                            <strong>Bảo hành 365 ngày</strong>
                            <p>Đường may, cúc áo, dây kéo</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Bảng Quy Đổi Kích Cỡ Chuẩn YaMe -->
    @if (_showSizeGuideModal)
    {
        <div class="size-modal-backdrop" @onclick="() => _showSizeGuideModal = false" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 1.5rem;">
            <div class="size-modal-card" @onclick:stopPropagation="true" style="background: #FFFFFF; border-radius: 6px; max-width: 650px; width: 100%; padding: 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid #E2E8F0; padding-bottom: 0.75rem;">
                    <h3 style="font-size: 1.25rem; font-weight: 800; color: #0F172A; margin: 0;">BẢNG QUY ĐỔI KÍCH CỠ QF</h3>
                    <button type="button" @onclick="() => _showSizeGuideModal = false" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748B;">✕</button>
                </div>
                <p style="font-size: 0.85rem; color: #64748B; margin-bottom: 1.25rem;">
                    Bảng thông số chiều cao và cân nặng chuẩn phom dáng người Việt Nam. Hãy chọn size phù hợp hoặc liên hệ hotline để được đổi size miễn phí trong 14 ngày:
                </p>
                <div style="overflow-x: auto; margin-bottom: 1.5rem;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: center;">
                        <thead>
                            <tr style="background: #F8FAFC; border-bottom: 2px solid #E2E8F0;">
                                <th style="padding: 10px; font-weight: 700;">Size</th>
                                <th style="padding: 10px; font-weight: 700;">Chiều cao</th>
                                <th style="padding: 10px; font-weight: 700;">Cân nặng</th>
                                <th style="padding: 10px; font-weight: 700;">Vòng ngực</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 10px; font-weight: 700; color: #0F172A;">S</td>
                                <td style="padding: 10px; color: #475569;">1m55 - 1m64</td>
                                <td style="padding: 10px; color: #475569;">48 - 55 kg</td>
                                <td style="padding: 10px; color: #475569;">86 - 90 cm</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #F1F5F9; background: #FAFAFA;">
                                <td style="padding: 10px; font-weight: 700; color: #0F172A;">M</td>
                                <td style="padding: 10px; color: #475569;">1m65 - 1m72</td>
                                <td style="padding: 10px; color: #475569;">56 - 65 kg</td>
                                <td style="padding: 10px; color: #475569;">90 - 94 cm</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 10px; font-weight: 700; color: #0F172A;">L</td>
                                <td style="padding: 10px; color: #475569;">1m73 - 1m78</td>
                                <td style="padding: 10px; color: #475569;">66 - 75 kg</td>
                                <td style="padding: 10px; color: #475569;">94 - 98 cm</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #F1F5F9; background: #FAFAFA;">
                                <td style="padding: 10px; font-weight: 700; color: #0F172A;">XL</td>
                                <td style="padding: 10px; color: #475569;">1m79 - 1m84</td>
                                <td style="padding: 10px; color: #475569;">76 - 85 kg</td>
                                <td style="padding: 10px; color: #475569;">98 - 104 cm</td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: 700; color: #0F172A;">2XL</td>
                                <td style="padding: 10px; color: #475569;">1m82 - 1m90</td>
                                <td style="padding: 10px; color: #475569;">86 - 95 kg</td>
                                <td style="padding: 10px; color: #475569;">104 - 110 cm</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div style="text-align: right;">
                    <button type="button" @onclick="() => _showSizeGuideModal = false" style="background: #000000; color: #FFFFFF; border: none; padding: 10px 24px; border-radius: 4px; font-weight: 700; cursor: pointer;">
                        ĐÃ HIỂU
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Tra Cứu Tồn Kho Từng Chi Nhánh (Minh bạch dữ liệu & Khách hàng) -->
    @if (_showBranchStockModal)
    {
        <div class="branch-stock-modal-backdrop" @onclick="() => _showBranchStockModal = false" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 1.5rem;">
            <div class="branch-stock-modal-card" @onclick:stopPropagation="true" style="background: #FFFFFF; border-radius: 8px; max-width: 680px; width: 100%; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid #E2E8F0;">
                    <div>
                        <h3 style="font-size: 1.15rem; font-weight: 800; color: #0F172A; margin: 0;">TỒN KHO THEO TỪNG CHI NHÁNH</h3>
                        <p style="font-size: 0.8rem; color: #64748B; margin: 4px 0 0 0;">
                            @ProductName @(SelectedVariant != null ? $"- Màu {SelectedVariant.MauSac} / Size {SelectedVariant.KichCo}" : "")
                        </p>
                    </div>
                    <button type="button" @onclick="() => _showBranchStockModal = false" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748B;">✕</button>
                </div>

                <div style="padding: 1.25rem 1.5rem; overflow-y: auto; flex: 1;">
                    @if (_loadingBranchStock)
                    {
                        <div style="text-align: center; padding: 2rem; color: #64748B;">
                            Đang nạp dữ liệu tồn kho các chi nhánh...
                        </div>
                    }
                    else if (!_branchStockList.Any())
                    {
                        <div style="text-align: center; padding: 2rem; color: #64748B;">
                            Không có dữ liệu tồn kho cho sản phẩm này.
                        </div>
                    }
                    else
                    {
                        var filteredStocks = SelectedVariant != null
                            ? _branchStockList.Where(b => b.MaBienThe == SelectedVariant.MaBienThe).ToList()
                            : _branchStockList.ToList();

                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            @foreach (var group in filteredStocks.GroupBy(x => new { x.MaChiNhanh, x.TenChiNhanh, x.DiaChi, x.IsOnlineWarehouse }))
                            {
                                var totalStock = group.Sum(x => x.SoLuongTon);
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid @(group.Key.IsOnlineWarehouse ? "#000000" : "#E2E8F0"); border-radius: 6px; background: @(group.Key.IsOnlineWarehouse ? "#F8FAFC" : "#FFFFFF");">
                                    <div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <strong style="font-size: 0.9rem; color: #0F172A;">@group.Key.TenChiNhanh</strong>
                                            @if (group.Key.IsOnlineWarehouse)
                                            {
                                                <span style="background: #000000; color: #FFFFFF; font-size: 0.68rem; font-weight: 700; padding: 2px 6px; border-radius: 4px;">KHO GIAO ONLINE</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(group.Key.DiaChi))
                                        {
                                            <p style="font-size: 0.78rem; color: #64748B; margin: 2px 0 0 0;">@group.Key.DiaChi</p>
                                        }
                                        @if (SelectedVariant == null)
                                        {
                                            <div style="font-size: 0.75rem; color: #475569; margin-top: 4px;">
                                                @string.Join(" • ", group.Select(v => $"{v.MauSac}/{v.KichCo}: {v.SoLuongTon} chiếc"))
                                            </div>
                                        }
                                    </div>
                                    <div style="text-align: right; flex-shrink: 0; margin-left: 12px;">
                                        @if (totalStock > 0)
                                        {
                                            <span style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 20px;">
                                                Còn @totalStock chiếc
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background: #F1F5F9; color: #94A3B8; font-size: 0.8rem; font-weight: 600; padding: 4px 10px; border-radius: 20px;">
                                                Hết hàng
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="padding: 1rem 1.5rem; background: #F8FAFC; border-top: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.75rem; color: #64748B;">
                        Dữ liệu thời gian thực từ hệ thống kho đa chi nhánh
                    </span>
                    <button type="button" @onclick="() => _showBranchStockModal = false" style="background: #000000; color: #FFFFFF; border: none; padding: 8px 20px; border-radius: 4px; font-weight: 700; font-size: 0.82rem; cursor: pointer;">
                        ĐÓNG
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int id { get; set; }

    private List<ProductVariantDto> Variants = new();
    private List<ProductImageDto> GalleryImages = new();
    private bool IsLoading = true;
    private bool _showSizeGuideModal = false;
    private string? SelectedColor;
    private string? SelectedSize;
    private int Quantity = 1;

    private const string FallbackPlaceholder = "/images/no-image.svg";
    private string ActiveImage = string.Empty;
    private int SoldOnlineCount => ((id * 37 + 59) % 180) + 25;

    private IEnumerable<string> AvailableColors => Variants
        .Select(v => v.MauSac)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> AvailableSizes => Variants
        .Select(v => v.KichCo)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private ProductVariantDto? SelectedVariant =>
        Variants.FirstOrDefault(v => string.Equals(v.MauSac, SelectedColor, StringComparison.OrdinalIgnoreCase) 
                                  && string.Equals(v.KichCo, SelectedSize, StringComparison.OrdinalIgnoreCase));

    private ProductVariantDto? ActiveVariant
    {
        get
        {
            if (SelectedVariant != null) return SelectedVariant;
            if (!string.IsNullOrWhiteSpace(SelectedColor))
            {
                var cv = Variants.Where(v => string.Equals(v.MauSac, SelectedColor, StringComparison.OrdinalIgnoreCase)).ToList();
                if (cv.Any()) return cv.FirstOrDefault(v => v.SoLuongTon > 0) ?? cv.FirstOrDefault();
            }
            if (!string.IsNullOrWhiteSpace(SelectedSize))
            {
                var sv = Variants.Where(v => string.Equals(v.KichCo, SelectedSize, StringComparison.OrdinalIgnoreCase)).ToList();
                if (sv.Any()) return sv.FirstOrDefault(v => v.SoLuongTon > 0) ?? sv.FirstOrDefault();
            }
            return Variants.FirstOrDefault(v => v.SoLuongTon > 0) ?? Variants.FirstOrDefault();
        }
    }

    private string ProductName => Variants.FirstOrDefault()?.TenSanPham ?? "Chi tiết sản phẩm QF";
    private int CurrentDiscountPercent => ActiveVariant?.PhanTramGiamGia ?? 0;
    private decimal OriginalPrice => ActiveVariant?.GiaBan ?? 0;
    private decimal DisplayPrice => CurrentDiscountPercent > 0 
        ? Math.Round(OriginalPrice * (100 - CurrentDiscountPercent) / 100m, 0) 
        : OriginalPrice;
    private bool CanAddToCart => SelectedVariant != null && SelectedVariant.SoLuongTon > 0 && Quantity > 0 && Quantity <= SelectedVariant.SoLuongTon;
    private bool IsEntirelyOutOfStock => !Variants.Any() || Variants.All(v => v.SoLuongTon <= 0);

    protected override async Task OnInitializedAsync()
    {
        await LoadProductAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        IsLoading = true;
        try
        {
            var variantsTask = CatalogApi.GetProductVariantsAsync(id);
            var imagesTask = CatalogApi.GetProductImagesAsync(id);
            await Task.WhenAll(variantsTask, imagesTask);

            Variants = (await variantsTask)?.ToList() ?? new List<ProductVariantDto>();
            GalleryImages = (await imagesTask)?.ToList() ?? new List<ProductImageDto>();

            // Ưu tiên hiển thị ảnh chính thật từ cơ sở dữ liệu
            var primaryImage = GalleryImages.FirstOrDefault(i => i.LaAnhChinh)?.DuongDanAnh
                            ?? GalleryImages.FirstOrDefault()?.DuongDanAnh
                            ?? Variants.FirstOrDefault(v => !string.IsNullOrEmpty(v.HinhAnh))?.HinhAnh
                            ?? FallbackPlaceholder;

            ActiveImage = primaryImage;
            SelectedColor = null;
            SelectedSize = null;
            Quantity = 1;
        }
        catch
        {
            Variants = new List<ProductVariantDto>();
            GalleryImages = new List<ProductImageDto>();
            ActiveImage = FallbackPlaceholder;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectColor(string color)
    {
        SelectedColor = color;
        Quantity = 1;
        
        var matchingVariants = Variants.Where(v => string.Equals(v.MauSac, color, StringComparison.OrdinalIgnoreCase)).ToList();
        if (string.IsNullOrEmpty(SelectedSize) || !matchingVariants.Any(v => string.Equals(v.KichCo, SelectedSize, StringComparison.OrdinalIgnoreCase)))
        {
            var bestSize = matchingVariants.FirstOrDefault(v => v.SoLuongTon > 0)?.KichCo 
                        ?? matchingVariants.FirstOrDefault()?.KichCo;
            if (!string.IsNullOrEmpty(bestSize))
            {
                SelectedSize = bestSize;
            }
        }
    }

    private void SelectSize(string size)
    {
        SelectedSize = size;
        Quantity = 1;
        
        var matchingVariants = Variants.Where(v => string.Equals(v.KichCo, size, StringComparison.OrdinalIgnoreCase)).ToList();
        if (string.IsNullOrEmpty(SelectedColor) || !matchingVariants.Any(v => string.Equals(v.MauSac, SelectedColor, StringComparison.OrdinalIgnoreCase)))
        {
            var bestColor = matchingVariants.FirstOrDefault(v => v.SoLuongTon > 0)?.MauSac 
                         ?? matchingVariants.FirstOrDefault()?.MauSac;
            if (!string.IsNullOrEmpty(bestColor))
            {
                SelectedColor = bestColor;
            }
        }
    }

    private void HandleContainerClick()
    {
        if (!CanAddToCart)
        {
            if (string.IsNullOrEmpty(SelectedColor) && string.IsNullOrEmpty(SelectedSize))
            {
                Toast.ShowWarning("Vui lòng click chọn Màu sắc và Kích cỡ ở trên để đặt hàng.");
            }
            else if (string.IsNullOrEmpty(SelectedColor))
            {
                Toast.ShowWarning("Vui lòng click chọn Màu sắc sản phẩm.");
            }
            else if (string.IsNullOrEmpty(SelectedSize))
            {
                Toast.ShowWarning("Vui lòng click chọn Kích cỡ sản phẩm.");
            }
            else if (SelectedVariant != null && SelectedVariant.SoLuongTon <= 0)
            {
                Toast.ShowWarning("Phiên bản bạn chọn hiện đã hết hàng, vui lòng chọn màu hoặc kích cỡ khác.");
            }
        }
    }

    private void IncreaseQuantity()
    {
        if (SelectedVariant != null && Quantity < SelectedVariant.SoLuongTon)
        {
            Quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
        {
            Quantity--;
        }
    }

    private void SetActiveImage(string img)
    {
        ActiveImage = img;
    }

    private async Task AddToCart()
    {
        if (string.IsNullOrEmpty(SelectedColor))
        {
            Toast.ShowWarning("Vui lòng chọn màu sắc trước khi thêm vào giỏ hàng.");
            return;
        }

        if (string.IsNullOrEmpty(SelectedSize))
        {
            Toast.ShowWarning("Vui lòng chọn kích cỡ trước khi thêm vào giỏ hàng.");
            return;
        }

        if (SelectedVariant == null)
        {
            Toast.ShowWarning("Phân loại màu sắc và kích cỡ này hiện không có sẵn.");
            return;
        }

        if (SelectedVariant.SoLuongTon <= 0)
        {
            Toast.ShowWarning("Phiên bản sản phẩm này hiện đã hết hàng.");
            return;
        }

        await CartService.AddItemAsync(new CartItemDto
        {
            MaSanPham = id,
            TenSanPham = ProductName,
            HinhAnh = ActiveImage,
            MaBienThe = SelectedVariant.MaBienThe,
            MaSKU = SelectedVariant.MaSku,
            MauSac = SelectedVariant.MauSac,
            KichCo = SelectedVariant.KichCo,
            DonGia = DisplayPrice,
            SoLuong = Quantity,
            SoLuongTon = SelectedVariant.SoLuongTon
        });

        CartService.SetDrawerOpen(true);
        Toast.ShowSuccess($"Đã thêm {Quantity}x '{ProductName}' ({SelectedColor} / {SelectedSize}) vào giỏ hàng!");
    }

    private async Task BuyNow()
    {
        if (string.IsNullOrEmpty(SelectedColor))
        {
            Toast.ShowWarning("Vui lòng chọn màu sắc trước khi mua hàng.");
            return;
        }

        if (string.IsNullOrEmpty(SelectedSize))
        {
            Toast.ShowWarning("Vui lòng chọn kích cỡ trước khi mua hàng.");
            return;
        }

        if (SelectedVariant == null)
        {
            Toast.ShowWarning("Phân loại màu sắc và kích cỡ này hiện không có sẵn.");
            return;
        }

        if (SelectedVariant.SoLuongTon <= 0)
        {
            Toast.ShowWarning("Phiên bản sản phẩm này hiện đã hết hàng.");
            return;
        }

        await CartService.AddItemAsync(new CartItemDto
        {
            MaSanPham = id,
            TenSanPham = ProductName,
            HinhAnh = ActiveImage,
            MaBienThe = SelectedVariant.MaBienThe,
            MaSKU = SelectedVariant.MaSku,
            MauSac = SelectedVariant.MauSac,
            KichCo = SelectedVariant.KichCo,
            DonGia = DisplayPrice,
            SoLuong = Quantity,
            SoLuongTon = SelectedVariant.SoLuongTon
        });

        // Kiểm tra xem khách đã đăng nhập chưa
        string? token = null;
        try
        {
            token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authToken");
        }
        catch { }

        if (!string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/checkout");
        }
        else
        {
            Toast.ShowInfo("Vui lòng đăng nhập hoặc tạo tài khoản để hoàn tất đơn hàng.");
            Navigation.NavigateTo("/login?returnUrl=/checkout");
        }
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoToCatalog()
    {
        Navigation.NavigateTo("/catalog");
    }

    private async Task ConsultStylistAi()
    {
        try
        {
            var prompt = $"Mình đang xem sản phẩm '{ProductName}'. Mình cao và nặng bao nhiêu kg thì mặc size nào vừa vặn nhất, và hiện tại mẫu này còn màu gì và size nào trong kho ạ?";
            await JSRuntime.InvokeVoidAsync("qfOpenChat", prompt);
        }
        catch
        {
            _showSizeGuideModal = true;
        }
    }

    private bool _showBranchStockModal = false;
    private bool _loadingBranchStock = false;
    private List<ProductBranchStockDto> _branchStockList = new();

    private async Task OpenBranchStockModal()
    {
        _showBranchStockModal = true;
        _loadingBranchStock = true;
        try
        {
            var data = await CatalogApi.GetProductBranchStockAsync(id);
            _branchStockList = data.ToList();
        }
        catch
        {
            _branchStockList = new();
        }
        finally
        {
            _loadingBranchStock = false;
        }
    }
}
