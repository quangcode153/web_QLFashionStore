    private void PreFillImport(int variantId, decimal price, global::Shared.DTOs.Warehouse.LowStockAlertDto? item = null)
    {
        if (item != null && item.DaXoa)
        {
            Toast.ShowWarning($"Hàng đã tạm thời ngừng cung cấp. Không thể lập phiếu nhập cho '{item.TenSanPham}'!");
            return;
        }
        _currentTab = TabType.Import;
        _importVariantId = variantId;
        if (price > 0) _importPrice = price;
        _selectedVariant = item 
            ?? _allVariants.FirstOrDefault(x => x.MaBienThe == variantId) 
            ?? _lowStockAlerts.FirstOrDefault(x => x.MaBienThe == variantId);
        Toast.ShowSuccess($"Đã nạp thông tin SKU #{variantId} vào form nhập!");
    }

