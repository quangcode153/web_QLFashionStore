@page "/warehouse"
@page "/admin/warehouse"
@page "/warehouse/portal"
@page "/kho"
@layout EmptyLayout
@namespace Frontend.Pages.Warehouse
@inject IAdminApiClient AdminApi
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Frontend.Services.IAuthStateService AuthStateService
@inject Frontend.Services.ISignalRNotificationService SignalRService

<div class="warehouse-portal-layout">
    <!-- TOPBAR ĐIỀU HÀNH KHO CHUYÊN NGHIỆP -->
    <header class="wh-topbar">
        <div class="topbar-left">
            @if (_isBranchManager)
            {
                <a href="/admin/orders" class="btn-topbar-back" title="Quay lại giao diện Quản lý chi nhánh">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Quay lại</span>
                </a>
            }
            else if (_canAccessAdminChain)
            {
                <a href="/admin/dashboard" class="btn-topbar-back" title="Quay lại giao diện Quản trị chuỗi">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Quay lại</span>
                </a>
            }

            <div class="wh-brand">
                <div class="wh-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <div class="wh-brand-text">
                    <span class="brand-title">QF WAREHOUSE</span>
                    <span class="brand-sub">Điều Hành Kho & Nhập Hàng</span>
                </div>
            </div>

            <div class="topbar-brand-divider"></div>

            <!-- BỘ ĐIỀU HÀNH PHẠM VI (SCOPE CONTROL CAPSULE - TÍCH HỢP LIỀN MẠCH) -->
            <div class="wh-scope-capsule" title="@_scopeDescText">
                <div class="capsule-role-tag">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>@_badgeRoleTitle</span>
                </div>

                <div class="capsule-divider"></div>

                <div class="capsule-scope-select">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span class="scope-label">Kho:</span>
                    <select class="wh-branch-scope-select"
                            data-testid="warehouse-scope-selector"
                            disabled="@(!_isChainAdmin)"
                            value="@_currentWarehouseScopeId"
                            @onchange="OnWarehouseScopeChanged">
                        @if (_isChainAdmin)
                        {
                            <option value="0">🏢 Toàn chuỗi (@(_branches.Any() ? $"{_branches.Count} chi nhánh" : "Tất cả chi nhánh"))</option>
                            @foreach (var b in _branches)
                            {
                                @if (b.IsOnlineWarehouse || b.MaChiNhanh == 9)
                                {
                                    <option value="@b.MaChiNhanh">🌐 Kho Tổng Online (@b.TenChiNhanh)</option>
                                }
                                else
                                {
                                    <option value="@b.MaChiNhanh">🏬 @b.TenChiNhanh</option>
                                }
                            }
                        }
                        else if (_isOnlineWarehouseKeeper)
                        {
                            var onlineBranch = _branches.FirstOrDefault(b => b.IsOnlineWarehouse || b.MaChiNhanh == 9);
                            <option value="9">🌐 Kho Tổng Online (@(onlineBranch?.TenChiNhanh ?? "Tân Bình"))</option>
                        }
                        else if (_isBranchWarehouseKeeper || _staffBranchId > 0)
                        {
                            var myBranch = _branches.FirstOrDefault(b => b.MaChiNhanh == _staffBranchId);
                            <option value="@_staffBranchId">🏬 @(myBranch?.TenChiNhanh ?? _staffBranchName)</option>
                        }
                        else
                        {
                            <option value="9">🌐 Kho Tổng QF Tân Bình</option>
                        }
                    </select>
                    @if (!_isChainAdmin)
                    {
                        <span class="scope-lock-indicator" title="Tài khoản bị giới hạn theo chi nhánh trực thuộc">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Cố định</span>
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="topbar-right">
            <!-- NHÓM PHÍM TẮT & THÔNG BÁO -->
            <div class="topbar-actions">
                @if (_canAccessPos)
                {
                    <a href="/pos" class="btn-portal-shortcut" title="Mở máy tính tiền POS bán lẻ">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <span>Quầy POS</span>
                    </a>
                }

                @if (_canAccessAdminChain)
                {
                    <a href="/admin/dashboard" class="btn-portal-shortcut" title="Về trang Quản trị chuỗi">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="9"></rect>
                            <rect x="14" y="3" width="7" height="5"></rect>
                            <rect x="14" y="12" width="7" height="9"></rect>
                            <rect x="3" y="16" width="7" height="5"></rect>
                        </svg>
                        <span>Admin Hub</span>
                    </a>
                }
                else if (_isBranchManager)
                {
                    <a href="/admin/orders" class="btn-portal-shortcut btn-portal-shortcut-highlight" title="Quay lại giao diện Quản lý chi nhánh">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="2" width="18" height="20" rx="2"></rect>
                            <line x1="9" y1="6" x2="9" y2="6.01"></line>
                            <line x1="15" y1="6" x2="15" y2="6.01"></line>
                            <line x1="9" y1="12" x2="9" y2="12.01"></line>
                            <line x1="15" y1="12" x2="15" y2="12.01"></line>
                        </svg>
                        <span>Quản lý chi nhánh</span>
                    </a>
                }

                <div class="topbar-bell-wrapper">
                    <RealtimeNotificationBell />
                </div>
            </div>

            <div class="topbar-divider"></div>

            <!-- PROFILE & THOÁT -->
            <div class="wh-user-profile">
                <div class="avatar-squircle">@_avatarLetters</div>
                <div class="profile-info">
                    <span class="profile-name">@(_staffName ?? "Lê Văn Cường")</span>
                    <span class="profile-role">@_roleDisplayTitle</span>
                </div>
            </div>

            <button type="button" class="btn-logout" @onclick="HandleLogout" title="Đăng xuất">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Thoát</span>
            </button>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="wh-main-content">
        <!-- 1. KPI RIBBON: CÁC CHỈ SỐ KHO TỨC THỜI -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon icon-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                </div>
                <div class="kpi-body">
                    <span class="kpi-label">@(_currentWarehouseScopeId == 0 ? "TỔNG SKU TOÀN CHUỖI" : "BIẾN THỂ SKU THEO DÕI")</span>
                    <div class="kpi-value tabular-nums">@_totalSkuTracked</div>
                    <span class="kpi-hint">Đầy đủ màu sắc & size</span>
                </div>
            </div>

            @if (_currentWarehouseScopeId == 0)
            {
                <div class="kpi-card">
                    <div class="kpi-icon icon-chain-total">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <div class="kpi-body">
                        <span class="kpi-label">TỔNG HÀNG TỒN TOÀN HỆ THỐNG</span>
                        <div class="kpi-value tabular-nums text-blue">@_totalStockInChain.ToString("N0") <small style="font-size: 0.82rem; font-weight: normal; color: #64748b;">cái</small></div>
                        <span class="kpi-hint">Tổng sản phẩm thực tế cả 9 kho</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon icon-chain-network">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <div class="kpi-body">
                        <span class="kpi-label">ĐIỂM BÁN & KHO VẬN HÀNH</span>
                        <div class="kpi-value tabular-nums text-emerald">@_branches.Count <small style="font-size: 0.82rem; font-weight: normal; color: #64748b;">cơ sở</small></div>
                        <span class="kpi-hint">1 Kho Online + 8 Chi nhánh</span>
                    </div>
                </div>
            }
            else
            {
                <div class="kpi-card @(_lowStockAlerts.Count > 0 ? "border-amber" : "")">
                    <div class="kpi-icon icon-warn">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                    <div class="kpi-body">
                        <span class="kpi-label">CẢNH BÁO SẮP HẾT (&le; 10 CÁI)</span>
                        <div class="kpi-value tabular-nums text-amber">@_lowStockAlerts.Count</div>
                        <span class="kpi-hint">Cần lập đơn nhập hàng bổ sung</span>
                    </div>
                </div>

                <div class="kpi-card @(_outOfStockCount > 0 ? "border-red" : "")">
                    <div class="kpi-icon icon-danger">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                        </svg>
                    </div>
                    <div class="kpi-body">
                        <span class="kpi-label">CẠN HÀNG TRONG KHO (0 CÁI)</span>
                        <div class="kpi-value tabular-nums text-red">@_outOfStockCount</div>
                        <span class="kpi-hint">Hết sạch biến thể bày bán</span>
                    </div>
                </div>
            }

            <div class="kpi-card">
                <div class="kpi-icon icon-supplier">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </div>
                <div class="kpi-body">
                    <span class="kpi-label">NHÀ CUNG CẤP LIÊN KẾT</span>
                    <div class="kpi-value tabular-nums text-emerald">@_suppliers.Count</div>
                    <span class="kpi-hint">Đối tác may mặc & phụ kiện</span>
                </div>
            </div>
        </div>

        <!-- 2. TABS ĐIỀU HƯỚNG TÁC VỤ THỦ KHO -->
        <div class="wh-tabs-bar">
            @if (_currentWarehouseScopeId > 0)
            {
                <button type="button" class="wh-tab-btn @(_currentTab == TabType.Import ? "active" : "")" @onclick="() => SetTab(TabType.Import)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="12" y1="18" x2="12" y2="12"></line>
                        <line x1="9" y1="15" x2="15" y2="15"></line>
                    </svg>
                    <span>1. LẬP PHIẾU NHẬP HÀNG</span>
                </button>
            }

            <button type="button" class="wh-tab-btn @(_currentTab == TabType.Inventory ? "active" : "")" @onclick="() => SetTab(TabType.Inventory)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                <span>@(_currentWarehouseScopeId == 0 ? "1. TỔNG HỢP SẢN PHẨM & TỒN KHO TOÀN CHUỖI" : (_isBranchManager ? "1. DANH SÁCH SẢN PHẨM & TỒN KHO" : "2. CẢNH BÁO TỒN KHO & KIỂM KÊ"))</span>
                @if (_currentWarehouseScopeId == 0)
                {
                    <span class="tab-badge-count">@_totalSkuTracked SKU</span>
                }
                else if (_lowStockAlerts.Count > 0)
                {
                    <span class="tab-badge-count">@_lowStockAlerts.Count</span>
                }
            </button>

            <button type="button" data-testid="tab-history-btn" class="wh-tab-btn @(_currentTab == TabType.History ? "active" : "")" @onclick="() => SetTab(TabType.History)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>@(_currentWarehouseScopeId == 0 ? "2. LỊCH SỬ NHẬP KHO & AUDIT" : "3. LỊCH SỬ NHẬP KHO & AUDIT")</span>
            </button>

            <button type="button" class="wh-tab-btn @(_currentTab == TabType.Announcements ? "active" : "")" @onclick="() => SetTab(TabType.Announcements)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span>@(_currentWarehouseScopeId == 0 ? "3. THÔNG BÁO ĐIỀU HÀNH KHO" : "4. THÔNG BÁO ĐIỀU HÀNH KHO")</span>
                @if (_announcements.Count > 0)
                {
                    <span class="tab-badge-blue">@_announcements.Count</span>
                }
            </button>
        </div>

        <!-- 3. NỘI DUNG TỪNG TAB -->
        @if (_currentTab == TabType.Import)
        {
            @if (_currentWarehouseScopeId == 0)
            {
                <!-- KHI Ở PHẠM VI TOÀN CHUỖI: BẢNG HƯỚNG DẪN & ĐIỀU PHỐI CHỌN KHO -->
                <div class="card wh-card chain-scope-guide-card">
                    <div class="chain-guide-header">
                        <div class="guide-icon-badge">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                        </div>
                        <div class="guide-texts">
                            <h3 class="guide-title">CHẾ ĐỘ GIÁM SÁT TOÀN CHUỖI (@(_branches.Any() ? $"{_branches.Count} CHI NHÁNH" : "TOÀN HỆ THỐNG"))</h3>
                            <p class="guide-desc">
                                Toàn chuỗi là chỉ số tổng hợp logic toàn hệ thống. Hàng hóa thực tế chỉ được nhập vào <strong>Kho Tổng Online</strong> hoặc <strong>Kho Chi Nhánh vật lý cụ thể</strong>.
                                Vui lòng chọn một kho bên dưới để bắt đầu lập phiếu nhập hàng:
                            </p>
                        </div>
                    </div>

                    <div class="dispatch-grid">
                        <!-- Kho Tổng Online Card -->
                        <div class="dispatch-card online-wh-card" @onclick="() => SwitchToSpecificWarehouse(OnlineWarehouseId)">
                            <div class="card-status-pill online">Fulfillment & Đơn Online</div>
                            <div class="wh-symbol">🌐</div>
                            <h4 class="wh-title">@OnlineWarehouseName</h4>
                            <p class="wh-meta">Kho tiếp nhận từ xưởng may, đối tác NCC, xử lý đơn online & điều phối liên chi nhánh</p>
                            <button type="button" class="btn-dispatch-action online">Vào Lập Phiếu Nhập Kho Online &rarr;</button>
                        </div>

                        <!-- Các chi nhánh offline -->
                        @foreach (var b in _branches.Where(x => !x.IsOnlineWarehouse && x.MaChiNhanh != OnlineWarehouseId))
                        {
                            <div class="dispatch-card offline-branch-card" @onclick="() => SwitchToSpecificWarehouse(b.MaChiNhanh)">
                                <div class="card-status-pill offline">Điểm Bán Lẻ POS</div>
                                <div class="wh-symbol">🏬</div>
                                <h4 class="wh-title">@b.TenChiNhanh</h4>
                                <p class="wh-meta">@(string.IsNullOrEmpty(b.DiaChi) ? "Chi nhánh thời trang QF" : b.DiaChi)</p>
                                <button type="button" class="btn-dispatch-action offline">Vào Lập Phiếu Nhập Kho CN #@b.MaChiNhanh &rarr;</button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- TAB 1: LẬP PHIẾU NHẬP HÀNG KHO CỤ THỂ -->
                <div class="import-tab-layout">
                    <!-- FORM NHẬP KHO CHÍNH -->
                    <div class="card wh-card">
                        <div class="card-header">
                            <div class="header-left">
                                <span class="step-num">01</span>
                            <div>
                                <h3 class="card-title">LẬP PHIẾU NHẬP KHO TỨC THÌ</h3>
                                <p class="card-desc">Cập nhật số lượng tồn vào kho và ghi vết kiểm toán hệ thống</p>
                            </div>
                        </div>
                        <button type="button" class="btn-clear-form" @onclick="ResetImportForm" title="Xóa dữ liệu để nhập mới">
                            Làm mới form
                        </button>
                    </div>

                    <div class="card-body">
                        <!-- Dòng 1: Nhà cung cấp & Chi nhánh nhận -->
                        <div class="form-row-2">
                            <div class="form-group">
                                <div class="label-with-action">
                                    <label class="form-label">Nhà cung cấp hàng hóa <span class="required">*</span></label>
                                    <button type="button" class="btn-text-action" @onclick="ToggleSupplierMode">
                                        @if (_isCustomSupplierMode)
                                        {
                                            <span>&larr; Chọn từ danh sách</span>
                                        }
                                        else
                                        {
                                            <span>+ Thêm NCC mới</span>
                                        }
                                    </button>
                                </div>

                                @if (_isCustomSupplierMode)
                                {
                                    <div class="quick-add-supplier-box">
                                        <input type="text" class="form-control" placeholder="Tên nhà cung cấp mới (*)..." @bind="_newSupplierName" />
                                        <input type="text" class="form-control" placeholder="SĐT liên hệ..." @bind="_newSupplierPhone" />
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveNewSupplierQuickly" disabled="@_isSavingSupplier">
                                            @(_isSavingSupplier ? "Đang lưu..." : "Lưu & Chọn")
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    @if (_isLoadingData && !_suppliers.Any())
                                    {
                                        <select class="form-control" disabled>
                                            <option>⏳ Đang nạp danh sách nhà cung cấp...</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="form-control" @bind="_selectedSupplierId">
                                            @if (!_suppliers.Any())
                                            {
                                                <option value="0">-- Chưa có dữ liệu nhà cung cấp --</option>
                                            }
                                            @foreach (var s in _suppliers)
                                            {
                                                <option value="@s.MaNhaCungCap">@s.TenNhaCungCap (@(string.IsNullOrEmpty(s.DienThoaiLienHe) ? "Chưa có SĐT" : s.DienThoaiLienHe))</option>
                                            }
                                        </select>
                                    }
                                }
                            </div>

                            <div class="form-group">
                                <label class="form-label">Cơ sở / Kho tiếp nhận hàng <span class="required">*</span></label>
                                <div class="locked-branch-display">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                    <span class="locked-branch-text">@CurrentWarehouseDisplayName</span>
                                    @if (_isChainAdmin)
                                    {
                                        <button type="button" class="btn-change-branch-link" @onclick="() => SwitchToSpecificWarehouse(0)" title="Trở về bảng chọn kho khác">
                                            &larr; Đổi kho khác
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge-lock-pill">Khóa theo phân quyền</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Dòng 2: Tra cứu & Chọn biến thể SKU -->
                        <div class="form-group variant-lookup-group">
                            <label class="form-label">Mặt hàng / Biến thể cần nhập <span class="required">*</span></label>
                            <div class="lookup-input-wrapper">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" class="lookup-icon">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <input type="text" 
                                       class="form-control lookup-input" 
                                       placeholder="Gõ mã SKU hoặc tên sản phẩm để tìm nhanh (Vd: AT-TRANG-M, Áo Thun, Polo...)" 
                                       @bind="_skuSearchQuery" 
                                       @bind:event="oninput" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_skuSearchQuery) && _filteredSuggestions.Any())
                            {
                                <div class="lookup-dropdown">
                                    @foreach (var v in _filteredSuggestions)
                                    {
                                        <div class="lookup-item @(v.DaXoa ? "item-disabled" : "")" @onclick="() => SelectSuggestion(v)">
                                            <div class="item-left">
                                                <code class="sku-tag">@v.MaSku</code>
                                                <span class="item-name">@v.TenSanPham</span>
                                                <span class="item-variant">(@v.MauSac - Size @v.KichCo)</span>
                                                @if (v.DaXoa)
                                                {
                                                    <span class="badge-hidden-pill" style="background: #fef2f2; color: #ef4444; font-size: 0.68rem; font-weight: 700; padding: 1px 6px; border-radius: 4px; margin-left: 6px; border: 1px solid #fecaca;">⚠️ TẠM NGỪNG CUNG CẤP</span>
                                                }
                                            </div>
                                            <div class="item-right">
                                                <span class="stock-pill">Tồn: @v.SoLuongTon</span>
                                                <span class="price-pill">@v.GiaNhap.ToString("N0") đ</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (_selectedVariant != null)
                            {
                                <div class="selected-variant-card">
                                    <div class="card-pill">ĐÃ CHỌN</div>
                                    <div class="variant-details">
                                        <strong>@_selectedVariant.TenSanPham</strong>
                                        <span>SKU: <code>@_selectedVariant.MaSku</code></span>
                                        <span>Phân loại: <strong>@_selectedVariant.MauSac - @_selectedVariant.KichCo</strong></span>
                                        <span>Tồn hiện tại: <strong class="text-amber">@_selectedVariant.SoLuongTon cái</strong></span>
                                        <span>Mã biến thể ID: <strong>#@_selectedVariant.MaBienThe</strong></span>
                                    </div>
                                    <button type="button" class="btn-clear-selected" @onclick="ClearSelectedVariant" title="Đổi sang mặt hàng khác">
                                        ✕ Đổi mặt hàng
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Dòng 3: Số lượng & Đơn giá nhập -->
                        <div class="form-row-3">
                            <div class="form-group">
                                <label class="form-label">
                                    Mã biến thể ID (*) 
                                    <span class="text-muted" style="font-size: 0.72rem; font-weight: normal;">(Tự khóa theo mặt hàng)</span>
                                </label>
                                <input type="text" 
                                       class="form-control font-mono font-weight-bold" 
                                       readonly 
                                       disabled
                                       value="@(_selectedVariant != null ? $"#{_selectedVariant.MaBienThe} ({_selectedVariant.MaSku})" : (_importVariantId > 0 ? $"#{_importVariantId}" : "Vui lòng chọn ở trên"))" 
                                       style="background: #f8fafc; color: #0f172a; cursor: not-allowed; border-color: #cbd5e1; font-weight: 700;" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Số lượng nhập (*)</label>
                                <div class="qty-input-row">
                                    <input type="number" class="form-control input-qty" placeholder="VD: 50" @bind="_importQuantity" />
                                    <div class="quick-qty-chips">
                                        <button type="button" class="btn-qty-chip" @onclick="() => AddQuickQty(20)">+20</button>
                                        <button type="button" class="btn-qty-chip" @onclick="() => AddQuickQty(50)">+50</button>
                                        <button type="button" class="btn-qty-chip" @onclick="() => AddQuickQty(100)">+100</button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Đơn giá nhập (VNĐ) (*)</label>
                                <input type="number" class="form-control tabular-nums" placeholder="VD: 85000" @bind="_importPrice" />
                            </div>
                        </div>

                        <!-- Dòng 4: Ghi chú & Tổng tiền phiếu nhập -->
                        <div class="form-row-2 align-items-center">
                            <div class="form-group">
                                <label class="form-label">Ghi chú phiếu nhập / Số hóa đơn NCC</label>
                                <input type="text" class="form-control" placeholder="Vd: Lô vải cao cấp nhập từ NCC 01 / Hóa đơn #HD-892" @bind="_importNote" />
                            </div>

                            <div class="preview-total-box">
                                <span class="total-label">DỰ TÍNH TỔNG TIỀN PHIẾU NHẬP:</span>
                                <span class="total-value tabular-nums">@((_importQuantity * _importPrice).ToString("N0")) đ</span>
                            </div>
                        </div>

                        <div class="form-actions-footer">
                            <button type="button" class="btn btn-submit-import" @onclick="HandleImportStock" disabled="@_isSubmittingImport">
                                @if (_isSubmittingImport)
                                {
                                    <span class="btn-spinner"></span>
                                    <span>ĐANG LƯU VÀO CSDL KHO...</span>
                                }
                                else
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                    <span>XÁC NHẬN NHẬP KHO & CẬP NHẬT TỒN NGAY</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHỤ: DANH SÁCH NHANH CÁC MẶT HÀNG CẦN NHẬP GẤP -->
                <div class="card wh-card urgent-stock-panel">
                    <div class="card-header">
                        <div class="header-left">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            <h4 class="card-title">CẦN BỔ SUNG GẤP</h4>
                        </div>
                        <span class="badge-count">@_lowStockAlerts.Count mặt hàng</span>
                    </div>

                    <div class="urgent-list">
                        @if (!_lowStockAlerts.Any())
                        {
                            <div class="empty-urgent-state">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>Tất cả mặt hàng đều đảm bảo tồn kho an toàn!</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in _lowStockAlerts.Take(8))
                            {
                                <div class="urgent-item" @onclick="() => PreFillImport(item.MaBienThe, item.GiaNhap, item)">
                                    <div class="item-info">
                                        <span class="item-sku"><code>@item.MaSku</code></span>
                                        <span class="item-prod-name">@item.TenSanPham</span>
                                        <span class="item-specs">@item.MauSac - Size @item.KichCo</span>
                                    </div>
                                    <div class="item-action">
                                        <span class="badge-stock-urgent @(item.SoLuongTon == 0 ? "zero" : "")">
                                            @(item.SoLuongTon == 0 ? "HẾT HÀNG" : $"Còn {item.SoLuongTon}")
                                        </span>
                                        <button type="button" class="btn-quick-import" title="Nạp nhanh vào form nhập">+ Nhập</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            }
        }
        else if (_currentTab == TabType.Inventory)
        {
            @if (_currentWarehouseScopeId == 0)
            {
                <!-- TAB TỔNG HỢP TỒN KHO TOÀN CHUỖI (DÀNH CHO ADMIN) -->
                <div class="card wh-card">
                    <div class="card-header">
                        <div class="header-left">
                            <div>
                                <h3 class="card-title">TỔNG HỢP TỒN KHO TOÀN HỆ THỐNG (@FilteredInventoryList.Count() SKU)</h3>
                                <p class="card-desc" style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">
                                    💡 Hệ thống hiển thị tổng sản lượng hàng hóa của cả chuỗi (@(_branches.Any() ? $"{_branches.Count} kho" : "toàn chuỗi")). Để xem chi tiết kho nào đang thiếu hàng hoặc lập phiếu nhập, vui lòng chọn kho chi nhánh trên thanh điều hành ở trên.
                                </p>
                            </div>
                        </div>
                        <div class="header-filter-bar">
                            <div class="search-box">
                                <input type="text" class="form-control" placeholder="Lọc theo SKU, tên sản phẩm, màu sắc, size..." @bind="_inventoryFilterQuery" @bind:event="oninput" />
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="wh-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">MÃ BT</th>
                                    <th>MÃ SKU</th>
                                    <th>TÊN SẢN PHẨM</th>
                                    <th>PHÂN LOẠI</th>
                                    <th class="text-center">TỔNG TỒN CẢ CHUỖI</th>
                                    <th class="text-right">GIÁ NHẬP THAM KHẢO</th>
                                    <th class="text-center" style="width: 140px;">CHI TIẾT KHO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredInventoryList.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            Không tìm thấy sản phẩm nào phù hợp điều kiện lọc.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in FilteredInventoryList)
                                    {
                                        <tr>
                                            <td class="font-mono text-muted">#@item.MaBienThe</td>
                                            <td><code class="sku-code">@item.MaSku</code></td>
                                            <td class="font-bold">@item.TenSanPham</td>
                                            <td>@item.MauSac - Size @item.KichCo</td>
                                            <td class="text-center tabular-nums">
                                                <span class="stock-badge stock-neutral">
                                                    @item.SoLuongTon cái
                                                </span>
                                                @if (item.DaXoa)
                                                {
                                                    <span style="display: block; font-size: 0.68rem; color: #64748b; font-weight: 700; margin-top: 2px;">⚪ ĐÃ ẨN</span>
                                                }
                                            </td>
                                            <td class="text-right tabular-nums">@item.GiaNhap.ToString("N0") đ</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-branch-detail" @onclick="() => OpenDispatchModal(item)" title="Xem danh sách kho để chuyển sang kiểm tra">
                                                    🏬 Xem từng kho &rarr;
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- TAB CẢNH BÁO TỒN KHO & KIỂM KÊ CHO KHO CỤ THỂ -->
                <div class="card wh-card">
                    <div class="card-header">
                        <div class="header-left">
                            <div>
                                <h3 class="card-title">CẢNH BÁO THIẾU HÀNG & KIỂM KÊ - @CurrentWarehouseDisplayName</h3>
                                <p class="card-desc" style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">
                                    Danh sách các mặt hàng tại cơ sở này cần lập kế hoạch bổ sung hàng hóa.
                                </p>
                            </div>
                        </div>
                        <div class="header-filter-bar">
                            <div class="search-box">
                                <input type="text" class="form-control" placeholder="Lọc theo SKU, tên sản phẩm, màu sắc, size..." @bind="_inventoryFilterQuery" @bind:event="oninput" />
                            </div>
                            <div class="status-filters">
                                <button type="button" class="filter-chip @(_stockFilterMode == "ALL" ? "active" : "")" @onclick='() => _stockFilterMode = "ALL"'>Tất cả (@_totalSkuTracked)</button>
                                <button type="button" class="filter-chip @(_stockFilterMode == "LOW" ? "active" : "")" @onclick='() => _stockFilterMode = "LOW"'>Sắp hết (&le; 10)</button>
                                <button type="button" class="filter-chip @(_stockFilterMode == "OUT" ? "active" : "")" @onclick='() => _stockFilterMode = "OUT"'>Cạn kho (0)</button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="wh-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">MÃ BT</th>
                                    <th>MÃ SKU</th>
                                    <th>TÊN SẢN PHẨM</th>
                                    <th>PHÂN LOẠI</th>
                                    <th class="text-center">SỐ LƯỢNG TỒN</th>
                                    <th class="text-right">GIÁ NHẬP ĐỀ XUẤT</th>
                                    <th class="text-center">TRẠNG THÁI</th>
                                    <th class="text-center" style="width: 110px;">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredInventoryList.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            Không tìm thấy sản phẩm nào phù hợp điều kiện lọc.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in FilteredInventoryList)
                                    {
                                        <tr class="@(item.SoLuongTon == 0 ? "row-out-of-stock" : (item.SoLuongTon <= 10 ? "row-low-stock" : ""))">
                                            <td class="font-mono text-muted">#@item.MaBienThe</td>
                                            <td><code class="sku-code">@item.MaSku</code></td>
                                            <td class="font-bold">@item.TenSanPham</td>
                                            <td>@item.MauSac - Size @item.KichCo</td>
                                            <td class="text-center tabular-nums">
                                                <span class="stock-badge @(item.SoLuongTon == 0 ? "stock-zero" : (item.SoLuongTon <= 10 ? "stock-low" : "stock-ok"))">
                                                    @item.SoLuongTon
                                                </span>
                                            </td>
                                            <td class="text-right tabular-nums">@item.GiaNhap.ToString("N0") đ</td>
                                            <td class="text-center">
                                                @if (item.DaXoa)
                                                {
                                                    <span class="badge-status-hidden" style="background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; padding: 2px 8px; border-radius: 9999px; font-size: 0.72rem; font-weight: 700;">⚪ ĐÃ ẨN / TẠM NGỪNG</span>
                                                }
                                                else if (item.SoLuongTon == 0)
                                                {
                                                    <span class="badge-status-out">HẾT HÀNG</span>
                                                }
                                                else if (item.SoLuongTon <= 10)
                                                {
                                                    <span class="badge-status-warn">SẮP HẾT HÀNG</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-status-ok">ĐỦ HÀNG</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.DaXoa)
                                                {
                                                    <button type="button" class="btn btn-sm" @onclick="() => WarnHiddenItem(item)" style="opacity: 0.7; background: #f8fafc; color: #94a3b8; border: 1px dashed #cbd5e1; cursor: not-allowed; font-size: 0.74rem;" title="Hàng đã tạm thời ngừng cung cấp">
                                                        🚫 Đã ẩn
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-action-import" @onclick="() => PreFillImport(item.MaBienThe, item.GiaNhap, item)" title="Nạp vào form nhập của kho này">
                                                        + Nhập hàng
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else if (_currentTab == TabType.History)
        {
            <!-- TAB 3: LỊCH SỬ NHẬP KHO & AUDIT -->
            <div class="card wh-card">
                <div class="card-header">
                    <h3 class="card-title">
                        @if (_isChainAdmin)
                        {
                            <span>NHẬT KÝ THAO TÁC NHẬP HÀNG & BIẾN ĐỘNG KHO (@(_currentWarehouseScopeId == 0 ? "TOÀN HỆ THỐNG" : (_branches.FirstOrDefault(b => b.MaChiNhanh == _currentWarehouseScopeId)?.TenChiNhanh ?? $"Chi nhánh #{_currentWarehouseScopeId}")))</span>
                        }
                        else
                        {
                            <span>NHẬT KÝ NHẬP HÀNG KHO (@(_isOnlineWarehouseKeeper ? OnlineWarehouseName : _staffBranchName))</span>
                        }
                    </h3>
                    <button type="button" class="btn-refresh" @onclick="LoadAuditLogs">Làm mới lịch sử</button>
                </div>

                <div class="table-responsive">
                    <table class="wh-table">
                        <thead>
                            <tr>
                                <th style="width: 90px;">MÃ VẾT</th>
                                <th style="width: 140px;">ĐỐI TƯỢNG</th>
                                <th>NỘI DUNG CHI TIẾT NHẬP HÀNG</th>
                                @if (_isChainAdmin && _currentWarehouseScopeId == 0)
                                {
                                    <th style="width: 170px;">CHI NHÁNH</th>
                                }
                                <th style="width: 180px;">NGƯỜI THỰC HIỆN</th>
                                <th style="width: 160px;" class="text-right">THỜI GIAN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isLoadingLogs)
                            {
                                <tr>
                                    <td colspan="@(_isChainAdmin && _currentWarehouseScopeId == 0 ? 6 : 5)" class="text-center py-5 text-muted">
                                        <div class="spinner-border spinner-border-sm me-2" role="status"></div> Đang nạp nhật ký kiểm toán và lịch sử nhập kho...
                                    </td>
                                </tr>
                            }
                            else if (!_auditLogs.Any())
                            {
                                <tr>
                                    <td colspan="@(_isChainAdmin && _currentWarehouseScopeId == 0 ? 6 : 5)" class="text-center py-5 text-muted">Chưa ghi nhận đợt nhập hàng nào trong nhật ký kho này.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in _auditLogs)
                                {
                                    <tr>
                                        <td class="font-mono text-muted">#@log.MaNhatKy</td>
                                        <td><span class="pill-badge">@log.DoiTuong</span></td>
                                        <td class="log-content">@log.NoiDungChiTiet</td>
                                        @if (_isChainAdmin && _currentWarehouseScopeId == 0)
                                        {
                                            <td><span class="pill-badge" style="background:#e0e7ff; color:#3730a3;">@(log.TenChiNhanh ?? (log.MaChiNhanh.HasValue ? $"Chi nhánh #{log.MaChiNhanh}" : "Kho hệ thống"))</span></td>
                                        }
                                        <td><strong>@log.TenNhanVien</strong></td>
                                        <td class="text-right font-mono text-muted">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (_currentTab == TabType.Announcements)
        {
            <!-- TAB 4: THÔNG BÁO ĐIỀU HÀNH KHO -->
            <div class="card wh-card">
                <div class="card-header">
                    <h3 class="card-title">THÔNG BÁO ĐIỀU HÀNH TỪ QUẢN TRỊ VIÊN & CỬA HÀNG TRƯỞNG</h3>
                    <button type="button" class="btn-refresh" @onclick="LoadAnnouncements">Tải lại thông báo</button>
                </div>

                <div class="announcements-body">
                    @if (!_announcements.Any())
                    {
                        <div class="empty-state py-5">Chưa có thông báo nào gửi đến bộ phận kho.</div>
                    }
                    else
                    {
                        @foreach (var item in _announcements)
                        {
                            <div class="announcement-item priority-@item.MucDoUuTien.ToLower()">
                                <div class="ann-top">
                                    <div class="badges">
                                        <span class="badge-priority">@item.MucDoUuTien</span>
                                        <span class="badge-scope">@item.PhamViGui</span>
                                    </div>
                                    <span class="ann-date">@item.NgayTao.ToString("HH:mm - dd/MM/yyyy")</span>
                                </div>
                                <h4 class="ann-title">@item.TieuDe</h4>
                                <p class="ann-content">@item.NoiDung</p>
                                <div class="ann-footer">Người gửi: <strong>@item.TenNguoiGui</strong> (@(item.ChucVuNguoiGui ?? "Quản lý"))</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- MODAL CHUYỂN SANG TRANG KHO CHI NHÁNH KHI ĐANG Ở TOÀN CHUỖI -->
        @if (_isDispatchModalOpen && _dispatchingItem != null)
        {
            <div class="modal-backdrop">
                <div class="modal-card dispatch-modal-box">
                    <div class="modal-header">
                        <div class="modal-header-left">
                            <span class="icon-modal-dispatch">🏬</span>
                            <div>
                                <h3 class="modal-title">CHUYỂN SANG TRANG KHO CHI NHÁNH</h3>
                                <p class="modal-desc">Chọn một cơ sở để chuyển sang kiểm tra tồn kho & lập phiếu nhập hàng</p>
                            </div>
                        </div>
                        <button type="button" class="btn-modal-close" @onclick="CloseDispatchModal">&times;</button>
                    </div>

                    <div class="modal-body">
                        <div class="dispatch-target-item">
                            <div class="target-sku"><code>@_dispatchingItem.MaSku</code></div>
                            <div class="target-name">@_dispatchingItem.TenSanPham</div>
                            <div class="target-meta">Phân loại: <strong>@_dispatchingItem.MauSac - Size @_dispatchingItem.KichCo</strong> | Tổng tồn toàn chuỗi: <span class="text-blue font-weight-bold">@_dispatchingItem.SoLuongTon cái</span></div>
                        </div>

                        <div class="dispatch-prompt">
                            <strong>Chọn cơ sở / kho để chuyển sang quản lý:</strong>
                        </div>

                        <div class="dispatch-options-list">
                            <!-- Kho Tổng Online -->
                            <button type="button" class="dispatch-option-btn online" @onclick="() => DispatchToWarehouse(OnlineWarehouseId)">
                                <div class="option-icon">🌐</div>
                                <div class="option-info">
                                    <span class="option-title">@OnlineWarehouseName</span>
                                    <span class="option-sub">Phục vụ đơn online, fulfillment & bưu tá</span>
                                </div>
                                <span class="option-arrow">&rarr;</span>
                            </button>

                            <!-- Các chi nhánh offline -->
                            @foreach (var b in _branches.Where(x => !x.IsOnlineWarehouse && x.MaChiNhanh != OnlineWarehouseId))
                            {
                                <button type="button" class="dispatch-option-btn branch" @onclick="() => DispatchToWarehouse(b.MaChiNhanh)">
                                    <div class="option-icon">🏬</div>
                                    <div class="option-info">
                                        <span class="option-title">@b.TenChiNhanh</span>
                                        <span class="option-sub">@(string.IsNullOrEmpty(b.DiaChi) ? "Điểm bán lẻ trực tiếp" : b.DiaChi)</span>
                                    </div>
                                    <span class="option-arrow">&rarr;</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseDispatchModal">Đóng</button>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

