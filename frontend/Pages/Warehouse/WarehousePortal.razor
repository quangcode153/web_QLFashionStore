    private async Task SaveNewSupplierQuickly()
    {
        if (string.IsNullOrWhiteSpace(_newSupplierName))
        {
            Toast.ShowWarning("Vui lòng nhập tên nhà cung cấp mới.");
            return;
        }

        _isSavingSupplier = true;
        try
        {
            var req = new global::Shared.DTOs.Warehouse.CreateSupplierRequestDto
            {
                TenNhaCungCap = _newSupplierName.Trim(),
                DienThoaiLienHe = string.IsNullOrWhiteSpace(_newSupplierPhone) ? null : _newSupplierPhone.Trim()
            };

            var created = await AdminApi.CreateSupplierAsync(req);
            if (created != null && created.MaNhaCungCap > 0)
            {
                _suppliers.Insert(0, created);
                _selectedSupplierId = created.MaNhaCungCap;
                _newSupplierName = string.Empty;
                _newSupplierPhone = null;
                _isCustomSupplierMode = false;
                Toast.ShowSuccess($"Đã tạo NCC '{created.TenNhaCungCap}' thành công!");
            }
            else
            {
                Toast.ShowError("Không thể tạo nhà cung cấp.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tạo NCC: {ex.Message}");
        }
        finally
        {
            _isSavingSupplier = false;
        }
    }

    private async Task HandleImportStock()
    {
        if (_selectedVariant != null && _selectedVariant.DaXoa)
        {
            Toast.ShowError("Hàng đã tạm thời ngừng cung cấp. Không thể lập phiếu nhập cho sản phẩm này!");
            return;
        }

        if (_importVariantId <= 0 && _selectedVariant != null)
        {
            _importVariantId = _selectedVariant.MaBienThe;
        }

        if (_importVariantId <= 0)
        {
            Toast.ShowWarning("Vui lòng tìm và chọn mặt hàng/biến thể cần nhập ở ô tìm kiếm phía trên.");
            return;
        }

        if (_importQuantity <= 0)
        {
            Toast.ShowWarning("Số lượng nhập phải lớn hơn 0.");
            return;
        }

        if (_importPrice < 0)
        {
            Toast.ShowWarning("Đơn giá nhập không hợp lệ.");
            return;
        }

        _isSubmittingImport = true;
        try
        {
            var req = new global::Shared.DTOs.Warehouse.ImportStockRequestDto
            {
                MaChiNhanh = !_isChainAdmin
                    ? (_isOnlineWarehouseKeeper ? OnlineWarehouseId : (_staffBranchId > 0 ? _staffBranchId : OnlineWarehouseId))
                    : (_selectedBranchId > 0 ? _selectedBranchId : OnlineWarehouseId),
                MaBienThe = _importVariantId,
                MaNhaCungCap = _selectedSupplierId,
                MaNhanVien = _staffId,
                SoLuong = _importQuantity,
                DonGiaNhap = _importPrice,
                GhiChu = _importNote
            };

            var success = await AdminApi.ImportStockAsync(req);
            if (success)
            {
                Toast.ShowSuccess($"Nhập kho thành công {_importQuantity} sản phẩm (SKU #{_importVariantId})!");
                await LoadWarehouseData();
                await LoadAuditLogs();
                ResetImportForm();
            }
            else
            {
                Toast.ShowError("Nhập kho thất bại. Vui lòng kiểm tra mã biến thể SKU.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi nhập kho: {ex.Message}");
        }
        finally
        {
            _isSubmittingImport = false;
        }
    }

