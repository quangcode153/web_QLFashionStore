    protected override async Task OnInitializedAsync()
    {
        await SignalRService.StartAsync();
        SyncAuthFromAuthStateService();
        await LoadWarehouseData();
    }

    private void SyncAuthFromAuthStateService()
    {
        if (AuthStateService.IsAuthenticated && !string.IsNullOrEmpty(AuthStateService.UserRole))
        {
            _userRole = AuthStateService.UserRole;
            _staffName = AuthStateService.StaffName;
            var isChainAdmin = _userRole.Contains("Admin", StringComparison.OrdinalIgnoreCase) ||
                               _userRole.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                               _userRole.Contains("chuỗi", StringComparison.OrdinalIgnoreCase);

            var isBranchManager = _userRole.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                                  _userRole.Contains("Cửa hàng trưởng", StringComparison.OrdinalIgnoreCase);

            if (isChainAdmin)
            {
                _isChainAdmin = true;
                _canAccessAdminChain = true;
                _canAccessPos = true;
                _badgeRoleTitle = "QUẢN LÝ CHUỖI TOÀN HỆ THỐNG";
                _roleDisplayTitle = "Quản trị viên toàn chuỗi";
                _scopeDescText = "Phạm vi: Toàn chuỗi";
                var name = _staffName ?? "Admin";
                _avatarLetters = name.Length >= 2 ? name.Substring(0, 2).ToUpper() : "AD";
            }
            else if (isBranchManager)
            {
                _isBranchManager = true;
                _canAccessPos = true;
                _badgeRoleTitle = "QUẢN LÝ CHI NHÁNH";
                _scopeDescText = $"Phạm vi: {_staffBranchName}";
                _roleDisplayTitle = "Cửa hàng trưởng chi nhánh";
                var name = _staffName ?? "QL";
                _avatarLetters = name.Length >= 2 ? name.Substring(0, 2).ToUpper() : "QL";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _userRole = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                _staffName = await JS.InvokeAsync<string?>("localStorage.getItem", "staffName");
                var idStr = await JS.InvokeAsync<string?>("localStorage.getItem", "staffId");
                if (int.TryParse(idStr, out var id) && id > 0)
                {
                    _staffId = id;
                }

                var branchIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "staffBranchId");
                var branchName = await JS.InvokeAsync<string?>("localStorage.getItem", "staffBranchName");
                var loaiThuKhoVal = await JS.InvokeAsync<string?>("localStorage.getItem", "loaiThuKho");
                if (int.TryParse(branchIdStr, out var bId) && bId > 0)
                {
                    _staffBranchId = bId;
                    _selectedBranchId = bId;
                    _staffBranchName = branchName ?? $"Chi nhánh #{bId}";
                }
                if (!string.IsNullOrEmpty(loaiThuKhoVal))
                {
                    _loaiThuKho = loaiThuKhoVal;
                }

                if (!string.IsNullOrEmpty(_userRole))
                {
                    var isChainAdmin = _userRole.Contains("Admin", StringComparison.OrdinalIgnoreCase) ||
                                       _userRole.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                                       _userRole.Contains("chuỗi", StringComparison.OrdinalIgnoreCase);

                    var isBranchManager = _userRole.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                                          _userRole.Contains("Cửa hàng trưởng", StringComparison.OrdinalIgnoreCase);

                    var isThuKho = _userRole.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                                   _userRole.Contains("kho", StringComparison.OrdinalIgnoreCase) ||
                                   _userRole.Contains("warehouse", StringComparison.OrdinalIgnoreCase);

                    if (isChainAdmin)
                    {
                        _isChainAdmin = true;
                        _isOnlineWarehouseKeeper = false;
                        _isBranchWarehouseKeeper = false;
                        _canAccessAdminChain = true;
                        _canAccessPos = true;
                        _badgeRoleTitle = "QUẢN LÝ CHUỖI TOÀN HỆ THỐNG";
                        _scopeDescText = _currentWarehouseScopeId == 0 
                            ? $"Phạm vi: Toàn chuỗi ({(_branches.Any() ? _branches.Count.ToString() : "Tất cả")} chi nhánh)" 
                            : $"Phạm vi: {_branches.FirstOrDefault(b => b.MaChiNhanh == _currentWarehouseScopeId)?.TenChiNhanh ?? $"Chi nhánh #{_currentWarehouseScopeId}"}";
                        _roleDisplayTitle = "Quản trị viên toàn chuỗi";
                        var name = _staffName ?? "Admin";
                        _avatarLetters = name.Length >= 2 ? name.Substring(0, 2).ToUpper() : "AD";

                        // Khi ở chế độ Toàn chuỗi: Mặc định Tab Giám sát tồn kho toàn chuỗi để quan sát số liệu
                        if (_currentWarehouseScopeId == 0)
                        {
                            _currentTab = TabType.Inventory;
                        }
                    }
                    else if (isBranchManager)
                    {
                        _isChainAdmin = false;
                        _isBranchManager = true;
                        _isOnlineWarehouseKeeper = false;
                        _isBranchWarehouseKeeper = true;
                        _currentWarehouseScopeId = _staffBranchId;
                        _selectedBranchId = _staffBranchId;
                        _canAccessAdminChain = false;
                        _canAccessPos = true;
                        _currentTab = TabType.Inventory;
                        _badgeRoleTitle = "QUẢN LÝ CHI NHÁNH";
                        _scopeDescText = $"Phạm vi: {_staffBranchName}";
                        _roleDisplayTitle = "Cửa hàng trưởng chi nhánh";
                        var name = _staffName ?? "QL";
                        _avatarLetters = name.Length >= 2 ? name.Substring(0, 2).ToUpper() : "QL";
                    }
                    else if (isThuKho)
                    {
                        // THỦ KHO: Phân biệt Thủ kho Online (Kho Tổng) vs Thủ kho chi nhánh
                        _canAccessAdminChain = false;
                        _canAccessPos = false;
                        if (_loaiThuKho.Contains("Online", StringComparison.OrdinalIgnoreCase) || _staffBranchId == 9)
                        {
                            _isChainAdmin = false;
                            _isOnlineWarehouseKeeper = true;
                            _isBranchWarehouseKeeper = false;
                            _currentWarehouseScopeId = 9;
                            _selectedBranchId = 9;
                            _badgeRoleTitle = "THỦ KHO ONLINE (KHO TỔNG)";
                            _scopeDescText = "Phạm vi: Kho Tổng QF Tân Bình (Đơn Online & Bán buôn)";
                            _roleDisplayTitle = "Thủ kho Online (Kho Tổng)";
                        }
                        else
                        {
                            _isChainAdmin = false;
                            _isOnlineWarehouseKeeper = false;
                            _isBranchWarehouseKeeper = true;
                            _currentWarehouseScopeId = _staffBranchId;
                            _selectedBranchId = _staffBranchId;
                            _badgeRoleTitle = "THỦ KHO CHI NHÁNH";
                            _scopeDescText = $"Phạm vi: {_staffBranchName}";
                            _roleDisplayTitle = $"Thủ kho {_staffBranchName}";
                        }
                        _avatarLetters = "TK";
                    }
                    else
                    {
                        Toast.ShowWarning("Bạn không có quyền truy cập cổng Quản lý kho.");
                        Navigation.NavigateTo(_userRole == global::Shared.Constants.RoleConstants.KhachHang ? "/" : "/pos");
                        return;
                    }
                }
                else
                {
                    Navigation.NavigateTo("/login?returnUrl=/warehouse");
                    return;
                }
                if (_currentWarehouseScopeId > 0)
                {
                    await LoadWarehouseDataForScope(_currentWarehouseScopeId);
                }
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task SetTab(TabType tab)
    {
        _currentTab = tab;
        if (tab == TabType.History)
        {
            await LoadAuditLogs();
        }
        else if (tab == TabType.Announcements && !_announcements.Any())
        {
            await LoadAnnouncements();
        }
    }

    private string CurrentWarehouseDisplayName
    {
        get
        {
            if (_currentWarehouseScopeId == 0) return $"Toàn chuỗi ({(_branches.Any() ? _branches.Count.ToString() : "Tất cả")} chi nhánh)";
            var onlineBranch = _branches.FirstOrDefault(x => x.IsOnlineWarehouse);
            if (onlineBranch != null && _currentWarehouseScopeId == onlineBranch.MaChiNhanh) return $"🌐 Kho Tổng Online ({onlineBranch.TenChiNhanh})";
            var b = _branches.FirstOrDefault(x => x.MaChiNhanh == _currentWarehouseScopeId);
            return b != null ? $"🏬 {b.TenChiNhanh}" : $"Chi nhánh #{_currentWarehouseScopeId}";
        }
    }

    private async Task SwitchToSpecificWarehouse(int branchId)
    {
        var onlineBranchId = _branches.FirstOrDefault(x => x.IsOnlineWarehouse)?.MaChiNhanh ?? 9;
        if (!_isChainAdmin && branchId != _staffBranchId && !(_isOnlineWarehouseKeeper && branchId == onlineBranchId))
            return;

        _currentWarehouseScopeId = branchId;
        if (branchId > 0)
        {
            _selectedBranchId = branchId;
            var b = _branches.FirstOrDefault(x => x.MaChiNhanh == branchId);
            var name = b?.IsOnlineWarehouse == true ? "Kho Tổng Online" : (b?.TenChiNhanh ?? $"Chi nhánh #{branchId}");
            _scopeDescText = $"Phạm vi: {name}";
            _currentTab = TabType.Import;
        }
        else
        {
            _scopeDescText = $"Phạm vi: Toàn chuỗi ({(_branches.Any() ? _branches.Count.ToString() : "Tất cả")} chi nhánh)";
            _currentTab = TabType.Inventory;
        }
        await LoadWarehouseDataForScope(branchId);
        if (_currentTab == TabType.History)
        {
            await LoadAuditLogs();
        }
        StateHasChanged();
    }

    private async Task OnWarehouseScopeChanged(ChangeEventArgs e)
    {
        if (!_isChainAdmin) return;

        if (int.TryParse(e.Value?.ToString(), out var newScopeId))
        {
            await SwitchToSpecificWarehouse(newScopeId);
        }
    }

    // Modal Điều Phối Nhập Hàng Từ Bảng Toàn Chuỗi
    private bool _isDispatchModalOpen = false;
    private global::Shared.DTOs.Warehouse.LowStockAlertDto? _dispatchingItem;

    private void OpenDispatchModal(global::Shared.DTOs.Warehouse.LowStockAlertDto item)
    {
        _dispatchingItem = item;
        _isDispatchModalOpen = true;
    }

    private void CloseDispatchModal()
    {
        _isDispatchModalOpen = false;
        _dispatchingItem = null;
    }

    private async Task DispatchToWarehouse(int branchId)
    {
        var itemToImport = _dispatchingItem;
        await SwitchToSpecificWarehouse(branchId);
        if (itemToImport != null)
        {
            PreFillImport(itemToImport.MaBienThe, itemToImport.GiaNhap, itemToImport);
        }
        CloseDispatchModal();
    }

    private Task LoadWarehouseData() => LoadWarehouseDataForScope(_currentWarehouseScopeId);

    private async Task LoadWarehouseDataForScope(int scopeId)
    {
        _isLoadingData = true;
        try
        {
            var suppliersTask = AdminApi.GetSuppliersAsync();
            var announcementsTask = AdminApi.GetAnnouncementsAsync(phamVi: "Thủ kho");
            var branchesTask = AdminApi.GetBranchesAsync();

            if (scopeId == 0)
            {
                // TOÀN CHUỖI: Lấy tổng hợp toàn chuỗi (Toàn bộ 351 SKU)
                var variantsTask = AdminApi.GetAllWarehouseVariantsAsync();

                await Task.WhenAll(variantsTask, suppliersTask, announcementsTask, branchesTask);

                _allVariants = (await variantsTask) ?? new();
                _suppliers = (await suppliersTask) ?? new();
                _announcements = (await announcementsTask) ?? new();
                _branches = (await branchesTask) ?? new();

                _totalStockInChain = _allVariants.Sum(x => x.SoLuongTon);
                _totalSkuTracked = _allVariants.Any() ? _allVariants.Count : 351;
                _lowStockAlerts = new();
                _outOfStockCount = 0;
            }
            else
            {
                // KHO CỤ THỂ: Lấy đúng tồn kho của chi nhánh/kho online này từ TonKhoChiNhanh
                var inventoryTask = AdminApi.GetBranchInventoryAsync(scopeId);

                await Task.WhenAll(inventoryTask, suppliersTask, announcementsTask, branchesTask);

                var branchItems = (await inventoryTask) ?? new();
                _suppliers = (await suppliersTask) ?? new();
                _announcements = (await announcementsTask) ?? new();
                _branches = (await branchesTask) ?? new();

                _allVariants = branchItems.Select(x => new LowStockAlertDto
                {
                    MaBienThe = x.MaBienThe,
                    TenSanPham = x.TenSanPham,
                    MaSku = x.MaSku ?? $"QF-SP-{x.MaBienThe}",
                    MauSac = x.MauSac,
                    KichCo = x.KichCo,
                    SoLuongTon = x.SoLuongTon,
                    GiaNhap = x.GiaBan * 0.6m,
                    DaXoa = x.DaXoa
                }).ToList();

                _lowStockAlerts = branchItems
                    .Where(x => x.SoLuongTon <= x.MucCanhBaoTon)
                    .OrderBy(x => x.SoLuongTon)
                    .Select(x => new LowStockAlertDto
                    {
                        MaBienThe = x.MaBienThe,
                        TenSanPham = x.TenSanPham,
                        MaSku = x.MaSku ?? $"QF-SP-{x.MaBienThe}",
                        MauSac = x.MauSac,
                        KichCo = x.KichCo,
                        SoLuongTon = x.SoLuongTon,
                        GiaNhap = x.GiaBan * 0.6m,
                        DaXoa = x.DaXoa
                    }).ToList();

                _outOfStockCount = branchItems.Count(x => x.SoLuongTon == 0);
                _totalSkuTracked = branchItems.Count;
            }

            if (_suppliers.Any() && (_selectedSupplierId == 0 || !_suppliers.Any(s => s.MaNhaCungCap == _selectedSupplierId)))
            {
                _selectedSupplierId = _suppliers.First().MaNhaCungCap;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải dữ liệu kho: {ex.Message}");
        }
        finally
        {
            _isLoadingData = false;
            StateHasChanged();
        }
    }

    private async Task LoadAuditLogs()
    {
        _isLoadingLogs = true;
        StateHasChanged();
        try
        {
            int? targetBranchId = null;
            if (!_isChainAdmin)
            {
                // Kho chi nhánh chỉ được xem nhật ký của kho mình đang quản lý
                targetBranchId = _isOnlineWarehouseKeeper ? OnlineWarehouseId : (_staffBranchId > 0 ? _staffBranchId : _currentWarehouseScopeId);
            }
            else
            {
                // Admin: Toàn chuỗi (_currentWarehouseScopeId == 0) xem toàn bộ; nếu chọn kho cụ thể thì xem riêng kho đó
                targetBranchId = _currentWarehouseScopeId > 0 ? _currentWarehouseScopeId : null;
            }

            var data = await AdminApi.GetAuditLogsAsync("NHAP_HANG", targetBranchId, 50);
            _auditLogs = data ?? new();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải lịch sử: {ex.Message}");
        }
        finally
        {
            _isLoadingLogs = false;
            StateHasChanged();
        }
    }

    private async Task LoadAnnouncements()
    {
        try
        {
            var data = await AdminApi.GetAnnouncementsAsync(phamVi: "Thủ kho");
            _announcements = data ?? new();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải thông báo: {ex.Message}");
        }
    }

    private IEnumerable<global::Shared.DTOs.Warehouse.LowStockAlertDto> _filteredSuggestions =>
        string.IsNullOrWhiteSpace(_skuSearchQuery) 
            ? Enumerable.Empty<global::Shared.DTOs.Warehouse.LowStockAlertDto>()
            : (_allVariants.Any() ? _allVariants : _lowStockAlerts).Where(x => 
                x.MaSku.Contains(_skuSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                x.TenSanPham.Contains(_skuSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                (x.MauSac != null && x.MauSac.Contains(_skuSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (x.KichCo != null && x.KichCo.Contains(_skuSearchQuery, StringComparison.OrdinalIgnoreCase)))
                .Take(25);

    private IEnumerable<global::Shared.DTOs.Warehouse.LowStockAlertDto> FilteredInventoryList
    {
        get
        {
            var source = _allVariants.Any() ? _allVariants : _lowStockAlerts;
            var q = source.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_inventoryFilterQuery))
            {
                q = q.Where(x => 
                    x.MaSku.Contains(_inventoryFilterQuery, StringComparison.OrdinalIgnoreCase) ||
                    x.TenSanPham.Contains(_inventoryFilterQuery, StringComparison.OrdinalIgnoreCase) ||
                    (x.MauSac != null && x.MauSac.Contains(_inventoryFilterQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (x.KichCo != null && x.KichCo.Contains(_inventoryFilterQuery, StringComparison.OrdinalIgnoreCase)));
            }
            if (_currentWarehouseScopeId > 0)
            {
                if (_stockFilterMode == "LOW")
                {
                    q = q.Where(x => x.SoLuongTon > 0 && x.SoLuongTon <= 10);
                }
                else if (_stockFilterMode == "OUT")
                {
                    q = q.Where(x => x.SoLuongTon == 0);
                }
            }
            return q;
        }
    }

