@code {
    private string _activeMobileTab = "products";
    private string _searchBarcode = string.Empty;
    private string _customerPhone = string.Empty;
    private string _cashGivenInput = string.Empty;
    private decimal CashGiven => decimal.TryParse(_cashGivenInput, out var val) ? val : 0;

    private List<ProductListItemDto> _fastSaleProducts = new();
    private List<PosCartLineItem> _cartItems = new();
    private CustomerProfileDto? _currentCustomer;

    private bool _isLoadingFastSale = true;
    private bool _isProcessingPayment = false;
    private bool _showPrintModal = false;
    private bool _showReturnModal = false;
    private bool _showVariantModal = false;
    private ProductListItemDto? _selectedFastSaleProduct;
    private List<ProductVariantDto> _fastSaleVariants = new();
    private ReceiptPrintDto? _activeReceipt;

    private decimal SubTotal => _cartItems.Sum(x => x.ThanhTien);
    private decimal DiscountAmount => _currentCustomer != null && _currentCustomer.PhanTramGiamGia > 0
        ? Math.Round(SubTotal * _currentCustomer.PhanTramGiamGia / 100m, 0)
        : 0;

    private string DiscountDescription => _currentCustomer != null 
        ? $"VIP {_currentCustomer.TenCapDo} {_currentCustomer.PhanTramGiamGia}%"
        : string.Empty;

    private decimal GrandTotal => Math.Max(0, SubTotal - DiscountAmount);
    private decimal ChangeDue => CashGiven > GrandTotal ? CashGiven - GrandTotal : 0;
    private string? _cashierName;
    private int _staffId = 1;
    private int _cashierBranchId = 1;
    private string? _cashierBranchName;
    private string? _userRole;
    private bool _canAccessWarehouse = false;
    private bool _canAccessAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
            var name = await JS.InvokeAsync<string?>("localStorage.getItem", "staffName");
            if (!string.IsNullOrEmpty(name)) _cashierName = name;

            var idStr = await JS.InvokeAsync<string?>("localStorage.getItem", "staffId");
            if (int.TryParse(idStr, out var id) && id > 0) _staffId = id;

            var bIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
            if (int.TryParse(bIdStr, out var bId) && bId > 0) _cashierBranchId = bId;

            var bName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
            if (!string.IsNullOrEmpty(bName)) _cashierBranchName = bName;

            if (!string.IsNullOrEmpty(role))
            {
                _userRole = role;
                _canAccessAdmin = role.Contains("Admin", StringComparison.OrdinalIgnoreCase) ||
                                  role.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                                  role.Contains("chuỗi", StringComparison.OrdinalIgnoreCase);

                _canAccessWarehouse = _canAccessAdmin ||
                                      role.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                                      role.Contains("kho", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch { }

        await SignalRService.StartAsync();
        await LoadFastSaleProducts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                if (string.IsNullOrWhiteSpace(role) || !global::Shared.Constants.RoleConstants.IsStaff(role))
                {
                    Navigation.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
                    return;
                }
            }
            catch { }
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthStateService.ClearAuthAsync();
        }
        catch { }
        Navigation.NavigateTo("/login");
    }

    private async Task LoadFastSaleProducts()
    {
        _isLoadingFastSale = true;
        try
        {
            var res = await PosApiClient.GetFastSaleProductsAsync();
            _fastSaleProducts = res ?? new List<ProductListItemDto>();
        }
        catch
        {
            _fastSaleProducts = new List<ProductListItemDto>();
        }
        finally
        {
            _isLoadingFastSale = false;
        }
    }

    private void OnBarcodeChanged(ChangeEventArgs e)
    {
        _searchBarcode = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F3")
        {
            OpenReturnModal();
        }
        else if (e.Key == "Enter")
        {
            await HandleSearchSku();
        }
    }

    private void OpenReturnModal()
    {
        _showReturnModal = true;
    }

    private void CloseReturnModal()
    {
        _showReturnModal = false;
    }

    private async Task HandleReturnSuccess(int orderId)
    {
        await LoadFastSaleProducts();
    }

    private async Task HandleSearchSku()
    {
        if (string.IsNullOrWhiteSpace(_searchBarcode)) return;

        try
        {
            var variant = await PosApiClient.SearchSkuAsync(_searchBarcode.Trim());
            if (variant != null)
            {
                AddVariantToCart(variant);
                _searchBarcode = string.Empty;
            }
            else
            {
                Toast.ShowWarning($"Không tìm thấy sản phẩm với mã SKU: {_searchBarcode}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tra cứu SKU: {ex.Message}");
        }
    }

    private void CloseVariantModal()
    {
        _showVariantModal = false;
        _selectedFastSaleProduct = null;
        _fastSaleVariants.Clear();
    }

    private void SelectVariantAndAddToCart(ProductVariantDto variant)
    {
        AddVariantToCart(variant);
        CloseVariantModal();
    }

    private async Task HandleFastSaleSelect(ProductListItemDto prod)
    {
        try
        {
            var variants = await PosApiClient.GetProductVariantsAsync(prod.MaSanPham);
            if (variants != null && variants.Any())
            {
                if (variants.Count == 1)
                {
                    AddVariantToCart(variants[0]);
                    return;
                }

                _selectedFastSaleProduct = prod;
                _fastSaleVariants = variants;
                _showVariantModal = true;
                return;
            }
        }
        catch { }

        var existing = _cartItems.FirstOrDefault(x => x.MaSanPham == prod.MaSanPham);
        if (existing != null)
        {
            existing.SoLuong++;
            return;
        }

        _cartItems.Add(new PosCartLineItem
        {
            MaBienThe = prod.MaSanPham,
            MaSanPham = prod.MaSanPham,
            TenSanPham = prod.TenSanPham,
            MaSku = $"SP-{prod.MaSanPham}",
            MauSac = "Tiêu chuẩn",
            KichCo = "Freesize",
            DonGia = prod.GiaThapNhat,
            SoLuong = 1
        });
    }

    private void AddVariantToCart(ProductVariantDto variant)
    {
        var existing = _cartItems.FirstOrDefault(x => x.MaBienThe == variant.MaBienThe);
        if (existing != null)
        {
            existing.SoLuong++;
        }
        else
        {
            _cartItems.Add(new PosCartLineItem
            {
                MaBienThe = variant.MaBienThe,
                MaSanPham = variant.MaSanPham,
                TenSanPham = variant.TenSanPham,
                MaSku = variant.MaSku,
                MauSac = variant.MauSac,
                KichCo = variant.KichCo,
                DonGia = (variant.PhanTramGiamGia > 0 && variant.GiaSauGiam > 0) ? variant.GiaSauGiam : variant.GiaBan,
                SoLuong = 1
            });
        }
    }

    private void UpdateQuantity(PosCartLineItem item, int delta)
    {
        item.SoLuong += delta;
        if (item.SoLuong <= 0)
        {
            _cartItems.Remove(item);
        }
    }

    private void RemoveCartItem(PosCartLineItem item)
    {
        _cartItems.Remove(item);
    }

    private void OnCustomerPhoneChanged(ChangeEventArgs e)
    {
        _customerPhone = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnCustomerPhoneKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLookupCustomer();
        }
    }

    private async Task HandleLookupCustomer()
    {
        if (string.IsNullOrWhiteSpace(_customerPhone)) return;

        try
        {
            var customer = await PosApiClient.LookupCustomerByPhoneAsync(_customerPhone.Trim());
            if (customer != null)
            {
                _currentCustomer = customer;
                Toast.ShowSuccess($"Đã gắn thông tin khách VIP: {customer.TenKhachHang} ({customer.TenCapDo})");
            }
            else
            {
                Toast.ShowWarning("Không tìm thấy khách hàng với số điện thoại này.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tra cứu khách hàng: {ex.Message}");
        }
    }

    private void RemoveCustomer()
    {
        _currentCustomer = null;
        _customerPhone = string.Empty;
    }

    private void OnCashGivenChanged(ChangeEventArgs e)
    {
        _cashGivenInput = e.Value?.ToString() ?? string.Empty;
    }

    private void OnCashGivenInput(ChangeEventArgs e)
    {
        _cashGivenInput = e.Value?.ToString() ?? string.Empty;
    }

    private void SetQuickCash(decimal amount)
    {
        _cashGivenInput = amount > 0 ? amount.ToString("0") : "0";
    }

    private async Task HandleCheckoutAndPrint()
    {
        if (_cartItems.Count == 0) return;

        if (CashGiven > 0 && CashGiven < GrandTotal)
        {
            Toast.ShowWarning($"Số tiền khách đưa ({CashGiven:N0} đ) chưa đủ để thanh toán ({GrandTotal:N0} đ).");
            return;
        }

        _isProcessingPayment = true;
        try
        {
            var orderReq = new CreateOrderRequestDto
            {
                MaKhachHang = _currentCustomer?.MaKhachHang,
                MaNhanVien = _staffId > 0 ? _staffId : 1, // Mã nhân viên của người đang trực tiếp thao tác tại quầy POS
                MaChiNhanh = _cashierBranchId > 0 ? _cashierBranchId : 1, // Chi nhánh của thu ngân
                MaGiamGia = null,
                TrangThai = "Đã hoàn thành", // Khách thanh toán đủ tại quầy -> tự động hoàn tất đơn
                Items = _cartItems.Select(x => new CreateOrderItemDto
                {
                    MaBienThe = x.MaBienThe,
                    SoLuong = x.SoLuong
                }).ToList()
            };

            var orderRes = await PosApiClient.CreatePosOrderAsync(orderReq);
            if (orderRes != null && orderRes.MaHoaDon > 0)
            {
                var receipt = await PosApiClient.GetReceiptPrintAsync(orderRes.MaHoaDon);
                _activeReceipt = receipt ?? new ReceiptPrintDto
                {
                    MaHoaDon = orderRes.MaHoaDon,
                    NgayLapHoaDon = DateTime.Now,
                    TenKhachHang = _currentCustomer?.TenKhachHang ?? "Khách lẻ",
                    SdtKhachHang = _currentCustomer?.DienThoai,
                    ThuNgan = _cashierName ?? "Thu ngân 01",
                    TienHang = SubTotal,
                    TienGiamGia = DiscountAmount,
                    TongThanhToan = GrandTotal,
                    TrangThai = "Đã thanh toán",
                    Items = _cartItems.Select(x => new ReceiptItemDto
                    {
                        TenSanPham = x.TenSanPham,
                        MauSac = x.MauSac,
                        KichCo = x.KichCo,
                        SoLuong = x.SoLuong,
                        DonGia = x.DonGia,
                        ThanhTien = x.ThanhTien
                    }).ToList()
                };

                _showPrintModal = true;
                Toast.ShowSuccess($"Tạo đơn hàng #{orderRes.MaHoaDon} thành công!");
            }
            else
            {
                Toast.ShowError("Tạo đơn hàng tại quầy thất bại. Vui lòng kiểm tra tồn kho.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi thanh toán: {ex.Message}");
        }
        finally
        {
            _isProcessingPayment = false;
        }
    }

    private void ClosePrintModal()
    {
        _showPrintModal = false;
        _activeReceipt = null;
        _cartItems.Clear();
        _customerPhone = string.Empty;
        _currentCustomer = null;
        _cashGivenInput = string.Empty;
        _activeMobileTab = "products";
    }

    public class PosCartLineItem
    {
        public int MaBienThe { get; set; }
        public int MaSanPham { get; set; }
        public string TenSanPham { get; set; } = string.Empty;
        public string MaSku { get; set; } = string.Empty;
        public string MauSac { get; set; } = string.Empty;
        public string KichCo { get; set; } = string.Empty;
        public decimal DonGia { get; set; }
        public int SoLuong { get; set; }
        public decimal ThanhTien => DonGia * SoLuong;
    }
}
