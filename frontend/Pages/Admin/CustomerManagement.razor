    }

    private static string GetRankCssClass(string? rank)
    {
        if (string.IsNullOrWhiteSpace(rank)) return "standard";
        var r = rank.ToLowerInvariant();
        if (r.Contains("kim cương") || r.Contains("diamond")) return "diamond";
        if (r.Contains("vàng") || r.Contains("gold")) return "gold";
        if (r.Contains("bạc") || r.Contains("silver")) return "silver";
        return "standard";
    }

    private static string GetOrderStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "pending";
        var s = status.ToLowerInvariant();
        if (s.Contains("hoàn thành")) return "completed";
        if (s.Contains("hủy")) return "cancelled";
        return "pending";
    }
