@page "/admin/customers"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast

<PageTitle>Quản lý tài khoản khách hàng | QF Noir Admin</PageTitle>

<div class="customer-management-container">
    <!-- Header -->
    <div class="page-header">
        <div>
            <div class="header-breadcrumb">QUẢN TRỊ KHÁCH HÀNG & THÀNH VIÊN</div>
            <h2 class="page-title">QUẢN LÝ TÀI KHOẢN KHÁCH HÀNG</h2>
        </div>
        <div class="header-actions">
            <!-- Nút Tự động xét duyệt hạng VIP -->
            <button class="btn-action-secondary" @onclick="HandleEvaluateRanks" disabled="@_isEvaluatingRanks" title="Quét toàn bộ chi tiêu thực tế để tự động thăng hạng Bạc/Vàng">
                @if (_isEvaluatingRanks)
                {
                    <span class="spinner-small"></span>
                    <span>Đang xét duyệt...</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>Xét hạng VIP tự động</span>
                }
            </button>

            <!-- Nút Thêm khách hàng mới -->
            <button class="btn-action-primary" @onclick="OpenCreateModal" title="Tạo tài khoản khách hàng mới">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Thêm khách hàng</span>
            </button>
        </div>
    </div>

    <!-- Thống kê nhanh (KPI Summary Cards) -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">TỔNG KHÁCH HÀNG</div>
            <div class="kpi-val">@(_customersList?.Count ?? 0)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">HẠNG THÀNH VIÊN VIP</div>
            <div class="kpi-val text-amber">
                @(_customersList?.Count(c => c.TenCapDo == "Vàng" || c.TenCapDo == "Bạc" || c.TenCapDo == "Kim Cương") ?? 0)
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">ĐANG HOẠT ĐỘNG</div>
            <div class="kpi-val text-emerald">@(_customersList?.Count(c => !c.DaXoa) ?? 0)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">TÀI KHOẢN ĐÃ KHÓA</div>
            <div class="kpi-val text-rose">@(_customersList?.Count(c => c.DaXoa) ?? 0)</div>
        </div>
    </div>

    <!-- Thanh Tìm Kiếm & Bộ Lọc -->
    <div class="filter-bar">
        <div class="search-input-wrapper">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="search-input" placeholder="Tìm theo tên, SĐT, email, tên đăng nhập..." 
                   @bind="SearchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button" class="clear-btn" @onclick="ClearSearch">×</button>
            }
        </div>

        <div class="filter-controls">
            <!-- Lọc Cấp độ -->
            <div class="filter-tabs">
                <button class="tab-btn @(_selectedRankFilter == null ? "active" : "")" @onclick="() => SetRankFilter(null)">
                    Tất cả hạng
                </button>
                <button class="tab-btn @(_selectedRankFilter == 1 ? "active" : "")" @onclick="() => SetRankFilter(1)">
                    Thường
                </button>
                <button class="tab-btn @(_selectedRankFilter == 2 ? "active" : "")" @onclick="() => SetRankFilter(2)">
                    Bạc (Giảm 5%)
                </button>
                <button class="tab-btn @(_selectedRankFilter == 3 ? "active" : "")" @onclick="() => SetRankFilter(3)">
                    Vàng (Giảm 10%)
                </button>
                <button class="tab-btn @(_selectedRankFilter == 4 ? "active" : "")" @onclick="() => SetRankFilter(4)">
                    Kim Cương (Giảm 15%)
                </button>
            </div>

            <!-- Lọc Trạng thái -->
            <div class="filter-tabs">
                <button class="tab-btn @(_selectedStatusFilter == null ? "active" : "")" @onclick="() => SetStatusFilter(null)">
                    Tất cả TT
                </button>
                <button class="tab-btn @(_selectedStatusFilter == false ? "active" : "")" @onclick="() => SetStatusFilter(false)">
                    Hoạt động
                </button>
                <button class="tab-btn @(_selectedStatusFilter == true ? "active" : "")" @onclick="() => SetStatusFilter(true)">
                    Đã khóa
                </button>
            </div>
        </div>
    </div>

    <!-- Bảng Danh Sách Tài Khoản Khách Hàng (Dạng Cuộn Nội Bộ & Phân Trang Gọn Gàng) -->
    <div class="card catalog-card">
        <div class="table-scroll-container">
            <table class="admin-table sticky-header-table">
                <thead>
                    <tr>
                        <th style="width: 75px;">Mã KH</th>
                        <th>Họ tên & Tài khoản</th>
                        <th>Số điện thoại</th>
                        <th>Email liên hệ</th>
                        <th class="text-center">Cấp độ VIP</th>
                        <th class="text-center">Điểm thưởng</th>
                        <th class="text-right">Tổng chi tiêu</th>
                        <th class="text-center">Đơn hàng</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <span class="spinner-small spinner-dark"></span> Đang tải danh sách tài khoản khách hàng...
                            </td>
                        </tr>
                    }
                    else if (FilteredCustomers == null || !FilteredCustomers.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                Không tìm thấy tài khoản khách hàng nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cus in PagedCustomers)
                        {
                            <tr class="@(cus.DaXoa ? "row-locked" : "")">
                                <td class="font-mono text-muted">#KH-@cus.MaKhachHang</td>
                                <td>
                                    <div class="customer-info-cell">
                                        <span class="customer-name">@cus.TenKhachHang</span>
                                        @if (!string.IsNullOrWhiteSpace(cus.TenDangNhap))
                                        {
                                            <span class="customer-username font-mono">@@@cus.TenDangNhap</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="phone-text font-mono">@(string.IsNullOrWhiteSpace(cus.DienThoai) ? "-" : cus.DienThoai)</span>
                                </td>
                                <td>
                                    <span class="email-text">@(string.IsNullOrWhiteSpace(cus.Email) ? "-" : cus.Email)</span>
                                </td>
                                <td class="text-center">
                                    <span class="rank-badge rank-@GetRankCssClass(cus.TenCapDo)">
                                        @cus.TenCapDo
                                        @if (cus.PhanTramGiamGia > 0)
                                        {
                                            <small class="discount-pill">-@cus.PhanTramGiamGia%</small>
                                        }
                                    </span>
                                </td>
                                <td class="text-center tabular-nums">
                                    <span class="point-badge">@cus.DiemThuong pts</span>
                                </td>
                                <td class="text-right tabular-nums">
                                    <span class="spending-val">@cus.TongChiTieu.ToString("N0") đ</span>
                                </td>
                                <td class="text-center tabular-nums">
                                    <span class="order-count-badge">@cus.TongSoDonHang</span>
                                </td>
                                <td class="text-center">
                                    @if (!cus.DaXoa)
                                    {
                                        <span class="status-indicator active">
                                            <span class="dot"></span>
                                            <span>Hoạt động</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-indicator locked">
                                            <span class="dot"></span>
                                            <span>Đã khóa</span>
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="row-actions">
                                        <!-- Xem lịch sử đơn hàng -->
                                        <button class="btn-action-ghost" @onclick="() => OpenOrderHistoryModal(cus)" title="Xem lịch sử đơn hàng của khách hàng">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-7z"></path>
                                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                                            </svg>
                                        </button>
                                        <!-- Sửa thông tin -->
                                        <button class="btn-action-ghost" @onclick="() => OpenEditModal(cus)" title="Chỉnh sửa thông tin / Hạng thành viên">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>
                                        <!-- Khóa / Mở khóa -->
                                        <button class="btn-action-ghost @(cus.DaXoa ? "btn-unlock" : "btn-lock")" 
                                                @onclick="() => HandleToggleStatus(cus)" 
                                                title="@(cus.DaXoa ? "Mở khóa tài khoản" : "Khóa tài khoản này")">
                                            @if (cus.DaXoa)
                                            {
                                                <!-- Icon Unlock -->
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <!-- Icon Lock -->
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Thanh phân trang Pagination gọn gàng -->
        @if (TotalFilteredCount > 0)
        {
            <div class="pagination-footer">
                <div class="pagination-info">
                    Hiển thị <strong>@((_currentPage - 1) * _pageSize + 1)</strong> - <strong>@(Math.Min(_currentPage * _pageSize, TotalFilteredCount))</strong> trong tổng số <strong>@TotalFilteredCount</strong> khách hàng
                </div>

                <div class="pagination-controls">
                    <div class="page-size-selector">
                        <label>Số dòng:</label>
                        <select @onchange="HandlePageSizeChange" value="@_pageSize">
                            <option value="15">15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                    <button class="page-nav-btn" 
                            disabled="@(_currentPage <= 1)" 
                            @onclick="() => ChangePage(_currentPage - 1)">
                        &laquo; Trước
                    </button>

                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pageNumber = p;
                        @if (TotalPages <= 7 || pageNumber == 1 || pageNumber == TotalPages || Math.Abs(pageNumber - _currentPage) <= 1)
                        {
                            <button class="page-num-btn @(_currentPage == pageNumber ? "active" : "")" 
                                    @onclick="() => ChangePage(pageNumber)">
                                @pageNumber
                            </button>
                        }
                        else if (Math.Abs(pageNumber - _currentPage) == 2)
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }

                    <button class="page-nav-btn" 
                            disabled="@(_currentPage >= TotalPages)" 
                            @onclick="() => ChangePage(_currentPage + 1)">
                        Sau &raquo;
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: TẠO MỚI TÀI KHOẢN KHÁCH HÀNG                                     -->
<!-- ========================================================================= -->
@if (_isCreateModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseCreateModal">
        <div class="modal-panel modal-panel-md" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">TÀI KHOẢN THÀNH VIÊN</div>
                    <h3 class="modal-title">THÊM KHÁCH HÀNG MỚI</h3>
                    <p class="modal-subtitle">Tạo hồ sơ và tài khoản đăng nhập cho khách hàng thân thiết</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseCreateModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_createErrorMessage))
                {
                    <div class="alert-box alert-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@_createErrorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Họ và tên khách hàng <span class="required">*</span></label>
                    <input type="text" class="form-control" placeholder="VD: Nguyễn Văn A..." @bind="_createForm.TenKhachHang" />
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Số điện thoại <span class="required">*</span></label>
                        <input type="text" class="form-control font-mono" placeholder="VD: 0912345678" @bind="_createForm.DienThoai" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tên đăng nhập (Username)</label>
                        <input type="text" class="form-control font-mono" placeholder="VD: nguyenvana (tùy chọn)" @bind="_createForm.TenDangNhap" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Địa chỉ Email</label>
                        <input type="email" class="form-control" placeholder="VD: nva@gmail.com" @bind="_createForm.Email" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mật khẩu khởi tạo</label>
                        <input type="text" class="form-control font-mono" placeholder="Mặc định: 123456" @bind="_createForm.MatKhau" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Cấp độ thành viên ban đầu</label>
                        <select class="form-control" @bind="_createForm.MaCapDo">
                            <option value="1">Hạng Thường (0% chiết khấu)</option>
                            <option value="2">Hạng Bạc (Giảm 5%)</option>
                            <option value="3">Hạng Vàng (Giảm 10%)</option>
                            <option value="4">Hạng Kim Cương (Giảm 15%)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Điểm thưởng khởi tạo</label>
                        <input type="number" class="form-control tabular-nums" min="0" @bind="_createForm.DiemThuong" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseCreateModal" disabled="@_isSubmittingCreate">
                    Hủy bỏ
                </button>
                <button type="button" class="btn-modal-submit" @onclick="SubmitCreateCustomer" disabled="@_isSubmittingCreate">
                    @if (_isSubmittingCreate)
                    {
                        <span class="spinner-small"></span>
                        <span>Đang tạo tài khoản...</span>
                    }
                    else
                    {
                        <span>Lưu tài khoản khách hàng</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 2: CHỈNH SỬA THÔNG TIN & HẠNG THÀNH VIÊN                            -->
<!-- ========================================================================= -->
@if (_isEditModalOpen && _editingCustomer != null)
{
    <div class="modal-backdrop" @onclick="CloseEditModal">
        <div class="modal-panel modal-panel-md" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">HỒ SƠ KHÁCH HÀNG #KH-@_editingCustomer.MaKhachHang</div>
                    <h3 class="modal-title">CHỈNH SỬA TÀI KHOẢN KHÁCH HÀNG</h3>
                    <p class="modal-subtitle">Cập nhật thông tin liên hệ, điều chỉnh điểm thưởng và cấp độ thành viên</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseEditModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_editErrorMessage))
                {
                    <div class="alert-box alert-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@_editErrorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Họ và tên khách hàng <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="_editForm.TenKhachHang" />
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" class="form-control font-mono" @bind="_editForm.DienThoai" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Địa chỉ Email</label>
                        <input type="email" class="form-control" @bind="_editForm.Email" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Cấp độ thành viên VIP</label>
                        <select class="form-control" @bind="_editForm.MaCapDo">
                            <option value="1">Hạng Thường (0% giảm giá)</option>
                            <option value="2">Hạng Bạc (Giảm giá 5%)</option>
                            <option value="3">Hạng Vàng (Giảm giá 10%)</option>
                            <option value="4">Hạng Kim Cương (Giảm giá 15%)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Điểm thưởng tích lũy (pts)</label>
                        <input type="number" class="form-control tabular-nums" min="0" @bind="_editForm.DiemThuong" />
                    </div>
                </div>

                <div class="spending-preview-box">
                    <span class="preview-label">Tổng chi tiêu thực tế tích lũy:</span>
                    <strong class="preview-val">@_editingCustomer.TongChiTieu.ToString("N0") đ</strong>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseEditModal" disabled="@_isSubmittingEdit">
                    Hủy bỏ
                </button>
                <button type="button" class="btn-modal-submit" @onclick="SubmitEditCustomer" disabled="@_isSubmittingEdit">
                    @if (_isSubmittingEdit)
                    {
                        <span class="spinner-small"></span>
                        <span>Đang cập nhật...</span>
                    }
                    else
                    {
                        <span>Lưu thay đổi</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 3: XEM LỊCH SỬ ĐƠN HÀNG CỦA KHÁCH HÀNG                              -->
<!-- ========================================================================= -->
@if (_isOrderHistoryModalOpen && _viewingCustomer != null)
{
    <div class="modal-backdrop" @onclick="CloseOrderHistoryModal">
        <div class="modal-panel modal-panel-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">LỊCH SỬ MUA SẮM KHÁCH HÀNG</div>
                    <h3 class="modal-title">#KH-@_viewingCustomer.MaKhachHang - @_viewingCustomer.TenKhachHang</h3>
                    <p class="modal-subtitle">
                        SĐT: @_viewingCustomer.DienThoai &bull; Hạng: @_viewingCustomer.TenCapDo &bull; Tổng chi tiêu: @_viewingCustomer.TongChiTieu.ToString("N0") đ
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseOrderHistoryModal">✕</button>
            </div>

            <div class="modal-body-p0">
                @if (_isLoadingOrders)
                {
                    <div class="py-5 text-center text-muted">
                        <span class="spinner-small spinner-dark"></span> Đang tải lịch sử đơn hàng...
                    </div>
                }
                else if (_customerOrdersList == null || !_customerOrdersList.Any())
                {
                    <div class="py-5 text-center text-muted">
                        Khách hàng này chưa có đơn hàng nào trong hệ thống.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="variant-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">Mã ĐH</th>
                                    <th>Thời gian tạo</th>
                                    <th class="text-right">Tiền hàng</th>
                                    <th class="text-right">Giảm giá</th>
                                    <th class="text-right">Thanh toán</th>
                                    <th class="text-center">Số món</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ord in _customerOrdersList)
                                {
                                    <tr>
