    {
        _selectedRankFilter = rank;
        _currentPage = 1;
    }

    private void SetStatusFilter(bool? status)
    {
        _selectedStatusFilter = status;
        _currentPage = 1;
    }

    // State Tự động xét duyệt hạng
    private bool _isEvaluatingRanks = false;

    // State Modal Tạo Mới
    private bool _isCreateModalOpen = false;
    private bool _isSubmittingCreate = false;
    private string _createErrorMessage = string.Empty;
    private CreateCustomerAccountDto _createForm = new();

    // State Modal Sửa
    private bool _isEditModalOpen = false;
    private bool _isSubmittingEdit = false;
    private string _editErrorMessage = string.Empty;
    private CustomerAccountDto? _editingCustomer;
    private UpdateCustomerAccountDto _editForm = new();

    // State Modal Lịch Sử Đơn Hàng
    private bool _isOrderHistoryModalOpen = false;
    private bool _isLoadingOrders = false;
    private CustomerAccountDto? _viewingCustomer;
    private List<CustomerOrderHistoryItemDto>? _customerOrdersList;

    private IEnumerable<CustomerAccountDto>? FilteredCustomers
    {
        get
        {
            if (_customersList == null) return null;
            var list = _customersList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLowerInvariant();
                list = list.Where(c =>
                    c.TenKhachHang.ToLowerInvariant().Contains(term) ||
                    (c.DienThoai != null && c.DienThoai.Contains(term)) ||
                    (c.Email != null && c.Email.ToLowerInvariant().Contains(term)) ||
                    (c.TenDangNhap != null && c.TenDangNhap.ToLowerInvariant().Contains(term)) ||
                    c.MaKhachHang.ToString().Contains(term));
            }

            if (_selectedRankFilter.HasValue)
            {
                list = list.Where(c => c.MaCapDo == _selectedRankFilter.Value);
            }

            if (_selectedStatusFilter.HasValue)
            {
                list = list.Where(c => c.DaXoa == _selectedStatusFilter.Value);
            }

            return list;
        }
    }

    private int TotalFilteredCount => FilteredCustomers?.Count() ?? 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / _pageSize));

    private IEnumerable<CustomerAccountDto> PagedCustomers
    {
        get
        {
            if (FilteredCustomers == null) return Enumerable.Empty<CustomerAccountDto>();
            return FilteredCustomers
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize);
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            _currentPage = page;
        }
    }

    private void HandlePageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        {
            _pageSize = size;
            _currentPage = 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        try
        {
            _customersList = await AdminApi.GetAllCustomersAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách khách hàng: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleEvaluateRanks()
    {
        _isEvaluatingRanks = true;
        try
        {
            var res = await AdminApi.EvaluateMemberRanksAsync();
            if (res.Success)
            {
                Toast.ShowSuccess(res.Message ?? "Tự động xét duyệt hạng thành viên VIP thành công!");
                await LoadCustomers();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Xét duyệt hạng thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi thực thi xét duyệt: {ex.Message}");
        }
        finally
        {
            _isEvaluatingRanks = false;
        }
    }

    private async Task HandleToggleStatus(CustomerAccountDto cus)
    {
        var actionText = cus.DaXoa ? "mở khóa" : "khóa";
        try
        {
            var ok = await AdminApi.ToggleCustomerStatusAsync(cus.MaKhachHang);
            if (ok)
            {
                cus.DaXoa = !cus.DaXoa;
                Toast.ShowSuccess($"Đã {actionText} tài khoản khách hàng #{cus.MaKhachHang} ({cus.TenKhachHang}) thành công!");
            }
            else
            {
                Toast.ShowError($"Không thể {actionText} tài khoản khách hàng.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi cập nhật: {ex.Message}");
        }
    }

    // =========================================================================
    // MODAL TẠO MỚI
    // =========================================================================
    private void OpenCreateModal()
    {
        _createErrorMessage = string.Empty;
        _createForm = new CreateCustomerAccountDto
        {
            MatKhau = "123456",
            MaCapDo = 1,
            DiemThuong = 0
        };
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _createErrorMessage = string.Empty;
    }

    private async Task SubmitCreateCustomer()
    {
        _createErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_createForm.TenKhachHang))
        {
            _createErrorMessage = "Vui lòng nhập họ và tên khách hàng.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_createForm.DienThoai))
        {
            _createErrorMessage = "Vui lòng nhập số điện thoại khách hàng.";
            return;
        }

        _isSubmittingCreate = true;
        try
        {
            var res = await AdminApi.CreateCustomerAccountAsync(_createForm);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã tạo thành công tài khoản cho khách hàng: {_createForm.TenKhachHang}!");
                CloseCreateModal();
                await LoadCustomers();
            }
            else
            {
                _createErrorMessage = res.Message ?? "Tạo tài khoản thất bại.";
            }
        }
        catch (Exception ex)
        {
            _createErrorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingCreate = false;
        }
    }

    // =========================================================================
    // MODAL CHỈNH SỬA
    // =========================================================================
    private void OpenEditModal(CustomerAccountDto cus)
    {
        _editingCustomer = cus;
        _editErrorMessage = string.Empty;
        _editForm = new UpdateCustomerAccountDto
        {
            MaKhachHang = cus.MaKhachHang,
            TenKhachHang = cus.TenKhachHang,
            DienThoai = cus.DienThoai,
            Email = cus.Email,
            MaCapDo = cus.MaCapDo,
            DiemThuong = cus.DiemThuong,
            DaXoa = cus.DaXoa
        };
        _isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        _isEditModalOpen = false;
        _editingCustomer = null;
        _editErrorMessage = string.Empty;
    }

    private async Task SubmitEditCustomer()
    {
        _editErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_editForm.TenKhachHang))
        {
            _editErrorMessage = "Tên khách hàng không được để trống.";
            return;
        }

        _isSubmittingEdit = true;
        try
        {
            var res = await AdminApi.UpdateCustomerAccountAsync(_editForm);
            if (res.Success)
            {
                Toast.ShowSuccess($"Cập nhật thành công thông tin khách hàng #{_editForm.MaKhachHang}!");
                CloseEditModal();
                await LoadCustomers();
            }
            else
            {
                _editErrorMessage = res.Message ?? "Cập nhật thất bại.";
            }
        }
        catch (Exception ex)
        {
            _editErrorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingEdit = false;
        }
    }

    // =========================================================================
    // MODAL LỊCH SỬ ĐƠN HÀNG
    // =========================================================================
    private async Task OpenOrderHistoryModal(CustomerAccountDto cus)
