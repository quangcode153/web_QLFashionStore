        };
        _branchModalError = null;
        _showCreateBranchModal = true;
    }

    private void CloseCreateBranchModal()
    {
        _showCreateBranchModal = false;
        _branchModalError = null;
    }

    private async Task HandleCreateBranchAndManager()
    {
        if (!_isMultiBranchAdmin) return;

        if (string.IsNullOrWhiteSpace(_newBranchModel.TenChiNhanh))
        {
            _branchModalError = "Vui lòng nhập tên chi nhánh mới.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newBranchModel.DiaChi))
        {
            _branchModalError = "Vui lòng nhập địa chỉ chi nhánh mới.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_branchManagerModel.TenNhanVien))
        {
            _branchModalError = "Vui lòng nhập họ tên Quản lý chi nhánh.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_branchManagerModel.TenDangNhap))
        {
            _branchModalError = "Vui lòng nhập tên đăng nhập cho Quản lý chi nhánh.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_branchManagerModel.MatKhau) || _branchManagerModel.MatKhau.Length < 6)
        {
            _branchModalError = "Mật khẩu khởi tạo phải có tối thiểu 6 ký tự.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_branchManagerModel.DienThoai))
        {
            _branchModalError = "Vui lòng nhập số điện thoại cho Quản lý chi nhánh.";
            return;
        }

        _isSubmittingBranch = true;
        _branchModalError = null;

        try
        {
            // Bước 1: Tạo chi nhánh mới
            var branchRes = await AdminApi.CreateBranchAsync(_newBranchModel);
            if (!branchRes.Success || branchRes.Data <= 0)
            {
                _branchModalError = branchRes.Message ?? "Không thể tạo chi nhánh mới.";
                return;
            }

            int newBranchId = branchRes.Data;

            // Bước 2: Tạo tài khoản Quản lý cho chi nhánh vừa tạo
            _branchManagerModel.MaChiNhanh = newBranchId;
            _branchManagerModel.ChiNhanh = _newBranchModel.TenChiNhanh;
            _branchManagerModel.VaiTro = RoleConstants.QuanLyChiNhanh;
            _branchManagerModel.LoaiThuKho = "CHI_NHANH";

            var accRes = await AdminApi.CreateStaffAccountAsync(_branchManagerModel);
            if (!accRes.Success)
            {
                Toast.ShowWarning($"Chi nhánh {_newBranchModel.TenChiNhanh} đã tạo thành công, nhưng tạo tài khoản bị lỗi: {accRes.Message}");
            }
            else
            {
                Toast.ShowSuccess($"Đã tạo chi nhánh '{_newBranchModel.TenChiNhanh}' và cấp tài khoản Quản lý '{_branchManagerModel.TenDangNhap}' thành công!");
            }

            _showCreateBranchModal = false;
            await LoadBranches();
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            _branchModalError = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingBranch = false;
        }
    }
}
