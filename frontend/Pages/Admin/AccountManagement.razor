@code {
    private List<AccountSummaryDto> _accounts = new();
    private List<BranchDto> _branches = new();
    private string? _selectedRoleFilter = null;
    private bool _isLoading = true;
    private bool _isMultiBranchAdmin = true;
    private bool _showCreateModal = false;
    private bool _isSubmitting = false;
    private string? _modalError = null;

    private int? _userBranchId = null;
    private string? _userBranchName = null;

    private readonly List<BranchDto> _defaultFallbackBranches = new()
    {
        new BranchDto { MaChiNhanh = 1, TenChiNhanh = "QF Sư Vạn Hạnh (Q.10, TP.HCM)", DiaChi = "Sư Vạn Hạnh, Q.10, TP.HCM" },
        new BranchDto { MaChiNhanh = 2, TenChiNhanh = "QF Quang Trung (Q. Gò Vấp, TP.HCM)", DiaChi = "Quang Trung, Q. Gò Vấp, TP.HCM" },
        new BranchDto { MaChiNhanh = 3, TenChiNhanh = "QF Lê Văn Sỹ (Q. Phú Nhuận, TP.HCM)", DiaChi = "Lê Văn Sỹ, Q. Phú Nhuận, TP.HCM" },
        new BranchDto { MaChiNhanh = 4, TenChiNhanh = "QF Cầu Giấy (Q. Cầu Giấy, Hà Nội)", DiaChi = "Cầu Giấy, Q. Cầu Giấy, Hà Nội" },
        new BranchDto { MaChiNhanh = 5, TenChiNhanh = "QF Chùa Bộc (Q. Đống Đa, Hà Nội)", DiaChi = "Chùa Bộc, Q. Đống Đa, Hà Nội" },
        new BranchDto { MaChiNhanh = 6, TenChiNhanh = "QF Lê Duẩn (Q. Thanh Khê, Đà Nẵng)", DiaChi = "Lê Duẩn, Q. Thanh Khê, Đà Nẵng" },
        new BranchDto { MaChiNhanh = 7, TenChiNhanh = "QF Ninh Kiều (Q. Ninh Kiều, Cần Thơ)", DiaChi = "Ninh Kiều, Q. Ninh Kiều, Cần Thơ" },
        new BranchDto { MaChiNhanh = 8, TenChiNhanh = "QF Ba Mươi Tháng Tư (TP. Biên Hòa, Đồng Nai)", DiaChi = "30/4, TP. Biên Hòa, Đồng Nai" },
        new BranchDto { MaChiNhanh = 9, TenChiNhanh = "Kho Tổng QF Tân Bình (TP.HCM)", DiaChi = "Tân Bình, TP.HCM", IsOnlineWarehouse = true }
    };

    private CreateStaffAccountDto _createModel = new() 
    { 
        VaiTro = RoleConstants.QuanLyChiNhanh,
        LoaiThuKho = "CHI_NHANH",
        MaChiNhanh = 1,
        ChiNhanh = "QF Sư Vạn Hạnh (Q.10, TP.HCM)"
    };

    private List<AccountSummaryDto> FilteredAccounts => string.IsNullOrEmpty(_selectedRoleFilter)
        ? _accounts
        : _selectedRoleFilter == RoleConstants.ThuKho
            ? _accounts.Where(x => x.VaiTro == RoleConstants.ThuKho).ToList()
            : (_selectedRoleFilter == RoleConstants.NhanVien || _selectedRoleFilter == RoleConstants.NhanVienBanHang)
                ? _accounts.Where(x => RoleConstants.IsGeneralStaff(x.VaiTro) && x.VaiTro != RoleConstants.ThuKho).ToList()
                : _accounts.Where(x => x.VaiTro == _selectedRoleFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRole();
        await LoadBranches();
        await LoadAccounts();
    }

    private async Task LoadUserRole()
    {
        try
        {
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
            if (string.IsNullOrEmpty(role))
            {
                _isMultiBranchAdmin = true;
            }
            else if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase) && !role.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase))
            {
                _isMultiBranchAdmin = false;
            }
            else
            {
                _isMultiBranchAdmin = true;
            }

            var bIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
            if (int.TryParse(bIdStr, out var bId))
            {
                _userBranchId = bId;
            }
            _userBranchName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
        }
        catch
        {
            _isMultiBranchAdmin = true;
        }
    }

    private async Task LoadBranches()
    {
        try
        {
            var apiBranches = await AdminApi.GetBranchesAsync();
            if (apiBranches != null && apiBranches.Any())
            {
                _branches = apiBranches;
                return;
            }
        }
        catch { }

        _branches = _defaultFallbackBranches;
    }

    private async Task LoadAccounts()
    {
        _isLoading = true;
        try
        {
            var list = await AdminApi.GetAccountsAsync();
            if (list != null && list.Any())
            {
                _accounts = list;
            }
            else
            {
                _accounts = GetDefaultDemoAccounts();
            }
        }
        catch (Exception)
        {
            _accounts = GetDefaultDemoAccounts();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<BranchDto> GetSelectableBranches()
    {
        return _branches.Where(b => !b.IsOnlineWarehouse).ToList();
    }

    private List<AccountSummaryDto> GetDefaultDemoAccounts()
    {
        return new List<AccountSummaryDto>
        {
            new AccountSummaryDto
            {
                MaTaiKhoan = 1,
                TenDangNhap = "admin",
                MaNhanVien = 1,
                TenNhanVien = "Nguyễn Văn An",
                DienThoai = "0901111111",
                VaiTro = RoleConstants.AdminChuoi,
                ChiNhanh = "Toàn hệ thống (Hội sở)",
                DangHoatDong = true
            },
            new AccountSummaryDto
            {
                MaTaiKhoan = 2,
                TenDangNhap = "manager_q10",
                MaNhanVien = 2,
                TenNhanVien = "Hoàng Thị Mai",
                DienThoai = "0904445555",
                VaiTro = RoleConstants.QuanLyChiNhanh,
                MaChiNhanh = 1,
                ChiNhanh = "QF Sư Vạn Hạnh (Q.10, TP.HCM)",
                DangHoatDong = true
            },
            new AccountSummaryDto
            {
                MaTaiKhoan = 3,
                TenDangNhap = "thukho_online",
                MaNhanVien = 3,
                TenNhanVien = "Phạm Đình Kho",
                DienThoai = "0907778888",
                VaiTro = RoleConstants.ThuKho,
                LoaiThuKho = "ONLINE",
                MaChiNhanh = 9,
                ChiNhanh = "Kho Tổng QF Tân Bình (TP.HCM)",
                IsOnlineWarehouse = true,
                DangHoatDong = true
            },
            new AccountSummaryDto
            {
                MaTaiKhoan = 4,
                TenDangNhap = "thukho_q10",
                MaNhanVien = 4,
                TenNhanVien = "Lê Văn Lưu",
                DienThoai = "0906663333",
                VaiTro = RoleConstants.ThuKho,
                LoaiThuKho = "CHI_NHANH",
                MaChiNhanh = 1,
                ChiNhanh = "QF Sư Vạn Hạnh (Q.10, TP.HCM)",
                IsOnlineWarehouse = false,
                DangHoatDong = true
            },
            new AccountSummaryDto
            {
                MaTaiKhoan = 5,
                TenDangNhap = "cashier01",
                MaNhanVien = 5,
                TenNhanVien = "Trần Thị Bích",
                DienThoai = "0902222222",
                VaiTro = RoleConstants.NhanVien,
                MaChiNhanh = 1,
                ChiNhanh = "QF Sư Vạn Hạnh (Q.10, TP.HCM)",
                DangHoatDong = true
            }
        };
    }

    private void FilterRole(string? role)
    {
        _selectedRoleFilter = role;
    }

    private void OpenCreateModal()
    {
        var defaultBranch = _branches.FirstOrDefault(b => !b.IsOnlineWarehouse) ?? _branches.FirstOrDefault();
        var defaultBranchId = defaultBranch?.MaChiNhanh ?? 1;
        var defaultBranchName = defaultBranch?.TenChiNhanh ?? "QF Sư Vạn Hạnh (Q.10, TP.HCM)";

        if (!_isMultiBranchAdmin && _userBranchId.HasValue)
        {
            defaultBranchId = _userBranchId.Value;
            defaultBranchName = _userBranchName ?? defaultBranchName;
        }

        _createModel = new CreateStaffAccountDto
        {
            VaiTro = _isMultiBranchAdmin ? RoleConstants.QuanLyChiNhanh : RoleConstants.NhanVien,
            LoaiThuKho = "CHI_NHANH",
            MaChiNhanh = defaultBranchId,
            ChiNhanh = defaultBranchName
        };
        _modalError = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
    }

    private void OnRoleChanged()
    {
        if (_createModel.VaiTro == RoleConstants.ThuKho)
        {
            if (_isMultiBranchAdmin)
            {
                SelectWarehouseKeeperType(_createModel.LoaiThuKho ?? "ONLINE");
            }
            else
            {
                SelectWarehouseKeeperType("CHI_NHANH");
            }
        }
        else
        {
            if (!_isMultiBranchAdmin && _userBranchId.HasValue)
            {
                _createModel.MaChiNhanh = _userBranchId.Value;
                _createModel.ChiNhanh = _userBranchName ?? "Chi nhánh hiện tại";
            }
            else
            {
                var branch = _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh) 
                          ?? _branches.FirstOrDefault(b => !b.IsOnlineWarehouse);
                if (branch != null)
                {
                    _createModel.MaChiNhanh = branch.MaChiNhanh;
                    _createModel.ChiNhanh = branch.TenChiNhanh;
                }
            }
        }
    }

    private void SelectWarehouseKeeperType(string loai)
    {
        _createModel.LoaiThuKho = loai;
        if (loai == "ONLINE")
        {
            var onlineBranch = _branches.FirstOrDefault(b => b.IsOnlineWarehouse);
            _createModel.MaChiNhanh = onlineBranch?.MaChiNhanh ?? 9;
            _createModel.ChiNhanh = onlineBranch?.TenChiNhanh ?? "Kho Tổng QF Tân Bình (TP.HCM)";
        }
        else
        {
            if (!_isMultiBranchAdmin && _userBranchId.HasValue)
            {
                _createModel.MaChiNhanh = _userBranchId.Value;
                _createModel.ChiNhanh = _userBranchName ?? "Chi nhánh hiện tại";
            }
            else
            {
                var retail = _branches.FirstOrDefault(b => !b.IsOnlineWarehouse);
                if (retail != null)
                {
                    _createModel.MaChiNhanh = retail.MaChiNhanh;
                    _createModel.ChiNhanh = retail.TenChiNhanh;
                }
            }
        }
    }

    private void OnBranchSelected()
    {
        var branch = _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh);
        if (branch != null)
        {
            _createModel.ChiNhanh = branch.TenChiNhanh;
        }
    }

    private async Task HandleCreateAccount()
    {
        _isSubmitting = true;
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_createModel.ChiNhanh) && _createModel.MaChiNhanh.HasValue)
        {
            var branch = _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh);
            _createModel.ChiNhanh = branch?.TenChiNhanh;
        }

        try
        {
            var res = await AdminApi.CreateStaffAccountAsync(_createModel);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã tạo tài khoản [{_createModel.VaiTro}] {_createModel.TenDangNhap} thành công!");
                CloseCreateModal();
                await LoadAccounts();
                return;
            }
            else
            {
                _modalError = res.Message;
                _isSubmitting = false;
                return;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }

        // Mô phỏng tạo tài khoản thành công ngay trên frontend (chế độ demo/offline)
        var isOnline = _createModel.VaiTro == RoleConstants.ThuKho && _createModel.LoaiThuKho == "ONLINE";
        var newAcc = new AccountSummaryDto
        {
            MaTaiKhoan = _accounts.Count > 0 ? _accounts.Max(a => a.MaTaiKhoan) + 1 : 1,
            TenDangNhap = _createModel.TenDangNhap,
            TenNhanVien = _createModel.TenNhanVien,
            DienThoai = _createModel.DienThoai,
            VaiTro = _createModel.VaiTro,
            LoaiThuKho = _createModel.LoaiThuKho,
            MaChiNhanh = _createModel.MaChiNhanh,
            ChiNhanh = _createModel.ChiNhanh,
            IsOnlineWarehouse = isOnline,
            DangHoatDong = true
        };
        _accounts.Insert(0, newAcc);
        Toast.ShowSuccess($"Đã tạo tài khoản [{_createModel.VaiTro}] {_createModel.TenDangNhap} thành công!");
        CloseCreateModal();
        _isSubmitting = false;
    }

    private async Task HandleToggleStatus(int accountId)
    {
        var acc = _accounts.FirstOrDefault(x => x.MaTaiKhoan == accountId);
        if (acc != null)
        {
            try
            {
                await AdminApi.ToggleAccountStatusAsync(accountId);
            }
            catch { }
            acc.DangHoatDong = !acc.DangHoatDong;
            Toast.ShowSuccess($"Đã {(acc.DangHoatDong ? "kích hoạt" : "khóa")} tài khoản {acc.TenDangNhap}!");
        }
    }

    private string GetRoleCss(string role)
    {
        return role switch
        {
            RoleConstants.AdminChuoi or RoleConstants.QuanLyHeThong => "role-admin",
            RoleConstants.QuanLyChiNhanh => "role-manager",
            RoleConstants.ThuKho => "role-warehouse",
            _ => "role-staff"
        };
    }
}
