@code {
    private List<AccountSummaryDto> _accounts = new();
    private List<BranchDto> _branches = new();
    private string? _selectedRoleFilter = null;
    private bool _isLoading = true;
    private bool _isMultiBranchAdmin = true;
    private bool _showCreateModal = false;
    private bool _isSubmitting = false;
    private string? _modalError = null;

    // Quản lý Modal Mở Chi Nhánh Mới & Cấp Quản Lý
    private bool _showCreateBranchModal = false;
    private bool _isSubmittingBranch = false;
    private string? _branchModalError = null;
    private CreateBranchDto _newBranchModel = new();
    private CreateStaffAccountDto _branchManagerModel = new();

    private int? _userBranchId = null;
    private string? _userBranchName = null;

    private CreateStaffAccountDto _createModel = new() 
    { 
        VaiTro = RoleConstants.QuanLyChiNhanh,
        LoaiThuKho = "CHI_NHANH",
        MaChiNhanh = 1,
        ChiNhanh = ""
    };

    private List<AccountSummaryDto> FilteredAccounts => string.IsNullOrEmpty(_selectedRoleFilter)
        ? _accounts
        : _selectedRoleFilter == RoleConstants.OrderCoordinator
            ? _accounts.Where(x => x.VaiTro == RoleConstants.OrderCoordinator).ToList()
            : _selectedRoleFilter == RoleConstants.ThuKho
                ? _accounts.Where(x => x.VaiTro == RoleConstants.ThuKho).ToList()
                : (_selectedRoleFilter == RoleConstants.NhanVien || _selectedRoleFilter == RoleConstants.NhanVienBanHang || _selectedRoleFilter == RoleConstants.ThuNgan)
                    ? _accounts.Where(x => RoleConstants.IsGeneralStaff(x.VaiTro) && x.VaiTro != RoleConstants.ThuKho && x.VaiTro != RoleConstants.OrderCoordinator).ToList()
                    : _accounts.Where(x => x.VaiTro == _selectedRoleFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRole();
        await LoadBranches();
        await LoadAccounts();
    }

    private async Task LoadUserRole()
    {
        try
        {
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
            if (string.IsNullOrEmpty(role))
            {
                _isMultiBranchAdmin = true;
            }
            else if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase) && !role.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase))
            {
                _isMultiBranchAdmin = false;
            }
            else
            {
                _isMultiBranchAdmin = true;
            }

            var bIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
            if (int.TryParse(bIdStr, out var bId))
            {
                _userBranchId = bId;
            }
            _userBranchName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
        }
        catch
        {
            _isMultiBranchAdmin = true;
        }
    }

    private async Task LoadBranches()
    {
        try
        {
            var apiBranches = await AdminApi.GetBranchesAsync();
            _branches = apiBranches ?? new List<BranchDto>();
        }
        catch
        {
            _branches = new List<BranchDto>();
        }
    }

    private async Task LoadAccounts()
    {
        _isLoading = true;
        try
        {
            var list = await AdminApi.GetAccountsAsync();
            _accounts = list ?? new List<AccountSummaryDto>();
        }
        catch (Exception ex)
        {
            _accounts = new List<AccountSummaryDto>();
            Toast.ShowError($"Lỗi nạp danh sách tài khoản: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<BranchDto> GetSelectableBranches()
    {
        if (_createModel.VaiTro == RoleConstants.NhanVien || 
            _createModel.VaiTro == RoleConstants.NhanVienBanHang || 
            _createModel.VaiTro == RoleConstants.ThuNgan)
        {
            // Chi nhánh Online không có nhân viên bán hàng/thu ngân POS tại quầy
            return _branches
                .Where(b => !b.IsOnlineWarehouse && b.MaChiNhanh != 9)
                .OrderBy(b => b.MaChiNhanh)
                .ToList();
        }

        // Quản lý chi nhánh, Thủ kho, Điều phối viên: Có thể phân công tại Chi nhánh Online #9 hoặc bất kỳ chi nhánh nào
        return _branches
            .OrderByDescending(b => b.IsOnlineWarehouse || b.MaChiNhanh == 9)
            .ThenBy(b => b.MaChiNhanh)
            .ToList();
    }

    private void FilterRole(string? role)
    {
        _selectedRoleFilter = role;
    }

    private void OpenCreateModal()
    {
        var defaultBranch = _branches.FirstOrDefault(b => !b.IsOnlineWarehouse && b.MaChiNhanh != 9) ?? _branches.FirstOrDefault();
        var defaultBranchId = defaultBranch?.MaChiNhanh ?? 0;
        var defaultBranchName = defaultBranch?.TenChiNhanh ?? "Chi nhánh mặc định";

        if (!_isMultiBranchAdmin && _userBranchId.HasValue)
        {
            defaultBranchId = _userBranchId.Value;
            defaultBranchName = _userBranchName ?? defaultBranchName;
        }

        _createModel = new CreateStaffAccountDto
        {
            VaiTro = _isMultiBranchAdmin ? RoleConstants.QuanLyChiNhanh : RoleConstants.NhanVien,
            LoaiThuKho = "CHI_NHANH",
            MaChiNhanh = defaultBranchId,
            ChiNhanh = defaultBranchName
        };
        _modalError = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
    }

    private void OnRoleChanged()
    {
        var selectable = GetSelectableBranches();
        if (!selectable.Any(b => b.MaChiNhanh == _createModel.MaChiNhanh))
        {
            var fallback = selectable.FirstOrDefault();
            if (fallback != null)
            {
                _createModel.MaChiNhanh = fallback.MaChiNhanh;
                _createModel.ChiNhanh = fallback.TenChiNhanh;
            }
        }
        UpdateLoaiThuKho();
    }

    private void OnBranchSelected()
    {
        var branch = _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh);
        if (branch != null)
        {
            _createModel.ChiNhanh = branch.TenChiNhanh;
        }
        UpdateLoaiThuKho();
    }

    private void UpdateLoaiThuKho()
    {
        var isOnline = _createModel.MaChiNhanh == 9 || _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh)?.IsOnlineWarehouse == true;
        _createModel.LoaiThuKho = isOnline ? "ONLINE" : "CHI_NHANH";
    }

    private void SelectWarehouseKeeperType(string loai)
    {
        _createModel.LoaiThuKho = loai;
        if (loai == "ONLINE")
        {
            var onlineBranch = _branches.FirstOrDefault(b => b.IsOnlineWarehouse || b.MaChiNhanh == 9);
            if (onlineBranch != null)
            {
                _createModel.MaChiNhanh = onlineBranch.MaChiNhanh;
                _createModel.ChiNhanh = onlineBranch.TenChiNhanh;
            }
        }
    }

    private async Task HandleCreateAccount()
    {
        _isSubmitting = true;
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_createModel.ChiNhanh) && _createModel.MaChiNhanh.HasValue)
        {
            var branch = _branches.FirstOrDefault(b => b.MaChiNhanh == _createModel.MaChiNhanh);
            _createModel.ChiNhanh = branch?.TenChiNhanh;
        }

        try
        {
            var res = await AdminApi.CreateStaffAccountAsync(_createModel);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã tạo tài khoản [{_createModel.VaiTro}] {_createModel.TenDangNhap} thành công!");
                CloseCreateModal();
                await LoadAccounts();
                return;
            }
            else
            {
                _modalError = res.Message;
                _isSubmitting = false;
                return;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }

        // Mô phỏng tạo tài khoản thành công ngay trên frontend (chế độ demo/offline)
        var isOnline = (_createModel.VaiTro == RoleConstants.ThuKho && _createModel.LoaiThuKho == "ONLINE")
                    || _branches.Any(b => b.MaChiNhanh == _createModel.MaChiNhanh && b.IsOnlineWarehouse);
        var newAcc = new AccountSummaryDto
        {
            MaTaiKhoan = _accounts.Count > 0 ? _accounts.Max(a => a.MaTaiKhoan) + 1 : 1,
            TenDangNhap = _createModel.TenDangNhap,
            TenNhanVien = _createModel.TenNhanVien,
            DienThoai = _createModel.DienThoai,
            VaiTro = _createModel.VaiTro,
            LoaiThuKho = _createModel.LoaiThuKho,
            MaChiNhanh = _createModel.MaChiNhanh,
            ChiNhanh = _createModel.ChiNhanh,
            IsOnlineWarehouse = isOnline,
            DangHoatDong = true
        };
        _accounts.Insert(0, newAcc);
        Toast.ShowSuccess($"Đã tạo tài khoản [{_createModel.VaiTro}] {_createModel.TenDangNhap} thành công!");
        CloseCreateModal();
        _isSubmitting = false;
    }

    private async Task HandleToggleStatus(int accountId)
    {
        var acc = _accounts.FirstOrDefault(x => x.MaTaiKhoan == accountId);
        if (acc != null)
        {
            try
            {
                await AdminApi.ToggleAccountStatusAsync(accountId);
            }
            catch { }
            acc.DangHoatDong = !acc.DangHoatDong;
            Toast.ShowSuccess($"Đã {(acc.DangHoatDong ? "kích hoạt" : "khóa")} tài khoản {acc.TenDangNhap}!");
        }
    }

    private string GetRoleCss(string role)
    {
        return role switch
        {
            RoleConstants.AdminChuoi or RoleConstants.QuanLyHeThong => "role-admin",
            RoleConstants.QuanLyChiNhanh => "role-manager",
            RoleConstants.ThuKho => "role-warehouse",
            RoleConstants.OrderCoordinator => "role-coordinator",
            _ => "role-staff"
        };
    }

    private void OpenCreateBranchModal()
    {
        if (!_isMultiBranchAdmin) return;
        _newBranchModel = new CreateBranchDto { LoaiChiNhanh = "Cửa hàng bán lẻ" };
        _branchManagerModel = new CreateStaffAccountDto
        {
            VaiTro = RoleConstants.QuanLyChiNhanh,
