@code {
    private List<OrderSummaryDto> _orders = new();
    private string? _selectedStatus = null;
    private string _searchTerm = string.Empty;

    // Phân quyền & Quản lý phạm vi chi nhánh
    private int _selectedBranchId = 1; // Admin mặc định vào chi nhánh 1
    private bool _isBranchManager = false;
    private string _branchName = "QF Sư Vạn Hạnh (Q.10, TP.HCM)";

    // Phân trang gọn gàng
    private int _currentPage = 1;
    private int _pageSize = 8;

    // Chi tiết đơn hàng
    private bool _showDetailModal = false;
    private OrderSummaryDto? _selectedOrder;
    private List<OrderDetailItemDto> _orderDetails = new();
    private bool _isLoadingDetails = false;

    private List<OrderSummaryDto> FilteredOrders
    {
        get
        {
            var list = _orders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_selectedStatus))
            {
                list = list.Where(x => x.TrangThai == _selectedStatus);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLowerInvariant().TrimStart('#');
                list = list.Where(x => 
                    x.MaHoaDon.ToString().Contains(term) ||
                    (!string.IsNullOrEmpty(x.TenKhachHang) && x.TenKhachHang.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(x.SdtKhachHang) && x.SdtKhachHang.Contains(term)) ||
                    (!string.IsNullOrEmpty(x.NguoiLapDon) && x.NguoiLapDon.ToLowerInvariant().Contains(term)));
            }

            return list.ToList();
        }
    }

    private List<OrderSummaryDto> PagedOrders
    {
        get
        {
            return FilteredOrders
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize)
                .ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                if (!string.IsNullOrEmpty(role))
                {
                    if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase) && 
                        !role.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase))
                    {
                        // Quản lý 1 chi nhánh: chỉ quản lý các đơn hàng tại chi nhánh của mình
                        _isBranchManager = true;
                        var branchStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
                        if (int.TryParse(branchStr, out var bId) && bId > 0)
                        {
                            _selectedBranchId = bId;
                        }
                        else
                        {
                            _selectedBranchId = 1;
                        }
                        _branchName = GetBranchDisplayName(_selectedBranchId);
                        await LoadOrders();
                        StateHasChanged();
                    }
                    else
                    {
                        // Quản trị viên (Admin) / Quản lý chuỗi: mặc định vào khu vực chi nhánh 1
                        _isBranchManager = false;
                        _selectedBranchId = 1;
                    }
                }
            }
            catch { }
        }
    }

    private async Task LoadOrders()
    {
        try
        {
            int? branchParam = _selectedBranchId > 0 ? _selectedBranchId : null;
            var res = await AdminApi.GetAllOrdersAsync(branchParam);
            _orders = res ?? new();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách đơn hàng: {ex.Message}");
        }
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var bId))
        {
            _selectedBranchId = bId;
            _currentPage = 1;
            await LoadOrders();
        }
    }

    private string GetBranchDisplayName(int branchId) => branchId switch
    {
        1 => "QF Sư Vạn Hạnh (Q.10, TP.HCM)",
        2 => "QF Quang Trung (Q. Gò Vấp, TP.HCM)",
        3 => "QF Lê Văn Sỹ (Q. Phú Nhuận, TP.HCM)",
        4 => "QF Cầu Giấy (Q. Cầu Giấy, Hà Nội)",
        5 => "QF Chùa Bộc (Q. Đống Đa, Hà Nội)",
        6 => "QF Lê Duẩn (Q. Thanh Khê, Đà Nẵng)",
        7 => "QF Ninh Kiều (Q. Ninh Kiều, Cần Thơ)",
        8 => "QF Ba Mươi Tháng Tư (TP. Biên Hòa)",
        9 => "Kho Tổng QF Tân Bình (TP.HCM)",
        _ => $"Chi nhánh #{branchId}"
    };

    private void FilterByStatus(string? status)
    {
        _selectedStatus = status;
        _currentPage = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _currentPage = 1;
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            _currentPage = newPage;
        }
    }

    private async Task UpdateStatus(int orderId, string status)
    {
        try
        {
            var success = await AdminApi.UpdateOrderStatusAsync(orderId, status);
            if (success)
            {
                var target = _orders.FirstOrDefault(x => x.MaHoaDon == orderId);
                if (target != null)
                {
                    target.TrangThai = status;
                }
                Toast.ShowSuccess($"Đã cập nhật trạng thái đơn #{orderId} sang '{status}'!");
                StateHasChanged();
            }
            else
            {
                Toast.ShowError($"Cập nhật trạng thái đơn #{orderId} thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi cập nhật: {ex.Message}");
        }
    }

    private async Task ViewOrderDetails(OrderSummaryDto order)
    {
        _selectedOrder = order;
        _showDetailModal = true;
        _isLoadingDetails = true;
        _orderDetails = new();

        try
        {
            var details = await AdminApi.GetOrderDetailsAsync(order.MaHoaDon);
            _orderDetails = details ?? new();
        }
        catch
        {
            _orderDetails = new();
        }
        finally
        {
            _isLoadingDetails = false;
        }
    }

    private async Task UpdateStatusFromModal(string status)
    {
        if (_selectedOrder == null) return;
        await UpdateStatus(_selectedOrder.MaHoaDon, status);
        _selectedOrder.TrangThai = status;
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _selectedOrder = null;
        _orderDetails = new();
    }

    private string GetStatusCss(string status)
    {
        return status switch
        {
            "Chờ xử lý" => "pending",
            "Đã hoàn thành" => "completed",
            "Đã hủy" => "cancelled",
            _ => "pending"
        };
    }
}
