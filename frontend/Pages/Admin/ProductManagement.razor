    private void GenerateSuggestedSku()
    {
        var pid = _variantForm.MaSanPham > 0 ? _variantForm.MaSanPham : (_selectedProductForVariant?.MaSanPham ?? 1);
        var rawColor = string.IsNullOrWhiteSpace(_variantForm.MauSac) ? "MAU" : ConvertToUnaccentedUpper(_variantForm.MauSac).Replace(" ", "");
        var rawSize = string.IsNullOrWhiteSpace(_variantForm.KichCo) ? "SIZE" : _variantForm.KichCo.Trim().ToUpperInvariant();
        _variantForm.MaSku = $"QF-SP{pid:D2}-{rawColor}-{rawSize}";
    }

    private async Task SubmitCreateVariant()
    {
        _variantErrorMessage = string.Empty;
        _variantForm.SoLuongTon = 0; // Luôn luôn khởi tạo tồn kho = 0

        if (_variantForm.MaSanPham <= 0)
        {
            _variantErrorMessage = "Vui lòng chọn sản phẩm hợp lệ để gắn biến thể.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.MauSac) && string.IsNullOrWhiteSpace(_variantForm.KichCo))
        {
            _variantErrorMessage = "Vui lòng nhập ít nhất Màu sắc hoặc Kích cỡ biến thể.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.MauSac))
        {
            _variantForm.MauSac = "Mặc định";
        }

        if (string.IsNullOrWhiteSpace(_variantForm.KichCo))
        {
            _variantForm.KichCo = "Free";
        }

        if (IsDuplicateVariant)
        {
            _variantErrorMessage = $"Sản phẩm này đã có biến thể [Màu: {_variantForm.MauSac} - Size: {_variantForm.KichCo}]. Hệ thống chặn trùng để bảo vệ dữ liệu tồn kho hiện có!";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.MaSku))
        {
            GenerateSuggestedSku();
        }

        if (_variantForm.GiaBan < 0 || _variantForm.GiaNhap < 0)
        {
            _variantErrorMessage = "Giá bán và giá nhập không được nhỏ hơn 0.";
            return;
        }

        _isSubmittingVariant = true;
        try
        {
            var res = await AdminApi.CreateProductVariantAsync(_variantForm);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã tạo thành công biến thể mới [SKU: {_variantForm.MaSku}]!");
                CloseCreateVariantModal();
                
                // Nếu đang mở danh sách biến thể, tải lại danh sách
                if (_isViewVariantsModalOpen && _viewingProduct != null && _viewingProduct.MaSanPham == _variantForm.MaSanPham)
                {
                    await LoadProductVariants(_viewingProduct.MaSanPham);
                }

                // Tải lại danh sách sản phẩm để cập nhật tồn kho & khoảng giá
                await LoadProducts();
            }
            else
            {
                _variantErrorMessage = res.Message ?? "Tạo biến thể thất bại.";
            }
        }
        catch (Exception ex)
        {
            _variantErrorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingVariant = false;
        }
    }

