@page "/admin/products"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast

<div class="products-container">
    <div class="page-header">
        <div>
            <div class="header-breadcrumb">CATALOG CHUỖI CỬA HÀNG QF</div>
            <h2 class="page-title">QUẢN LÝ SẢN PHẨM & BIẾN THỂ</h2>
            <p class="page-subtitle">Quản lý catalog thời trang QF Noir, bảng giá, phân loại kích cỡ và tồn kho chi nhánh</p>
        </div>
        <div class="header-actions">
            <!-- Nút Thêm biến thể nổi bật -->
            <button class="btn-action-primary" @onclick="() => OpenCreateVariantModal(null)" title="Thêm biến thể mới vào sản phẩm">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <span>+ Thêm biến thể</span>
            </button>

            <!-- Nút Thêm sản phẩm mới -->
            <button class="btn-action-secondary" @onclick="OpenCreateProductModal" title="Thêm sản phẩm mới vào catalog">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Thêm sản phẩm</span>
            </button>
        </div>
    </div>

    <!-- Thanh Lọc & Tìm Kiếm Nhanh -->
    <div class="catalog-filter-bar">
        <div class="search-input-wrapper">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="search-catalog-input" placeholder="Lọc nhanh theo tên hoặc mã SP..." @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button" class="clear-btn" @onclick="() => _searchTerm = string.Empty">×</button>
            }
        </div>
        <div class="catalog-stats-pill">
            <span>Tổng: <strong>@(_pagedResult?.TotalCount ?? 0)</strong> sản phẩm</span>
        </div>
    </div>

    <!-- Bảng sản phẩm Phong Cách Cao Cấp -->
    <div class="card catalog-card">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">Mã</th>
                        <th style="width: 70px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Thương hiệu</th>
                        <th class="text-right">Khoảng giá</th>
                        <th class="text-center">Tổng tồn</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredProducts == null || !FilteredProducts.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                Không tìm thấy sản phẩm nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prod in FilteredProducts)
                        {
                            <tr>
                                <td class="font-mono text-muted">#@prod.MaSanPham</td>
                                <td>
                                    <div class="product-squircle-thumb">
                                        @if (!string.IsNullOrEmpty(prod.AnhDaiDien))
                                        {
                                            <img src="@prod.AnhDaiDien" alt="@prod.TenSanPham" />
                                        }
                                        else
                                        {
                                            <span class="no-img">SP</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="prod-title-wrap">
                                        <a href="javascript:void(0)" class="prod-name-link" @onclick="() => OpenViewVariantsModal(prod)">
                                            @prod.TenSanPham
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(prod.ChatLieu))
                                        {
                                            <span class="prod-material">@prod.ChatLieu</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="badge-cat">@prod.TenDanhMuc</span></td>
                                <td><span class="brand-text">@prod.TenThuongHieu</span></td>
                                <td class="text-right tabular-nums">
                                    @if (prod.GiaThapNhat == prod.GiaCaoNhat)
                                    {
                                        <span class="price-val">@prod.GiaThapNhat.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="price-val">@prod.GiaThapNhat.ToString("N0") - @prod.GiaCaoNhat.ToString("N0") đ</span>
                                    }
                                </td>
                                <td class="text-center tabular-nums">
                                    <span class="stock-val @(prod.TongTonKho <= 10 ? "stock-low" : "")">@prod.TongTonKho</span>
                                </td>
                                <td class="text-center">
                                    @if (prod.TongTonKho > 0)
                                    {
                                        <span class="status-indicator in-stock">
                                            <span class="dot"></span>
                                            <span>Còn hàng</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-indicator out-of-stock">
                                            <span class="dot"></span>
                                            <span>Hết hàng</span>
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="row-actions">
                                        <!-- Xem biến thể -->
                                        <button class="btn-action-ghost" @onclick="() => OpenViewVariantsModal(prod)" title="Xem danh sách biến thể của sản phẩm">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                            </svg>
                                        </button>
                                        <!-- Thêm biến thể trực tiếp cho sản phẩm này -->
                                        <button class="btn-action-ghost btn-add-variant" @onclick="() => OpenCreateVariantModal(prod)" title="Thêm biến thể mới cho sản phẩm này">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <path d="M12 5v14M5 12h14"></path>
                                            </svg>
                                        </button>
                                        <!-- Chỉnh sửa -->
                                        <button class="btn-action-ghost" @onclick="() => EditProduct(prod)" title="Chỉnh sửa thông tin sản phẩm">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang tối giản -->
        @if (_pagedResult != null && _pagedResult.TotalCount > 0)
        {
            <div class="pagination-footer">
                <span class="text-muted text-sm tabular-nums">
                    Hiển thị <strong>@_pagedResult.Items.Count()</strong> / <strong>@_pagedResult.TotalCount</strong> bản ghi
                </span>
                <div class="pagination-controls">
                    <button class="btn-page-step" 
                            disabled="@(!_pagedResult.HasPreviousPage)" 
                            @onclick="() => ChangePage(_currentPage - 1)">
                        ← Trang trước
                    </button>
                    <span class="page-current tabular-nums">@_currentPage / @(_pagedResult.TotalPages == 0 ? 1 : _pagedResult.TotalPages)</span>
                    <button class="btn-page-step" 
                            disabled="@(!_pagedResult.HasNextPage)" 
                            @onclick="() => ChangePage(_currentPage + 1)">
                        Trang sau →
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: FORM NHẬP THÔNG TIN THÊM BIẾN THỂ SẢN PHẨM                       -->
<!-- ========================================================================= -->
@if (_isVariantModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseCreateVariantModal">
        <div class="modal-panel modal-panel-md" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">QF NOIR CATALOG</div>
                    <h3 class="modal-title">THÊM BIẾN THỂ SẢN PHẨM</h3>
                    <p class="modal-subtitle">Tạo biến thể màu sắc, kích cỡ, mã SKU và định mức tồn kho ban đầu</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseCreateVariantModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_variantErrorMessage))
                {
                    <div class="alert-box alert-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@_variantErrorMessage</span>
                    </div>
                }

                <!-- Chọn sản phẩm -->
                <div class="form-group">
                    <label class="form-label">Sản phẩm thuộc về <span class="required">*</span></label>
                    @if (_selectedProductForVariant != null)
                    {
                        <div class="selected-product-card">
                            <div class="prod-thumb-mini">
                                @if (!string.IsNullOrEmpty(_selectedProductForVariant.AnhDaiDien))
                                {
                                    <img src="@_selectedProductForVariant.AnhDaiDien" alt="@_selectedProductForVariant.TenSanPham" />
                                }
                                else
                                {
                                    <span>SP</span>
                                }
                            </div>
                            <div class="prod-info-mini">
                                <div class="prod-name-mini">@_selectedProductForVariant.TenSanPham</div>
                                <div class="prod-sub-mini">Mã SP: #@_selectedProductForVariant.MaSanPham &bull; Danh mục: @_selectedProductForVariant.TenDanhMuc</div>
                            </div>
                            @if (_canChangeProductInVariantModal)
                            {
                                <button type="button" class="btn-change-prod" @onclick="() => _selectedProductForVariant = null">Thay đổi</button>
                            }
                        </div>
                    }
                    else
                    {
                        <select class="form-control" @onchange="OnProductSelectChanged">
                            <option value="0">-- Chọn sản phẩm từ danh sách --</option>
                            @if (_allProductsList != null)
                            {
                                @foreach (var p in _allProductsList)
                                {
                                    <option value="@p.MaSanPham">#@p.MaSanPham - @p.TenSanPham (@p.TenDanhMuc)</option>
                                }
                            }
                        </select>
                    }
                </div>

                <div class="form-row-2">
                    <!-- Màu sắc -->
                    <div class="form-group">
                        <label class="form-label">Màu sắc <span class="required">*</span></label>
                        <div class="input-with-suggestions">
                            <input type="text" class="form-control" placeholder="VD: Đen, Trắng, Xanh Navy..." 
                                   @bind="_variantForm.MauSac" @bind:after="OnVariantAttributesChanged" />
                        </div>
                        <div class="quick-chips">
                            @foreach (var c in _popularColors)
                            {
                                <button type="button" class="chip-btn @(_variantForm.MauSac == c ? "active" : "")" 
                                        @onclick="() => SelectColor(c)">@c</button>
                            }
                        </div>
                    </div>

                    <!-- Kích cỡ -->
                    <div class="form-group">
                        <label class="form-label">Kích cỡ (Size) <span class="required">*</span></label>
                        <div class="input-with-suggestions">
                            <input type="text" class="form-control font-mono" placeholder="VD: S, M, L, XL, 30..." 
                                   @bind="_variantForm.KichCo" @bind:after="OnVariantAttributesChanged" />
                        </div>
                        <div class="quick-chips">
                            @foreach (var s in _popularSizes)
                            {
                                <button type="button" class="chip-btn @(_variantForm.KichCo == s ? "active" : "")" 
                                        @onclick="() => SelectSize(s)">@s</button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Mã SKU -->
                <div class="form-group">
                    <div class="label-with-action">
                        <label class="form-label">Mã SKU (Stock Keeping Unit) <span class="required">*</span></label>
                        <button type="button" class="btn-text-action" @onclick="GenerateSuggestedSku">Tự sinh SKU chuẩn</button>
                    </div>
                    <input type="text" class="form-control font-mono" placeholder="VD: QF-SP01-DEN-L" @bind="_variantForm.MaSku" />
                    <span class="form-hint">Mã định danh duy nhất của từng biến thể trên toàn hệ thống kho QF.</span>
                </div>

                <div class="form-row-3">
                    <!-- Giá nhập -->
                    <div class="form-group">
                        <label class="form-label">Giá nhập đề xuất (đ) <span class="required">*</span></label>
                        <input type="number" class="form-control tabular-nums text-right" min="0" step="1000" @bind="_variantForm.GiaNhap" />
                    </div>

                    <!-- Giá bán -->
                    <div class="form-group">
                        <label class="form-label">Giá niêm yết bán (đ) <span class="required">*</span></label>
                        <input type="number" class="form-control tabular-nums text-right font-weight-bold" min="0" step="1000" @bind="_variantForm.GiaBan" />
                    </div>

                    <!-- Tồn kho ban đầu -->
                    <div class="form-group">
                        <label class="form-label">Tồn kho ban đầu</label>
                        <input type="number" class="form-control tabular-nums text-center" min="0" @bind="_variantForm.SoLuongTon" />
                    </div>
                </div>

                @if (_variantForm.GiaBan > 0 && _variantForm.GiaNhap > _variantForm.GiaBan)
                {
                    <div class="alert-box alert-warning">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>Cảnh báo: Giá bán đang thấp hơn giá nhập đề xuất!</span>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseCreateVariantModal" disabled="@_isSubmittingVariant">
                    Hủy bỏ
                </button>
                <button type="button" class="btn-modal-submit" @onclick="SubmitCreateVariant" disabled="@_isSubmittingVariant">
                    @if (_isSubmittingVariant)
                    {
                        <span class="spinner-small"></span>
                        <span>Đang lưu biến thể...</span>
                    }
                    else
                    {
                        <span>Lưu biến thể vào CSDL</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 2: XEM DANH SÁCH TẤT CẢ BIẾN THỂ CỦA MỘT SẢN PHẨM                   -->
<!-- ========================================================================= -->
@if (_isViewVariantsModalOpen && _viewingProduct != null)
{
    <div class="modal-backdrop" @onclick="CloseViewVariantsModal">
        <div class="modal-panel modal-panel-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">DANH SÁCH BIẾN THỂ SẢN PHẨM</div>
                    <h3 class="modal-title">#@_viewingProduct.MaSanPham - @_viewingProduct.TenSanPham</h3>
                    <p class="modal-subtitle">Danh mục: @_viewingProduct.TenDanhMuc &bull; Thương hiệu: @_viewingProduct.TenThuongHieu &bull; Tổng tồn: @_viewingProduct.TongTonKho cái</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseViewVariantsModal">✕</button>
            </div>

            <div class="modal-body-p0">
                <div class="variant-toolbar">
                    <span class="variant-count">Tổng cộng <strong>@(_productVariantsList?.Count ?? 0)</strong> biến thể cấu hình</span>
                    <button type="button" class="btn-add-variant-quick" @onclick="() => SwitchToCreateVariantFromView(_viewingProduct)">
                        + Thêm biến thể mới cho sản phẩm này
                    </button>
                </div>

                @if (_isLoadingVariants)
                {
                    <div class="py-5 text-center text-muted">
                        <span class="spinner-small"></span> Đang tải danh sách biến thể...
                    </div>
                }
                else if (_productVariantsList == null || !_productVariantsList.Any())
                {
                    <div class="py-5 text-center text-muted">
                        Sản phẩm này chưa có biến thể nào được cấu hình.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="variant-table">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">Mã BT</th>
                                    <th>Mã SKU</th>
                                    <th>Màu sắc</th>
                                    <th>Kích cỡ</th>
                                    <th class="text-right">Giá bán niêm yết</th>
                                    <th class="text-center">Số lượng tồn</th>
                                    <th class="text-center">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in _productVariantsList)
                                {
                                    <tr>
                                        <td class="font-mono text-muted">#@v.MaBienThe</td>
                                        <td><code class="sku-badge">@v.MaSku</code></td>
                                        <td>
                                            <div class="color-badge-wrap">
                                                <span class="color-dot"></span>
                                                <span>@v.MauSac</span>
                                            </div>
                                        </td>
                                        <td><span class="size-pill">@v.KichCo</span></td>
                                        <td class="text-right tabular-nums font-weight-bold">@v.GiaBan.ToString("N0") đ</td>
                                        <td class="text-center tabular-nums">
                                            <span class="stock-badge @(v.SoLuongTon <= 10 ? "stock-badge-low" : "")">
                                                @v.SoLuongTon
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (v.SoLuongTon > 0)
                                            {
                                                <span class="badge-status-green">Còn hàng</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status-red">Hết hàng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseViewVariantsModal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 3: TẠO SẢN PHẨM MỚI                                                 -->
<!-- ========================================================================= -->
@if (_isProductModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseCreateProductModal">
        <div class="modal-panel modal-panel-md" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <div class="modal-badge">TẠO SẢN PHẨM MỚI</div>
                    <h3 class="modal-title">THÊM SẢN PHẨM VÀO CATALOG</h3>
                    <p class="modal-subtitle">Thêm dòng sản phẩm thời trang mới vào bộ sưu tập QF Noir</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseCreateProductModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_productErrorMessage))
                {
                    <div class="alert-box alert-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@_productErrorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Tên sản phẩm thời trang <span class="required">*</span></label>
                    <input type="text" class="form-control" placeholder="VD: Áo Blazer Nam Slimfit Sang Trọng..." @bind="_productForm.TenSanPham" />
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Danh mục sản phẩm <span class="required">*</span></label>
                        <select class="form-control" @bind="_productForm.MaDanhMuc">
                            <option value="0">-- Chọn danh mục --</option>
                            @if (_categoriesList != null)
                            {
                                @foreach (var cat in _categoriesList)
                                {
                                    <option value="@cat.MaDanhMuc">@cat.TenDanhMuc</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Thương hiệu <span class="required">*</span></label>
                        <select class="form-control" @bind="_productForm.MaThuongHieu">
                            <option value="0">-- Chọn thương hiệu --</option>
                            @if (_brandsList != null)
                            {
                                @foreach (var b in _brandsList)
                                {
                                    <option value="@b.MaThuongHieu">@b.TenThuongHieu</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Chất liệu vải / mô tả vật liệu</label>
                    <input type="text" class="form-control" placeholder="VD: 100% Cotton Compact 240gsm, Chống nhăn..." @bind="_productForm.ChatLieu" />
                </div>

                <div class="form-group">
                    <label class="form-label">Đường dẫn hình ảnh chính (URL) <span class="required">*</span></label>
                    <input type="text" class="form-control" placeholder="https://images.unsplash.com/..." @bind="_productMainImageUrl" />
                    <span class="form-hint">Quy tắc CSDL: Sản phẩm bắt buộc phải có ít nhất 1 hình ảnh đại diện hợp lệ.</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" @onclick="CloseCreateProductModal" disabled="@_isSubmittingProduct">
                    Hủy bỏ
                </button>
                <button type="button" class="btn-modal-submit" @onclick="SubmitCreateProduct" disabled="@_isSubmittingProduct">
                    @if (_isSubmittingProduct)
                    {
                        <span class="spinner-small"></span>
                        <span>Đang tạo sản phẩm...</span>
                    }
                    else
                    {
                        <span>Lưu sản phẩm mới</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

