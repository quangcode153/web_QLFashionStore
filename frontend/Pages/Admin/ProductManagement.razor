@code {
    private PagedResult<ProductListItemDto>? _pagedResult;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private string _searchTerm = string.Empty;

    // Danh sách toàn bộ sản phẩm (để chọn khi thêm biến thể)
    private List<ProductListItemDto>? _allProductsList;

    // Danh mục & Thương hiệu cho form thêm sản phẩm
    private List<CategoryDto>? _categoriesList;
    private List<BrandDto>? _brandsList;

    // State Modal Thêm Biến Thể
    private bool _isVariantModalOpen = false;
    private bool _isSubmittingVariant = false;
    private string _variantErrorMessage = string.Empty;
    private ProductListItemDto? _selectedProductForVariant;
    private bool _canChangeProductInVariantModal = true;
    private CreateProductVariantRequest _variantForm = new();

    // State Modal Xem Biến Thể
    private bool _isViewVariantsModalOpen = false;
    private bool _isLoadingVariants = false;
    private ProductListItemDto? _viewingProduct;
    private List<ProductVariantDto>? _productVariantsList;

    // State Modal Thêm Sản Phẩm Mới
    private bool _isProductModalOpen = false;
    private bool _isSubmittingProduct = false;
    private string _productErrorMessage = string.Empty;
    private CreateProductRequest _productForm = new();
    private string _productMainImageUrl = string.Empty;

    // Gợi ý nhanh màu & size nam chuẩn
    private readonly string[] _popularColors = new[] { "Đen", "Trắng", "Xám Ghi", "Be Sáng", "Xanh Navy", "Xanh Rêu", "Nâu Cafe" };
    private readonly string[] _popularSizes = new[] { "S", "M", "L", "XL", "XXL", "29", "30", "31", "32" };

    private IEnumerable<ProductListItemDto>? FilteredProducts
    {
        get
        {
            if (_pagedResult?.Items == null) return null;
            if (string.IsNullOrWhiteSpace(_searchTerm)) return _pagedResult.Items;
            
            var term = _searchTerm.Trim().ToLowerInvariant();
            return _pagedResult.Items.Where(p => 
                p.TenSanPham.ToLowerInvariant().Contains(term) ||
                p.MaSanPham.ToString().Contains(term) ||
                p.TenDanhMuc.ToLowerInvariant().Contains(term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            _pagedResult = await AdminApi.GetProductsAsync(_currentPage, _pageSize);
            // Tải thêm danh sách trang lớn để phục vụ chọn SP nhanh khi thêm biến thể
            if (_allProductsList == null || !_allProductsList.Any())
            {
                var bigPage = await AdminApi.GetProductsAsync(1, 100);
                _allProductsList = bigPage?.Items?.ToList() ?? new List<ProductListItemDto>();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách sản phẩm: {ex.Message}");
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1) return;
        _currentPage = newPage;
        await LoadProducts();
    }

    // =========================================================================
    // XỬ LÝ MODAL THÊM BIẾN THỂ
    // =========================================================================
    private void OpenCreateVariantModal(ProductListItemDto? prod = null)
    {
        _variantErrorMessage = string.Empty;
        _variantForm = new CreateProductVariantRequest
        {
            MauSac = "Đen",
            KichCo = "L",
            GiaNhap = 150000,
            GiaBan = 250000,
            SoLuongTon = 20
        };

        if (prod != null)
        {
            _selectedProductForVariant = prod;
            _canChangeProductInVariantModal = false;
            _variantForm.MaSanPham = prod.MaSanPham;
            if (prod.GiaThapNhat > 0)
            {
                _variantForm.GiaBan = prod.GiaThapNhat;
                _variantForm.GiaNhap = (decimal)(Math.Round((double)(prod.GiaThapNhat * 0.6m) / 10000.0) * 10000);
            }
        }
        else
        {
            _selectedProductForVariant = _allProductsList?.FirstOrDefault();
            _canChangeProductInVariantModal = true;
            _variantForm.MaSanPham = _selectedProductForVariant?.MaSanPham ?? 0;
        }

        GenerateSuggestedSku();
        _isVariantModalOpen = true;
    }

    private void CloseCreateVariantModal()
    {
        _isVariantModalOpen = false;
        _variantErrorMessage = string.Empty;
    }

    private void OnProductSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int pid))
        {
            _selectedProductForVariant = _allProductsList?.FirstOrDefault(x => x.MaSanPham == pid);
            _variantForm.MaSanPham = pid;
            GenerateSuggestedSku();
        }
    }

    private void SelectColor(string color)
    {
        _variantForm.MauSac = color;
        GenerateSuggestedSku();
    }

    private void SelectSize(string size)
    {
        _variantForm.KichCo = size;
        GenerateSuggestedSku();
    }

    private void OnVariantAttributesChanged()
    {
        GenerateSuggestedSku();
    }

    private void GenerateSuggestedSku()
    {
        var pid = _variantForm.MaSanPham > 0 ? _variantForm.MaSanPham : (_selectedProductForVariant?.MaSanPham ?? 1);
        var rawColor = string.IsNullOrWhiteSpace(_variantForm.MauSac) ? "DEN" : ConvertToUnaccentedUpper(_variantForm.MauSac).Replace(" ", "");
        var rawSize = string.IsNullOrWhiteSpace(_variantForm.KichCo) ? "L" : _variantForm.KichCo.Trim().ToUpperInvariant();
        _variantForm.MaSku = $"QF-SP{pid:D2}-{rawColor}-{rawSize}";
    }

    private async Task SubmitCreateVariant()
    {
        _variantErrorMessage = string.Empty;

        if (_variantForm.MaSanPham <= 0)
        {
            _variantErrorMessage = "Vui lòng chọn sản phẩm hợp lệ để gắn biến thể.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.MauSac))
        {
            _variantErrorMessage = "Vui lòng nhập hoặc chọn màu sắc biến thể.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.KichCo))
        {
            _variantErrorMessage = "Vui lòng nhập hoặc chọn kích cỡ biến thể.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_variantForm.MaSku))
        {
            _variantErrorMessage = "Vui lòng nhập mã SKU cho biến thể.";
            return;
        }

        if (_variantForm.GiaBan < 0 || _variantForm.GiaNhap < 0)
        {
            _variantErrorMessage = "Giá bán và giá nhập không được nhỏ hơn 0.";
            return;
        }

        _isSubmittingVariant = true;
        try
        {
            var res = await AdminApi.CreateProductVariantAsync(_variantForm);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã tạo thành công biến thể mới [SKU: {_variantForm.MaSku}]!");
                CloseCreateVariantModal();
                
                // Nếu đang mở danh sách biến thể, tải lại danh sách
                if (_isViewVariantsModalOpen && _viewingProduct != null && _viewingProduct.MaSanPham == _variantForm.MaSanPham)
                {
                    await LoadProductVariants(_viewingProduct.MaSanPham);
                }

                // Tải lại danh sách sản phẩm để cập nhật tồn kho & khoảng giá
                await LoadProducts();
            }
            else
            {
                _variantErrorMessage = res.Message ?? "Tạo biến thể thất bại.";
            }
        }
        catch (Exception ex)
        {
            _variantErrorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingVariant = false;
        }
    }

    // =========================================================================
    // XỬ LÝ MODAL XEM BIẾN THỂ
    // =========================================================================
    private async Task OpenViewVariantsModal(ProductListItemDto prod)
    {
        _viewingProduct = prod;
        _isViewVariantsModalOpen = true;
        await LoadProductVariants(prod.MaSanPham);
    }

    private async Task LoadProductVariants(int productId)
    {
        _isLoadingVariants = true;
        try
        {
            _productVariantsList = await AdminApi.GetProductVariantsAsync(productId);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách biến thể: {ex.Message}");
        }
        finally
        {
            _isLoadingVariants = false;
        }
    }

    private void CloseViewVariantsModal()
    {
        _isViewVariantsModalOpen = false;
        _viewingProduct = null;
        _productVariantsList = null;
    }

    private void SwitchToCreateVariantFromView(ProductListItemDto prod)
    {
        CloseViewVariantsModal();
        OpenCreateVariantModal(prod);
    }

    // =========================================================================
    // XỬ LÝ MODAL TẠO SẢN PHẨM MỚI
    // =========================================================================
    private async Task OpenCreateProductModal()
    {
        _productErrorMessage = string.Empty;
        _productForm = new CreateProductRequest();
        _productMainImageUrl = "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80";

        try
        {
            if (_categoriesList == null || !_categoriesList.Any())
                _categoriesList = await AdminApi.GetCategoriesAsync();

            if (_brandsList == null || !_brandsList.Any())
                _brandsList = await AdminApi.GetBrandsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh mục/thương hiệu: {ex.Message}");
        }

        _isProductModalOpen = true;
    }

    private void CloseCreateProductModal()
    {
        _isProductModalOpen = false;
        _productErrorMessage = string.Empty;
    }

    private async Task SubmitCreateProduct()
    {
        _productErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_productForm.TenSanPham))
        {
            _productErrorMessage = "Vui lòng nhập tên sản phẩm.";
            return;
        }

        if (_productForm.MaDanhMuc <= 0)
        {
            _productErrorMessage = "Vui lòng chọn danh mục cho sản phẩm.";
            return;
        }

        if (_productForm.MaThuongHieu <= 0)
        {
            _productErrorMessage = "Vui lòng chọn thương hiệu cho sản phẩm.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_productMainImageUrl))
        {
            _productErrorMessage = "Vui lòng nhập URL hình ảnh đại diện chính của sản phẩm.";
            return;
        }

        _productForm.Images = new List<CreateProductImageDto>
        {
            new CreateProductImageDto { DuongDanAnh = _productMainImageUrl.Trim(), LaAnhChinh = true }
        };

        _isSubmittingProduct = true;
        try
        {
            var res = await AdminApi.CreateProductAsync(_productForm);
            if (res.Success)
            {
                var newPid = res.Data;
                Toast.ShowSuccess($"Tạo thành công sản phẩm #{newPid}: {_productForm.TenSanPham}!");
                CloseCreateProductModal();
                await LoadProducts();

                // Gợi ý ngay mở form tạo biến thể đầu tiên cho sản phẩm vừa tạo
                var newProd = _pagedResult?.Items?.FirstOrDefault(x => x.MaSanPham == newPid) 
                              ?? new ProductListItemDto { MaSanPham = newPid, TenSanPham = _productForm.TenSanPham };
                OpenCreateVariantModal(newProd);
            }
            else
            {
                _productErrorMessage = res.Message ?? "Tạo sản phẩm thất bại.";
            }
        }
        catch (Exception ex)
        {
            _productErrorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmittingProduct = false;
        }
    }

    private void EditProduct(ProductListItemDto prod)
    {
        Toast.ShowInfo($"Chỉnh sửa sản phẩm #{prod.MaSanPham}: {prod.TenSanPham}");
    }

    private static string ConvertToUnaccentedUpper(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var normalizedString = text.Normalize(System.Text.NormalizationForm.FormD);
        var stringBuilder = new System.Text.StringBuilder();

        foreach (var c in normalizedString)
        {
            var unicodeCategory = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (unicodeCategory != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                stringBuilder.Append(c);
            }
        }

        var result = stringBuilder.ToString().Normalize(System.Text.NormalizationForm.FormC);
        return result.Replace("đ", "d").Replace("Đ", "D").ToUpperInvariant();
    }
