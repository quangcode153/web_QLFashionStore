    private ProductListItemDto? _editingProduct;
    private UpdateProductRequest _editProductForm = new();

    // Danh sách toàn bộ sản phẩm (để chọn khi thêm biến thể)
    private List<ProductListItemDto>? _allProductsList;

    // Danh mục & Thương hiệu cho form thêm sản phẩm
    private List<CategoryDto>? _categoriesList;
    private List<BrandDto>? _brandsList;

    // State Thêm nhanh Danh mục & Thương hiệu (Quick Add)
    private bool _showQuickCategory = false;
    private string _newCategoryName = string.Empty;
    private int _newCategoryParentId = 4; // Mặc định Áo Nam (4)
    private bool _isSavingQuickCategory = false;

    private bool _showQuickBrand = false;
    private string _newBrandName = string.Empty;
    private string _newBrandOrigin = "Việt Nam";
    private bool _isSavingQuickBrand = false;

    // State Modal Thêm Biến Thể
    private bool _isVariantModalOpen = false;
    private bool _isSubmittingVariant = false;
    private string _variantErrorMessage = string.Empty;
    private ProductListItemDto? _selectedProductForVariant;
    private bool _canChangeProductInVariantModal = true;
    private CreateProductVariantRequest _variantForm = new();
    private List<ProductVariantDto> _existingVariantsForSelectedProduct = new();
    private bool _isLoadingExistingVariants = false;

    private bool IsDuplicateVariant
    {
        get
        {
            if (_existingVariantsForSelectedProduct == null || !_existingVariantsForSelectedProduct.Any())
                return false;

            if (string.IsNullOrWhiteSpace(_variantForm.MauSac) && string.IsNullOrWhiteSpace(_variantForm.KichCo))
                return false;

            var checkColor = string.IsNullOrWhiteSpace(_variantForm.MauSac) ? "Mặc định" : _variantForm.MauSac.Trim();
            var checkSize = string.IsNullOrWhiteSpace(_variantForm.KichCo) ? "Free" : _variantForm.KichCo.Trim();

            return _existingVariantsForSelectedProduct.Any(v => 
                v.MauSac.Trim().Equals(checkColor, StringComparison.OrdinalIgnoreCase) && 
                v.KichCo.Trim().Equals(checkSize, StringComparison.OrdinalIgnoreCase));
        }
    }

    // State Modal Xem Biến Thể
    private bool _isViewVariantsModalOpen = false;
    private bool _isLoadingVariants = false;
    private ProductListItemDto? _viewingProduct;
    private List<ProductVariantDto>? _productVariantsList;

    // State Modal Thêm Sản Phẩm Mới
    private bool _isProductModalOpen = false;
    private bool _isSubmittingProduct = false;
    private string _productErrorMessage = string.Empty;
    private CreateProductRequest _productForm = new();
    private string _productMainImageUrl = string.Empty;

    // Gợi ý nhanh màu & size nam chuẩn (có Free size cho Ví, Clutch, Thắt lưng, Phụ kiện)
    private readonly string[] _popularColors = new[] { "Đen", "Trắng", "Xám Ghi", "Be Sáng", "Xanh Navy", "Xanh Rêu", "Nâu Cafe" };
    private readonly string[] _popularSizes = new[] { "Free", "S", "M", "L", "XL", "XXL", "29", "30", "31", "32" };

    private IEnumerable<ProductListItemDto>? FilteredProducts
    {
        get
        {
            if (_pagedResult?.Items == null) return null;
            if (string.IsNullOrWhiteSpace(_searchTerm)) return _pagedResult.Items;
            
            var term = _searchTerm.Trim().ToLowerInvariant();
            return _pagedResult.Items.Where(p => 
                p.TenSanPham.ToLowerInvariant().Contains(term) ||
                p.MaSanPham.ToString().Contains(term) ||
                p.TenDanhMuc.ToLowerInvariant().Contains(term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRole();
        if (!_isChainAdmin)
        {
            Toast.ShowWarning("Chỉ Quản trị viên chuỗi mới có quyền quản lý Sản phẩm & Biến thể. Đang chuyển hướng về trang Kho & Tồn kho...");
            Navigation.NavigateTo("/warehouse");
            return;
        }
        await LoadProducts();
    }

    private async Task LoadUserRole()
    {
        try
        {
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
            if (string.IsNullOrEmpty(role))
            {
                _isChainAdmin = true;
            }
            else if (role.Equals("AdminChuoi", StringComparison.OrdinalIgnoreCase) || 
                     role.Equals("QuanLyHeThong", StringComparison.OrdinalIgnoreCase) ||
                     role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
                     (role.Contains("Admin", StringComparison.OrdinalIgnoreCase) && !role.Contains("ChiNhanh", StringComparison.OrdinalIgnoreCase)) ||
                     role.Contains("đa chi nhánh", StringComparison.OrdinalIgnoreCase) ||
                     role.Contains("chuỗi", StringComparison.OrdinalIgnoreCase))
            {
                _isChainAdmin = true;
            }
            else
            {
                _isChainAdmin = false;
            }
        }
        catch
        {
            _isChainAdmin = true;
        }
    }

    private async Task SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _currentPage = 1;
        await LoadProducts();
