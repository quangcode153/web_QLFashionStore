@page "/admin/feedback"
@page "/admin/feedbacks"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast
@inject ISignalRNotificationService SignalRService
@implements IDisposable

<div class="feedback-admin-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">QUẢN LÝ KHIẾU NẠI & GÓP Ý</h2>
            <p class="page-subtitle">Theo dõi, tiếp nhận và giải quyết phản hồi, khiếu nại dịch vụ từ khách hàng</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline btn-refresh" @onclick="LoadFeedbacks" disabled="@_isLoading" title="Tải lại danh sách phản hồi">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isLoading ? "spin-refresh" : "")">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>@(_isLoading ? "Đang tải..." : "Làm mới dữ liệu")</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Pills -->
    <div class="kpi-grid">
        <div class="kpi-card @(_currentFilter == "ALL" ? "active" : "")" @onclick='() => _currentFilter = "ALL"'>
            <div class="kpi-label">Tổng số phản hồi</div>
            <div class="kpi-value">@_feedbacks.Count</div>
            <div class="kpi-sub">Tất cả danh mục</div>
        </div>
        <div class="kpi-card text-danger @(_currentFilter == "Chưa xử lý" ? "active" : "")" @onclick='() => _currentFilter = "Chưa xử lý"'>
            <div class="kpi-label">Chưa xử lý</div>
            <div class="kpi-value text-danger">@_feedbacks.Count(f => f.TrangThai == "Chưa xử lý")</div>
            <div class="kpi-sub">Cần giải quyết ngay</div>
        </div>
        <div class="kpi-card text-primary @(_currentFilter == "Đang xử lý" ? "active" : "")" @onclick='() => _currentFilter = "Đang xử lý"'>
            <div class="kpi-label">Đang xử lý</div>
            <div class="kpi-value text-primary">@_feedbacks.Count(f => f.TrangThai == "Đang xử lý")</div>
            <div class="kpi-sub">Đang liên hệ khách</div>
        </div>
        <div class="kpi-card text-success @(_currentFilter == "Đã giải quyết" ? "active" : "")" @onclick='() => _currentFilter = "Đã giải quyết"'>
            <div class="kpi-label">Đã giải quyết</div>
            <div class="kpi-value text-success">@_feedbacks.Count(f => f.TrangThai == "Đã giải quyết")</div>
            <div class="kpi-sub">Hoàn tất hỗ trợ</div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="filter-card">
        <div class="filter-search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="search-input" placeholder="Tìm theo tên khách, SĐT, tiêu đề hoặc nội dung..." @bind="_searchText" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_searchText))
            {
                <button type="button" class="btn-clear" @onclick='() => _searchText = string.Empty'>×</button>
            }
        </div>

        <div class="filter-tabs">
            <button type="button" class="filter-tab @(_currentFilter == "ALL" ? "active" : "")" @onclick='() => _currentFilter = "ALL"'>Tất cả</button>
            <button type="button" class="filter-tab @(_currentFilter == "Chưa xử lý" ? "active" : "")" @onclick='() => _currentFilter = "Chưa xử lý"'>Chưa xử lý</button>
            <button type="button" class="filter-tab @(_currentFilter == "Đang xử lý" ? "active" : "")" @onclick='() => _currentFilter = "Đang xử lý"'>Đang xử lý</button>
            <button type="button" class="filter-tab @(_currentFilter == "Đã giải quyết" ? "active" : "")" @onclick='() => _currentFilter = "Đã giải quyết"'>Đã giải quyết</button>
        </div>
    </div>

    <!-- Danh sách Tickets Khiếu nại / Góp ý -->
    <div class="feedback-list-container">
        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Đang tải danh sách khiếu nại & góp ý...</p>
            </div>
        }
        else if (!FilteredFeedbacks.Any())
        {
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <p class="empty-title">Không tìm thấy phản hồi nào phù hợp</p>
                <span class="empty-sub">Các phiếu khiếu nại hoặc góp ý từ chân trang Storefront sẽ xuất hiện tại đây.</span>
            </div>
        }
        else
        {
            <div class="tickets-grid">
                @foreach (var fb in FilteredFeedbacks)
                {
                    <div class="ticket-card @GetTicketBorderClass(fb.TrangThai)">
                        <div class="ticket-header">
                            <div class="ticket-meta">
                                <span class="ticket-id">#@fb.MaPhanHoi</span>
                                <span class="badge-type @GetTypeBadgeClass(fb.LoaiPhanHoi)">@fb.LoaiPhanHoi</span>
                                <span class="ticket-time">@fb.NgayGui.ToString("HH:mm - dd/MM/yyyy")</span>
                            </div>
                            <div class="ticket-status">
                                <span class="badge-status @GetStatusBadgeClass(fb.TrangThai)">@fb.TrangThai</span>
                            </div>
                        </div>

                        <div class="ticket-customer-info">
                            <div class="cust-row">
                                <strong class="cust-name">@fb.HoTen</strong>
                                <a href="tel:@fb.DienThoai" class="cust-phone">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    @fb.DienThoai
                                </a>
                                @if (!string.IsNullOrEmpty(fb.Email))
                                {
                                    <span class="cust-email">@fb.Email</span>
                                }
                            </div>
                        </div>

                        <div class="ticket-body">
                            <h4 class="ticket-subject">@fb.TieuDe</h4>
                            <p class="ticket-content">@fb.NoiDung</p>

                            @if (fb.LoaiPhanHoi == "Yêu cầu hoàn trả hàng" && fb.MaHoaDon.HasValue)
                            {
                                <div class="ticket-return-details-box">
                                    <div class="return-box-title">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 10h10a8 8 0 0 1 8 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                        THÔNG TIN HOÀN TRẢ HÀNG
                                    </div>
                                    <div class="return-box-grid">
                                        <span>Mã đơn hàng: <strong>#DH-@fb.MaHoaDon</strong></span>
                                        <span>Biến thể SKU: <strong>#@fb.MaBienThe</strong></span>
                                        <span>Số lượng hoàn: <strong>@fb.SoLuongTra</strong> sản phẩm</span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(fb.GhiChuXuLy))
                            {
                                <div class="ticket-internal-notes">
                                    <strong>Ghi chú xử lý:</strong> @fb.GhiChuXuLy
                                </div>
                            }
                        </div>

                        <div class="ticket-actions">
                            @if (fb.LoaiPhanHoi == "Yêu cầu hoàn trả hàng" && fb.TrangThai == "Chưa xử lý")
                            {
                                <button type="button" class="btn btn-sm btn-approve-return-action" @onclick='() => ApproveReturn(fb.MaPhanHoi)' title="Duyệt yêu cầu và cộng lại số lượng vào kho">
                                    Chấp thuận & Hoàn kho
                                </button>
                                <button type="button" class="btn btn-sm btn-reject-return-action" @onclick='() => RejectReturn(fb.MaPhanHoi)' title="Từ chối yêu cầu hoàn trả">
                                    Từ chối hoàn trả
                                </button>
                            }
                            else
                            {
                                @if (fb.TrangThai == "Chưa xử lý")
                                {
                                    <button type="button" class="btn btn-sm btn-primary-action" @onclick='() => UpdateStatus(fb.MaPhanHoi, "Đang xử lý")'>
                                        Tiếp nhận xử lý
                                    </button>
                                }
                                @if (fb.TrangThai != "Đã giải quyết")
                                {
                                    <button type="button" class="btn btn-sm btn-success-action" @onclick='() => UpdateStatus(fb.MaPhanHoi, "Đã giải quyết")'>
                                        Đã giải quyết
                                    </button>
                                }
                                @if (fb.TrangThai != "Đã đóng")
                                {
                                    <button type="button" class="btn btn-sm btn-secondary-action" @onclick='() => UpdateStatus(fb.MaPhanHoi, "Đã đóng")'>
                                        Đóng ticket
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

