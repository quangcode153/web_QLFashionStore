@code {
    private List<global::Shared.DTOs.Feedback.FeedbackDto> _feedbacks = new();
    private bool _isLoading = false;
    private string _currentFilter = "ALL";
    private string _searchText = string.Empty;

    private IEnumerable<global::Shared.DTOs.Feedback.FeedbackDto> FilteredFeedbacks
    {
        get
        {
            var query = _feedbacks.AsEnumerable();

            if (_currentFilter != "ALL")
            {
                query = query.Where(f => f.TrangThai.Equals(_currentFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim().ToLowerInvariant();
                query = query.Where(f => 
                    f.HoTen.ToLowerInvariant().Contains(term) ||
                    f.DienThoai.Contains(term) ||
                    (f.Email != null && f.Email.ToLowerInvariant().Contains(term)) ||
                    f.TieuDe.ToLowerInvariant().Contains(term) ||
                    f.NoiDung.ToLowerInvariant().Contains(term));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedbacks();

        // Đăng ký nhận sự kiện realtime từ SignalR khi có phản hồi mới từ khách hàng
        SignalRService.OnCustomerFeedbackReceived += HandleFeedbackReceived;
    }

    private void HandleFeedbackReceived(int id, string hoTen, string loai, string tieuDe)
    {
        InvokeAsync(async () =>
        {
            Toast.ShowWarning($"[REPORT MỚI] Khách hàng '{hoTen}' vừa gửi phiếu: {tieuDe}");
            await LoadFeedbacks();
            StateHasChanged();
        });
    }

    private async Task LoadFeedbacks()
    {
        _isLoading = true;
        try
        {
            _feedbacks = await AdminApi.GetFeedbacksAsync() ?? new();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách phản hồi: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateStatus(int id, string newStatus)
    {
        try
        {
            var success = await AdminApi.UpdateFeedbackStatusAsync(id, newStatus);
            if (success)
            {
                Toast.ShowSuccess($"Đã cập nhật trạng thái phiếu #{id} thành '{newStatus}'!");
                var fb = _feedbacks.FirstOrDefault(f => f.MaPhanHoi == id);
                if (fb != null) fb.TrangThai = newStatus;
                StateHasChanged();
            }
            else
            {
                Toast.ShowError("Cập nhật trạng thái thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi cập nhật: {ex.Message}");
        }
    }

    private async Task ApproveReturn(int id)
    {
        try
        {
            var req = new global::Shared.DTOs.Feedback.ProcessReturnRequestDto
            {
                IsApproved = true,
                Notes = "Yêu cầu hoàn trả được chấp thuận. Đã tự động hoàn trả số lượng vào kho thành công."
            };

            var res = await AdminApi.ProcessReturnRequestAsync(id, req);
            if (res.Success)
            {
                Toast.ShowSuccess($"Đã chấp thuận hoàn trả phiếu #{id} và tự động cộng lại tồn kho thành công!");
                var fb = _feedbacks.FirstOrDefault(f => f.MaPhanHoi == id);
                if (fb != null)
                {
                    fb.TrangThai = "Đã giải quyết";
                    fb.GhiChuXuLy = req.Notes;
                }
                StateHasChanged();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Xử lý chấp thuận thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi duyệt hoàn trả: {ex.Message}");
        }
    }

    private async Task RejectReturn(int id)
    {
        try
        {
            var req = new global::Shared.DTOs.Feedback.ProcessReturnRequestDto
            {
                IsApproved = false,
                Notes = "Yêu cầu hoàn trả bị từ chối do không thỏa mãn chính sách đổi trả hàng."
            };

            var res = await AdminApi.ProcessReturnRequestAsync(id, req);
            if (res.Success)
            {
                Toast.ShowWarning($"Đã từ chối hoàn trả cho phiếu #{id}.");
                var fb = _feedbacks.FirstOrDefault(f => f.MaPhanHoi == id);
                if (fb != null)
                {
                    fb.TrangThai = "Đã đóng";
                    fb.GhiChuXuLy = req.Notes;
                }
                StateHasChanged();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Xử lý từ chối thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi từ chối hoàn trả: {ex.Message}");
        }
    }

    private string GetTicketBorderClass(string status) => status switch
    {
        "Chưa xử lý" => "ticket-border-pending",
        "Đang xử lý" => "ticket-border-processing",
        "Đã giải quyết" => "ticket-border-resolved",
        _ => "ticket-border-closed"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Chưa xử lý" => "badge-status-pending",
        "Đang xử lý" => "badge-status-processing",
        "Đã giải quyết" => "badge-status-resolved",
        _ => "badge-status-closed"
    };

    private string GetTypeBadgeClass(string type) => type switch
    {
        "Yêu cầu hoàn trả hàng" => "badge-type-return",
        "Khiếu nại dịch vụ" => "badge-type-complaint",
        "Góp ý sản phẩm" => "badge-type-suggestion",
        "Báo lỗi website" => "badge-type-bug",
        "Hỗ trợ đơn hàng" => "badge-type-support",
        _ => "badge-type-other"
    };

    public void Dispose()
    {
        SignalRService.OnCustomerFeedbackReceived -= HandleFeedbackReceived;
    }
