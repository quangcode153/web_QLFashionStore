@code {
    private List<global::Shared.DTOs.Announcement.InternalAnnouncementDto> _announcements = new();
    private List<global::Shared.DTOs.Warehouse.BranchDto> _branches = new();
    private global::Shared.DTOs.Announcement.CreateAnnouncementRequestDto _model = new();
    private bool _isLoading = false;
    private bool _isSubmitting = false;
    private bool _isBranchManager = false;
    private string _branchName = "Cơ sở";
    private int _branchId = 1;

    private bool _isScopeDropdownOpen = false;
    private string _scopeSearchText = string.Empty;

    private string CurrentScopeDisplayName
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_model.PhamViGui))
            {
                return _branches.Any() ? $"Toàn hệ thống (Tất cả {_branches.Count} chi nhánh)" : "Toàn hệ thống";
            }
            return _model.PhamViGui;
        }
    }

    private void ToggleScopeDropdown() => _isScopeDropdownOpen = !_isScopeDropdownOpen;

    private void SelectScope(string scope, int? branchId)
    {
        _model.PhamViGui = scope;
        _model.MaChiNhanh = branchId;
        _isScopeDropdownOpen = false;
        _scopeSearchText = string.Empty;
    }

    private bool IsSystemScopeVisible(string scopeKey)
    {
        if (string.IsNullOrWhiteSpace(_scopeSearchText)) return true;
        var term = _scopeSearchText.Trim().ToLowerInvariant();
        return scopeKey.ToLowerInvariant().Contains(term) ||
               (scopeKey == "Toàn hệ thống" && ("toan he thong".Contains(term) || "tat ca".Contains(term))) ||
               (scopeKey == "Quản lý chi nhánh" && ("quan ly".Contains(term) || "manager".Contains(term))) ||
               (scopeKey == "Nhân viên bán hàng" && ("ban hang".Contains(term) || "pos".Contains(term) || "thu ngan".Contains(term))) ||
               (scopeKey == "Thủ kho" && ("thu kho".Contains(term) || "kho".Contains(term)));
    }

    private List<global::Shared.DTOs.Warehouse.BranchDto> DisplayedScopeBranches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_scopeSearchText))
            {
                return _branches;
            }
            var term = _scopeSearchText.Trim().ToLowerInvariant();
            return _branches.Where(b =>
                b.TenChiNhanh.ToLowerInvariant().Contains(term) ||
                (b.DiaChi != null && b.DiaChi.ToLowerInvariant().Contains(term))
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var branches = await AdminApi.GetBranchesAsync();
            if (branches != null && branches.Any())
            {
                _branches = branches;
            }
        }
        catch { }

        await LoadAnnouncements();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                if (!string.IsNullOrEmpty(role))
                {
                    if (role.Contains("Order Coordinator", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Điều phối", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Nhân viên", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Thu ngân", StringComparison.OrdinalIgnoreCase))
                    {
                        Toast.ShowWarning("Bạn không có quyền truy cập trang soạn thông báo nội bộ.");
                        Navigation.NavigateTo(role.Contains("Order Coordinator", StringComparison.OrdinalIgnoreCase) || role.Contains("Điều phối", StringComparison.OrdinalIgnoreCase) ? "/admin/orders" : 
                                              role.Contains("kho", StringComparison.OrdinalIgnoreCase) ? "/warehouse" : "/pos");
                        return;
                    }

                    if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase))
                    {
                        _isBranchManager = true;
                        var storedBranchName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
                        var storedBranchIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
                        if (!string.IsNullOrWhiteSpace(storedBranchName))
                        {
                            _branchName = storedBranchName;
                        }
                        else if (_branches.Any())
                        {
                            _branchName = _branches.First().TenChiNhanh;
                        }

                        if (int.TryParse(storedBranchIdStr, out var bid) && bid > 0)
                        {
                            _branchId = bid;
                        }
                        else if (_branches.Any())
                        {
                            _branchId = _branches.First().MaChiNhanh;
                        }

                        _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                        _model.MaChiNhanh = _branchId;
                        await LoadAnnouncements();
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private async Task LoadAnnouncements()
    {
        _isLoading = true;
        try
        {
            var data = await AdminApi.GetAnnouncementsAsync(maChiNhanh: _isBranchManager ? _branchId : null);
            _announcements = data ?? new List<global::Shared.DTOs.Announcement.InternalAnnouncementDto>();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải thông báo: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSendAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(_model.TieuDe))
        {
            Toast.ShowWarning("Vui lòng nhập tiêu đề thông báo.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.NoiDung))
        {
            Toast.ShowWarning("Vui lòng nhập nội dung thông báo.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var staffIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "staffId");
            if (int.TryParse(staffIdStr, out var id) && id > 0)
            {
                _model.MaNguoiGui = id;
            }
            else
            {
                _model.MaNguoiGui = _isBranchManager ? 2 : 1; // manager01 (2) or admin (1)
            }

            if (_isBranchManager)
            {
                _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                _model.MaChiNhanh = _branchId;
            }
            else
            {
                if (_model.PhamViGui.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase))
                {
                    var matched = _branches.FirstOrDefault(b => _model.PhamViGui.Contains(b.TenChiNhanh, StringComparison.OrdinalIgnoreCase));
                    _model.MaChiNhanh = matched?.MaChiNhanh ?? (_branches.FirstOrDefault()?.MaChiNhanh ?? 1);
                }
                else
                {
                    _model.MaChiNhanh = null;
                }
            }

            var res = await AdminApi.CreateAnnouncementAsync(_model);
            if (res.Success)
            {
                var msg = _isBranchManager 
                    ? $"Đã phát thông báo nội bộ thành công tới các nhân viên cùng chi nhánh {_branchName}!" 
                    : "Phát thông báo nội bộ thành công tới toàn thể nhân viên!";
                Toast.ShowSuccess(msg);
                _model = new();
                if (_isBranchManager)
                {
                    _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                    _model.MaChiNhanh = _branchId;
                }
                await LoadAnnouncements();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Phát thông báo thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi phát thông báo: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
