@page "/admin/announcements"
@page "/admin/thong-bao"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="announcement-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">THÔNG BÁO NỘI BỘ & ĐIỀU HÀNH</h2>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline btn-refresh" @onclick="LoadAnnouncements" disabled="@_isLoading" title="Tải lại danh sách">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isLoading ? "spin-refresh" : "")">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>@(_isLoading ? "Đang tải..." : "Làm mới dữ liệu")</span>
            </button>
        </div>
    </div>

    <!-- Form Phát Thông Báo Mới -->
    <div class="card form-card">
        <div class="card-header">
            <div class="ann-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    <line x1="9" y1="10" x2="15" y2="10"></line>
                    <line x1="12" y1="7" x2="12" y2="7.01"></line>
                </svg>
                <h3 class="card-title">SOẠN VÀ PHÁT THÔNG BÁO ĐIỀU HÀNH MỚI</h3>
            </div>
        </div>


        <div class="form-body">
            <div class="form-row form-row-2">
                <div class="form-group">
                    <label class="form-label">Tiêu đề thông báo <span class="required">*</span></label>
                    <input type="text" class="form-control" placeholder="Vd: Thông báo lịch ca trực tuần mới / Chỉ thị phục vụ quầy..." @bind="_model.TieuDe" />
                </div>

                <div class="form-row form-row-2">
                    <div class="form-group">
                        <label class="form-label">Phạm vi nhận tin <span class="required">*</span></label>
                        @if (_isBranchManager)
                        {
                            <div class="scope-locked-field">
                                <span class="scope-icon">📍</span>
                                <span>Nội bộ chi nhánh (@_branchName)</span>
                            </div>
                        }
                        else
                        {
                            <div class="scope-searchable-combobox">
                                <button type="button" class="scope-combobox-trigger" @onclick="ToggleScopeDropdown">
                                    <span class="scope-icon">📍</span>
                                    <span class="scope-current-name">@CurrentScopeDisplayName</span>
                                    <span class="scope-arrow">@(_isScopeDropdownOpen ? "▲" : "▼")</span>
                                </button>

                                @if (_isScopeDropdownOpen)
                                {
                                    <div class="scope-combobox-popover">
                                        <div class="scope-search-box">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" class="scope-search-input" placeholder="Tìm nhanh tên chi nhánh, địa chỉ..."
                                                   @bind="_scopeSearchText" @bind:event="oninput" autofocus />
                                            @if (!string.IsNullOrWhiteSpace(_scopeSearchText))
                                            {
                                                <button type="button" class="scope-clear-btn" @onclick="() => _scopeSearchText = string.Empty">×</button>
                                            }
                                        </div>

                                        <div class="scope-combobox-list">
                                            <!-- Mục Hệ thống chung (nếu khớp tìm kiếm) -->
                                            @if (IsSystemScopeVisible("Toàn hệ thống"))
                                            {
                                                <div class="scope-combobox-item @(_model.PhamViGui == "Toàn hệ thống" ? "active" : "")" 
                                                     @onclick='() => SelectScope("Toàn hệ thống", null)'>
                                                    <div class="scope-item-info">
                                                        <span class="scope-item-title">Toàn hệ thống</span>
                                                        <span class="scope-item-subtitle">Phát thông báo tới toàn bộ @_branches.Count chi nhánh chuỗi</span>
                                                    </div>
                                                    <span class="scope-item-badge badge-all">Toàn chuỗi</span>
                                                </div>
                                            }

                                            @if (IsSystemScopeVisible("Quản lý chi nhánh"))
                                            {
                                                <div class="scope-combobox-item @(_model.PhamViGui == "Quản lý chi nhánh" ? "active" : "")" 
                                                     @onclick='() => SelectScope("Quản lý chi nhánh", null)'>
                                                    <div class="scope-item-info">
                                                        <span class="scope-item-title">Các Quản lý chi nhánh</span>
                                                        <span class="scope-item-subtitle">Chỉ gửi cho cấp Quản lý cửa hàng</span>
                                                    </div>
                                                    <span class="scope-item-badge badge-role">Quản lý</span>
                                                </div>
                                            }

                                            @if (IsSystemScopeVisible("Nhân viên bán hàng"))
                                            {
                                                <div class="scope-combobox-item @(_model.PhamViGui == "Nhân viên bán hàng" ? "active" : "")" 
                                                     @onclick='() => SelectScope("Nhân viên bán hàng", null)'>
                                                    <div class="scope-item-info">
                                                        <span class="scope-item-title">Nhân viên bán hàng (POS)</span>
                                                        <span class="scope-item-subtitle">Chỉ gửi cho Thu ngân & Nhân viên quầy</span>
                                                    </div>
                                                    <span class="scope-item-badge badge-role">Bán hàng</span>
                                                </div>
                                            }

                                            @if (IsSystemScopeVisible("Thủ kho"))
                                            {
                                                <div class="scope-combobox-item @(_model.PhamViGui == "Thủ kho" ? "active" : "")" 
                                                     @onclick='() => SelectScope("Thủ kho", null)'>
                                                    <div class="scope-item-info">
                                                        <span class="scope-item-title">Thủ kho & Nhân viên kho</span>
                                                        <span class="scope-item-subtitle">Chỉ gửi cho bộ phận kho bãi</span>
                                                    </div>
                                                    <span class="scope-item-badge badge-role">Kho</span>
                                                </div>
                                            }

                                            <!-- Divider -->
                                            <div class="scope-list-divider">CHI NHÁNH CỤ THỂ (@DisplayedScopeBranches.Count)</div>

                                            @if (!DisplayedScopeBranches.Any())
                                            {
                                                <div class="scope-empty-item">Không tìm thấy chi nhánh phù hợp với "@_scopeSearchText"</div>
                                            }
                                            else
                                            {
                                                @foreach (var b in DisplayedScopeBranches)
                                                {
                                                    var scopeName = $"Nội bộ chi nhánh ({b.TenChiNhanh})";
                                                    var isSelected = _model.PhamViGui == scopeName || _model.MaChiNhanh == b.MaChiNhanh;
                                                    <div class="scope-combobox-item @(isSelected ? "active" : "")" 
                                                         data-branch-id="@b.MaChiNhanh"
                                                         @onclick="() => SelectScope(scopeName, b.MaChiNhanh)">
                                                        <div class="scope-item-info">
                                                            <span class="scope-item-title">@b.TenChiNhanh</span>
                                                            <span class="scope-item-subtitle">@b.DiaChi</span>
                                                        </div>
                                                        @if (b.IsOnlineWarehouse)
                                                        {
                                                            <span class="scope-item-badge badge-online">Kho Online</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="scope-item-badge badge-branch">Chi nhánh</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mức độ ưu tiên <span class="required">*</span></label>
                        <select class="form-control" @bind="_model.MucDoUuTien">
                            <option value="Bình thường">Bình thường (Tin tức chung)</option>
                            <option value="Quan trọng">Quan trọng (Lưu ý ca trực)</option>
                            <option value="Khẩn cấp">Khẩn cấp (Hành động ngay)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Nội dung chi tiết thông báo <span class="required">*</span></label>
                <textarea class="form-control form-textarea" rows="3" placeholder="Nhập đầy đủ nội dung thông báo, hướng dẫn nghiệp vụ hoặc chính sách áp dụng..." @bind="_model.NoiDung"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-submit" @onclick="HandleSendAnnouncement" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="btn-spinner"></span>
                        <span>ĐANG PHÁT TIN...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        <span>PHÁT THÔNG BÁO TỚI NHÂN VIÊN</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Danh Sách Thông Báo Đã Phát -->
    <div class="card list-card">
        <div class="card-header">
            <h3 class="card-title">LỊCH SỬ CÁC THÔNG BÁO NỘI BỘ ĐÃ PHÁT</h3>
            <span class="badge-count">@_announcements.Count thông báo</span>
        </div>

        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Đang tải danh sách thông báo...</p>
            </div>
        }
        else if (!_announcements.Any())
        {
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <p>Chưa có thông báo nội bộ nào được phát</p>
            </div>
        }
        else
        {
            <div class="announcement-list">
                @foreach (var item in _announcements)
                {
                    <div class="announcement-item priority-@item.MucDoUuTien.ToLower()">
                        <div class="announcement-top">
                            <div class="badges-row">
                                <span class="badge-priority priority-@item.MucDoUuTien.ToLower()">
                                    @item.MucDoUuTien
                                </span>
                                <span class="badge-scope">
                                    @item.PhamViGui
                                </span>
                            </div>
                            <div class="announcement-meta font-mono text-muted">
                                @item.NgayTao.ToString("HH:mm - dd/MM/yyyy")
                            </div>
                        </div>

                        <h4 class="announcement-title">@item.TieuDe</h4>
                        <div class="announcement-content">@item.NoiDung</div>

                        <div class="announcement-footer">
                            <span class="sender-tag">
                                Người phát: <strong>@item.TenNguoiGui</strong> (@(item.ChucVuNguoiGui ?? "Quản lý"))
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .announcement-container {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .page-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0.25rem 0 0 0;
    }

    .btn-refresh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        transition: all 0.15s ease;
    }

    .btn-refresh:hover:not(:disabled) {
        background: #f1f5f9;
        border-color: #94a3b8;
    }

    .card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
    }

    .card-header {
        padding: 12px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ann-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-title {
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #0f172a;
        margin: 0;
    }

    .header-note {
        font-size: 0.72rem;
        color: #64748b;
    }

    .badge-count {
        font-size: 0.72rem;
        font-weight: 700;
        color: #2563eb;
        background: #eff6ff;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .form-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-row {
        display: grid;
        gap: 12px;
    }

    .form-row-2 {
        grid-template-columns: 1fr 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .form-label {
        font-size: 0.76rem;
        font-weight: 700;
        color: #334155;
    }

    .required { color: #ef4444; }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.82rem;
        color: #0f172a;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .form-control:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.1);
    }

    .form-textarea {
        resize: vertical;
        line-height: 1.4;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 4px;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .btn-submit:hover:not(:disabled) {
        background: #1e293b;
    }

    .btn-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* List styling */
    .announcement-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
    }

    .announcement-item {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: #ffffff;
        border-left: 4px solid #cbd5e1;
        transition: all 0.15s ease;
    }

    .announcement-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .announcement-item.priority-quan_trọng,
    .announcement-item.priority-quan trọng {
        border-left-color: #f59e0b;
    }

    .announcement-item.priority-khẩn_cấp,
    .announcement-item.priority-khẩn cấp {
        border-left-color: #ef4444;
        background: #fffafa;
    }

    .announcement-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .badges-row {
        display: flex;
        gap: 6px;
    }

    .badge-priority {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        background: #f1f5f9;
        color: #475569;
    }

    .badge-priority.priority-quan_trọng,
    .badge-priority.priority-quan trọng {
        background: #fef3c7;
        color: #b45309;
    }

    .badge-priority.priority-khẩn_cấp,
    .badge-priority.priority-khẩn cấp {
        background: #fee2e2;
        color: #dc2626;
    }

    .badge-scope {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .announcement-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .announcement-content {
        font-size: 0.82rem;
        color: #334155;
        line-height: 1.45;
        white-space: pre-line;
    }

    .announcement-footer {
        border-top: 1px solid #f1f5f9;
        padding-top: 6px;
        font-size: 0.72rem;
        color: #64748b;
    }

    .font-mono { font-family: var(--font-mono, monospace); }
    .text-muted { color: #94a3b8; }

    .loading-state, .empty-state {
        padding: 40px 16px;
        text-align: center;
        color: #64748b;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid #e2e8f0;
        border-top-color: #0f172a;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .branch-scope-banner {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        background: #eff6ff;
        border-bottom: 1px solid #bfdbfe;
        color: #1e40af;
    }

    .scope-icon {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .scope-title {
        font-size: 0.82rem;
        font-weight: 800;
        color: #1e3a8a;
        margin-bottom: 2px;
    }

    .scope-desc {
        font-size: 0.75rem;
        line-height: 1.4;
        color: #3b82f6;
    }

    .select-locked {
        background: #f1f5f9;
        cursor: not-allowed;
        color: #475569;
        font-weight: 600;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .announcement-container {
            gap: 12px;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .btn-refresh {
            width: 100%;
            justify-content: center;
        }

        .form-row.form-row-2, .form-row-2 {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
        }

        .announcement-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }
    }

    /* SEARCHABLE SCOPE COMBOBOX */
    .scope-searchable-combobox {
        position: relative;
        width: 100%;
    }

    .scope-locked-field {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #475569;
        font-weight: 500;
    }

    .scope-combobox-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        padding: 8px 12px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #0f172a;
        cursor: pointer;
        text-align: left;
        transition: all 0.15s ease;
    }

    .scope-combobox-trigger:hover {
        border-color: #0f172a;
    }

    .scope-icon {
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .scope-current-name {
        flex: 1;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .scope-arrow {
        font-size: 0.7rem;
        color: #64748b;
        flex-shrink: 0;
    }

    .scope-combobox-popover {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        right: 0;
        min-width: 320px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
        z-index: 1000;
        overflow: hidden;
    }

    .scope-search-box {
        position: relative;
        display: flex;
        align-items: center;
        padding: 8px 12px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .scope-search-box svg {
        position: absolute;
        left: 14px;
        pointer-events: none;
    }

    .scope-search-input {
        width: 100%;
        padding: 6px 28px 6px 28px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.82rem;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .scope-search-input:focus {
        border-color: #0f172a;
    }

    .scope-clear-btn {
        position: absolute;
        right: 18px;
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 1rem;
        cursor: pointer;
    }

    .scope-combobox-list {
        max-height: 270px;
