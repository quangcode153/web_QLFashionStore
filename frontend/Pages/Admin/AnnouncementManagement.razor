@page "/admin/announcements"
@page "/admin/thong-bao"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="announcement-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">THÔNG BÁO NỘI BỘ & ĐIỀU HÀNH</h2>
            <p class="page-subtitle">Soạn và phát tin tức điều hành từ Quản trị viên đến toàn thể nhân viên chi nhánh</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline btn-refresh" @onclick="LoadAnnouncements" disabled="@_isLoading" title="Tải lại danh sách">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isLoading ? "spin-refresh" : "")">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>@(_isLoading ? "Đang tải..." : "Làm mới dữ liệu")</span>
            </button>
        </div>
    </div>

    <!-- Form Phát Thông Báo Mới -->
    <div class="card form-card">
        <div class="card-header">
            <div class="ann-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    <line x1="9" y1="10" x2="15" y2="10"></line>
                    <line x1="12" y1="7" x2="12" y2="7.01"></line>
                </svg>
                <h3 class="card-title">SOẠN VÀ PHÁT THÔNG BÁO ĐIỀU HÀNH MỚI</h3>
            </div>
            <span class="header-note">Tự động truyền tin tức thời qua SignalR tới màn hình nhân viên</span>
        </div>

        @if (_isBranchManager)
        {
            <div class="branch-scope-banner">
                <div class="scope-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <div class="scope-text">
                    <div class="scope-title">Giới hạn quyền phát thông báo: Cửa hàng trưởng (@_branchName)</div>
                    <div class="scope-desc">Theo quy định phân quyền, Quản lý chi nhánh chỉ có quyền phát thông báo tới các nhân viên trực thuộc cùng chi nhánh @_branchName. Quyền phát toàn hệ thống thuộc về Quản lý chuỗi (Admin).</div>
                </div>
            </div>
        }

        <div class="form-body">
            <div class="form-row form-row-2">
                <div class="form-group">
                    <label class="form-label">Tiêu đề thông báo <span class="required">*</span></label>
                    <input type="text" class="form-control" placeholder="Vd: Thông báo lịch ca trực tuần mới / Chỉ thị phục vụ quầy..." @bind="_model.TieuDe" />
                </div>

                <div class="form-row form-row-2">
                    <div class="form-group">
                        <label class="form-label">Phạm vi nhận tin <span class="required">*</span></label>
                        @if (_isBranchManager)
                        {
                            <select class="form-control select-locked" @bind="_model.PhamViGui" disabled title="Quản lý chi nhánh chỉ được phát thông báo cho chi nhánh của mình">
                                <option value="@($"Nội bộ chi nhánh ({_branchName})")">Nội bộ chi nhánh (@_branchName)</option>
                            </select>
                        }
                        else
                        {
                            <select class="form-control" @bind="_model.PhamViGui">
                                <option value="Toàn hệ thống">Toàn hệ thống (@(_branches.Any() ? $"Tất cả {_branches.Count} chi nhánh" : "Tất cả chi nhánh"))</option>
                                @foreach (var b in _branches)
                                {
                                    <option value="@($"Nội bộ chi nhánh ({b.TenChiNhanh})")">Nội bộ chi nhánh (@b.TenChiNhanh)</option>
                                }
                                <option value="Quản lý chi nhánh">Các Quản lý chi nhánh</option>
                                <option value="Nhân viên bán hàng">Nhân viên bán hàng (POS)</option>
                                <option value="Thủ kho">Thủ kho & Nhân viên kho</option>
                            </select>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mức độ ưu tiên <span class="required">*</span></label>
                        <select class="form-control" @bind="_model.MucDoUuTien">
                            <option value="Bình thường">Bình thường (Tin tức chung)</option>
                            <option value="Quan trọng">Quan trọng (Lưu ý ca trực)</option>
                            <option value="Khẩn cấp">Khẩn cấp (Hành động ngay)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Nội dung chi tiết thông báo <span class="required">*</span></label>
                <textarea class="form-control form-textarea" rows="3" placeholder="Nhập đầy đủ nội dung thông báo, hướng dẫn nghiệp vụ hoặc chính sách áp dụng..." @bind="_model.NoiDung"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-submit" @onclick="HandleSendAnnouncement" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="btn-spinner"></span>
                        <span>ĐANG PHÁT TIN...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                        <span>PHÁT THÔNG BÁO TỚI NHÂN VIÊN</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Danh Sách Thông Báo Đã Phát -->
    <div class="card list-card">
        <div class="card-header">
            <h3 class="card-title">LỊCH SỬ CÁC THÔNG BÁO NỘI BỘ ĐÃ PHÁT</h3>
            <span class="badge-count">@_announcements.Count thông báo</span>
        </div>

        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Đang tải danh sách thông báo...</p>
            </div>
        }
        else if (!_announcements.Any())
        {
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <p>Chưa có thông báo nội bộ nào được phát</p>
            </div>
        }
        else
        {
            <div class="announcement-list">
                @foreach (var item in _announcements)
                {
                    <div class="announcement-item priority-@item.MucDoUuTien.ToLower()">
                        <div class="announcement-top">
                            <div class="badges-row">
                                <span class="badge-priority priority-@item.MucDoUuTien.ToLower()">
                                    @item.MucDoUuTien
                                </span>
                                <span class="badge-scope">
                                    @item.PhamViGui
                                </span>
                            </div>
                            <div class="announcement-meta font-mono text-muted">
                                @item.NgayTao.ToString("HH:mm - dd/MM/yyyy")
                            </div>
                        </div>

                        <h4 class="announcement-title">@item.TieuDe</h4>
                        <div class="announcement-content">@item.NoiDung</div>

                        <div class="announcement-footer">
                            <span class="sender-tag">
                                Người phát: <strong>@item.TenNguoiGui</strong> (@(item.ChucVuNguoiGui ?? "Quản lý"))
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .announcement-container {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .page-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0.25rem 0 0 0;
    }

    .btn-refresh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        transition: all 0.15s ease;
    }

    .btn-refresh:hover:not(:disabled) {
        background: #f1f5f9;
        border-color: #94a3b8;
    }

    .card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
    }

    .card-header {
        padding: 12px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ann-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-title {
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #0f172a;
        margin: 0;
    }

    .header-note {
        font-size: 0.72rem;
        color: #64748b;
    }

    .badge-count {
        font-size: 0.72rem;
        font-weight: 700;
        color: #2563eb;
        background: #eff6ff;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .form-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-row {
        display: grid;
        gap: 12px;
    }

    .form-row-2 {
        grid-template-columns: 1fr 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .form-label {
        font-size: 0.76rem;
        font-weight: 700;
        color: #334155;
    }

    .required { color: #ef4444; }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.82rem;
        color: #0f172a;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .form-control:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.1);
    }

    .form-textarea {
        resize: vertical;
        line-height: 1.4;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 4px;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .btn-submit:hover:not(:disabled) {
        background: #1e293b;
    }

    .btn-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* List styling */
    .announcement-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
    }

    .announcement-item {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: #ffffff;
        border-left: 4px solid #cbd5e1;
        transition: all 0.15s ease;
    }

    .announcement-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .announcement-item.priority-quan_trọng,
    .announcement-item.priority-quan trọng {
        border-left-color: #f59e0b;
    }

    .announcement-item.priority-khẩn_cấp,
    .announcement-item.priority-khẩn cấp {
        border-left-color: #ef4444;
        background: #fffafa;
    }

    .announcement-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .badges-row {
        display: flex;
        gap: 6px;
    }

    .badge-priority {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        background: #f1f5f9;
        color: #475569;
    }

    .badge-priority.priority-quan_trọng,
    .badge-priority.priority-quan trọng {
        background: #fef3c7;
        color: #b45309;
    }

    .badge-priority.priority-khẩn_cấp,
    .badge-priority.priority-khẩn cấp {
        background: #fee2e2;
        color: #dc2626;
    }

    .badge-scope {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .announcement-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .announcement-content {
        font-size: 0.82rem;
        color: #334155;
        line-height: 1.45;
        white-space: pre-line;
    }

    .announcement-footer {
        border-top: 1px solid #f1f5f9;
        padding-top: 6px;
        font-size: 0.72rem;
        color: #64748b;
    }

    .font-mono { font-family: var(--font-mono, monospace); }
    .text-muted { color: #94a3b8; }

    .loading-state, .empty-state {
        padding: 40px 16px;
        text-align: center;
        color: #64748b;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid #e2e8f0;
        border-top-color: #0f172a;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .branch-scope-banner {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        background: #eff6ff;
        border-bottom: 1px solid #bfdbfe;
        color: #1e40af;
    }

    .scope-icon {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .scope-title {
        font-size: 0.82rem;
        font-weight: 800;
        color: #1e3a8a;
        margin-bottom: 2px;
    }

    .scope-desc {
        font-size: 0.75rem;
        line-height: 1.4;
        color: #3b82f6;
    }

    .select-locked {
        background: #f1f5f9;
        cursor: not-allowed;
        color: #475569;
        font-weight: 600;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<global::Shared.DTOs.Announcement.InternalAnnouncementDto> _announcements = new();
    private List<global::Shared.DTOs.Warehouse.BranchDto> _branches = new();
    private global::Shared.DTOs.Announcement.CreateAnnouncementRequestDto _model = new();
    private bool _isLoading = false;
    private bool _isSubmitting = false;
    private bool _isBranchManager = false;
    private string _branchName = "Cơ sở";
    private int _branchId = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var branches = await AdminApi.GetBranchesAsync();
            if (branches != null && branches.Any())
            {
                _branches = branches;
            }
        }
        catch { }

        await LoadAnnouncements();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                if (!string.IsNullOrEmpty(role))
                {
                    if (role.Contains("Order Coordinator", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Điều phối", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Nhân viên", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("Thu ngân", StringComparison.OrdinalIgnoreCase))
                    {
                        Toast.ShowWarning("Bạn không có quyền truy cập trang soạn thông báo nội bộ.");
                        Navigation.NavigateTo(role.Contains("Order Coordinator", StringComparison.OrdinalIgnoreCase) || role.Contains("Điều phối", StringComparison.OrdinalIgnoreCase) ? "/admin/orders" : 
                                              role.Contains("kho", StringComparison.OrdinalIgnoreCase) ? "/warehouse" : "/pos");
                        return;
                    }

                    if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase))
                    {
                        _isBranchManager = true;
                        var storedBranchName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
                        var storedBranchIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "branchId");
                        if (!string.IsNullOrWhiteSpace(storedBranchName))
                        {
                            _branchName = storedBranchName;
                        }
                        else if (_branches.Any())
                        {
                            _branchName = _branches.First().TenChiNhanh;
                        }

                        if (int.TryParse(storedBranchIdStr, out var bid) && bid > 0)
                        {
                            _branchId = bid;
                        }
                        else if (_branches.Any())
                        {
                            _branchId = _branches.First().MaChiNhanh;
                        }

                        _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                        _model.MaChiNhanh = _branchId;
                        await LoadAnnouncements();
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    private async Task LoadAnnouncements()
    {
        _isLoading = true;
        try
        {
            var data = await AdminApi.GetAnnouncementsAsync(maChiNhanh: _isBranchManager ? _branchId : null);
            _announcements = data ?? new List<global::Shared.DTOs.Announcement.InternalAnnouncementDto>();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải thông báo: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSendAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(_model.TieuDe))
        {
            Toast.ShowWarning("Vui lòng nhập tiêu đề thông báo.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.NoiDung))
        {
            Toast.ShowWarning("Vui lòng nhập nội dung thông báo.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var staffIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", "staffId");
            if (int.TryParse(staffIdStr, out var id) && id > 0)
            {
                _model.MaNguoiGui = id;
            }
            else
            {
                _model.MaNguoiGui = _isBranchManager ? 2 : 1; // manager01 (2) or admin (1)
            }

            if (_isBranchManager)
            {
                _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                _model.MaChiNhanh = _branchId;
            }
            else
            {
                if (_model.PhamViGui.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase))
                {
                    var matched = _branches.FirstOrDefault(b => _model.PhamViGui.Contains(b.TenChiNhanh, StringComparison.OrdinalIgnoreCase));
                    _model.MaChiNhanh = matched?.MaChiNhanh ?? (_branches.FirstOrDefault()?.MaChiNhanh ?? 1);
                }
                else
                {
                    _model.MaChiNhanh = null;
                }
            }

            var res = await AdminApi.CreateAnnouncementAsync(_model);
            if (res.Success)
            {
                var msg = _isBranchManager 
                    ? $"Đã phát thông báo nội bộ thành công tới các nhân viên cùng chi nhánh {_branchName}!" 
                    : "Phát thông báo nội bộ thành công tới toàn thể nhân viên!";
                Toast.ShowSuccess(msg);
                _model = new();
                if (_isBranchManager)
                {
                    _model.PhamViGui = $"Nội bộ chi nhánh ({_branchName})";
                    _model.MaChiNhanh = _branchId;
                }
                await LoadAnnouncements();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Phát thông báo thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi phát thông báo: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
