        try
        {
            // Backend sp_BaoCaoDoanhThuTheoKhoangThoiGian hỗ trợ fromDate = toDate
            _singleDateReport = await AdminApi.GetFinancialReportAsync(_singleDate, _singleDate);
            if (_singleDateReport != null && (_singleDateReport.TongSoDonHoanThanh > 0 || _singleDateReport.TongDoanhThuThuc > 0))
            {
                Toast.ShowSuccess($"Đã tải dữ liệu ngày {_singleDate:dd/MM/yyyy}!");
