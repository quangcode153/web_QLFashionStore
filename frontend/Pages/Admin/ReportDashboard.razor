@code {
    private List<DailyRevenueReportDto> _dailyRevenues = new();
    private List<TopSellingProductDto> _topSelling = new();
    private List<BranchSalesLeaderboardDto> _branchLeaderboard = new();
    private List<BranchInventorySummaryDto> _branchInventorySummaries = new();
    private FinancialRangeReportDto? _financialReport;
    private bool _isLoading = false;

    // Khoảng ngày
    private DateTime _fromDate = DateTime.Today.AddDays(-30);
    private DateTime _toDate = DateTime.Today;

    // ==========================================
    // CHẾ ĐỘ & DỮ LIỆU BIỂU ĐỒ DOANH THU KẾT HỢP
    // ==========================================
    private string _chartMode = "daily"; // "daily", "weekly", "monthly"
    private int _chartDaysRange = 14;    // 7, 14, 30 ngày (cho daily, 0 là tất cả)
    private int? _hoveredChartIndex = null;

    // ==========================================
    // MODAL CHI TIẾT ĐƠN HÀNG & HỦY/HOÀN THEO NGÀY
    // ==========================================
    private DateTime? _selectedDateDetail = null;
    private List<OrderSummaryDto> _allOrdersCache = new();
    private List<OrderSummaryDto> _modalOrders = new();
    private string _modalFilter = "ALL"; // "ALL", "COMPLETED", "REFUND_CANCEL"
    private bool _isLoadingDateOrders = false;

    private async Task OpenDateDetailModal(DateTime date)
    {
        _selectedDateDetail = date.Date;
        _modalFilter = "ALL";
        _isLoadingDateOrders = true;
        StateHasChanged();
        try
        {
            if (_allOrdersCache.Count == 0)
            {
                _allOrdersCache = await AdminApi.GetAllOrdersAsync() ?? new();
            }
            _modalOrders = _allOrdersCache.Where(o => o.NgayLapHoaDon.Date == date.Date).ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải danh sách đơn ngày: {ex.Message}");
        }
        finally
        {
            _isLoadingDateOrders = false;
            StateHasChanged();
        }
    }

    private void CloseDateDetailModal()
    {
        _selectedDateDetail = null;
        _modalOrders.Clear();
        StateHasChanged();
    }

    private List<OrderSummaryDto> FilteredModalOrders => _modalFilter switch
    {
        "COMPLETED" => _modalOrders.Where(o => o.TrangThai == "Đã hoàn thành").ToList(),
        "REFUND_CANCEL" => _modalOrders.Where(o => o.TrangThai == "Đã hủy" || o.CoHoanTra || o.SoTienDaHoan > 0).ToList(),
        _ => _modalOrders
    };

    private class ChartDataPoint
    {
        public DateTime Date { get; set; }
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string FullTitle { get; set; } = string.Empty;
        public decimal Revenue { get; set; }        // Doanh thu thuần thực tế (Net)
        public decimal TotalRefund { get; set; }     // Tiền hoàn trả đã khấu trừ
        public decimal GrossRevenue => Revenue + TotalRefund; // Doanh thu gộp trước hoàn
        public int OrderCount { get; set; }          // Tổng đơn phát sinh ban đầu
        public int RefundCount { get; set; }         // Số đơn có hoàn hàng
        public int NetOrderCount => Math.Max(0, OrderCount - RefundCount); // Số đơn hoàn tất thực tế
        public decimal TotalGoods { get; set; }
        public decimal TotalDiscount { get; set; }
    }

    private List<ChartDataPoint> ChartPoints
    {
        get
        {
            if (_dailyRevenues.Count == 0) return new();

            if (_chartMode == "weekly")
            {
                var cal = System.Globalization.CultureInfo.CurrentCulture.Calendar;
                return _dailyRevenues
                    .OrderBy(x => x.NgayBan)
                    .GroupBy(x => {
                        var week = cal.GetWeekOfYear(x.NgayBan, System.Globalization.CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
                        return $"{x.NgayBan.Year}-W{week:D2}";
                    })
                    .Select(g => {
                        var first = g.Min(x => x.NgayBan);
                        var last = g.Max(x => x.NgayBan);
                        var weekNum = g.Key.Split("-W")[1];
                        return new ChartDataPoint
                        {
                            Date = first,
                            Key = g.Key,
                            Label = $"T{weekNum}",
                            FullTitle = $"Tuần {weekNum} ({first:dd/MM} - {last:dd/MM/yyyy})",
                            Revenue = g.Sum(x => x.DoanhThuThucTe),
                            TotalRefund = g.Sum(x => x.TongTienHoan),
                            OrderCount = g.Sum(x => x.TongSoDon),
                            RefundCount = g.Sum(x => x.SoDonHoan),
                            TotalGoods = g.Sum(x => x.TongTienHang),
                            TotalDiscount = g.Sum(x => x.TongTienGiam)
                        };
                    })
                    .TakeLast(12)
                    .ToList();
            }
            else if (_chartMode == "monthly")
            {
                return _dailyRevenues
                    .OrderBy(x => x.NgayBan)
                    .GroupBy(x => x.NgayBan.ToString("MM/yyyy"))
                    .Select(g => new ChartDataPoint
                    {
                        Date = g.First().NgayBan,
                        Key = g.Key,
                        Label = g.Key,
                        FullTitle = $"Tháng {g.Key}",
                        Revenue = g.Sum(x => x.DoanhThuThucTe),
                        TotalRefund = g.Sum(x => x.TongTienHoan),
                        OrderCount = g.Sum(x => x.TongSoDon),
                        RefundCount = g.Sum(x => x.SoDonHoan),
                        TotalGoods = g.Sum(x => x.TongTienHang),
                        TotalDiscount = g.Sum(x => x.TongTienGiam)
                    })
                    .TakeLast(12)
                    .ToList();
            }
            else // daily (chỉ lấy 7 hoặc 14 ngày gần nhất để đảm bảo độ rộng cột và thẩm mỹ)
            {
                var days = _chartDaysRange == 7 ? 7 : 14;
                var query = _dailyRevenues.OrderBy(x => x.NgayBan).TakeLast(days);
                return query.Select(x => new ChartDataPoint
                {
                    Date = x.NgayBan,
                    Key = x.NgayBan.ToString("yyyy-MM-dd"),
                    Label = x.NgayBan.ToString("dd/MM"),
                    FullTitle = $"{GetVietnameseDayOfWeek(x.NgayBan.DayOfWeek)}, {x.NgayBan:dd/MM/yyyy}",
                    Revenue = x.DoanhThuThucTe,
                    TotalRefund = x.TongTienHoan,
                    OrderCount = x.TongSoDon,
                    RefundCount = x.SoDonHoan,
                    TotalGoods = x.TongTienHang,
                    TotalDiscount = x.TongTienGiam
                }).ToList();
            }
        }
    }

    private decimal ChartTotalRevenue => ChartPoints.Sum(p => p.Revenue);
    private decimal ChartTotalRefund => ChartPoints.Sum(p => p.TotalRefund);
    private int ChartTotalOrders => ChartPoints.Sum(p => p.OrderCount);
    private int ChartNetOrders => ChartPoints.Sum(p => p.NetOrderCount);
    private int ChartRefundOrders => ChartPoints.Sum(p => p.RefundCount);
    private decimal ChartAvgOrderValue => ChartNetOrders > 0 ? ChartTotalRevenue / ChartNetOrders : (ChartTotalOrders > 0 ? ChartTotalRevenue / ChartTotalOrders : 0);
    private ChartDataPoint? ChartPeakPoint => ChartPoints.OrderByDescending(p => p.Revenue).FirstOrDefault();

    private void SetChartMode(string mode)
    {
        _chartMode = mode;
        _hoveredChartIndex = null;
    }

    private void SetChartDaysRange(int days)
    {
        _chartDaysRange = days == 7 ? 7 : 14;
        _hoveredChartIndex = null;
    }

    private static string FormatCompactCurrency(decimal val)
    {
        if (val >= 1_000_000_000m)
            return $"{(val / 1_000_000_000m):0.#} tỷ";
        if (val >= 1_000_000m)
            return $"{(val / 1_000_000m):0.#} tr";
        if (val >= 1_000m)
            return $"{(val / 1_000m):0.#} k";
        return val.ToString("N0");
    }

    // Tra cứu 1 ngày cụ thể
    private DateTime _singleDate = DateTime.Today;
    private FinancialRangeReportDto? _singleDateReport;
    private bool _isSearchingSingle = false;
    private bool _singleDateSearched = false;

    // Gom gọn & Lọc bảng Doanh thu theo ngày
    private int _daysLimit = 7; // Mặc định chỉ hiện 7 ngày gần nhất
    private string _dailySearchText = string.Empty;

    private decimal LatestRevenue => _dailyRevenues.OrderBy(x => x.NgayBan).LastOrDefault()?.DoanhThuThucTe ?? 0;
    private int LatestOrderCount => _dailyRevenues.OrderBy(x => x.NgayBan).LastOrDefault()?.TongSoDon ?? 0;
    private decimal TotalPeriodRevenue => _dailyRevenues.Sum(x => x.DoanhThuThucTe);
    private decimal TotalPeriodDiscount => _dailyRevenues.Sum(x => x.TongTienGiam);

    /// <summary>
    /// Danh sách ngày đã gom gọn: sắp xếp ngày gần nhất lên trên cùng, giới hạn số ngày, và lọc theo text tìm kiếm
    /// </summary>
    private List<DailyRevenueReportDto> DisplayedDailyRevenues
    {
        get
        {
            var query = _dailyRevenues.OrderByDescending(x => x.NgayBan).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_dailySearchText))
            {
                var term = _dailySearchText.Trim().ToLowerInvariant();
                query = query.Where(x => 
                    x.NgayBan.ToString("dd/MM/yyyy").Contains(term) ||
                    x.NgayBan.ToString("yyyy-MM-dd").Contains(term) ||
                    GetVietnameseDayOfWeek(x.NgayBan.DayOfWeek).ToLowerInvariant().Contains(term));
            }
            else if (_daysLimit > 0)
            {
                query = query.Take(_daysLimit);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                if (!string.IsNullOrEmpty(role))
                {
                    if (role.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("warehouse", StringComparison.OrdinalIgnoreCase))
                    {
                        Toast.ShowWarning("Tài khoản Thủ kho không có quyền truy cập Quản trị chuỗi. Đang chuyển về module Kho.");
                        Navigation.NavigateTo("/warehouse");
                        return;
                    }
                    else if (role.Contains("ThuNgan", StringComparison.OrdinalIgnoreCase) ||
                             role.Contains("bán hàng", StringComparison.OrdinalIgnoreCase))
                    {
                        Toast.ShowWarning("Tài khoản Thu ngân không có quyền truy cập Quản trị chuỗi. Đang chuyển về quầy POS.");
                        Navigation.NavigateTo("/pos");
                        return;
                    }
                }
            }
            catch { }
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var revTask = AdminApi.GetDailyRevenueAsync();
            var topTask = AdminApi.GetTopSellingProductsAsync(20);
            var boardTask = AdminApi.GetBranchSalesLeaderboardAsync();
            var invTask = AdminApi.GetBranchInventorySummaryAsync();
            var ordersTask = AdminApi.GetAllOrdersAsync();

            await Task.WhenAll(revTask, topTask, boardTask, invTask, ordersTask);

            _dailyRevenues = await revTask ?? new();
            _topSelling = await topTask ?? new();
            _branchLeaderboard = await boardTask ?? new();
            _branchInventorySummaries = await invTask ?? new();
            _allOrdersCache = await ordersTask ?? new();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tải báo cáo: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        Toast.ShowSuccess("Dữ liệu báo cáo đã được làm mới!");
    }

    private void SetDaysLimit(int limit)
    {
        _daysLimit = limit;
    }

    private async Task SetSingleDate(DateTime date)
