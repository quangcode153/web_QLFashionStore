        cursor: pointer;
    }

    .chart-bar-refund {
        transition: fill 0.2s ease, opacity 0.2s ease;
        cursor: pointer;
    }

    .chart-bar.hovered {
        filter: drop-shadow(0 4px 6px rgba(37, 99, 235, 0.35));
        opacity: 1;
    }

    .chart-node {
        cursor: pointer;
        transition: r 0.15s ease, stroke-width 0.15s ease;
    }

    .chart-node.hovered {
        filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.7));
