@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject IAdminApiClient AdminApi
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="report-dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">BÁO CÁO & TỔNG QUAN</h2>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-outline btn-refresh" @onclick="RefreshData" disabled="@_isLoading" title="Tải lại số liệu báo cáo mới nhất">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(_isLoading ? "spin-refresh" : "")">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>@(_isLoading ? "Đang đồng bộ..." : "Làm mới dữ liệu")</span>
            </button>
        </div>
    </div>

    <!-- KPIs Summary Cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Doanh thu ngày gần nhất</div>
            <div class="kpi-value">@(LatestRevenue.ToString("N0")) đ</div>
            <div class="kpi-sub">Tổng số đơn: @LatestOrderCount</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Tổng doanh thu kỳ</div>
            <div class="kpi-value text-success">@(TotalPeriodRevenue.ToString("N0")) đ</div>
            <div class="kpi-sub">@_dailyRevenues.Count ngày ghi nhận</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Sản phẩm bán chạy nhất</div>
            <div class="kpi-value" style="font-size: 1.1rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                @(_topSelling.FirstOrDefault()?.TenSanPham ?? "Chưa có dữ liệu")
            </div>
            <div class="kpi-sub">Đã bán: @(_topSelling.FirstOrDefault()?.TongSoLuongDaBan ?? 0) sản phẩm</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Tổng tiền chiết khấu</div>
            <div class="kpi-value text-danger">@(TotalPeriodDiscount.ToString("N0")) đ</div>
            <div class="kpi-sub">Voucher & Khách VIP</div>
        </div>
    </div>

    <!-- SƠ ĐỒ DOANH THU KẾT HỢP CỘT & ĐƯỜNG (COMBO BAR + LINE CHART) -->
    <div class="revenue-chart-card">
        <div class="chart-header-row">
            <div class="chart-title-group">
                <div class="chart-title-wrapper">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="chart-header-icon">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <h3 class="chart-card-title">Sơ Đồ Tăng Trưởng Doanh Thu & Đơn Hàng</h3>
                </div>
                <span class="chart-card-subtitle">Phân tích trực quan tương quan giữa Doanh thu thuần (Cột) và Lượng đơn hoàn thành (Đường)</span>
            </div>

            <div class="chart-toolbar">
                <!-- Chế độ xem: Theo Ngày / Theo Tuần / Theo Tháng -->
                <div class="chart-mode-pill-group">
                    <button type="button" class="chart-mode-btn @(_chartMode == "daily" ? "active" : "")" data-mode="daily" @onclick='() => SetChartMode("daily")'>
                        Theo ngày
                    </button>
                    <button type="button" class="chart-mode-btn @(_chartMode == "weekly" ? "active" : "")" data-mode="weekly" @onclick='() => SetChartMode("weekly")'>
                        Theo tuần
                    </button>
                    <button type="button" class="chart-mode-btn @(_chartMode == "monthly" ? "active" : "")" data-mode="monthly" @onclick='() => SetChartMode("monthly")'>
                        Theo tháng
                    </button>
                </div>

                @if (_chartMode == "daily")
                {
                    <!-- Lọc khoảng ngày nhanh cho chế độ ngày: Giới hạn tối ưu 7 ngày và 14 ngày tránh tràn nhãn -->
                    <div class="chart-sub-range-group">
                        <button type="button" class="chart-sub-btn @(_chartDaysRange == 7 ? "active" : "")" @onclick="() => SetChartDaysRange(7)">7 ngày</button>
                        <button type="button" class="chart-sub-btn @(_chartDaysRange == 14 ? "active" : "")" @onclick="() => SetChartDaysRange(14)">14 ngày</button>
                    </div>
                }
            </div>
        </div>

        <!-- Thanh thống kê chỉ số nhanh (Quick Metrics Strip) -->
        <div class="chart-metrics-strip">
            <div class="metric-item">
                <span class="metric-label">Tổng doanh thu kỳ:</span>
                <span class="metric-value text-success">@ChartTotalRevenue.ToString("N0") đ</span>
            </div>
            @if (ChartTotalRefund > 0)
            {
                <div class="metric-divider"></div>
                <div class="metric-item">
                    <span class="metric-label">Khấu trừ hoàn trả:</span>
                    <span class="metric-value" style="color: #ea580c; font-weight: 700;">-@ChartTotalRefund.ToString("N0") đ</span>
                </div>
            }
            <div class="metric-divider"></div>
            <div class="metric-item">
                <span class="metric-label">Tổng đơn hoàn thành:</span>
                <span class="metric-value">
                    @ChartNetOrders.ToString("N0") đơn
                    @if (ChartRefundOrders > 0)
                    {
                        <span style="font-size: 0.8rem; font-weight: 500; color: #ea580c; margin-left: 4px;">(@ChartRefundOrders đơn hoàn)</span>
                    }
                </span>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
                <span class="metric-label">Giá trị TB/đơn (AOV):</span>
                <span class="metric-value" style="color: #6366f1;">@ChartAvgOrderValue.ToString("N0") đ</span>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
                <span class="metric-label">Đỉnh doanh thu (@(ChartPeakPoint?.Label ?? "--")):</span>
                <span class="metric-value" style="color: #f59e0b;">@((ChartPeakPoint?.Revenue ?? 0).ToString("N0")) đ</span>
            </div>
        </div>

        <!-- Chú giải sơ đồ (Legend) -->
        <div class="chart-legend-row">
            <div class="legend-item">
                <span class="legend-color-box legend-bar"></span>
                <span class="legend-text">Doanh thu thuần (Trục trái - VNĐ)</span>
            </div>
            <div class="legend-item">
                <span class="legend-color-box legend-refund"></span>
                <span class="legend-text">Tiền hoàn trả (Khấu trừ hoàn kho - VNĐ)</span>
            </div>
            <div class="legend-item">
                <span class="legend-color-line legend-line"></span>
                <span class="legend-color-dot"></span>
                <span class="legend-text">Số lượng đơn hoàn tất (Trục phải - Đơn)</span>
            </div>
        </div>

        <!-- Khung vẽ biểu đồ SVG thuần túy -->
        <div class="svg-chart-container">
            @{
                var points = ChartPoints;
            }
            @if (points.Count == 0)
            {
                <div class="chart-empty-state">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span>Không có dữ liệu doanh số trong khoảng thời gian đã chọn</span>
                </div>
            }
            else
            {
                var maxRevRaw = points.Max(p => p.Revenue);
                var maxRev = maxRevRaw > 0 ? maxRevRaw * 1.15m : 1000000m;
                var maxOrdersRaw = points.Max(p => p.OrderCount);
                // Chuẩn hóa maxOrders thành bội số của 4 để 4 vạch hiển thị luôn chia đều thành các số nguyên chính xác
                var maxOrders = Math.Max(4, ((maxOrdersRaw + 3) / 4) * 4);

                const double svgW = 1000;
                const double svgH = 340;
                const double leftM = 75;
                const double rightM = 60;
                const double topM = 30;
                const double botM = 55;
                var chartW = svgW - leftM - rightM;
                var chartH = svgH - topM - botM;
                var step = chartW / points.Count;
                var barW = Math.Clamp(step * 0.45, 12, 42);

                // Tính tọa độ đường line (vẽ theo số đơn hoàn thành ban đầu)
                var linePoints = new System.Text.StringBuilder();
                for (int i = 0; i < points.Count; i++)
                {
                    var p = points[i];
                    var cx = leftM + i * step + step / 2;
                    var cy = topM + chartH - ((double)p.OrderCount / maxOrders) * chartH;
                    linePoints.Append(System.FormattableString.Invariant($"{cx:0.#},{cy:0.#} "));
                }

                <svg class="revenue-combo-chart" viewBox="0 0 1000 340" preserveAspectRatio="none">
                    <defs>
                        <!-- Gradient màu cột Doanh thu thuần -->
                        <linearGradient id="barGradientPrimary" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#2563eb" stop-opacity="0.95" />
                            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.45" />
                        </linearGradient>
                        <linearGradient id="barGradientHover" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#1d4ed8" stop-opacity="1" />
                            <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.75" />
                        </linearGradient>
                    </defs>

                    <!-- Lưới ngang và nhãn trục Y -->
                    @for (int stepIdx = 0; stepIdx <= 4; stepIdx++)
                    {
                        var ratio = (double)stepIdx / 4;
                        var yPos = topM + chartH - ratio * chartH;
                        var valRev = maxRev * (decimal)ratio;
                        var valOrd = (int)Math.Round(maxOrders * ratio);

                        <g class="axis-grid-row">
                            <!-- Đường lưới ngang nét đứt -->
                            <line x1="@leftM" y1="@yPos.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" 
                                  x2="@((leftM + chartW).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" 
                                  y2="@yPos.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" 
                                  stroke="#e2e8f0" stroke-width="1" stroke-dasharray="@(stepIdx == 0 ? "none" : "3,4")" />

                            <!-- Nhãn trục Y trái (Doanh thu VNĐ) -->
                            <text x="@((leftM - 10).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" 
                                  y="@((yPos + 4).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" 
                                  text-anchor="end" font-size="11" fill="#64748b" font-weight="600" font-family="inherit">
                                @FormatCompactCurrency(valRev)
                            </text>

                            <!-- Nhãn trục Y phải (Số đơn) -->
                            <text x="@((leftM + chartW + 12).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" 
                                  y="@((yPos + 4).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" 
                                  text-anchor="start" font-size="11" fill="#f59e0b" font-weight="700" font-family="inherit">
                                @valOrd
                            </text>
                        </g>
                    }

                    <!-- 1. VẼ CÁC CỘT DOANH THU THỰC TẾ (LỢI NHUẬN THỰC THU) -->
                    @for (int i = 0; i < points.Count; i++)
                    {
                        var pt = points[i];
                        var idx = i;
                        var netH = maxRev > 0 ? (double)(pt.Revenue / maxRev) * chartH : 0;
                        if (netH < 3 && pt.Revenue > 0) netH = 3;

                        var bx = leftM + i * step + (step - barW) / 2;
                        var byNet = topM + chartH - netH;
                        var isHovered = _hoveredChartIndex == idx;

                        <g class="chart-bar-group" style="cursor: pointer;" @onclick="() => OpenDateDetailModal(pt.Date)" @onmouseover="() => _hoveredChartIndex = idx" @onmouseout="() => _hoveredChartIndex = null">
                            <!-- Hitbox trong suốt bắt trọn toàn bộ chiều cao dải cột từ đỉnh xuống đáy -->
                            <rect x="@bx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                  y="@topM.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                  width="@barW.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                  height="@chartH.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                  fill="rgba(0,0,0,0.001)" />

                            <!-- Cột Doanh Thu Thuần Thực Tế (Phần màu xanh dương) -->
                            @if (pt.Revenue > 0)
                            {
                                <rect class="chart-bar @(isHovered ? "hovered" : "")"
                                      x="@bx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@byNet.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      width="@barW.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      height="@netH.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      rx="4" ry="4"
                                      fill="@(isHovered ? "url(#barGradientHover)" : "url(#barGradientPrimary)")" />
                            }

                            <!-- Nhãn trục X dưới chân mỗi cột -->
                            <text x="@((bx + barW / 2).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                  y="@((topM + chartH + 20).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                  text-anchor="middle" font-size="11" fill="@(isHovered ? "#0f172a" : "#64748b")" font-weight="@(isHovered ? "700" : "500")" font-family="inherit">
                                @pt.Label
                            </text>
                        </g>
                    }

                    <!-- 2. VẼ ĐƯỜNG POLYLINE SỐ LƯỢNG ĐƠN HÀNG HOÀN TẤT (LINE) -->
                    <polyline class="chart-line"
                              fill="none"
                              stroke="#f59e0b"
                              stroke-width="2.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              points="@linePoints.ToString().Trim()" />

                    <!-- 3. CÁC NÚT ĐIỂM (NODES) TRÊN ĐƯỜNG ĐƠN HÀNG -->
                    @for (int i = 0; i < points.Count; i++)
                    {
                        var pt = points[i];
                        var idx = i;
                        var cx = leftM + i * step + step / 2;
                        var cy = topM + chartH - ((double)pt.OrderCount / maxOrders) * chartH;
                        var isHovered = _hoveredChartIndex == idx;

                        <!-- Hitbox trong suốt mở rộng cho nút điểm tròn để dễ click trúng -->
                        <circle cx="@cx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                cy="@cy.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                r="16"
                                fill="rgba(0,0,0,0.001)"
                                style="cursor: pointer;"
                                @onclick="() => OpenDateDetailModal(pt.Date)"
                                @onmouseover="() => _hoveredChartIndex = idx"
                                @onmouseout="() => _hoveredChartIndex = null" />

                        <circle class="chart-node @(isHovered ? "hovered" : "")"
                                style="cursor: pointer; pointer-events: none;"
                                cx="@cx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                cy="@cy.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                r="@(isHovered ? "6" : "4")"
                                fill="#ffffff"
                                stroke="#f59e0b"
                                stroke-width="@(isHovered ? "3.2" : "2.2")" />

                        @if (isHovered)
                        {
                            <!-- Tooltip nhãn giá trị tức thời khi hover: Gọn gàng, chỉ hiện đúng 2 dòng: Ngày & Lợi nhuận -->
                            var tooltipW = 185;
                            var tooltipH = 44;
                            var tooltipX = Math.Clamp(cx, tooltipW / 2 + 10, svgW - tooltipW / 2 - 10);
                            var tooltipY = Math.Max(cy - tooltipH - 12, 10);

                            <g class="chart-tooltip-badge" style="pointer-events: none;">
                                <rect x="@((tooltipX - tooltipW / 2).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                      y="@tooltipY.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      width="@tooltipW" height="@tooltipH" rx="6" ry="6" fill="#0f172a" opacity="0.96" />
                                <text x="@tooltipX.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@((tooltipY + 16).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                      text-anchor="middle" font-size="10.5" fill="#e2e8f0" font-weight="600" font-family="inherit">
                                    @pt.FullTitle
                                </text>
                                <text x="@tooltipX.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                      y="@((tooltipY + 33).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                      text-anchor="middle" font-size="11" fill="#38bdf8" font-weight="700" font-family="inherit">
                                    @($"Lợi nhuận: {pt.Revenue:N0} đ ({pt.OrderCount} đơn)")
                                </text>
                            </g>
                        }
                    }
                </svg>
            }
        </div>
    </div>

    <!-- KHU VỰC TRA CỨU: TRA CỨU 1 NGÀY & KHOẢNG THỜI GIAN -->
    <div class="search-section-grid">
        <!-- 1. TRA CỨU DỮ LIỆU CỦA 1 NGÀY CỤ THỂ -->
        <div class="range-filter-card single-date-card">
            <div class="card-title-row">
                <h4 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 6px;">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Tra cứu dữ liệu 1 ngày cụ thể
                </h4>
                <span class="badge-tag">Theo ngày</span>
            </div>

            <div class="filter-controls single-date-controls">
                <div class="form-group flex-grow">
                    <label>Chọn ngày cần xem:</label>
                    <input type="date" class="form-control" @bind="_singleDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <button class="btn btn-primary btn-search-single" @onclick="FetchSingleDateReport" disabled="@_isSearchingSingle">
                    @if (_isSearchingSingle)
                    {
                        <span>Đang tìm...</span>
                    }
                    else
                    {
                        <span>Tra cứu ngày này</span>
                    }
                </button>
            </div>

            <!-- Quick Day Shortcuts -->
            <div class="quick-chips">
                <span class="quick-chip-label">Chọn nhanh:</span>
                <button type="button" class="chip-btn" @onclick="() => SetSingleDate(DateTime.Today)">Hôm nay</button>
                <button type="button" class="chip-btn" @onclick="() => SetSingleDate(DateTime.Today.AddDays(-1))">Hôm qua</button>
                <button type="button" class="chip-btn" @onclick="() => SetSingleDate(DateTime.Today.AddDays(-2))">Hôm kia</button>
                <button type="button" class="chip-btn" @onclick="() => SetSingleDate(DateTime.Today.AddDays(-7))">7 ngày trước</button>
            </div>

            @if (_singleDateSearched)
            {
                <div class="single-date-result-box">
                    <div class="result-header">
                        <span class="result-date-badge">Kết quả ngày: <strong>@_singleDate.ToString("dd/MM/yyyy")</strong></span>
                    </div>
                    @if (_singleDateReport != null && (_singleDateReport.TongSoDonHoanThanh > 0 || _singleDateReport.TongDoanhThuThuc > 0))
                    {
                        <div class="single-stats-grid">
                            <div class="single-stat-item highlight">
                                <span class="stat-lbl">Doanh thu thực</span>
                                <span class="stat-val text-success">@_singleDateReport.TongDoanhThuThuc.ToString("N0") đ</span>
                            </div>
                            <div class="single-stat-item">
                                <span class="stat-lbl">Số đơn hoàn thành</span>
                                <span class="stat-val">@_singleDateReport.TongSoDonHoanThanh đơn</span>
                            </div>
                            <div class="single-stat-item">
                                <span class="stat-lbl">Số khách mua</span>
                                <span class="stat-val">@_singleDateReport.TongSoKhachHang khách</span>
                            </div>
                            <div class="single-stat-item">
                                <span class="stat-lbl">Tổng tiền hàng</span>
                                <span class="stat-val">@_singleDateReport.TongTienHang.ToString("N0") đ</span>
                            </div>
                            <div class="single-stat-item">
                                <span class="stat-lbl">Khuyến mãi / Giảm</span>
                                <span class="stat-val text-danger">-@_singleDateReport.TongTienKhuyenMai.ToString("N0") đ</span>
                            </div>
                            <div class="single-stat-item">
                                <span class="stat-lbl">Tiền hoàn trả</span>
                                <span class="stat-val" style="color: #ea580c; font-weight: 700;">-@_singleDateReport.TongTienHoanTra.ToString("N0") đ</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="single-empty-notice">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span>Ngày <strong>@_singleDate.ToString("dd/MM/yyyy")</strong> chưa có đơn hàng hoàn thành hoặc phát sinh doanh thu.</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 2. BỘ LỌC BÁO CÁO TÀI CHÍNH THEO KHOẢNG THỜI GIAN -->
        <div class="range-filter-card">
            <div class="card-title-row">
                <h4 class="card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 6px;">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Tra cứu theo khoảng thời gian
                </h4>
                <span class="badge-tag">Theo khoảng</span>
            </div>

            <div class="filter-controls">
                <div class="form-group">
                    <label>Từ ngày:</label>
                    <input type="date" class="form-control" @bind="_fromDate" />
                </div>
                <div class="form-group">
                    <label>Đến ngày:</label>
                    <input type="date" class="form-control" @bind="_toDate" />
                </div>
                <button class="btn btn-primary btn-apply-range" @onclick="FetchFinancialRangeReport">
                    Xem báo cáo
                </button>
            </div>

            @if (_financialReport != null)
            {
                <div class="range-result-box">
                    <div class="range-stat">
                        <span>Số đơn hoàn thành:</span>
                        <strong>@_financialReport.TongSoDonHoanThanh</strong>
                    </div>
                    <div class="range-stat">
                        <span>Số khách hàng:</span>
                        <strong>@_financialReport.TongSoKhachHang</strong>
                    </div>
                    <div class="range-stat">
                        <span>Tổng tiền hàng:</span>
                        <strong>@_financialReport.TongTienHang.ToString("N0") đ</strong>
                    </div>
                    <div class="range-stat">
                        <span>Tổng khuyến mãi:</span>
                        <strong class="text-danger">-@_financialReport.TongTienKhuyenMai.ToString("N0") đ</strong>
                    </div>
                    <div class="range-stat">
                        <span>Tổng hoàn trả:</span>
                        <strong style="color: #ea580c;">-@_financialReport.TongTienHoanTra.ToString("N0") đ</strong>
                    </div>
                    <div class="range-stat highlight">
                        <span>Doanh thu thuần (Net):</span>
                        <strong class="text-success">@_financialReport.TongDoanhThuThuc.ToString("N0") đ</strong>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Phân Khu 2 Cột: Bảng Doanh Thu Hàng Ngày (Được gom gọn) & Bảng Top Bán Chạy -->
    <div class="dashboard-tables-grid">
        <!-- Bảng Doanh thu theo ngày (Gom lại, cuộn lên dần, chỉ hiện ngày gần nhất) -->
        <div class="table-card compact-revenue-card">
            <div class="table-card-topbar">
                <div>
                    <h4 class="card-title">Doanh Thu Theo Ngày</h4>
                </div>

                <!-- Thanh lọc số ngày gần nhất (Pill buttons) -->
                <div class="pill-group">
                    <button type="button" class="pill-btn @(_daysLimit == 7 ? "active" : "")" @onclick="() => SetDaysLimit(7)">7 ngày</button>
                    <button type="button" class="pill-btn @(_daysLimit == 14 ? "active" : "")" @onclick="() => SetDaysLimit(14)">14 ngày</button>
                    <button type="button" class="pill-btn @(_daysLimit == 30 ? "active" : "")" @onclick="() => SetDaysLimit(30)">30 ngày</button>
                    <button type="button" class="pill-btn @(_daysLimit == 0 ? "active" : "")" @onclick="() => SetDaysLimit(0)">Tất cả</button>
                </div>
            </div>

            <!-- Ô tìm kiếm ngày nhanh trong bảng -->
            <div class="table-quick-search-bar">
                <div class="search-input-wrapper">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="quick-search-input" placeholder="Lọc nhanh ngày (vd: 08/10 hoặc 2026)..." @bind="_dailySearchText" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_dailySearchText))
                    {
                        <button type="button" class="clear-search-btn" @onclick="() => _dailySearchText = string.Empty">×</button>
                    }
                </div>
            </div>

            <!-- Khung cuộn giới hạn chiều cao (Scroll container gom gọn, có sticky header) -->
            <div class="table-scroll-container">
                <table class="admin-table sticky-header-table">
                    <thead>
                        <tr>
                            <th>Ngày bán</th>
                            <th class="text-center">Số đơn</th>
                            <th class="text-right">Tiền hàng</th>
                            <th class="text-right">Giảm giá</th>
                            <th class="text-right">Tiền hoàn</th>
                            <th class="text-right">Doanh thu thuần</th>
                            <th class="text-center" style="width: 110px; min-width: 110px; white-space: nowrap;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (DisplayedDailyRevenues.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Không tìm thấy dữ liệu ngày phù hợp
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in DisplayedDailyRevenues)
                            {
                                <tr style="cursor: pointer;" @onclick="() => OpenDateDetailModal(r.NgayBan)">
                                    <td>
                                        <div class="date-cell">
                                            <span class="date-main">@r.NgayBan.ToString("dd/MM/yyyy")</span>
                                            <span class="date-weekday">@GetVietnameseDayOfWeek(r.NgayBan.DayOfWeek)</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="order-count-badge">@r.TongSoDon</span>
                                        @if (r.SoDonHoan > 0)
                                        {
                                            <span style="display: block; font-size: 0.72rem; color: #ea580c; font-weight: 600; margin-top: 2px;">(-@r.SoDonHoan hoàn)</span>
                                        }
                                    </td>
                                    <td class="text-right">@r.TongTienHang.ToString("N0")</td>
                                    <td class="text-right text-danger">@(r.TongTienGiam > 0 ? $"-{r.TongTienGiam:N0}" : "0")</td>
                                    <td class="text-right" style="color: #ea580c; font-weight: 600;">@(r.TongTienHoan > 0 ? $"-{r.TongTienHoan:N0}" : "0")</td>
                                    <td class="text-right font-weight-bold text-success">@r.DoanhThuThucTe.ToString("N0") đ</td>
                                    <td class="text-center" style="width: 110px; min-width: 110px; white-space: nowrap;">
                                        <button type="button" class="btn-detail-sm" data-date-detail="@r.NgayBan.ToString("yyyy-MM-dd")" @onclick="() => OpenDateDetailModal(r.NgayBan)" @onclick:stopPropagation="true" title="Xem danh sách đơn hàng chi tiết của ngày này">
                                            Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bảng Top Sản Phẩm Bán Chạy -->
        <div class="table-card">
            <div class="table-card-topbar">
                <div>
                    <h4 class="card-title">Top Sản Phẩm Bán Chạy</h4>
                </div>
            </div>
            <div class="table-scroll-container">
                <table class="admin-table sticky-header-table">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th class="text-center">Đã bán</th>
                            <th class="text-right">Doanh thu mang lại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_topSelling.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                        }
                        else
                        {
                            @foreach (var p in _topSelling)
                            {
                                <tr>
                                    <td class="font-weight-bold">@p.TenSanPham</td>
                                    <td><span class="badge-category">@p.TenDanhMuc</span></td>
                                    <td class="text-center font-weight-bold">@p.TongSoLuongDaBan</td>
                                    <td class="text-right text-primary font-weight-bold">@p.TongDoanhThuMangLai.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PHÂN KHU HIỆU SUẤT CHI NHÁNH & GIÁM SÁT KHO HÀNG ĐA ĐIỂM -->
    <div class="branch-performance-section">
        <div class="section-header-row">
            <div>
                <h3 class="section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 8px;">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    HIỆU SUẤT CHI NHÁNH & GIÁM SÁT KHO HÀNG ĐA ĐIỂM
                </h3>
            </div>
            <div class="branch-summary-pills">
                <span class="summary-pill">@_branchLeaderboard.Count điểm bán & kho</span>
                <span class="summary-pill highlight">Đầu bảng: @(_branchLeaderboard.FirstOrDefault()?.TenChiNhanh ?? "Chưa có")</span>
            </div>
        </div>

        <div class="branch-grids-two-col">
            <!-- 1. BẢNG XẾP HẠNG DOANH SỐ CHI NHÁNH -->
            <div class="table-card branch-leaderboard-card">
                <div class="table-card-topbar">
                    <div>
                        <h4 class="card-title">Bảng Xếp Hạng Doanh Số Chi Nhánh</h4>
                    </div>
                </div>

                <div class="table-scroll-container">
                    <table class="admin-table sticky-header-table">
                        <thead>
                            <tr>
                                <th style="width: 55px;" class="text-center">Hạng</th>
                                <th>Chi nhánh</th>
                                <th class="text-center" style="width: 80px;">Số đơn</th>
                                <th class="text-right">Doanh thu</th>
                                <th style="width: 140px;">Tỷ lệ đóng góp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_branchLeaderboard.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu doanh số chi nhánh</td></tr>
                            }
                            else
                            {
                                int rank = 1;
                                @foreach (var b in _branchLeaderboard)
                                {
                                    <tr class="@(rank == 1 ? "top-branch-row" : "")">
                                        <td class="text-center">
                                            @if (rank == 1)
                                            {
                                                <span class="rank-badge rank-1" title="Hạng 1 - Doanh số cao nhất">1</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="rank-badge rank-2">2</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="rank-badge rank-3">3</span>
                                            }
                                            else
                                            {
                                                <span class="rank-badge rank-normal">@rank</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="branch-name-box">
                                                <span class="branch-name-text">@b.TenChiNhanh</span>
                                                @if (b.IsOnlineWarehouse)
                                                {
                                                    <span class="badge-online">Kho Tổng Online</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-store">Cửa hàng Offline</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center tabular-nums font-weight-bold">@b.TongSoDon</td>
                                        <td class="text-right text-success font-weight-bold tabular-nums">@b.TongDoanhThu.ToString("N0") đ</td>
                                        <td>
                                            <div class="contribution-box">
                                                <div class="contribution-progress">
                                                    <div class="contribution-bar" style="width: @Math.Min(b.TyLeDongGop, 100)%"></div>
                                                </div>
                                                <span class="contribution-label">@b.TyLeDongGop.ToString("0.1")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. GIÁM SÁT SẢN LƯỢNG TỒN KHO CHI NHÁNH -->
            <div class="table-card branch-inventory-card">
                <div class="table-card-topbar">
                    <div>
                        <h4 class="card-title">Giám Sát Sản Lượng & Tồn Kho Từng Kho</h4>
                    </div>
                </div>

                <div class="table-scroll-container">
                    <table class="admin-table sticky-header-table">
                        <thead>
                            <tr>
                                <th>Chi nhánh</th>
                                <th class="text-center">Số SKU</th>
                                <th class="text-center">Tổng tồn</th>
                                <th class="text-center">Sắp hết</th>
                                <th class="text-right">Giá trị tồn kho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_branchInventorySummaries.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu tồn kho chi nhánh</td></tr>
                            }
                            else
                            {
                                @foreach (var inv in _branchInventorySummaries)
                                {
                                    <tr>
                                        <td>
                                            <div class="branch-name-box">
                                                <span class="branch-name-text">@inv.TenChiNhanh</span>
                                                @if (inv.IsOnlineWarehouse)
                                                {
                                                    <span class="badge-online">Kho Tổng Online</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center tabular-nums">@inv.TongSoMatHang</td>
                                        <td class="text-center tabular-nums font-weight-bold @(inv.TongSoLuongTon == 0 ? "text-danger" : "")">
                                            @inv.TongSoLuongTon.ToString("N0")
                                        </td>
                                        <td class="text-center">
                                            @if (inv.SoMatHangSapHet > 0)
                                            {
                                                <span class="badge-lowstock" title="Số mặt hàng có tồn kho <= 10">@inv.SoMatHangSapHet SKU</span>
                                            }
                                            else
                                            {
                                                <span class="badge-ok">Đầy đủ</span>
                                            }
                                        </td>
                                        <td class="text-right tabular-nums text-primary font-weight-bold">
                                            @inv.TongGiaTriTonKho.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL CHI TIẾT ĐƠN HÀNG & GIAO DỊCH THEO NGÀY (THỰC TẾ MINH BẠCH) -->
    @if (_selectedDateDetail.HasValue)
    {
        <div class="date-detail-modal-overlay" style="position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 999999; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;" @onclick="CloseDateDetailModal">
            <div class="date-detail-modal-box date-detail-modal" style="background: #ffffff; border-radius: 16px; box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.45); width: 100%; max-width: 940px; max-height: 88vh; display: flex; flex-direction: column; overflow: hidden; position: relative; z-index: 1000000;" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="modal-header-custom">
                    <div class="modal-title-box">
                        <h3 class="modal-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Chi tiết giao dịch & đơn hàng ngày @_selectedDateDetail.Value.ToString("dd/MM/yyyy")
                        </h3>
                        <span class="modal-sub">@GetVietnameseDayOfWeek(_selectedDateDetail.Value.DayOfWeek) • Danh sách đơn bán, đơn hủy và hoàn trả</span>
                    </div>
                    <button type="button" class="btn-close-date-modal" @onclick="CloseDateDetailModal" title="Đóng cửa sổ">×</button>
                </div>

                <!-- Tóm tắt số liệu thu nhập thực tế trong ngày -->
                <div class="modal-metrics-strip">
                    <div class="modal-metric-card">
                        <span class="m-lbl">Đơn chốt bán</span>
                        <span class="m-val">@_modalOrders.Count(o => o.TrangThai == "Đã hoàn thành") đơn</span>
                    </div>
                    <div class="modal-metric-card">
                        <span class="m-lbl">Doanh số bán ra (Gộp)</span>
                        <span class="m-val">@_modalOrders.Where(o => o.TrangThai == "Đã hoàn thành").Sum(o => o.TongThanhToan).ToString("N0") đ</span>
                    </div>
                    <div class="modal-metric-card">
                        <span class="m-lbl">Khấu trừ tiền hoàn</span>
                        <span class="m-val text-warning">-@_modalOrders.Sum(o => o.SoTienDaHoan).ToString("N0") đ</span>
                    </div>
                    <div class="modal-metric-card highlight">
                        <span class="m-lbl">Thu nhập thực tế (Lợi nhuận)</span>
                        <span class="m-val text-success">@((_modalOrders.Where(o => o.TrangThai == "Đã hoàn thành").Sum(o => o.TongThanhToan - o.SoTienDaHoan)).ToString("N0")) đ</span>
                    </div>
                </div>

                <!-- Filter Tabs trong Modal -->
                <div class="modal-filter-tabs">
                    <button type="button" class="m-tab @(_modalFilter == "ALL" ? "active" : "")" @onclick='() => _modalFilter = "ALL"'>
                        Tất cả đơn (@_modalOrders.Count)
                    </button>
                    <button type="button" class="m-tab @(_modalFilter == "COMPLETED" ? "active" : "")" @onclick='() => _modalFilter = "COMPLETED"'>
                        Đã hoàn thành (@_modalOrders.Count(o => o.TrangThai == "Đã hoàn thành"))
                    </button>
                    <button type="button" class="m-tab @(_modalFilter == "REFUND_CANCEL" ? "active" : "")" @onclick='() => _modalFilter = "REFUND_CANCEL"'>
                        Có hoàn / Đã hủy (@_modalOrders.Count(o => o.TrangThai == "Đã hủy" || o.CoHoanTra || o.SoTienDaHoan > 0))
                    </button>
                </div>

                <!-- Bảng danh sách đơn hàng -->
                <div class="modal-table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width: 85px;">Mã đơn</th>
                                <th style="width: 80px;">Thời gian</th>
                                <th>Khách hàng</th>
                                <th class="text-right">Tiền hàng</th>
                                <th class="text-right">Giảm giá</th>
                                <th class="text-right">Tiền hoàn</th>
                                <th class="text-right">Thực thu</th>
                                <th class="text-center" style="width: 140px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isLoadingDateOrders)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        Đang nạp chi tiết các đơn hàng...
                                    </td>
                                </tr>
                            }
                            else if (FilteredModalOrders.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        Không có đơn hàng nào thỏa mãn tiêu chí lọc.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var o in FilteredModalOrders)
                                {
                                    var netOrderMoney = o.TrangThai == "Đã hoàn thành" ? Math.Max(0, o.TongThanhToan - o.SoTienDaHoan) : 0;
                                    <tr>
                                        <td><strong class="text-primary">#@o.MaHoaDon</strong></td>
                                        <td class="tabular-nums">@o.NgayLapHoaDon.ToString("HH:mm")</td>
                                        <td>
                                            <div class="font-weight-600">@o.TenKhachHang</div>
                                            @if (!string.IsNullOrEmpty(o.SdtKhachHang))
                                            {
                                                <small class="text-muted tabular-nums">@o.SdtKhachHang</small>
                                            }
                                        </td>
                                        <td class="text-right tabular-nums">@o.TienHang.ToString("N0") đ</td>
                                        <td class="text-right text-danger tabular-nums">@(o.TienGiamGia > 0 ? $"-{o.TienGiamGia:N0} đ" : "0")</td>
                                        <td class="text-right tabular-nums" style="color: #ea580c; font-weight: 600;">
                                            @(o.SoTienDaHoan > 0 ? $"-{o.SoTienDaHoan:N0} đ" : "0")
                                        </td>
                                        <td class="text-right font-weight-bold text-success tabular-nums">
                                            @netOrderMoney.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            @if (o.TrangThai == "Đã hoàn thành")
                                            {
                                                <span class="badge-status-completed">Đã hoàn thành</span>
                                                @if (o.CoHoanTra || o.SoTienDaHoan > 0)
                                                {
                                                    <span class="badge-status-refund-tag" style="display: block; font-size: 0.72rem; color: #ea580c; font-weight: 600; margin-top: 2px;">
                                                        Hoàn: -@o.SoTienDaHoan.ToString("N0") đ
                                                    </span>
                                                }
                                            }
                                            else if (o.TrangThai == "Đã hủy")
                                            {
                                                <span class="badge-status-cancelled">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status-pending">@o.TrangThai</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* ========================================== */
    /* NÚT CHI TIẾT TRONG BẢNG DOANH THU HÀNG NGÀY */
    /* ========================================== */
    .btn-detail-sm {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 5px 14px !important;
        font-size: 0.82rem !important;
        font-weight: 600 !important;
        color: #2563eb !important;
        background-color: #eff6ff !important;
        border: 1px solid #bfdbfe !important;
        border-radius: 6px !important;
        cursor: pointer !important;
        white-space: nowrap !important;
        text-decoration: none !important;
        transition: all 0.15s ease !important;
        line-height: 1.2 !important;
    }

    .btn-detail-sm:hover {
        background-color: #2563eb !important;
