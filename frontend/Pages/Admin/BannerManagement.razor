@page "/admin/banners"
@layout AdminLayout
@namespace Frontend.Pages.Admin
@inject ICatalogApiClient CatalogApi
@inject IToastService Toast

<div class="banners-admin-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">QUẢN LÝ HERO BANNER & CHIẾN DỊCH</h2>
            <p class="page-subtitle">Tùy biến nội dung, tiêu đề, giá nổi bật, nhãn badge và hình ảnh banner ngoài trang chủ (không khóa cứng dữ liệu)</p>
        </div>
        <div class="header-actions">
            <!-- Nút thêm chỉ duy nhất 1 dấu + tinh tế -->
            <button class="btn-add-banner" @onclick="OpenCreateModal" title="Thêm banner mới" aria-label="Thêm banner mới">
                <span class="plus-char">+</span>
                <span>Thêm Banner Mới</span>
            </button>
        </div>
    </div>

    <!-- Danh sách Banner -->
    <div class="card">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">Thứ tự</th>
                        <th style="width: 120px;">Hình ảnh</th>
                        <th>Tiêu đề & Badge</th>
                        <th>Phụ đề & Giá</th>
                        <th>Liên kết nút bấm</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-center" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <span class="spinner-border spinner-border-sm me-2"></span> Đang tải danh sách banner...
                            </td>
                        </tr>
                    }
                    else if (!_banners.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Chưa có banner nào trong hệ thống. Hãy bấm nút "+ Thêm Banner Mới" để tạo banner đầu tiên!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in _banners)
                        {
                            <tr>
                                <td class="text-center font-weight-bold">
                                    <span class="order-badge">@b.ThuTu</span>
                                </td>
                                <td>
                                    <div class="banner-thumb">
                                        <img src="@(string.IsNullOrEmpty(b.HinhAnh) ? "images/hero-model.jpg" : b.HinhAnh)" 
                                             alt="@b.TieuDe" 
                                             onerror="this.onerror=null;this.src='images/hero-model.jpg';" />
                                    </div>
                                </td>
                                <td>
                                    <div class="banner-title-cell">
                                        @if (!string.IsNullOrWhiteSpace(b.NhanBadge))
                                        {
                                            <span class="badge-tag">@b.NhanBadge</span>
                                        }
                                        <div class="main-title">@b.TieuDe.Replace("\n", " / ")</div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(b.PhuDe))
                                    {
                                        <div class="sub-title text-muted">@b.PhuDe</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.GiaNoiBat))
                                    {
                                        <div class="price-highlight">@b.GiaNoiBat</div>
                                    }
                                </td>
                                <td>
                                    <div class="links-cell">
                                        @if (!string.IsNullOrWhiteSpace(b.NutChinhText))
                                        {
                                            <div><strong>Chính:</strong> @b.NutChinhText <span class="text-muted">(@b.NutChinhLink)</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(b.NutPhuText))
                                        {
                                            <div><strong>Phụ:</strong> @b.NutPhuText <span class="text-muted">(@b.NutPhuLink)</span></div>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button class="status-toggle-btn @(b.KichHoat ? "status-active" : "status-inactive")"
                                            @onclick="() => ToggleStatus(b)"
                                            title="Bấm để bật/tắt hiển thị">
                                        @if (b.KichHoat)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:inline-block; vertical-align:-1px; margin-right:3px;"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Đang hiện</span>
                                        }
                                        else
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:inline-block; vertical-align:-1px; margin-right:3px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg><span>Đang ẩn</span>
                                        }
                                    </button>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-edit" @onclick="() => OpenEditModal(b)" title="Sửa nội dung">
                                            Sửa
                                        </button>
                                        <button class="btn-action btn-delete" @onclick="() => ConfirmDelete(b)" title="Xóa banner">
                                            Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL THÊM / CHỈNH SỬA BANNER
     ========================================================================= -->
@if (_showModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h3 class="modal-title-custom">
                    @(_isEditing ? "CHỈNH SỬA HERO BANNER" : "THÊM HERO BANNER MỚI")
                </h3>
                <button type="button" class="btn-close-custom" @onclick="CloseModal">✕</button>
            </div>

            <div class="modal-body-custom">
                <div class="form-row">
                    <div class="form-group col-12">
                        <label class="form-label required">Tiêu đề chính (Có thể xuống dòng):</label>
                        <textarea class="form-control" rows="2" @bind="_model.TieuDe" placeholder="Ví dụ: MẶC ĐẸP ĐI LÀM&#10;TAN TẦM ĐI QUẨY"></textarea>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Phụ đề / Khẩu hiệu:</label>
                        <input type="text" class="form-control" @bind="_model.PhuDe" placeholder="Ví dụ: MUA 2 GIẢM 25%" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giá nổi bật:</label>
                        <input type="text" class="form-control" @bind="_model.GiaNoiBat" placeholder="Ví dụ: 208K hoặc 250.000₫" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Nhãn Stamp Badge (Góc trái trên ảnh):</label>
                        <input type="text" class="form-control" @bind="_model.NhanBadge" placeholder="Ví dụ: WORK TO WEEKEND" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Thứ tự ưu tiên (Số nhỏ hiện trước):</label>
                        <input type="number" class="form-control" @bind="_model.ThuTu" min="1" max="999" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label required">Đường dẫn hình ảnh:</label>
                    <input type="text" class="form-control" @bind="_model.HinhAnh" placeholder="images/hero-model.jpg hoặc link URL ảnh online https://..." />
                    <small class="form-text text-muted">Có thể dùng ảnh có sẵn trong thư mục images/ hoặc URL ảnh từ Unsplash/Pexels.</small>
                </div>

                @if (!string.IsNullOrWhiteSpace(_model.HinhAnh))
                {
                    <div class="image-preview-box">
                        <div class="preview-label">Xem trước ảnh:</div>
                        <img src="@_model.HinhAnh" alt="Preview" class="preview-img" onerror="this.onerror=null;this.src='images/hero-model.jpg';" />
                    </div>
                }

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Tên nút chính (CTA 1):</label>
                        <input type="text" class="form-control" @bind="_model.NutChinhText" placeholder="Ví dụ: XEM BỘ SƯU TẬP" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Đường dẫn nút chính:</label>
                        <input type="text" class="form-control" @bind="_model.NutChinhLink" placeholder="Ví dụ: #product-catalog hoặc /catalog?sale=true" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Tên nút phụ (CTA 2):</label>
                        <input type="text" class="form-control" @bind="_model.NutPhuText" placeholder="Ví dụ: Đặc quyền VIP 2026" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Đường dẫn nút phụ:</label>
                        <input type="text" class="form-control" @bind="_model.NutPhuLink" placeholder="Ví dụ: /vip" />
                    </div>
                </div>

                <div class="form-check-group">
                    <label class="custom-checkbox-label">
                        <input type="checkbox" @bind="_model.KichHoat" />
                        <span>Kích hoạt hiển thị ngay trên Storefront</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary" @onclick="SaveBanner" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span>@(_isEditing ? "Lưu Thay Đổi" : "Tạo Banner Mới")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

