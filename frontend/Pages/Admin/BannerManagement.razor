@code {
    private List<BannerDto> _banners = new();
    private bool _isLoading = false;
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private int _editingId = 0;

    private CreateUpdateBannerDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBanners();
    }

    private async Task LoadBanners()
    {
        _isLoading = true;
        try
        {
            var data = await CatalogApi.GetAllBannersAsync();
            _banners = data.OrderBy(b => b.ThuTu).ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải banner: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _editingId = 0;
        _model = new CreateUpdateBannerDto
        {
            TieuDe = "BST THỜI TRANG MỚI 2026",
            PhuDe = "ƯU ĐÃI ĐỘC QUYỀN",
            GiaNoiBat = "199K",
            NhanBadge = "NEW COLLECTION",
            HinhAnh = "images/hero-model.jpg",
            NutChinhText = "XEM NGAY",
            NutChinhLink = "#product-catalog",
            NutPhuText = "Xem Chi Tiết",
            NutPhuLink = "/vip",
            ThuTu = _banners.Count + 1,
            KichHoat = true
        };
        _showModal = true;
    }

    private void OpenEditModal(BannerDto banner)
    {
        _isEditing = true;
        _editingId = banner.MaBanner;
        _model = new CreateUpdateBannerDto
        {
            TieuDe = banner.TieuDe,
            PhuDe = banner.PhuDe,
            GiaNoiBat = banner.GiaNoiBat,
            NhanBadge = banner.NhanBadge,
            HinhAnh = banner.HinhAnh,
            NutChinhText = banner.NutChinhText,
            NutChinhLink = banner.NutChinhLink,
            NutPhuText = banner.NutPhuText,
            NutPhuLink = banner.NutPhuLink,
            ThuTu = banner.ThuTu,
            KichHoat = banner.KichHoat
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SaveBanner()
    {
        if (string.IsNullOrWhiteSpace(_model.TieuDe))
        {
            Toast.ShowError("Vui lòng nhập tiêu đề banner!");
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.HinhAnh))
        {
            Toast.ShowError("Vui lòng nhập đường dẫn hình ảnh!");
            return;
        }

        _isSaving = true;
        try
        {
            bool success;
            if (_isEditing)
            {
                success = await CatalogApi.UpdateBannerAsync(_editingId, _model);
            }
            else
            {
                success = await CatalogApi.CreateBannerAsync(_model);
            }

            if (success)
            {
                Toast.ShowSuccess(_isEditing ? "Cập nhật banner thành công!" : "Tạo banner mới thành công!");
                _showModal = false;
                await LoadBanners();
            }
            else
            {
                Toast.ShowError("Không thể lưu banner. Vui lòng kiểm tra lại kết nối API!");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi lưu banner: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleStatus(BannerDto banner)
    {
        var updateDto = new CreateUpdateBannerDto
        {
            TieuDe = banner.TieuDe,
            PhuDe = banner.PhuDe,
            GiaNoiBat = banner.GiaNoiBat,
            NhanBadge = banner.NhanBadge,
            HinhAnh = banner.HinhAnh,
            NutChinhText = banner.NutChinhText,
            NutChinhLink = banner.NutChinhLink,
            NutPhuText = banner.NutPhuText,
            NutPhuLink = banner.NutPhuLink,
            ThuTu = banner.ThuTu,
            KichHoat = !banner.KichHoat
        };

        var success = await CatalogApi.UpdateBannerAsync(banner.MaBanner, updateDto);
        if (success)
        {
            banner.KichHoat = !banner.KichHoat;
            Toast.ShowSuccess($"Đã {(banner.KichHoat ? "bật" : "tắt")} hiển thị banner #{banner.MaBanner}");
        }
        else
        {
            Toast.ShowError("Lỗi cập nhật trạng thái banner");
        }
    }

    private async Task ConfirmDelete(BannerDto banner)
    {
        var success = await CatalogApi.DeleteBannerAsync(banner.MaBanner);
        if (success)
        {
            Toast.ShowSuccess($"Đã xóa thành công banner #{banner.MaBanner}");
            await LoadBanners();
        }
        else
        {
            Toast.ShowError("Lỗi khi xóa banner");
        }
    }
}
