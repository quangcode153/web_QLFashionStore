@code {
    private List<PolicyDto> _policies = new();
    private bool _isLoading = true;
    private bool _showEditModal = false;
    private bool _showDeleteModal = false;
    private bool _isCreating = false;
    private bool _isSaving = false;
    private bool _showPreviewTab = false;
    private string? _errorMessage;

    private CreateUpdatePolicyDto _editModel = new();
    private int _editingId = 0;
    private PolicyDto? _selectedPolicy;

    protected override async Task OnInitializedAsync()
    {
        await LoadPoliciesAsync();
    }

    private async Task LoadPoliciesAsync()
    {
        _isLoading = true;
        try
        {
            var res = await PolicyApi.GetAllPoliciesAsync();
            var list = res.ToList();
            if (!list.Any())
            {
                var active = await PolicyApi.GetActivePoliciesAsync();
                list = active.ToList();
            }
            _policies = list;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải danh sách chính sách: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _isCreating = true;
        _editingId = 0;
        _errorMessage = null;
        _showPreviewTab = false;
        _editModel = new CreateUpdatePolicyDto
        {
            Slug = "",
            TieuDe = "",
            TomTat = "",
            NoiDung = "<p>Nội dung chi tiết chính sách...</p>\n\n<h3>1. QUY ĐỊNH CHUNG</h3>\n<ul>\n    <li>Điều khoản áp dụng 1</li>\n    <li>Điều khoản áp dụng 2</li>\n</ul>",
            ThuTu = (_policies.Any() ? _policies.Max(p => p.ThuTu) + 1 : 1),
            KichHoat = true
        };
        _showEditModal = true;
    }

    private void OpenEditModal(PolicyDto policy)
    {
        _isCreating = false;
        _editingId = policy.MaChinhSach;
        _errorMessage = null;
        _showPreviewTab = false;
        _editModel = new CreateUpdatePolicyDto
        {
            Slug = policy.Slug,
            TieuDe = policy.TieuDe,
            TomTat = policy.TomTat,
            NoiDung = policy.NoiDung,
            ThuTu = policy.ThuTu,
            KichHoat = policy.KichHoat,
            NguoiCapNhat = "Admin"
        };
        _showEditModal = true;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        _errorMessage = null;
    }

    private async Task SavePolicyAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_editModel.Slug))
        {
            _errorMessage = "Vui lòng nhập định danh đường dẫn (slug).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editModel.TieuDe))
        {
            _errorMessage = "Vui lòng nhập tiêu đề chính sách.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editModel.NoiDung))
        {
            _errorMessage = "Vui lòng nhập nội dung chi tiết chính sách.";
            return;
        }

        _isSaving = true;
        try
        {
            if (_isCreating)
            {
                var success = await PolicyApi.CreatePolicyAsync(_editModel);
                if (success)
                {
                    Toast.ShowSuccess("Thêm mới chính sách thành công!");
                    _showEditModal = false;
                    await LoadPoliciesAsync();
                }
                else
                {
                    _errorMessage = "Thêm mới thất bại. Vui lòng kiểm tra xem slug có bị trùng không.";
                }
            }
            else
            {
                var success = await PolicyApi.UpdatePolicyAsync(_editingId, _editModel);
                if (success)
                {
                    Toast.ShowSuccess("Cập nhật nội dung chính sách thành công!");
                    _showEditModal = false;
                    await LoadPoliciesAsync();
                }
                else
                {
                    _errorMessage = "Cập nhật chính sách thất bại. Vui lòng thử lại.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDeleteModal(PolicyDto policy)
    {
        _selectedPolicy = policy;
        _showDeleteModal = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_selectedPolicy == null) return;
        _isSaving = true;
        try
        {
            var success = await PolicyApi.DeletePolicyAsync(_selectedPolicy.MaChinhSach);
            if (success)
            {
                Toast.ShowSuccess($"Đã xóa chính sách '{_selectedPolicy.TieuDe}' thành công!");
                _showDeleteModal = false;
                await LoadPoliciesAsync();
            }
            else
            {
                Toast.ShowError("Xóa chính sách thất bại. Vui lòng thử lại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi xóa: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
