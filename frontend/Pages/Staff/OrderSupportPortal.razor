    // Approve Return Ticket
    private async Task ApproveReturn(int feedbackId)
    {
        var request = new ProcessReturnRequestDto
        {
            Action = "APPROVE",
            IsApproved = true,
            Notes = "Điều phối viên đã xác nhận và phê duyệt yêu cầu thu hồi hàng."
        };

        var res = await AdminApi.ProcessReturnRequestAsync(feedbackId, request);
        if (res.Success)
        {
            ToastService.ShowSuccess($"Đã phê duyệt yêu cầu hoàn trả #{feedbackId} thành công!");
            var fb = _returnFeedbacks.FirstOrDefault(f => f.MaPhanHoi == feedbackId);
            if (fb != null) fb.TrangThai = "Đã duyệt";
            CalculateKpi();
        }
        else
        {
            ToastService.ShowError(res.Message ?? "Không thể phê duyệt phiếu hoàn trả.");
        }
    }

    // Reject Return Ticket
    private async Task RejectReturn(int feedbackId)
    {
        var request = new ProcessReturnRequestDto
        {
            Action = "REJECT",
            IsApproved = false,
            Notes = "Không đủ điều kiện đổi trả theo quy định."
        };

        var res = await AdminApi.ProcessReturnRequestAsync(feedbackId, request);
        if (res.Success)
        {
            ToastService.ShowSuccess($"Đã từ chối yêu cầu hoàn trả #{feedbackId}.");
            var fb = _returnFeedbacks.FirstOrDefault(f => f.MaPhanHoi == feedbackId);
            if (fb != null) fb.TrangThai = "Từ chối";
            CalculateKpi();
        }
        else
        {
            ToastService.ShowError(res.Message ?? "Không thể từ chối phiếu hoàn trả.");
        }
    }

    // Receive Defective Stock (Đã duyệt -> Đã hoàn tất & Nhập kho lỗi)
    private async Task ReceiveDefectiveStock(int feedbackId)
    {
        var request = new ProcessReturnRequestDto
        {
            Action = "RECEIVE",
            IsApproved = true,
            Notes = "Đã nhận bưu phẩm hoàn về, kiểm đếm và hoàn tất nhập kho hàng lỗi."
        };

        var res = await AdminApi.ProcessReturnRequestAsync(feedbackId, request);
        if (res.Success)
        {
            ToastService.ShowSuccess($"Đã nhận bưu phẩm hoàn và ghi nhận nhập kho lỗi cho phiếu #{feedbackId}!");
            var fb = _returnFeedbacks.FirstOrDefault(f => f.MaPhanHoi == feedbackId);
            if (fb != null) fb.TrangThai = "Đã hoàn tất";
            CalculateKpi();
        }
        else
        {
            ToastService.ShowError(res.Message ?? "Không thể ghi nhận nhận bưu phẩm hoàn.");
        }
    }

    private List<OrderSummaryDto> FilteredOrders => _onlineOrders
        .Where(o => string.IsNullOrEmpty(_orderStatusFilter) || o.TrangThai == _orderStatusFilter)
        .Where(o => string.IsNullOrWhiteSpace(_orderSearch) ||
                    o.MaHoaDon.ToString().Contains(_orderSearch.Trim()) ||
                    (o.TenKhachHang ?? "").Contains(_orderSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (o.SdtKhachHang ?? "").Contains(_orderSearch.Trim()))
        .ToList();

    private List<FeedbackDto> FilteredReturns => _returnFeedbacks
        .Where(f => string.IsNullOrEmpty(_returnStatusFilter) || f.TrangThai == _returnStatusFilter)
        .Where(f => string.IsNullOrWhiteSpace(_returnSearch) ||
                    f.MaPhanHoi.ToString().Contains(_returnSearch.Trim()) ||
                    (f.MaHoaDon.HasValue && f.MaHoaDon.Value.ToString().Contains(_returnSearch.Trim())) ||
                    (f.HoTen ?? "").Contains(_returnSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (f.DiaChiThuHoi ?? "").Contains(_returnSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (f.DiaChiNhanHangHoanVe ?? "").Contains(_returnSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (f.DiaChiChiNhanhHen ?? "").Contains(_returnSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string GetStatusClass(string status) => status switch
    {
        "Chờ xử lý" => "cho-xu-ly",
        "Đang giao hàng" => "dang-giao",
        "Đã hoàn thành" => "hoan-thanh",
        "Đã hủy" => "da-huy",
        "Cần duyệt" => "can-duyet",
        "Đã duyệt" => "da-duyet",
        "Đã hoàn tất" => "hoan-tat",
        "Từ chối" => "tu-choi",
        _ => "default"
    };
}
