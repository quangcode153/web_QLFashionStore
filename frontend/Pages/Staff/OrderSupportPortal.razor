            var item = _onlineOrders.FirstOrDefault(o => o.MaHoaDon == orderId);
            if (item != null) item.TrangThai = "Đã hoàn thành";
            CalculateKpi();
        }
        else
        {
            ToastService.ShowError($"Không thể xác nhận hoàn tất đơn #{orderId}!");
        }
    }

