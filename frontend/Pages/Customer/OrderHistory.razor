        color: #64748B;
        margin-bottom: 28px;
    }
    .btn-explore-shop {
        display: inline-block;
        background: #E11D48;
        color: #FFFFFF;
        font-weight: 800;
        padding: 13px 32px;
        border-radius: 6px;
        text-decoration: none;
        letter-spacing: 0.03em;
    }
    .btn-explore-shop:hover {
        background: #BE123C;
    }
    .tiktok-header-bar {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 20px;
    }
    .tiktok-title-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .tiktok-title-sub {
        font-size: 0.9rem;
        color: #64748B;
        font-weight: 500;
    }
    .mb-0 { margin-bottom: 0 !important; }

    /* TikTok Style Search Box */
    .tiktok-search-box {
        position: relative;
