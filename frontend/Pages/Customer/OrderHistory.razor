        border-color: #0F172A;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
    }
    .tiktok-search-icon {
        font-size: 1.05rem;
        color: #94A3B8;
        margin-right: 10px;
        flex-shrink: 0;
    }
    .tiktok-search-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.92rem;
        color: #0F172A;
        font-family: inherit;
    }
    .tiktok-search-input::placeholder {
        color: #94A3B8;
    }
    .btn-clear-search {
        background: none;
        border: none;
        color: #94A3B8;
        font-size: 1rem;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 50%;
        line-height: 1;
    }
    .btn-clear-search:hover {
        color: #0F172A;
        background: #F1F5F9;
    }

    /* TikTok Style Horizontal Tabs */
    .customer-order-tabs.tiktok-tabs-bar {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        gap: 8px;
        border-bottom: 1.5px solid #E2E8F0;
        padding-bottom: 4px;
        margin-bottom: 24px;
