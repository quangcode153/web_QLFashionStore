    private int _returnQty = 1;
    private int _maxReturnQty = 1;
    private string _returnReason = string.Empty;
    private string _returnCustomerName = string.Empty;
    private string _returnCustomerPhone = string.Empty;
    private string _returnCustomerEmail = string.Empty;
    private bool _isSubmittingReturn = false;

    // Filter Tabs, Search & Return Checks
    private string? _selectedStatusTab = null;
    private string _searchQuery = string.Empty;

    private void FilterOrdersByTab(string? tab)
    {
        _selectedStatusTab = tab;
    }

    private bool _isRepurchasing = false;
    private int? _repurchasingOrderId = null;

    private async Task RepurchaseOrderAsync(CustomerOrderHistoryItemDto order)
    {
        if (_isRepurchasing) return;
        _isRepurchasing = true;
        _repurchasingOrderId = order.MaHoaDon;
        try
        {
            var details = await CustomerApi.GetOrderDetailsAsync(order.MaHoaDon);
            if (details != null && details.Any())
            {
                if (details.Count == 1)
                {
                    var singleItem = details.First();
                    await RepurchaseSingleItemAsync(singleItem.TenSanPham);
                    return;
                }
                else
                {
                    await OpenOrderDetailsModalAsync(order);
                    Toast.ShowInfo("Đơn hàng gồm nhiều mặt hàng. Vui lòng chọn 'Mua lại' tại sản phẩm mong muốn.");
                    return;
                }
            }

            Toast.ShowWarning("Không tìm thấy thông tin mặt hàng trong đơn.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải thông tin mua lại: {ex.Message}");
        }
        finally
        {
            _isRepurchasing = false;
            _repurchasingOrderId = null;
        }
    }

    private async Task RepurchaseSingleItemAsync(string productName)
    {
        if (string.IsNullOrWhiteSpace(productName)) return;
        try
        {
            var result = await CatalogApi.GetProductsAsync(new ProductQueryParameters
            {
                Search = productName.Trim(),
                PageSize = 5
            });

            var matched = result?.Items?.FirstOrDefault(p => 
                string.Equals(p.TenSanPham.Trim(), productName.Trim(), StringComparison.OrdinalIgnoreCase)) 
                ?? result?.Items?.FirstOrDefault();

            if (matched != null && matched.MaSanPham > 0)
            {
                CloseModal();
                Navigation.NavigateTo($"/product/{matched.MaSanPham}");
            }
            else
            {
                Toast.ShowWarning($"Sản phẩm \"{productName}\" tạm thời không khả dụng trên gian hàng.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi tìm sản phẩm: {ex.Message}");
        }
    }

    private bool IsOrderReturned(CustomerOrderHistoryItemDto order) =>
        order.TrangThai == "Đã hoàn trả" || 
        order.TrangThaiHoanTra == "Đã nhận hàng hoàn" || 
        order.TrangThaiHoanTra == "Đã xử lý" ||
        order.TrangThaiHoanTra == "Đã hoàn tất";

    private bool IsOrderReturnPending(CustomerOrderHistoryItemDto order) =>
        order.TrangThaiHoanTra == "Cần duyệt" || 
        order.TrangThaiHoanTra == "Đang xử lý" || 
        order.TrangThaiHoanTra == "Đã duyệt";

    private bool IsOrderReturnedOrPending(CustomerOrderHistoryItemDto order) =>
        IsOrderReturned(order) || IsOrderReturnPending(order);

    private IEnumerable<CustomerOrderHistoryItemDto> FilteredOrders
    {
        get
        {
            if (_orders == null) return Enumerable.Empty<CustomerOrderHistoryItemDto>();
            var query = _orders.AsEnumerable();

            if (!string.IsNullOrEmpty(_selectedStatusTab))
            {
                if (_selectedStatusTab == "Đã hoàn thành")
                {
                    query = query.Where(x => (x.TrangThai == "Đã hoàn thành" || x.TrangThai == "Hoàn thành") && (x.TongSoLuongDaMua > x.TongSoLuongDaTra));
                }
                else if (_selectedStatusTab == "Đã hoàn trả")
                {
                    query = query.Where(x => IsOrderReturnedOrPending(x) || x.TrangThai == "Đã hoàn trả" || x.TongSoLuongDaTra > 0);
                }
                else
                {
                    query = query.Where(x => x.TrangThai == _selectedStatusTab);
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(x => 
                    x.MaHoaDon.ToString().Contains(q) || 
                    (x.DiaChiGiaoHang != null && x.DiaChiGiaoHang.ToLowerInvariant().Contains(q)) ||
                    x.TrangThai.ToLowerInvariant().Contains(q) ||
                    x.PhuongThucThanhToan.ToLowerInvariant().Contains(q)
                );
            }

            return query;
        }
    }

    // Return Method & Branch Selection
    private string _returnMethod = "Thu hồi tại nhà";
    private string _returnPickupAddress = string.Empty;
    private int _selectedBranchId = 1;
    private List<global::Shared.DTOs.Warehouse.BranchDto> _branches = new();
    private global::Shared.DTOs.Warehouse.BranchDto? SelectedBranch => _branches.FirstOrDefault(b => b.MaChiNhanh == _selectedBranchId) ?? _branches.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        try
        {
            _orders = await CustomerApi.GetOrderHistoryAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Đã hoàn thành" or "Hoàn thành" => "status-completed",
            "Chờ xử lý" or "Đang giao hàng" => "status-processing",
            "Đã hủy" => "status-cancelled",
            _ => "status-default"
        };
    }

    private async Task OpenOrderDetailsModalAsync(CustomerOrderHistoryItemDto order)
    {
        _selectedOrder = order;
        _isLoadingDetails = true;
        try
        {
            _orderDetails = await CustomerApi.GetOrderDetailsAsync(order.MaHoaDon);
        }
        finally
        {
            _isLoadingDetails = false;
        }
    }

    private void CloseModal()
    {
        _selectedOrder = null;
        _orderDetails = null;
    }

    private async Task OpenReturnModalAsync(CustomerOrderHistoryItemDto order)
    {
        _returnOrder = order;
        _isLoadingReturnItems = true;
        _selectedVariantId = 0;
        _selectedVariantIds.Clear();
        _returnQuantities.Clear();
        _returnQty = 1;
        _maxReturnQty = 1;
        _returnReason = string.Empty;
        _returnMethod = "Thu hồi tại nhà";
        _returnPickupAddress = string.Empty;
        _selectedBranchId = 1;

        // Nạp trước danh sách chi nhánh
        try
        {
            var branchList = await CustomerApi.GetBranchesAsync();
            _branches = branchList ?? new List<global::Shared.DTOs.Warehouse.BranchDto>();
            if (_branches.Any())
            {
                _selectedBranchId = _branches.First().MaChiNhanh;
            }
        }
        catch { }

        // Nạp trước thông tin từ profile khách hàng nếu có
        var profile = await CustomerApi.GetProfileAsync();
        if (profile != null)
        {
            _returnCustomerName = profile.TenKhachHang ?? string.Empty;
            _returnCustomerPhone = profile.DienThoai ?? string.Empty;
            _returnCustomerEmail = profile.Email ?? string.Empty;
        }

        try
        {
            _returnItems = await CustomerApi.GetOrderDetailsAsync(order.MaHoaDon);
            if (_returnItems != null && _returnItems.Any())
            {
                var returnableItems = _returnItems.Where(i => !i.DaTraHet).ToList();
                foreach (var it in returnableItems)
                {
                    _returnQuantities[it.MaBienThe] = 1;
                }
                var first = returnableItems.FirstOrDefault();
                if (first != null)
                {
                    _selectedVariantIds.Add(first.MaBienThe);
                    _selectedVariantId = first.MaBienThe;
                    _maxReturnQty = first.SoLuongConLai > 0 ? first.SoLuongConLai : 1;
                    _returnQty = 1;
                }
            }
        }
        finally
        {
            _isLoadingReturnItems = false;
        }
    }

    private void ToggleReturnItemSelection(OrderDetailItemDto item)
    {
        if (item.DaTraHet) return;

        if (_selectedVariantIds.Contains(item.MaBienThe))
        {
            _selectedVariantIds.Remove(item.MaBienThe);
        }
        else
        {
            _selectedVariantIds.Add(item.MaBienThe);
            if (!_returnQuantities.ContainsKey(item.MaBienThe))
            {
                _returnQuantities[item.MaBienThe] = 1;
            }
        }
        _selectedVariantId = _selectedVariantIds.FirstOrDefault();
        _maxReturnQty = item.SoLuongConLai > 0 ? item.SoLuongConLai : 1;
        _returnQty = GetReturnQty(_selectedVariantId);
    }

    private void ToggleSelectAllReturns()
    {
        if (_returnItems == null || !_returnItems.Any()) return;

        var returnableItems = _returnItems.Where(i => !i.DaTraHet).ToList();
        if (_selectedVariantIds.Count == returnableItems.Count)
        {
            _selectedVariantIds.Clear();
            _selectedVariantId = 0;
        }
        else
        {
            foreach (var it in returnableItems)
            {
                _selectedVariantIds.Add(it.MaBienThe);
                if (!_returnQuantities.ContainsKey(it.MaBienThe))
                {
                    _returnQuantities[it.MaBienThe] = 1;
                }
            }
            _selectedVariantId = _selectedVariantIds.FirstOrDefault();
        }
    }

    private int GetReturnQty(int variantId)
    {
        return _returnQuantities.TryGetValue(variantId, out var qty) ? qty : 1;
    }

    private void DecreaseItemQty(OrderDetailItemDto item)
    {
        if (item.DaTraHet) return;
        var current = GetReturnQty(item.MaBienThe);
        if (current > 1)
        {
            _returnQuantities[item.MaBienThe] = current - 1;
            if (item.MaBienThe == _selectedVariantId) _returnQty = current - 1;
        }
    }

    private void IncreaseItemQty(OrderDetailItemDto item)
    {
        if (item.DaTraHet) return;
        var current = GetReturnQty(item.MaBienThe);
        var max = item.SoLuongConLai > 0 ? item.SoLuongConLai : 1;
        if (current < max)
        {
            _returnQuantities[item.MaBienThe] = current + 1;
            if (item.MaBienThe == _selectedVariantId) _returnQty = current + 1;
        }
    }

    private void OnChangeReturnQty(OrderDetailItemDto item, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (item.DaTraHet) return;
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            var max = item.SoLuongConLai > 0 ? item.SoLuongConLai : 1;
            var clamped = Math.Clamp(val, 1, max);
            _returnQuantities[item.MaBienThe] = clamped;
            if (item.MaBienThe == _selectedVariantId) _returnQty = clamped;
        }
    }

    private int TotalReturnQty => _returnItems?
        .Where(i => _selectedVariantIds.Contains(i.MaBienThe))
        .Sum(i => GetReturnQty(i.MaBienThe)) ?? 0;

    private decimal TotalRefundAmount => _returnItems?
        .Where(i => _selectedVariantIds.Contains(i.MaBienThe))
        .Sum(i => i.DonGia * GetReturnQty(i.MaBienThe)) ?? 0m;

    private void CloseReturnModal()
    {
        _returnOrder = null;
        _returnItems = null;
        _selectedVariantIds.Clear();
        _returnQuantities.Clear();
    }

    private async Task SubmitReturnRequestAsync()
    {
        if (_returnOrder == null || !_selectedVariantIds.Any()) return;

        if (string.IsNullOrWhiteSpace(_returnCustomerName))
        {
            Toast.ShowWarning("Vui lòng nhập họ và tên người gửi.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_returnCustomerPhone))
        {
            Toast.ShowWarning("Vui lòng nhập số điện thoại liên hệ.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_returnReason))
        {
            Toast.ShowWarning("Vui lòng nhập lý do hoàn trả hàng chi tiết.");
            return;
        }

        if (_returnMethod == "Thu hồi tại nhà" && string.IsNullOrWhiteSpace(_returnPickupAddress))
        {
            Toast.ShowWarning("Vui lòng nhập địa chỉ thu hồi tại nhà để bưu tá đến lấy.");
            return;
        }

        if (_returnMethod == "Đến chi nhánh" && _selectedBranchId <= 0)
        {
            Toast.ShowWarning("Vui lòng chọn chi nhánh tiếp nhận hàng hoàn.");
            return;
        }

        _isSubmittingReturn = true;
        try
        {
            var selectedList = _returnItems?
                .Where(i => _selectedVariantIds.Contains(i.MaBienThe))
                .ToList() ?? new();

            var req = new global::Shared.DTOs.Feedback.CreateReturnRequestDto
            {
                MaHoaDon = _returnOrder.MaHoaDon,
                MaBienThe = selectedList.First().MaBienThe,
                SoLuongTra = selectedList.Sum(i => GetReturnQty(i.MaBienThe)),
                Items = selectedList.Select(i => new global::Shared.DTOs.Feedback.ReturnItemRequestDto
                {
                    MaBienThe = i.MaBienThe,
                    SoLuongTra = GetReturnQty(i.MaBienThe),
                    TenSanPham = i.TenSanPham,
                    MauSac = i.MauSac,
                    KichCo = i.KichCo
                }).ToList(),
                LyDoTra = _returnReason.Trim(),
                HoTen = _returnCustomerName.Trim(),
                DienThoai = _returnCustomerPhone.Trim(),
                Email = string.IsNullOrWhiteSpace(_returnCustomerEmail) ? null : _returnCustomerEmail.Trim(),
                HinhThucHoan = _returnMethod,
                DiaChiThuHoi = _returnMethod == "Thu hồi tại nhà" ? _returnPickupAddress.Trim() : null,
                MaChiNhanhHen = _returnMethod == "Đến chi nhánh" ? _selectedBranchId : null
            };

            var res = await CustomerApi.SubmitReturnRequestAsync(req);
            if (res.Success)
            {
                var itemText = selectedList.Count > 1 ? $"{selectedList.Count} sản phẩm" : "sản phẩm";
                Toast.ShowSuccess($"Đã lập 1 phiếu hoàn trả thành công cho {itemText} (Đơn #DH-{_returnOrder.MaHoaDon})! Đã chuyển tiếp vào hệ thống Khiếu nại & CSKH để giải quyết.");
                CloseReturnModal();
                await LoadOrdersAsync();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Không thể gửi yêu cầu hoàn trả.");
            }
        }
        finally
        {
            _isSubmittingReturn = false;
        }
    }
}
