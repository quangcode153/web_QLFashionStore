@page "/profile/orders"
@page "/orders"
@namespace Frontend.Pages.Customer
@inject ICustomerApiClient CustomerApi
@inject ICatalogApiClient CatalogApi
@inject NavigationManager Navigation
@inject IToastService Toast

<div class="orders-page-wrapper">
    <div class="yame-container">
        <!-- Breadcrumb -->
        <nav class="orders-breadcrumb" aria-label="Đường dẫn">
            <a href="/" class="bc-link">Trang chủ</a>
            <span class="bc-sep">/</span>
            <a href="/profile" class="bc-link">Tài khoản</a>
            <span class="bc-sep">/</span>
            <span class="bc-curr">Lịch sử đơn hàng</span>
        </nav>

        <!-- TikTok Shop Header & Search -->
        <div class="tiktok-header-bar">
            <div class="tiktok-title-row">
                <h1 class="orders-page-title mb-0">LỊCH SỬ ĐƠN HÀNG CỦA BẠN</h1>
                <span class="tiktok-title-sub">Theo dõi vận chuyển & Quản lý đơn hàng trực quan</span>
            </div>
            
            <div class="tiktok-search-box">
                <span class="tiktok-search-icon">🔍</span>
                <input type="text" 
                       class="tiktok-search-input" 
                       placeholder="Tìm kiếm theo mã đơn #DH, địa chỉ nhận hàng, phương thức thanh toán..." 
                       @bind="_searchQuery" 
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button" class="btn-clear-search" @onclick='() => _searchQuery = ""' title="Xóa tìm kiếm">✕</button>
                }
            </div>
        </div>

        @if (_orders != null && _orders.Any())
        {
            <div class="customer-order-tabs tiktok-tabs-bar">
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == null ? "active" : "")" 
                        data-tab="Tất cả"
                        @onclick="() => FilterOrdersByTab(null)">
                    Tất cả <span class="tab-count-pill">@_orders.Count</span>
                </button>
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == "Chờ xử lý" ? "active" : "")" 
                        data-tab="Chờ xử lý"
                        @onclick='() => FilterOrdersByTab("Chờ xử lý")'>
                    Chờ thanh toán <span class="tab-count-pill">@_orders.Count(x => x.TrangThai == "Chờ xử lý")</span>
                </button>
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == "Đang giao hàng" ? "active" : "")" 
                        data-tab="Đang giao hàng"
                        @onclick='() => FilterOrdersByTab("Đang giao hàng")'>
                    Chờ vận chuyển <span class="tab-count-pill">@_orders.Count(x => x.TrangThai == "Đang giao hàng")</span>
                </button>
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == "Đã hoàn thành" ? "active" : "")" 
                        data-tab="Thành công"
                        @onclick='() => FilterOrdersByTab("Đã hoàn thành")'>
                    Đã hoàn tất <span class="tab-count-pill">@_orders.Count(x => (x.TrangThai == "Đã hoàn thành" || x.TrangThai == "Hoàn thành") && !IsOrderReturnedOrPending(x))</span>
                </button>
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == "Đã hoàn trả" ? "active" : "")" 
                        data-tab="Đã hoàn trả"
                        @onclick='() => FilterOrdersByTab("Đã hoàn trả")'>
                    Đã hoàn trả <span class="tab-count-pill">@_orders.Count(x => IsOrderReturnedOrPending(x) || x.TrangThai == "Đã hoàn trả")</span>
                </button>
                <button type="button" 
                        class="order-tab-btn @(_selectedStatusTab == "Đã hủy" ? "active" : "")" 
                        data-tab="Đã hủy"
                        @onclick='() => FilterOrdersByTab("Đã hủy")'>
                    Đã hủy <span class="tab-count-pill">@_orders.Count(x => x.TrangThai == "Đã hủy")</span>
                </button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="orders-loading-state">
                <span class="loading-icon">⏳</span>
                <p>Đang tải danh sách đơn hàng...</p>
            </div>
        }
        else if (_orders == null || !_orders.Any())
        {
            <div class="orders-empty-state">
                <span class="empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </span>
                <h2 class="empty-title">Bạn chưa có đơn hàng nào</h2>
                <p class="empty-desc">Hãy khám phá ngay những bộ sưu tập thời trang cao cấp mới nhất từ QF nhé!</p>
                <a href="/catalog" class="btn-explore-shop">KHÁM PHÁ CỬA HÀNG NGAY</a>
            </div>
        }
        else if (!FilteredOrders.Any())
        {
            <div class="orders-empty-state" style="padding: 40px 20px;">
                <p class="empty-desc" style="margin-bottom: 0;">Không có đơn hàng nào phù hợp với bộ lọc hoặc tìm kiếm hiện tại.</p>
            </div>
        }
        else
        {
            <div class="orders-table-card tiktok-orders-container">
                @foreach (var order in FilteredOrders)
                {
                    <div class="order-row tiktok-order-card">
                        <!-- 1. Shop Header (TikTok Mall Header) -->
                        <div class="tiktok-shop-header">
                            <div class="tiktok-shop-left">
                                <span class="tiktok-mall-badge">Mall</span>
                                <span class="tiktok-shop-title">QF NOIR Official</span>
                                <span class="tiktok-live-badge">
                                    <span class="live-dot"></span> LIVE
                                </span>
                                <span class="tiktok-chevron-arrow">&gt;</span>
                            </div>
                            <div class="tiktok-status-right cell-status">
                                @if (IsOrderReturnPending(order))
                                {
                                    <span class="status-badge status-return-pending">
                                        Đang hoàn trả
                                    </span>
                                }
                                else if (IsOrderReturned(order) && !order.ConHangCoTheHoan)
                                {
                                    <span class="status-badge status-returned">
                                        Đã hoàn trả
                                    </span>
                                }
                                else if (order.TongSoLuongDaTra > 0 && order.ConHangCoTheHoan)
                                {
                                    <span class="status-badge status-returned" title="Đã hoàn một phần (@order.TongSoLuongDaTra/@order.TongSoLuongDaMua sp)">
                                        Hoàn 1 phần (@order.TongSoLuongDaTra/@order.TongSoLuongDaMua)
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge @GetStatusBadgeClass(order.TrangThai)">
                                        @order.TrangThai
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- 2. TikTok Shipping Tracker Box -->
                        <div class="tiktok-shipping-pill" @onclick="() => OpenOrderDetailsModalAsync(order)">
                            <div class="shipping-pill-icon">
                                @if (order.TrangThai == "Đã hoàn thành" || order.TrangThai == "Hoàn thành")
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                                else if (order.TrangThai == "Đang giao hàng")
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                }
                                else if (order.TrangThai == "Chờ xử lý")
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                }
                                else if (order.TrangThai == "Đã hủy")
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                }
                            </div>
                            <div class="shipping-pill-text">
                                <div class="shipping-pill-status">
                                    @if (order.TrangThai == "Đã hoàn thành" || order.TrangThai == "Hoàn thành")
                                    {
                                        <strong>@order.NgayLapHoaDon.ToString("HH:mm") Đã giao</strong>
                                    }
                                    else if (order.TrangThai == "Đang giao hàng")
                                    {
                                        <strong>Đang vận chuyển giao hàng</strong>
                                    }
                                    else if (order.TrangThai == "Chờ xử lý")
                                    {
                                        <strong>Đang chuẩn bị kiện hàng tại kho</strong>
                                    }
                                    else if (order.TrangThai == "Đã hủy")
                                    {
                                        <strong>Đơn hàng đã được hủy</strong>
                                    }
                                    else
                                    {
                                        <strong>Tiếp nhận yêu cầu hoàn trả</strong>
                                    }
                                </div>
                                <div class="shipping-pill-sub">
                                    @if (order.TrangThai == "Đã hoàn thành" || order.TrangThai == "Hoàn thành")
                                    {
                                        <span>Kiện hàng của bạn đã được giao đến nơi thành công....</span>
                                    }
                                    else if (order.TrangThai == "Đang giao hàng")
                                    {
                                        <span>Kiện hàng đang được bưu tá phát đến địa chỉ nhận.</span>
                                    }
                                    else if (order.TrangThai == "Chờ xử lý")
                                    {
                                        <span>Shop đang đóng gói và sắp xếp chuyển giao cho bưu cục.</span>
                                    }
                                    else if (order.TrangThai == "Đã hủy")
                                    {
                                        <span>Đơn hàng đã đóng lại theo chính sách sàn.</span>
                                    }
                                    else
                                    {
                                        <span>Bộ phận CSKH đang xử lý hồ sơ đổi trả của quý khách.</span>
                                    }
                                </div>
                            </div>
                            <span class="shipping-pill-arrow">&gt;</span>
                        </div>

                        <!-- 3. TikTok Order Item Preview -->
                        <div class="tiktok-item-preview" @onclick="() => OpenOrderDetailsModalAsync(order)">
                            <div class="tiktok-item-thumb-wrapper">
                                <div class="tiktok-item-thumb">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="tiktok-item-details">
                                <div class="tiktok-item-header-line">
                                    <span class="cell-id tiktok-order-code">#DH-@order.MaHoaDon</span>
                                    <span class="tiktok-order-title">Thời trang cao cấp QF NOIR Official</span>
                                </div>
                                <div class="tiktok-item-meta-line">
                                    <span class="cell-date">@order.NgayLapHoaDon.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span class="meta-dot">•</span>
                                    <span class="cell-qty">@order.SoMatHang sản phẩm</span>
                                    @if (!string.IsNullOrEmpty(order.DiaChiGiaoHangClean))
                                    {
                                        <span class="meta-dot">•</span>
                                        <span class="tiktok-addr-preview" title="@order.DiaChiGiaoHangClean">📍 @order.DiaChiGiaoHangClean</span>
                                    }
                                </div>
                                <div class="tiktok-pttt-box">
                                    <span class="order-pttt-pill @(order.PhuongThucThanhToan.Contains("VietQR") ? "pill-vietqr" : order.PhuongThucThanhToan.Contains("MoMo") ? "pill-momo" : "pill-cod")">
                                        @(order.PhuongThucThanhToan.Contains("VietQR") ? "🔷 VietQR" : order.PhuongThucThanhToan.Contains("MoMo") ? "🟣 MoMo" : "💵 COD")
                                    </span>
                                </div>
                            </div>
                            <div class="tiktok-item-price-col cell-total">
                                <div class="tiktok-unit-price">@order.TongThanhToan.ToString("N0") ₫</div>
                                <div class="tiktok-qty-tag">x@order.SoMatHang</div>
                            </div>
                        </div>

                        <!-- 4. TikTok Card Bottom: Subtotal, Social Bubble & Action Buttons -->
                        <div class="tiktok-card-bottom">
                            <div class="tiktok-total-row">
                                <span class="tiktok-total-lead">Tổng:</span>
                                <span class="tiktok-total-amount">@order.TongThanhToan.ToString("N0") ₫</span>
                            </div>
                            <div class="tiktok-actions-row cell-action">
                                <a href="/cart" class="btn-tiktok-cart" title="Giỏ hàng của bạn">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </a>

                                <button type="button" 
                                        class="btn-tiktok-repurchase" 
                                        @onclick="() => RepurchaseOrderAsync(order)"
                                        disabled="@_isRepurchasing"
                                        title="Xem và mua lại sản phẩm trong đơn này">
                                    @if (_repurchasingOrderId == order.MaHoaDon)
                                    {
                                        <span>Đang mở...</span>
                                    }
                                    else
                                    {
                                        <span>Mua lại</span>
                                    }
                                </button>

                                <button type="button" 
                                        class="btn-view-order-details" 
                                        @onclick="() => OpenOrderDetailsModalAsync(order)">
                                    Chi tiết
                                </button>

                                @if (order.TrangThai == "Chờ xử lý" || order.TrangThai == "Chờ thanh toán")
                                {
                                    <a href="/order-success/@order.MaHoaDon?payment=MOMO" 
                                       class="btn-pay-qr" 
                                       title="Quét mã MoMo hoặc VietQR thanh toán">
                                        💳 Thanh toán QR
                                    </a>
                                }

                                @if (order.ConHangCoTheHoan)
                                {
                                    <button type="button" 
                                            class="btn-open-return-modal" 
                                            @onclick="() => OpenReturnModalAsync(order)"
                                            title="Đăng ký hoàn trả hàng cho đơn này">
                                        Hoàn trả
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Order Details Modal -->
        @if (_selectedOrder != null)
        {
            <div class="modal-backdrop" @onclick="CloseModal"></div>
            <div class="order-details-modal" role="dialog" aria-modal="true">
                <div class="modal-header">
                    <div class="modal-title-box">
                        <h3 class="modal-title">CHI TIẾT ĐƠN HÀNG #DH-@_selectedOrder.MaHoaDon</h3>
                        <div class="modal-subtitle-row">
                            <span class="modal-subtitle">Ngày đặt: @_selectedOrder.NgayLapHoaDon.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="modal-pttt-badge @(_selectedOrder.PhuongThucThanhToan.Contains("VietQR") ? "badge-vietqr" : _selectedOrder.PhuongThucThanhToan.Contains("MoMo") ? "badge-momo" : "badge-cod")">
                                @if (_selectedOrder.PhuongThucThanhToan.Contains("VietQR"))
                                {
                                    <span>🔷 Chuyển khoản VietQR</span>
                                }
                                else if (_selectedOrder.PhuongThucThanhToan.Contains("MoMo"))
                                {
                                    <span>🟣 Ví điện tử MoMo</span>
                                }
                                else if (_selectedOrder.LoaiDonHang == "TAI_QUAY")
                                {
                                    <span>🏪 Mua tại quầy POS</span>
                                }
                                else
                                {
                                    <span>💵 Thanh toán khi nhận hàng (COD)</span>
                                }
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close-modal" @onclick="CloseModal" aria-label="Đóng">✕</button>
                </div>

                <div class="modal-body">
                    @if (_isLoadingDetails)
                    {
                        <div class="modal-loading">⏳ Đang tải chi tiết đơn hàng...</div>
                    }
                    else if (_orderDetails == null || !_orderDetails.Any())
                    {
                        <div class="modal-empty">Không có dữ liệu mặt hàng chi tiết.</div>
                    }
                    else
                    {
                        <div class="modal-items-list">
                            @foreach (var item in _orderDetails)
                            {
                                <div class="modal-item-row">
                                    <div class="item-main">
                                        <h4 class="item-name item-name-link" @onclick="() => RepurchaseSingleItemAsync(item.TenSanPham)" title="Bấm để xem trang sản phẩm và mua lại">
                                            @item.TenSanPham
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="vertical-align: middle; margin-left: 3px;">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                        </h4>
                                        <span class="item-variant">@item.MauSac / @item.KichCo</span>
                                        <span class="item-qty">Số lượng: <strong>@item.SoLuong</strong> x @item.DonGia.ToString("N0") ₫</span>
                                    </div>
                                    <div class="item-actions-side">
                                        <span class="item-subtotal">@item.ThanhTien.ToString("N0") ₫</span>
                                        <button type="button" class="btn-item-repurchase" @onclick="() => RepurchaseSingleItemAsync(item.TenSanPham)" title="Xem và mua lại sản phẩm này">
                                            Mua lại
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-summary-box">
                            <div class="sum-row pttt-highlight-row">
                                <span class="sum-label-bold">Phương thức thanh toán:</span>
                                <span class="pttt-status-text @(_selectedOrder.PhuongThucThanhToan.Contains("VietQR") ? "text-vietqr" : _selectedOrder.PhuongThucThanhToan.Contains("MoMo") ? "text-momo" : "text-cod")">
                                    @if (_selectedOrder.PhuongThucThanhToan.Contains("VietQR"))
                                    {
                                        <strong>🔷 Chuyển khoản QR (VietQR Napas 24/7)</strong>
                                    }
                                    else if (_selectedOrder.PhuongThucThanhToan.Contains("MoMo"))
                                    {
                                        <strong>🟣 Ví MoMo (Chuyển khoản QR)</strong>
                                    }
                                    else if (_selectedOrder.LoaiDonHang == "TAI_QUAY")
                                    {
                                        <strong>🏪 Mua & Thanh toán tại quầy</strong>
                                    }
                                    else
                                    {
                                        <strong>💵 Thanh toán khi nhận hàng (COD)</strong>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(_selectedOrder.DiaChiGiaoHangClean))
                            {
                                <div class="sum-row delivery-address-row">
                                    <span>Địa chỉ giao hàng:</span>
                                    <span class="delivery-address-val">@_selectedOrder.DiaChiGiaoHangClean</span>
                                </div>
                            }
                            <div class="sum-row">
                                <span>Tiền hàng:</span>
                                <span>@_selectedOrder.TienHang.ToString("N0") ₫</span>
                            </div>
                            @if (_selectedOrder.TienGiamGia > 0)
                            {
                                <div class="sum-row discount">
                                    <span>Voucher / Giảm giá:</span>
                                    <span>-@_selectedOrder.TienGiamGia.ToString("N0") ₫</span>
                                </div>
                            }
                            <div class="sum-row total">
                                <span>Tổng thanh toán:</span>
                                <span class="total-price">@_selectedOrder.TongThanhToan.ToString("N0") ₫</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-modal-close-action" @onclick="CloseModal">
                        ĐÓNG
                    </button>
                </div>
            </div>
        }

        <!-- Return Request Modal -->
        @if (_returnOrder != null)
        {
            <div class="modal-backdrop" @onclick="CloseReturnModal"></div>
            <div class="order-details-modal return-modal-card" role="dialog" aria-modal="true">
                <div class="modal-header">
                    <div class="modal-title-box">
                        <h3 class="modal-title">ĐĂNG KÝ HOÀN TRẢ HÀNG - ĐƠN #DH-@_returnOrder.MaHoaDon</h3>
                        <span class="modal-subtitle">Phiếu tiếp nhận yêu cầu hoàn trả sẽ được chuyển vào mục Khiếu nại & CSKH để xử lý</span>
                    </div>
                    <button type="button" class="btn-close-modal" @onclick="CloseReturnModal" aria-label="Đóng">✕</button>
                </div>

                <div class="modal-body">
                    @if (_isLoadingReturnItems)
                    {
                        <div class="modal-loading">⏳ Đang tải danh sách mặt hàng có thể hoàn trả...</div>
                    }
                    else if (_returnItems == null || !_returnItems.Any())
                    {
                        <div class="modal-empty">Không tìm thấy mặt hàng trong đơn hàng này.</div>
                    }
                    else
                    {
                        <div class="return-form-group">
                            <div class="return-picker-header">
                                <label class="form-label mb-0">1. Chọn sản phẩm bạn muốn hoàn trả (*):</label>
                                @{
                                    var selectableCount = _returnItems?.Count(i => !i.DaTraHet) ?? 0;
                                }
                                @if (selectableCount > 1)
                                {
                                    <button type="button" class="btn-select-all-returns" @onclick="ToggleSelectAllReturns">
                                        @(_selectedVariantIds.Count == selectableCount ? "Bỏ chọn tất cả" : "Chọn tất cả sản phẩm khả dụng")
                                    </button>
                                }
                            </div>
                            <div class="return-items-picker">
                                @foreach (var item in _returnItems!)
                                {
                                    var isSelected = _selectedVariantIds.Contains(item.MaBienThe);
                                    var isItemDisabled = item.DaTraHet;
                                    <div class="return-item-choice @(isItemDisabled ? "disabled-item" : (isSelected ? "selected" : ""))" 
                                         @onclick="() => { if (!isItemDisabled) ToggleReturnItemSelection(item); }">
                                        <input type="checkbox" 
                                               class="return-item-checkbox" 
                                               checked="@isSelected"
                                               disabled="@isItemDisabled"
                                               @onclick:stopPropagation
                                               @onchange="() => { if (!isItemDisabled) ToggleReturnItemSelection(item); }" />
                                        <div class="item-choice-info">
                                            <div class="item-choice-title">
                                                @item.TenSanPham
                                                @if (isItemDisabled)
                                                {
                                                    <span class="badge-fully-returned">Đã hoàn tất</span>
                                                }
                                            </div>
                                            <div class="item-choice-meta">
                                                Phân loại: <strong>@item.MauSac / @item.KichCo</strong> | Đã mua: <strong>@item.SoLuong</strong> sp
                                                @if (item.SoLuongDaTra > 0)
                                                {
                                                    <span class="text-returned-info"> | Đã hoàn: <strong>@item.SoLuongDaTra</strong> sp</span>
                                                }
                                                @if (!isItemDisabled)
                                                {
                                                    <span class="text-available-info"> | Có thể hoàn: <strong>@item.SoLuongConLai</strong> sp</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="item-choice-right" @onclick:stopPropagation>
                                            <div class="item-choice-price">@item.DonGia.ToString("N0") ₫</div>
                                            @if (isSelected && !isItemDisabled)
                                            {
                                                <div class="item-choice-qty-control">
                                                    <span class="qty-mini-label">SL hoàn:</span>
                                                    <div class="qty-stepper-compact">
                                                        <button type="button" class="btn-stepper-ctrl" @onclick="() => DecreaseItemQty(item)">−</button>
                                                        <input type="number" 
                                                               class="stepper-input-ctrl font-mono" 
                                                               min="1" 
                                                               max="@item.SoLuongConLai" 
                                                               value="@GetReturnQty(item.MaBienThe)" 
                                                               @onchange="(e) => OnChangeReturnQty(item, e)" />
                                                        <button type="button" class="btn-stepper-ctrl" @onclick="() => IncreaseItemQty(item)">+</button>
                                                    </div>
                                                    <span class="qty-max-hint">/ @item.SoLuongConLai sp</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (_selectedVariantIds.Any())
                            {
                                <div class="return-summary-pill">
                                    <span>Đã chọn: <strong>@_selectedVariantIds.Count</strong> mặt hàng (Tổng SL hoàn: <strong>@TotalReturnQty</strong> sp)</span>
                                    <span class="refund-estimate">Dự kiến hoàn trả: <strong>@TotalRefundAmount.ToString("N0") ₫</strong></span>
                                </div>
                            }
                        </div>

                        @if (_selectedVariantIds.Any())
                        {
                            <div class="return-grid-2col">
                                <div class="return-form-group">
                                    <label class="form-label">2. Họ và tên người gửi (*):</label>
                                    <input type="text" class="form-control-input" placeholder="Họ và tên của bạn..." @bind="_returnCustomerName" />
                                </div>

                                <div class="return-form-group">
                                    <label class="form-label">Số điện thoại liên hệ (*):</label>
                                    <input type="tel" class="form-control-input" placeholder="Số điện thoại..." @bind="_returnCustomerPhone" />
                                </div>

                                <div class="return-form-group full-col">
                                    <label class="form-label">Email thông báo kết quả (tùy chọn):</label>
                                    <input type="email" class="form-control-input" placeholder="Địa chỉ email..." @bind="_returnCustomerEmail" />
                                </div>
                            </div>

                            <div class="return-form-group full-col">
                                <label class="form-label">3. Chọn hình thức hoàn trả hàng (*):</label>
                                <div class="return-methods-row">
                                    <label class="return-method-card @(_returnMethod == "Thu hồi tại nhà" ? "selected" : "")">
                                        <input type="radio" 
                                               name="returnMethodChoice" 
                                               class="radio-return-home" 
                                               checked="@(_returnMethod == "Thu hồi tại nhà")" 
                                               @onchange='() => _returnMethod = "Thu hồi tại nhà"' />
                                        <div class="method-card-body">
                                            <span class="method-name">🚚 Bưu tá đến lấy tại nhà (Thu hồi tận nơi)</span>
                                            <span class="method-desc">Bưu tá liên hệ lấy hàng hoàn tại địa chỉ bạn cung cấp.</span>
                                        </div>
                                    </label>

                                    <label class="return-method-card @(_returnMethod == "Đến chi nhánh" ? "selected" : "")">
                                        <input type="radio" 
                                               name="returnMethodChoice" 
                                               class="radio-return-branch" 
                                               checked="@(_returnMethod == "Đến chi nhánh")" 
                                               @onchange='() => _returnMethod = "Đến chi nhánh"' />
                                        <div class="method-card-body">
                                            <span class="method-name">🏬 Trực tiếp mang đến chi nhánh QF Store</span>
                                            <span class="method-desc">Chủ động gửi sản phẩm tại chi nhánh gần bạn nhất.</span>
                                        </div>
                                    </label>
                                </div>

                                @if (_returnMethod == "Thu hồi tại nhà")
                                {
                                    <div class="return-sub-block home-pickup-block">
                                        <label class="form-sub-label">Địa chỉ thu hồi hàng (*):</label>
                                        <input type="text" 
                                               class="form-control-input input-pickup-address" 
                                               placeholder="Nhập địa chỉ nhà bưu tá đến lấy hàng..." 
                                               @bind="_returnPickupAddress" />
                                        <small class="field-hint">Bưu tá của đối tác vận chuyển sẽ tới địa chỉ này để tiếp nhận kiện hàng đổi trả.</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="return-sub-block branch-dropoff-block">
                                        <label class="form-sub-label">Chọn chi nhánh tiếp nhận hàng hoàn (*):</label>
                                        <select class="form-control-select select-branch-dropoff" @bind="_selectedBranchId">
                                            @if (_branches != null && _branches.Any())
                                            {
                                                @foreach (var b in _branches)
                                                {
                                                    <option value="@b.MaChiNhanh">@b.TenChiNhanh - @b.DiaChi</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="0">Đang tải danh sách chi nhánh...</option>
                                            }
                                        </select>
                                        @if (SelectedBranch != null)
                                        {
                                            <div class="branch-address-preview">
                                                <span>📍 <strong>Địa chỉ tiếp nhận:</strong> @SelectedBranch.DiaChi</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="return-form-group full-col">
                                <label class="form-label">4. Lý do hoàn trả hàng chi tiết (*):</label>
                                <textarea class="form-control-textarea return-reason" 
                                          rows="3" 
                                          placeholder="Mô tả cụ thể lý do hoàn trả (VD: Hàng bị rách đường chỉ may, không đúng mô tả, lỗi khóa kéo...)" 
                                          @bind="_returnReason"></textarea>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseReturnModal" disabled="@_isSubmittingReturn">
                        HỦY BỎ
                    </button>
                    <button type="button" 
                            class="btn-modal-submit-return" 
                            @onclick="SubmitReturnRequestAsync" 
                            disabled="@(_isSubmittingReturn || !_selectedVariantIds.Any())">
                        @if (_isSubmittingReturn)
                        {
                            <span>Đang gửi yêu cầu...</span>
                        }
                        else
                        {
                            <span>GỬI YÊU CẦU HOÀN TRẢ @(_selectedVariantIds.Count > 1 ? $"({_selectedVariantIds.Count} MẶT HÀNG)" : "")</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .orders-page-wrapper {
        padding: 24px 0 60px 0;
        background: #F8FAFC;
        min-height: 85vh;
    }
