        font-size: 1.75rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }
    .orders-loading-state, .orders-empty-state {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
