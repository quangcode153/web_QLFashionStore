    }
    .btn-clear-cart:hover {
        text-decoration: underline;
    }
    .summary-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 24px;
    }
    .summary-card-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #E2E8F0;
    }
    .summary-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 0.95rem;
        color: #475569;
    }
    .line-val {
        font-weight: 700;
        color: #0F172A;
    }
    .summary-divider {
        height: 1px;
        background: #E2E8F0;
        margin: 16px 0;
    }
    .summary-line.line-total {
        font-size: 1.15rem;
        margin-bottom: 6px;
    }
    .line-val.total-price {
        font-size: 1.35rem;
        font-weight: 800;
        color: #E11D48;
    }
    .summary-note {
        font-size: 0.8rem;
        color: #94A3B8;
        font-style: italic;
        margin-bottom: 24px;
    }
    .btn-proceed-checkout {
        display: block;
        width: 100%;
        background: #E11D48;
        color: #FFFFFF;
        text-align: center;
        padding: 14px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 800;
        text-decoration: none;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        transition: background 0.2s;
    }
    .btn-proceed-checkout:hover {
        background: #BE123C;
    }
    .btn-proceed-checkout.disabled {
        background: #94A3B8 !important;
        cursor: not-allowed;
        opacity: 0.7;
    }
    .unavailable-checkout-hint {
        font-size: 0.82rem;
        color: #DC2626;
        font-weight: 600;
