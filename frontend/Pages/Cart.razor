    }
    .item-title:hover {
        color: #E11D48;
    }
    .item-variant-label {
        font-size: 0.82rem;
        color: #64748B;
        margin-bottom: 2px;
    }
    .item-sku-label {
        font-size: 0.75rem;
        color: #94A3B8;
    }
    .cell-price {
        font-size: 0.92rem;
        color: #334155;
        font-weight: 600;
    }
    .item-qty-picker {
        display: inline-flex;
        align-items: center;
        border: 1px solid #CBD5E1;
        border-radius: 4px;
        overflow: hidden;
    }
    .btn-qty {
        background: #F8FAFC;
        border: none;
        width: 28px;
        height: 28px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        color: #334155;
    }
    .btn-qty:hover:not(:disabled) {
        background: #E2E8F0;
    }
    .btn-qty:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .qty-num {
        min-width: 32px;
        text-align: center;
        font-size: 0.88rem;
        font-weight: 700;
        color: #0F172A;
    }
    .cell-subtotal {
        font-size: 1rem;
        font-weight: 800;
        color: #E11D48;
    }
    .btn-delete-item {
        background: transparent;
        border: none;
