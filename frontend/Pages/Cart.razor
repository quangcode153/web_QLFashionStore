@code {
    private Dictionary<int, VariantAvailabilityDto> _availabilityMap = new();
    private bool _hasUnavailableItems => CartService.Items.Any(i => _availabilityMap.TryGetValue(i.MaBienThe, out var a) && a.DaAn);
    private int UnavailableCount => CartService.Items.Count(i => _availabilityMap.TryGetValue(i.MaBienThe, out var a) && a.DaAn);

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += OnCartChanged;
        await CheckAvailabilityAsync();
    }

    private async void OnCartChanged()
    {
        await CheckAvailabilityAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckAvailabilityAsync()
    {
        if (CartService.Items.Any())
        {
            var ids = CartService.Items.Select(x => x.MaBienThe).Distinct().ToList();
            var results = await CatalogApi.CheckVariantsAvailabilityAsync(ids);
            _availabilityMap = results.ToDictionary(x => x.MaBienThe, x => x);
        }
        else
        {
            _availabilityMap.Clear();
        }
    }

    private async Task RemoveAllUnavailableItems()
    {
        var unavailableIds = CartService.Items
            .Where(i => _availabilityMap.TryGetValue(i.MaBienThe, out var a) && a.DaAn)
            .Select(i => i.MaBienThe)
            .ToList();

        foreach (var id in unavailableIds)
        {
            await CartService.RemoveItemAsync(id);
        }
        await CheckAvailabilityAsync();
        Toast.ShowSuccess($"Đã xóa {unavailableIds.Count} sản phẩm tạm ngừng cung cấp khỏi giỏ hàng.");
    }

    private async Task IncrementQty(CartItemDto item)
    {
        await CartService.UpdateQuantityAsync(item.MaBienThe, item.SoLuong + 1);
    }

    private async Task DecrementQty(CartItemDto item)
    {
        await CartService.UpdateQuantityAsync(item.MaBienThe, item.SoLuong - 1);
    }

    private async Task RemoveItem(int maBienThe)
    {
        await CartService.RemoveItemAsync(maBienThe);
    }

    private async Task ClearCart()
    {
        await CartService.ClearCartAsync();
    }

    private async Task ProceedToCheckout()
    {
        if (_hasUnavailableItems)
        {
            Toast.ShowWarning("Trong giỏ hàng có sản phẩm tạm thời ngừng cung cấp. Vui lòng xóa trước khi thanh toán.");
            return;
        }

        string? token = null;
        try
        {
            token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authToken");
        }
        catch { }

        if (!string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/checkout");
        }
        else
        {
            Toast.ShowInfo("Vui lòng đăng nhập hoặc tạo tài khoản để hoàn tất đặt hàng.");
            Navigation.NavigateTo("/login?returnUrl=/checkout");
        }
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartChanged;
    }
}
