        font-size: 1.1rem;
        color: #94A3B8;
        transition: transform 0.15s;
    }
    .btn-delete-item:hover {
        transform: scale(1.15);
    }
    .cart-bottom-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }
    .btn-clear-cart {
        background: transparent;
        border: none;
        color: #EF4444;
        font-size: 0.85rem;
        font-weight: 600;
