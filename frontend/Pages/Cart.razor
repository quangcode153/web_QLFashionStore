    }
    @@media (max-width: 992px) {
        .cart-content-grid {
            grid-template-columns: 1fr;
        }
    }
    .cart-items-column {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 20px;
    }
    .cart-table-header {
        display: grid;
        grid-template-columns: 3fr 1.2fr 1.2fr 1.2fr 40px;
