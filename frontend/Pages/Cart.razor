    }
    .cart-unavailable-warning-banner {
        background: #FFF1F2;
        border: 1px solid #FECDD3;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }
    .warning-banner-text {
        color: #9F1239;
        font-size: 0.92rem;
        line-height: 1.5;
    }
    .btn-remove-unavailable {
        background: #E11D48;
        color: #FFFFFF;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background 0.2s;
        white-space: nowrap;
    }
    .btn-remove-unavailable:hover {
        background: #BE123C;
    }
    .cart-item-row.unavailable {
        background: #FFF8F8;
        border-left: 3px solid #FCA5A5;
    }
