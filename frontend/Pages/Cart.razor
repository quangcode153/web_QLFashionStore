@page "/cart"
@namespace Frontend.Pages
@using global::Shared.DTOs.Catalog
@inject ICartService CartService
@inject ICatalogApiClient CatalogApi
@inject IJSRuntime JSRuntime
@inject IToastService Toast
@inject NavigationManager Navigation
@implements IDisposable

<div class="cart-page-wrapper">
    <div class="yame-container">
        <!-- Breadcrumb -->
        <nav class="cart-breadcrumb" aria-label="Đường dẫn">
            <a href="/" class="bc-link">Trang chủ</a>
            <span class="bc-sep">/</span>
            <span class="bc-curr">Giỏ hàng (@CartService.TotalCount)</span>
        </nav>

        <h1 class="cart-page-title">GIỎ HÀNG CỦA BẠN</h1>

        @if (!CartService.Items.Any())
        {
            <!-- Empty Cart State -->
            <div class="cart-page-empty">
                <div class="empty-icon-lg">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <h2 class="empty-title-lg">Giỏ hàng của bạn đang trống</h2>
                <p class="empty-desc-lg">Hãy khám phá ngay các sản phẩm thời trang xu hướng mới nhất từ QF Fashion nhé!</p>
                <a href="/catalog" class="btn-continue-shopping">
                    TIẾP TỤC MUA SẮM
                </a>
            </div>
        }
        else
        {
            <!-- Freeship Notification Bar -->
            var freeshipThreshold = 50000m;
            var currentTotal = CartService.SubTotal;
            var diff = freeshipThreshold - currentTotal;
            var progressPercent = currentTotal >= freeshipThreshold ? 100 : (int)((currentTotal / freeshipThreshold) * 100);
            <div class="cart-freeship-box">
                <div class="freeship-header-row">
                    @if (currentTotal >= freeshipThreshold)
                    {
                        <span class="fs-badge success">ĐÃ ĐẠT FREESHIP</span>
                        <span class="fs-text">Đơn hàng của bạn được <strong>MIỄN PHÍ VẬN CHUYỂN</strong> toàn quốc!</span>
                    }
                    else
                    {
                        <span class="fs-badge">FREESHIP TỪ 50.000 ₫</span>
                        <span class="fs-text">Mua thêm <strong>@diff.ToString("N0") ₫</strong> để được miễn phí vận chuyển!</span>
                    }
                </div>
                <div class="freeship-track">
                    <div class="freeship-bar" style="width: @(progressPercent)%"></div>
                </div>
            </div>

            @if (_hasUnavailableItems)
            {
                <div class="cart-unavailable-warning-banner">
                    <div class="warning-banner-text">
                        <strong>⚠️ Lưu ý quan trọng:</strong> Giỏ hàng của bạn đang có <strong>@UnavailableCount sản phẩm tạm thời không cung cấp</strong>. Vui lòng xóa các sản phẩm này để có thể tiếp tục tiến hành đặt hàng.
                    </div>
                    <button type="button" class="btn-remove-unavailable" @onclick="RemoveAllUnavailableItems">
                        Xóa sản phẩm tạm ngừng (@UnavailableCount)
                    </button>
                </div>
            }

            <!-- Main Cart Content Grid -->
            <div class="cart-content-grid">
                <!-- Left: Items Table / List -->
                <div class="cart-items-column">
                    <div class="cart-table-header">
                        <span class="col-product">Sản phẩm</span>
                        <span class="col-price">Đơn giá</span>
                        <span class="col-qty">Số lượng</span>
                        <span class="col-total">Thành tiền</span>
                        <span class="col-action"></span>
                    </div>

                    <div class="cart-table-body">
                        @foreach (var item in CartService.Items)
                        {
                            var isUnavailable = _availabilityMap.TryGetValue(item.MaBienThe, out var avail) && avail.DaAn;
                            <div class="cart-item-row @(isUnavailable ? "unavailable" : "")">
                                <div class="col-product item-meta">
                                    <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "/images/no-image.svg" : item.HinhAnh)" 
                                         alt="@item.TenSanPham" 
                                         class="item-thumb" 
                                         loading="lazy" 
                                         decoding="async" 
                                         onerror="this.onerror=null;this.src='/images/no-image.svg';" />
                                    <div class="item-text">
                                        <a href="/products/@item.MaSanPham" class="item-title">@item.TenSanPham</a>
                                        <div class="item-variant-label">Phân loại: <strong>@item.MauSac / @item.KichCo</strong></div>
                                        <div class="item-sku-label">SKU: @item.MaSKU</div>
                                        @if (isUnavailable)
                                        {
                                            <div class="item-unavailable-tag">
                                                <span class="unavail-icon">⚠️</span> Sản phẩm tạm thời không cung cấp
                                            </div>
                                        }
                                        <!-- Mobile Price & Qty Stepper (Single neat row on mobile) -->
                                        <div class="mobile-item-pricing-row">
                                            <div class="mobile-price-box">
                                                <span class="mobile-cell-subtotal">@item.ThanhTien.ToString("N0") ₫</span>
                                                @if (item.SoLuong > 1)
                                                {
                                                    <span class="mobile-cell-unit">(@item.DonGia.ToString("N0") ₫/cái)</span>
                                                }
                                            </div>
                                            <div class="item-qty-picker mobile-qty-picker">
                                                <button type="button" class="btn-qty" @onclick="() => DecrementQty(item)">−</button>
                                                <span class="qty-num">@item.SoLuong</span>
                                                <button type="button" class="btn-qty" @onclick="() => IncrementQty(item)" disabled="@(item.SoLuong >= item.SoLuongTon)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-price desktop-only-col">
                                    <span class="cell-price">@item.DonGia.ToString("N0") ₫</span>
                                </div>

                                <div class="col-qty desktop-only-col">
                                    <div class="item-qty-picker">
                                        <button type="button" class="btn-qty" @onclick="() => DecrementQty(item)">−</button>
                                        <span class="qty-num">@item.SoLuong</span>
                                        <button type="button" class="btn-qty" @onclick="() => IncrementQty(item)" disabled="@(item.SoLuong >= item.SoLuongTon)">+</button>
                                    </div>
                                </div>

                                <div class="col-total desktop-only-col">
                                    <span class="cell-subtotal">@item.ThanhTien.ToString("N0") ₫</span>
                                </div>

                                <div class="col-action">
                                    <button type="button" class="btn-delete-item" @onclick="() => RemoveItem(item.MaBienThe)" title="Xóa món">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="cart-bottom-actions">
                        <a href="/catalog" class="btn-continue-shopping secondary">
                            ← Tiếp tục xem sản phẩm
                        </a>
                        <button type="button" class="btn-clear-cart" @onclick="ClearCart">
                            Xóa toàn bộ giỏ hàng
                        </button>
                    </div>
                </div>

                <!-- Right: Order Summary Sidebar -->
                <div class="cart-summary-column">
                    <div class="summary-card">
                        <h3 class="summary-card-title">TỔNG QUAN ĐƠN HÀNG</h3>

                        <div class="summary-line">
                            <span class="line-label">Tạm tính:</span>
                            <span class="line-val">@CartService.SubTotal.ToString("N0") ₫</span>
                        </div>

                        <div class="summary-line">
                            <span class="line-label">Phí vận chuyển:</span>
                            <span class="line-val">@(CartService.SubTotal >= 50000m ? "MIỄN PHÍ" : "30.000 ₫")</span>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="summary-line line-total">
                            <span class="line-label">Tổng cộng:</span>
                            <span class="line-val total-price">
                                @((CartService.SubTotal >= 50000m ? CartService.SubTotal : CartService.SubTotal + 30000m).ToString("N0")) ₫
                            </span>
                        </div>

                        <p class="summary-note">*(Giá đã bao gồm thuế VAT và áp dụng ưu đãi)*</p>

                        @if (_hasUnavailableItems)
                        {
                            <button type="button" class="btn-proceed-checkout disabled" disabled title="Vui lòng xóa sản phẩm tạm ngừng cung cấp trước khi thanh toán">
                                TIẾN HÀNH ĐẶT HÀNG
                            </button>
                            <p class="unavailable-checkout-hint">⚠️ Vui lòng xóa các sản phẩm tạm thời ngừng cung cấp để tiếp tục thanh toán.</p>
                        }
                        else
                        {
                            <button type="button" class="btn-proceed-checkout" @onclick="ProceedToCheckout">
                                TIẾN HÀNH ĐẶT HÀNG
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .cart-page-wrapper {
        padding: 24px 0 60px 0;
        background: #F8FAFC;
        min-height: 80vh;
    }
    .cart-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        margin-bottom: 20px;
    }
    .bc-link {
        color: #64748B;
        text-decoration: none;
    }
    .bc-link:hover {
        color: #0F172A;
    }
    .bc-sep {
        color: #CBD5E1;
    }
    .bc-curr {
        color: #0F172A;
        font-weight: 700;
    }
    .cart-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }
    .cart-page-empty {
        background: #FFFFFF;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        padding: 60px 20px;
        text-align: center;
    }
    .empty-icon-lg {
        font-size: 4rem;
        margin-bottom: 16px;
    }
    .empty-title-lg {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 10px;
    }
    .empty-desc-lg {
        font-size: 0.95rem;
        color: #64748B;
        margin-bottom: 28px;
    }
    .btn-continue-shopping {
        display: inline-block;
        background: #000000;
        color: #FFFFFF !important;
        font-weight: 700;
        padding: 13px 32px;
        border-radius: 4px;
        border: 1px solid #000000;
        text-decoration: none !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .btn-continue-shopping:hover {
        background: #000000 !important;
        color: #FFFFFF !important;
        text-decoration: none !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    }
    .btn-continue-shopping:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    .btn-continue-shopping.secondary {
        background: transparent;
        color: #334155;
        border: 1px solid #CBD5E1;
        padding: 10px 20px;
        font-size: 0.88rem;
    }
    .btn-continue-shopping.secondary:hover {
        background: #F1F5F9;
        border-color: #94A3B8;
    }
    .cart-freeship-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 24px;
    }
    .freeship-header-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        font-size: 0.92rem;
    }
    .fs-badge {
        background: #FEF3C7;
        color: #D97706;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 4px;
    }
    .fs-badge.success {
        background: #D1FAE5;
        color: #059669;
    }
    .freeship-track {
        height: 8px;
        background: #E2E8F0;
        border-radius: 999px;
        overflow: hidden;
    }
    .freeship-bar {
        height: 100%;
        background: #E11D48;
        transition: width 0.3s ease;
    }
    .cart-content-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 24px;
