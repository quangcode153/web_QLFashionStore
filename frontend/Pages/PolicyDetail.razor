    .auth-hint-text {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: #b45309;
        font-weight: 600;
        margin-right: 1rem;
        align-self: center;
    }
    .feedback-auth-alert {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1.5rem;
    }
    .auth-alert-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .auth-alert-content {
        flex: 1;
    }
    .auth-alert-content strong {
        display: block;
        color: #92400e;
        font-size: 0.875rem;
        margin-bottom: 2px;
    }
    .auth-alert-content p {
        margin: 0;
        font-size: 0.825rem;
        color: #b45309;
        line-height: 1.4;
    }
    .btn-auth-action {
        flex-shrink: 0;
        background: #0f172a;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-auth-action:hover {
        background: #1e293b;
        transform: translateY(-1px);
    }
    
    .feedback-draft-restored-banner {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 0.85rem 1.15rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.25rem;
