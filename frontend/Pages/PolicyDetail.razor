@page "/policies/{slug}"
@page "/policies"
@page "/policy/{slug}"
@page "/policy"
@page "/terms"
@page "/chinh-sach-giao-hang"
@page "/shipping"
@page "/feedback"
@page "/khieu-nai-gop-y"
@namespace Frontend.Pages
@inject NavigationManager Navigation
@inject Frontend.Services.ICustomerApiClient CustomerApi
@inject Frontend.Services.IPolicyApiClient PolicyApi
@inject Frontend.Services.IToastService Toast
@inject IJSRuntime JSRuntime
@inject Frontend.Services.IAuthStateService AuthStateService

<PageTitle>@(CurrentPolicy?.TieuDe ?? "Chính sách bán hàng") | QF Fashion</PageTitle>

<div class="policy-page-container">
    <div class="yame-container">
        <!-- Breadcrumb chuẩn QF Minimalist -->
        <nav class="policy-breadcrumb" aria-label="Đường dẫn">
            <a href="/" class="bc-link">Trang chủ</a>
            <span class="bc-sep">›</span>
            <span class="bc-curr">@(CurrentPolicy?.TieuDe ?? "Chính sách bán hàng")</span>
        </nav>

        <!-- Quick Tabs chuyển đổi chính sách -->
        <div class="policy-nav-tabs" role="tablist">
            @foreach (var item in _policyList)
            {
                <a href="/policies/@item.Slug" class="policy-tab-item @(CurrentPolicy?.Slug == item.Slug ? "active" : "")">
                    @item.TieuDe
                </a>
            }
        </div>

        <!-- Main Editorial Content Direct on Page (Hoàn toàn không viền khung hộp) -->
        <article class="policy-article-wrapper">
            <h1 class="policy-editorial-title">@(CurrentPolicy?.TieuDe ?? "")</h1>

            <div class="policy-editorial-body">
                @if (_isLoading)
                {
                    <div class="text-center py-5 text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span> Đang tải nội dung chính sách...
                    </div>
                }
                else if (CurrentPolicy != null)
                {
                    @((MarkupString)CurrentPolicy.NoiDung)
                }
                else
                {
                    <p class="text-muted">Chưa có nội dung cho chính sách này.</p>
                }
            </div>

            @if (CurrentPolicy?.Slug == "khieu-nai-gop-y")
            {
                <div class="feedback-form-card">
                    <div class="feedback-form-header">
                        <h3 class="feedback-form-title">PHIẾU TIẾP NHẬN KHIẾU NẠI & GÓP Ý TRỰC TUYẾN</h3>
                        <p class="feedback-form-desc">Mọi thông tin gửi qua biểu mẫu này sẽ được chuyển thẳng đến bộ phận Quản lý & Chăm sóc khách hàng của QF Fashion.</p>
                    </div>

                    @if (_isSubmittedSuccess)
                    {
                        <div class="feedback-success-banner">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            <div>
                                <strong>Gửi thành công!</strong>
                                <p>Cảm ơn bạn đã gửi ý kiến đóng góp. Chúng tôi sẽ xử lý và liên hệ phản hồi lại bạn sớm nhất.</p>
                            </div>
                        </div>
                    }

                    @if (_isDraftRestored)
                    {
                        <div class="feedback-draft-restored-banner">
                            <div class="draft-badge-icon">💾</div>
                            <div class="draft-text-content">
                                <strong>Đã tự động khôi phục nội dung bạn vừa soạn thảo!</strong>
                                <p>Toàn bộ thông tin bạn đã nhập trước khi đăng nhập đã được giữ nguyên vẹn. Bạn có thể kiểm tra lại và nhấn gửi ngay.</p>
                            </div>
                            <button type="button" class="btn-dismiss-draft" @onclick="ClearFeedbackDraftAsync" title="Xóa bản nháp và nhập lại từ đầu">
                                ✕ Nhập lại từ đầu
                            </button>
                        </div>
                    }

                    @if (!_isLoggedIn)
                    {
                        <div class="feedback-auth-alert">
                            <div class="auth-alert-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                            <div class="auth-alert-content">
                                <strong>Yêu cầu đăng nhập tài khoản</strong>
                                <p>Hệ thống chỉ tiếp nhận ý kiến từ tài khoản đã đăng nhập nhằm đảm bảo tính xác thực và ngăn chặn hành vi spam phá hoại.</p>
                            </div>
                            <button type="button" class="btn-auth-action" @onclick="RedirectToLogin">
                                ĐĂNG NHẬP NGAY
                            </button>
                        </div>
                    }

                    <div class="feedback-form-grid">
                        <div class="feedback-field">
                            <label>Họ và tên (*):</label>
                            <input type="text" class="form-control" placeholder="Họ và tên của bạn..." @bind="_fbHoTen" />
                        </div>

                        <div class="feedback-field">
                            <label>Số điện thoại liên hệ (*):</label>
                            <input type="tel" class="form-control" placeholder="Số điện thoại nhận hỗ trợ..." @bind="_fbDienThoai" />
                        </div>

                        <div class="feedback-field">
                            <label>Địa chỉ Email (tùy chọn):</label>
                            <input type="email" class="form-control" placeholder="Email nhận thông báo kết quả..." @bind="_fbEmail" />
                        </div>

                        <div class="feedback-field">
                            <label>Phân loại ý kiến (*):</label>
                            <select class="form-control select-fb-type" @bind="_fbLoaiPhanHoi">
                                <option value="Góp ý sản phẩm">Góp ý sản phẩm</option>
                                <option value="Khiếu nại dịch vụ">Khiếu nại dịch vụ / thái độ phục vụ</option>
                                <option value="Hỗ trợ đơn hàng">Hỗ trợ giao vận / đơn hàng</option>
                                <option value="Báo lỗi website">Báo lỗi kỹ thuật website</option>
                                <option value="Khác">Ý kiến đóng góp khác</option>
                            </select>
                        </div>

                        <div class="feedback-field full-width">
                            <label>Tiêu đề góp ý / khiếu nại (*):</label>
                            <input type="text" class="form-control" placeholder="Tóm tắt nội dung chính (VD: Đơn hàng #5001 bị giao chậm, Góp ý form áo...)" @bind="_fbTieuDe" />
                        </div>

                        <div class="feedback-field full-width">
                            <label>Nội dung chi tiết (*):</label>
                            <textarea class="form-control feedback-textarea" rows="4" placeholder="Mô tả cụ thể sự việc hoặc ý kiến của bạn để được hỗ trợ tốt nhất..." @bind="_fbNoiDung"></textarea>
                        </div>
                    </div>

                    <div class="feedback-actions">
                        @if (!_isLoggedIn)
                        {
                            <span class="auth-hint-text">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                Cần đăng nhập để gửi phiếu
                            </span>
                        }
                        <button type="button" class="btn btn-submit-feedback @(!_isLoggedIn ? "btn-require-login" : "")" disabled="@_isSubmittingFeedback" @onclick="SubmitFeedbackForm">
                            @if (_isSubmittingFeedback)
                            {
                                <span>ĐANG GỬI PHIẾU...</span>
                            }
                            else if (!_isLoggedIn)
                            {
                                <span>🔒 ĐĂNG NHẬP ĐỂ GỬI PHIẾU</span>
                            }
                            else
                            {
                                <span>GỬI PHIẾU GÓP Ý & KHIẾU NẠI</span>
                            }
                        </button>
                    </div>
                </div>

                @if (_showLoginRequiredModal)
                {
                    <div class="feedback-modal-overlay" @onclick="() => _showLoginRequiredModal = false">
                        <div class="feedback-modal-box" @onclick:stopPropagation="true">
                            <div class="modal-lock-badge">
                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                            <h4 class="feedback-modal-title">Yêu Cầu Đăng Nhập</h4>
                            <p class="feedback-modal-desc">
                                Để ngăn chặn tình trạng <strong>spam phá hoại</strong> và bảo đảm quyền lợi hỗ trợ chính xác, quý khách cần đăng nhập tài khoản trước khi gửi phiếu góp ý & khiếu nại.
                            </p>
                            <div class="feedback-modal-footer">
                                <button type="button" class="btn btn-secondary-outline" @onclick="() => _showLoginRequiredModal = false">
                                    Để sau
                                </button>
                                <button type="button" class="btn btn-primary-redirect" @onclick="RedirectToLogin">
                                    Đăng nhập ngay
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </article>
    </div>
</div>

<style>
