        padding: 2rem 0 5rem 0;
        background-color: #FFFFFF;
        min-height: 80vh;
    }
    .policy-breadcrumb {
        font-size: 0.85rem;
        color: #64748B;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .policy-breadcrumb .bc-link {
        color: #64748B;
        text-decoration: none;
        transition: color 0.15s ease;
    }
    .policy-breadcrumb .bc-link:hover {
        color: #0F172A;
    }
    .policy-breadcrumb .bc-sep {
        color: #94A3B8;
        font-size: 0.85rem;
    }
    .policy-breadcrumb .bc-curr {
        color: #0F172A;
        font-weight: 500;
    }

    /* Policy Navigation Pills */
    .policy-nav-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid #E2E8F0;
    }
    .policy-tab-item {
        padding: 0.5rem 1.15rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 500;
        color: #475569;
        background-color: #F8FAFC;
        border: 1px solid #E2E8F0;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .policy-tab-item:hover {
        color: #0F172A;
        border-color: #CBD5E1;
        background-color: #F1F5F9;
    }
    .policy-tab-item.active {
        background-color: #0F172A;
        color: #FFFFFF;
        border-color: #0F172A;
    }

    /* Editorial Content Area */
    .policy-article-wrapper {
        max-width: 900px;
        margin: 0;
    }
    .policy-editorial-title {
        font-family: var(--font-display);
        font-size: 2.4rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: #0F172A;
        margin-bottom: 2.25rem;
