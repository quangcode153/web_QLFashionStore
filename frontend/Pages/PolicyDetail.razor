        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 1rem;
    }
    .feedback-modal-box {
        background: #ffffff;
        border-radius: 12px;
        padding: 2rem;
        max-width: 440px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
        animation: modalFadeIn 0.2s ease-out;
    }
    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    .modal-lock-badge {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #fef3c7;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .feedback-modal-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 0.5rem 0;
    }
    .feedback-modal-desc {
        font-size: 0.875rem;
        color: #475569;
        line-height: 1.5;
        margin-bottom: 1.75rem;
    }
    .feedback-modal-desc strong {
        color: #dc2626;
    }
    .feedback-modal-footer {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }
    .btn-secondary-outline {
        background: transparent;
        border: 1px solid #cbd5e1;
        color: #64748b;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-secondary-outline:hover {
        background: #f8fafc;
        color: #0f172a;
    }
    .btn-primary-redirect {
        background: #0f172a;
        border: none;
        color: #ffffff;
        padding: 10px 22px;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-primary-redirect:hover {
        background: #1e293b;
        transform: translateY(-1px);
    }
    @@media (max-width: 640px) {
        .feedback-form-grid {
            grid-template-columns: 1fr;
        }
        .feedback-field.full-width {
            grid-column: span 1;
        }
    }
</style>

@code {
    [Parameter] public string? slug { get; set; }

    private List<PolicyDto> _policyList = new();
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        try
        {
            var policies = await PolicyApi.GetActivePoliciesAsync();
            _policyList = policies.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading policies: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private PolicyDto? CurrentPolicy
    {
        get
        {
            if (!_policyList.Any()) return null;

            var targetSlug = slug;
            if (string.IsNullOrWhiteSpace(targetSlug))
            {
                var uri = Navigation.Uri.ToLowerInvariant();
                if (uri.Contains("chinh-sach-giao-hang") || uri.Contains("shipping") || uri.Contains("freeship") || uri.Contains("giao-hang"))
                {
                    targetSlug = "chinh-sach-giao-hang";
                }
                else if (uri.EndsWith("/terms") || uri.Contains("dieu-khoan"))
                {
                    targetSlug = "dieu-khoan-dich-vu";
                }
            }

            if (string.IsNullOrWhiteSpace(targetSlug))
            {
                return _policyList.FirstOrDefault();
            }

            return _policyList.FirstOrDefault(p => 
                p.Slug.Equals(targetSlug, StringComparison.OrdinalIgnoreCase) ||
                (targetSlug.Contains("giao-hang") && p.Slug == "chinh-sach-giao-hang") ||
                (targetSlug.Contains("freeship") && p.Slug == "chinh-sach-giao-hang") ||
                (targetSlug.Contains("van-chuyen") && p.Slug == "chinh-sach-giao-hang") ||
                ((targetSlug.Contains("khieu-nai") || targetSlug.Contains("gop-y") || targetSlug.Contains("feedback")) && p.Slug == "khieu-nai-gop-y")
            ) ?? _policyList.FirstOrDefault();
        }
    }

    private string _fbHoTen = string.Empty;
    private string _fbDienThoai = string.Empty;
    private string? _fbEmail;
    private string _fbLoaiPhanHoi = "Góp ý sản phẩm";
    private string _fbTieuDe = string.Empty;
    private string _fbNoiDung = string.Empty;
    private bool _isSubmittingFeedback = false;
    private bool _isSubmittedSuccess = false;
    private bool _isLoggedIn = false;
    private bool _showLoginRequiredModal = false;
    private bool _isDraftRestored = false;

    private class FeedbackDraft
    {
        public string? HoTen { get; set; }
        public string? DienThoai { get; set; }
        public string? Email { get; set; }
        public string? LoaiPhanHoi { get; set; }
        public string? TieuDe { get; set; }
        public string? NoiDung { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckLoginStatusAsync();
            await RestoreFeedbackDraftAsync();
        }
    }

    private async Task CheckLoginStatusAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authToken");
            _isLoggedIn = !string.IsNullOrWhiteSpace(token);

            if (_isLoggedIn)
            {
                var staffName = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "staffName");
                var username = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "currentUser");
                if (string.IsNullOrWhiteSpace(_fbHoTen))
                {
                    _fbHoTen = staffName ?? username ?? string.Empty;
                }
            }
            StateHasChanged();
        }
        catch { }
    }

    private async Task SaveFeedbackDraftAsync()
    {
        try
        {
            var draft = new FeedbackDraft
            {
                HoTen = _fbHoTen,
                DienThoai = _fbDienThoai,
                Email = _fbEmail,
                LoaiPhanHoi = _fbLoaiPhanHoi,
                TieuDe = _fbTieuDe,
                NoiDung = _fbNoiDung
            };
            var json = System.Text.Json.JsonSerializer.Serialize(draft);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "draft_customer_feedback", json);
        }
        catch { }
    }

    private async Task RestoreFeedbackDraftAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "draft_customer_feedback");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var draft = System.Text.Json.JsonSerializer.Deserialize<FeedbackDraft>(json);
                if (draft != null)
                {
                    bool hasData = false;
                    if (!string.IsNullOrWhiteSpace(draft.HoTen)) { _fbHoTen = draft.HoTen; hasData = true; }
                    if (!string.IsNullOrWhiteSpace(draft.DienThoai)) { _fbDienThoai = draft.DienThoai; hasData = true; }
                    if (!string.IsNullOrWhiteSpace(draft.Email)) { _fbEmail = draft.Email; hasData = true; }
                    if (!string.IsNullOrWhiteSpace(draft.LoaiPhanHoi)) { _fbLoaiPhanHoi = draft.LoaiPhanHoi; }
                    if (!string.IsNullOrWhiteSpace(draft.TieuDe)) { _fbTieuDe = draft.TieuDe; hasData = true; }
                    if (!string.IsNullOrWhiteSpace(draft.NoiDung)) { _fbNoiDung = draft.NoiDung; hasData = true; }

                    if (hasData)
                    {
                        _isDraftRestored = true;
                        StateHasChanged();
                    }
                }
            }
        }
        catch { }
    }

    private async Task ClearFeedbackDraftAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "draft_customer_feedback");
            _isDraftRestored = false;
            _fbTieuDe = string.Empty;
            _fbNoiDung = string.Empty;
            StateHasChanged();
        }
        catch { }
    }

    private async Task RedirectToLogin()
    {
        await SaveFeedbackDraftAsync();
        var currentUrl = Navigation.Uri;
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(currentUrl)}");
    }

    private async Task SubmitFeedbackForm()
    {
        // 1. Kiểm tra đăng nhập để phân ra 2 trường hợp rõ ràng
        string? token = null;
        try
        {
            token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authToken");
        }
        catch { }

        bool authenticated = !string.IsNullOrWhiteSpace(token) || AuthStateService.IsAuthenticated;
        _isLoggedIn = authenticated;

        // Trường hợp 2: Chưa đăng nhập -> Tự động lưu bản nháp và buộc phải đăng nhập
        if (!authenticated)
        {
            await SaveFeedbackDraftAsync();
            Toast.ShowWarning("Nội dung của bạn đã được lưu tạm. Vui lòng đăng nhập tài khoản để gửi phiếu!");
            _showLoginRequiredModal = true;
            return;
        }

        // Trường hợp 1: Đã đăng nhập -> Cho phép gửi bình thường
        if (string.IsNullOrWhiteSpace(_fbHoTen) || string.IsNullOrWhiteSpace(_fbDienThoai) || string.IsNullOrWhiteSpace(_fbTieuDe) || string.IsNullOrWhiteSpace(_fbNoiDung))
        {
            Toast.ShowWarning("Vui lòng điền đầy đủ họ tên, số điện thoại, tiêu đề và nội dung.");
            return;
        }

        _isSubmittingFeedback = true;
        try
        {
            var req = new global::Shared.DTOs.Feedback.CreateFeedbackRequestDto
            {
                HoTen = _fbHoTen.Trim(),
                DienThoai = _fbDienThoai.Trim(),
                Email = string.IsNullOrWhiteSpace(_fbEmail) ? null : _fbEmail.Trim(),
                LoaiPhanHoi = _fbLoaiPhanHoi,
                TieuDe = _fbTieuDe.Trim(),
                NoiDung = _fbNoiDung.Trim()
            };

            var res = await CustomerApi.SubmitFeedbackAsync(req);
            if (res.Success)
            {
                Toast.ShowSuccess(res.Message ?? "Đã gửi phiếu thành công!");
                _isSubmittedSuccess = true;
                await ClearFeedbackDraftAsync();
            }
            else
            {
                Toast.ShowError(res.Message ?? "Gửi phiếu thất bại.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi gửi phiếu: {ex.Message}");
        }
        finally
        {
            _isSubmittingFeedback = false;
        }
    }
}
