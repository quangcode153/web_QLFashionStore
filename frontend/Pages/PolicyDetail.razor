        color: #334155;
    }
    .policy-editorial-body h3 {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: #0F172A;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        margin-top: 2.25rem;
        margin-bottom: 1rem;
    }
    .policy-editorial-body ul {
        margin-left: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .policy-editorial-body li {
        margin-bottom: 0.5rem;
    }
    .policy-editorial-body strong {
        color: #0F172A;
    }

    /* Feedback Form Styling */
    .feedback-form-card {
        margin-top: 2.5rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 2rem;
    }
    .feedback-form-header {
        margin-bottom: 1.5rem;
    }
    .feedback-form-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.01em;
    }
    .feedback-form-desc {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0;
    }
    .feedback-success-banner {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }
    .feedback-success-banner strong {
        color: #047857;
        display: block;
        margin-bottom: 0.25rem;
    }
    .feedback-success-banner p {
