        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.2);
        color: #ffffff !important;
    }
    .btn-submit-feedback:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
