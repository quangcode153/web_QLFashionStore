@code {
    private string _fullName = string.Empty;
    private string _phoneNumber = string.Empty;
    private string _address = string.Empty;
    private string _note = string.Empty;
    private string _paymentMethod = "COD";

    private string _voucherCode = string.Empty;
    private bool _isApplyingVoucher = false;
    private ValidateVoucherResponseDto? _voucherResult;

    private decimal _vipDiscountAmount = 0m;
    private CustomerProfileDto? _customerProfile;
    private bool _isSubmitting = false;
    private bool _isOrderPlaced = false;
    private string? _validationError;
    private bool _hasUnavailableItems = false;
    private string? _unavailableMessage;

    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeAsync();
        await CheckCartAvailabilityAsync();

        // Try to load VIP profile to apply VIP discount automatically
        try
        {
            var profile = await OrderApiClient.GetMyProfileAsync();
            if (profile != null)
            {
                _customerProfile = profile;
                if (string.IsNullOrWhiteSpace(_fullName) && !string.IsNullOrWhiteSpace(profile.TenKhachHang))
                {
                    _fullName = profile.TenKhachHang;
                }
                if (string.IsNullOrWhiteSpace(_phoneNumber) && !string.IsNullOrWhiteSpace(profile.DienThoai))
                {
                    _phoneNumber = profile.DienThoai;
                }

                if (profile.PhanTramGiamGia > 0)
                {
                    _vipDiscountAmount = Math.Round(CartService.SubTotal * (profile.PhanTramGiamGia / 100m));
                }
            }
        }
        catch
        {
            // Anonymous / non-VIP checkout
        }
    }

    private async Task CheckCartAvailabilityAsync()
    {
        if (CartService.Items.Any())
        {
            try
            {
                var ids = CartService.Items.Select(x => x.MaBienThe).Distinct().ToList();
                var results = await CatalogApi.CheckVariantsAvailabilityAsync(ids);
                var unavailable = results.FirstOrDefault(x => x.DaAn);
                if (unavailable != null)
                {
                    _hasUnavailableItems = true;
                    _unavailableMessage = $"Sản phẩm '{unavailable.TenSanPham}' tạm thời không cung cấp";
                    _validationError = $"{_unavailableMessage}. Vui lòng quay lại giỏ hàng để cập nhật.";
                }
                else
                {
                    _hasUnavailableItems = false;
                    _unavailableMessage = null;
                }
            }
            catch
            {
                // Fail-safe
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartService.InitializeAsync();
            try
            {
                var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "authToken");
                if (string.IsNullOrEmpty(token))
                {
                    ToastService.ShowInfo("Vui lòng đăng nhập hoặc tạo tài khoản để hoàn tất đơn hàng.");
                    Navigation.NavigateTo("/login?returnUrl=/checkout");
                    return;
                }
            }
            catch { }
            StateHasChanged();
        }
    }

    private async Task ApplyVoucherAsync()
    {
        if (string.IsNullOrWhiteSpace(_voucherCode))
        {
            _voucherResult = new ValidateVoucherResponseDto
            {
                Valid = false,
                Message = "Vui lòng nhập mã giảm giá"
            };
            return;
        }

        _isApplyingVoucher = true;
        try
        {
            var request = new ValidateVoucherRequestDto
            {
                MaGiamGia = _voucherCode,
                TongTienDonHang = CartService.SubTotal,
                MaKhachHang = _customerProfile?.MaKhachHang
            };

            _voucherResult = await OrderApiClient.ValidateVoucherAsync(request);
            if (_voucherResult != null && _voucherResult.Valid)
            {
                ToastService.ShowSuccess($"Áp dụng mã {_voucherResult.MaGiamGia} thành công!");
            }
        }
        finally
        {
            _isApplyingVoucher = false;
        }
    }

    private decimal CalculateFinalTotal()
    {
        var subTotal = CartService.SubTotal;
        var shippingFee = subTotal >= 50000m ? 0m : 30000m;
        var voucherDiscount = (_voucherResult != null && _voucherResult.Valid) ? _voucherResult.DiscountAmount : 0m;
        
        // RÀNG BUỘC TOÁN HỌC: Tổng tiền giảm (Voucher + VIP) không được vượt quá tổng tiền hàng
        var totalDiscount = voucherDiscount + _vipDiscountAmount;
        if (totalDiscount > subTotal)
        {
            totalDiscount = subTotal;
        }

        var final = subTotal + shippingFee - totalDiscount;
        return final < 0 ? 0 : final;
    }

    private async Task SubmitOrderAsync()
    {
        if (!CartService.Items.Any())
        {
            _validationError = "Giỏ hàng của bạn đang trống.";
            return;
        }

        // Validation check
        if (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_phoneNumber) || string.IsNullOrWhiteSpace(_address))
        {
            _validationError = "Vui lòng điền đầy đủ Họ tên, Số điện thoại và Địa chỉ giao hàng.";
            return;
        }

        var phoneClean = _phoneNumber.Trim().Replace(" ", "").Replace(".", "").Replace("-", "");
        if (!System.Text.RegularExpressions.Regex.IsMatch(phoneClean, @"^0\d{9,10}$"))
        {
            _validationError = "Số điện thoại không hợp lệ (phải bắt đầu bằng số 0 và gồm 10-11 chữ số).";
            return;
        }

        await CheckCartAvailabilityAsync();
        if (_hasUnavailableItems)
        {
            _validationError = $"{_unavailableMessage}. Vui lòng quay lại giỏ hàng để xóa.";
            ToastService.ShowError(_validationError);
            return;
        }

        _validationError = null;
        _isSubmitting = true;

        try
        {
            string paymentTag = _paymentMethod switch
            {
                "MOMO" => "[PTTT: VÍ MOMO - ĐÃ THANH TOÁN QR (THU HỘ 0Đ)]",
                "VIETQR" => "[PTTT: VIETQR MBBANK - ĐÃ CHUYỂN KHOẢN (THU HỘ 0Đ)]",
                _ => "[PTTT: COD - THU TIỀN KHI GIAO HÀNG]"
            };
            string noteText = string.IsNullOrWhiteSpace(_note) ? "" : $" (Ghi chú: {_note.Trim()})";

            var request = new CreateOrderRequestDto
            {
                MaKhachHang = _customerProfile?.MaKhachHang,
                MaNhanVien = 1, // Web order online channel
                MaChiNhanh = 9, // Kênh mua sắm trực tuyến xuất kho từ Kho Tổng Online QF Tân Bình
                MaGiamGia = (_voucherResult != null && _voucherResult.Valid) ? _voucherResult.MaGiamGia : null,
                DiaChiGiaoHang = $"{paymentTag} {_fullName.Trim()} - {_phoneNumber.Trim()} - {_address.Trim()}{noteText}",
                Items = CartService.Items.Select(i => new CreateOrderItemDto
                {
                    MaBienThe = i.MaBienThe,
                    SoLuong = i.SoLuong
                }).ToList()
            };

            var order = await OrderApiClient.CreateOrderAsync(request);
            if (order != null)
            {
                _isOrderPlaced = true;
                await CartService.ClearCartAsync();
                ToastService.ShowSuccess("Đặt hàng thành công!");
                Navigation.NavigateTo($"/order-success/{order.MaHoaDon}?payment={_paymentMethod}");
            }
            else
            {
                _validationError = "Không thể tạo đơn hàng. Vui lòng kiểm tra lại thông tin và thử lại.";
                ToastService.ShowError("Tạo đơn hàng thất bại.");
            }
        }
        catch (Exception ex)
        {
            _validationError = $"Lỗi xử lý đơn: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
