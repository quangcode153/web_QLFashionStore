@page "/checkout"
@namespace Frontend.Pages
@using Frontend.Services
@using global::Shared.DTOs.Catalog
@using global::Shared.DTOs.Order
@using Microsoft.JSInterop
@inject ICartService CartService
@inject IOrderApiClient OrderApiClient
@inject ICatalogApiClient CatalogApi
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation


<div class="checkout-page-wrapper">
    <div class="yame-container">
        <!-- Breadcrumb -->
        <nav class="checkout-breadcrumb" aria-label="Đường dẫn">
            <a href="/cart" class="bc-link">Giỏ hàng</a>
            <span class="bc-sep">/</span>
            <span class="bc-curr">Thanh toán & Đặt hàng</span>
        </nav>

        <h1 class="checkout-page-title">THÔNG TIN THANH TOÁN</h1>

        @if (!CartService.Items.Any() && !_isOrderPlaced)
        {
            <div class="checkout-empty-box">
                <p>Giỏ hàng của bạn đang trống. Vui lòng thêm sản phẩm trước khi thanh toán.</p>
                <a href="/catalog" class="btn-back-catalog">Quay lại mua sắm</a>
            </div>
        }
        else
        {
            <div class="checkout-grid">
                <!-- Left Column: Delivery Form & Payment Methods -->
                <div class="checkout-form-column">
                    <section class="form-section">
                        <h2 class="section-title">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>1. THÔNG TIN GIAO HÀNG</span>
                        </h2>

                        @if (!string.IsNullOrEmpty(_validationError))
                        {
                            <div class="validation-alert" role="alert">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 6px;">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                @_validationError
                            </div>
                        }

                        <div class="form-row-2col">
                            <div class="form-group">
                                <label class="form-label" for="fullName">Họ và tên người nhận <span class="req">*</span></label>
                                <input type="text" 
                                       id="fullName"
                                       name="fullName" 
                                       class="form-control" 
                                       placeholder="Ví dụ: Nguyễn Văn A" 
                                       value="@_fullName" 
                                       @onchange="e => _fullName = e.Value?.ToString() ?? string.Empty" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="phoneNumber">Số điện thoại liên hệ <span class="req">*</span></label>
                                <input type="tel" 
                                       id="phoneNumber"
                                       name="phoneNumber" 
                                       class="form-control" 
                                       placeholder="Ví dụ: 0901234567" 
                                       value="@_phoneNumber" 
                                       @onchange="e => _phoneNumber = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="address">Địa chỉ nhận hàng chi tiết <span class="req">*</span></label>
                            <textarea id="address"
                                      name="address" 
                                      class="form-control" 
                                      rows="2" 
                                      placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" 
                                      value="@_address" 
                                      @onchange="e => _address = e.Value?.ToString() ?? string.Empty"></textarea>
                        </div>

                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" for="note">Ghi chú đơn hàng (Tùy chọn)</label>
                            <textarea id="note"
                                      name="note" 
                                      class="form-control" 
                                      rows="2" 
                                      placeholder="Ghi chú thêm cho nhân viên giao hàng (Ví dụ: Giao giờ hành chính)" 
                                      value="@_note" 
                                      @onchange="e => _note = e.Value?.ToString() ?? string.Empty"></textarea>
                        </div>
                    </section>

                    <section class="form-section">
                        <h2 class="section-title">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                <line x1="2" y1="10" x2="22" y2="10"></line>
                            </svg>
                            <span>2. PHƯƠNG THỨC THANH TOÁN</span>
                        </h2>
                        
                        <div class="payment-methods-list">
                            <label class="payment-option @(_paymentMethod == "COD" ? "selected" : "")">
                                <input type="radio" 
                                       name="paymentMethod" 
                                       value="COD" 
                                       checked="@(_paymentMethod == "COD")" 
                                       @onchange="@(() => _paymentMethod = "COD")" />
                                <div class="payment-meta">
                                    <span class="payment-name">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;">
                                            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                                            <circle cx="12" cy="12" r="2"></circle>
                                            <path d="M6 12h.01M18 12h.01"></path>
                                        </svg>
                                        COD (Thanh toán tiền mặt khi nhận hàng)
                                    </span>
                                    <span class="payment-desc">Kiểm tra sản phẩm và thanh toán trực tiếp cho nhân viên giao vận</span>
                                </div>
                            </label>

                            <label class="payment-option @(_paymentMethod == "MOMO" ? "selected" : "")">
                                <input type="radio" 
                                       name="paymentMethod" 
                                       value="MOMO" 
                                       checked="@(_paymentMethod == "MOMO")" 
                                       @onchange="@(() => _paymentMethod = "MOMO")" />
                                <div class="payment-meta">
                                    <span class="payment-name" style="display: flex; align-items: center; gap: 6px;">
                                        <span style="display: inline-block; width: 18px; height: 18px; border-radius: 4px; background: #A50064; color: white; font-weight: 800; font-size: 11px; text-align: center; line-height: 18px;">M</span>
                                        Ví Điện Tử MoMo (Quét mã QR tiện lợi)
                                    </span>
                                    <span class="payment-desc">Quét mã bằng app MoMo, tự động điền SĐT và số tiền đơn hàng</span>
                                </div>
                            </label>

                            <label class="payment-option @(_paymentMethod == "VIETQR" || _paymentMethod == "QR" ? "selected" : "")">
                                <input type="radio" 
                                       name="paymentMethod" 
                                       value="VIETQR" 
                                       checked="@(_paymentMethod == "VIETQR" || _paymentMethod == "QR")" 
                                       @onchange="@(() => _paymentMethod = "VIETQR")" />
                                <div class="payment-meta">
                                    <span class="payment-name">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;">
                                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                            <line x1="1" y1="10" x2="23" y2="10"></line>
                                        </svg>
                                        Chuyển khoản QR (VietQR chuẩn ngân hàng 24/7)
                                    </span>
                                    <span class="payment-desc">Quét mã bằng MB, Vietcombank, Techcombank, ACB... không cần nhập số tài khoản</span>
                                </div>
                            </label>
                        </div>
                    </section>
                </div>

                <!-- Right Column: Order Summary & Voucher -->
                <div class="checkout-summary-column">
                    <div class="summary-box">
                        <h3 class="summary-heading">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                            <span>ĐƠN HÀNG CỦA BẠN (@CartService.TotalCount món)</span>
                        </h3>

                        <!-- Mini Items List -->
                        <div class="checkout-items-preview">
                            @foreach (var item in CartService.Items)
                            {
                                <div class="preview-item">
                                    <div class="preview-left">
                                        <span class="preview-qty">@item.SoLuong x</span>
                                        <span class="preview-name">@item.TenSanPham</span>
                                        <span class="preview-variant">(@item.MauSac, @item.KichCo)</span>
                                    </div>
                                    <span class="preview-price">@item.ThanhTien.ToString("N0") ₫</span>
                                </div>
                            }
                        </div>

                        <!-- Voucher Input Block (FR-12) -->
                        <div class="voucher-box">
                            <label class="voucher-label" for="voucherCode">
                                Mã Giảm Giá / Voucher 
                                <span style="font-size: 0.78rem; font-weight: 500; color: #64748B; margin-left: 6px;">(Áp dụng tối đa 1 mã/đơn)</span>
                            </label>
                            <div class="voucher-input-row">
                                <input type="text" 
                                       id="voucherCode"
                                       name="voucherCode" 
                                       class="form-control input-voucher" 
                                       placeholder="Nhập mã ưu đãi..." 
                                       value="@_voucherCode" 
                                       @onchange="e => _voucherCode = e.Value?.ToString()?.Trim().ToUpperInvariant() ?? string.Empty" />
                                <button type="button" 
                                        class="btn-apply-voucher" 
                                        @onclick="ApplyVoucherAsync" 
                                        disabled="@_isApplyingVoucher">
                                    @(_isApplyingVoucher ? "Đang áp dụng..." : "ÁP DỤNG")
                                </button>
                            </div>

                            @if (_voucherResult != null)
                            {
                                @if (_voucherResult.Valid)
                                {
                                    <div class="voucher-message success">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><polyline points="20 6 9 17 4 12"></polyline></svg>Đã áp dụng: <strong>@_voucherResult.TenKhuyenMai</strong> (-@_voucherResult.DiscountAmount.ToString("N0") ₫)
                                    </div>
                                }
                                else
                                {
                                    <div class="voucher-message error">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:-2px; margin-right:4px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>@_voucherResult.Message
                                    </div>
                                }
                            }
                        </div>

                        <!-- Price Calculations -->
                        <div class="calc-section">
                            <div class="calc-row">
                                <span>Tạm tính tiền hàng:</span>
                                <span class="calc-val">@CartService.SubTotal.ToString("N0") ₫</span>
                            </div>

                            <div class="calc-row">
                                <span>Phí vận chuyển:</span>
                                <span class="calc-val">@(CartService.SubTotal >= 50000m ? "MIỄN PHÍ" : "30.000 ₫")</span>
                            </div>

                            @if (_voucherResult != null && _voucherResult.Valid && _voucherResult.DiscountAmount > 0)
                            {
                                <div class="calc-row discount-row">
                                    <span>Voucher giảm giá (@_voucherResult.MaGiamGia):</span>
                                    <span class="calc-val text-sale">-@_voucherResult.DiscountAmount.ToString("N0") ₫</span>
                                </div>
                            }

                            @if (_vipDiscountAmount > 0)
                            {
                                <div class="calc-row vip-row">
                                    <span>Chiết khấu hạng thẻ VIP:</span>
                                    <span class="calc-val text-vip">-@_vipDiscountAmount.ToString("N0") ₫</span>
                                </div>
                            }

                            <div class="calc-divider"></div>

                            <div class="calc-row final-total-row">
                                <span class="final-label">TỔNG THANH TOÁN:</span>
                                <span class="final-val">@CalculateFinalTotal().ToString("N0") ₫</span>
                            </div>
                        </div>

                        @if (_hasUnavailableItems)
                        {
                            <div class="checkout-unavailable-alert" style="background:#FFF1F2; border:1px solid #FECDD3; border-radius:6px; padding:12px; margin-bottom:14px; color:#9F1239; font-size:0.88rem; line-height:1.4;">
                                ⚠️ Trong đơn hàng có <strong>@_unavailableMessage</strong>. Vui lòng <a href="/cart" style="color:#E11D48; font-weight:700; text-decoration:underline;">quay lại giỏ hàng</a> để loại bỏ món này trước khi đặt hàng.
                            </div>
                        }

                        <!-- Submit Order Button -->
                        <button type="button" 
                                class="btn-submit-order" 
                                @onclick="SubmitOrderAsync" 
                                disabled="@(_isSubmitting || _hasUnavailableItems)">
                            @if (_isSubmitting)
                            {
                                <span>ĐANG XỬ LÝ ĐƠN HÀNG...</span>
                            }
                            else
                            {
                                <span>XÁC NHẬN ĐẶT HÀNG</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .checkout-page-wrapper {
        padding: 24px 0 60px 0;
        background: #F8FAFC;
        min-height: 85vh;
    }
    .checkout-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        margin-bottom: 20px;
    }
    .bc-link { color: #64748B; text-decoration: none; }
    .bc-sep { color: #CBD5E1; }
    .bc-curr { color: #0F172A; font-weight: 700; }
    .checkout-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }
    .checkout-empty-box {
        background: #FFFFFF;
        padding: 40px;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        text-align: center;
    }
    .btn-back-catalog {
        display: inline-block;
        margin-top: 16px;
        background: #0F172A;
        color: #FFFFFF;
        padding: 10px 24px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
    }
    .checkout-grid {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 28px;
        align-items: start;
    }
    @@media (max-width: 992px) {
        .checkout-grid { grid-template-columns: 1fr; }
    }
    .checkout-form-column {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .form-section {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 24px;
    }
    .section-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #F1F5F9;
        letter-spacing: 0.02em;
    }
    .validation-alert {
        background: #FEE2E2;
        border: 1px solid #F87171;
        color: #991B1B;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 20px;
    }
    .form-group {
        margin-bottom: 18px;
    }
    .form-label {
        display: block;
        font-size: 0.88rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 6px;
    }
    .req { color: #E11D48; }
    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        font-size: 0.92rem;
        color: #0F172A;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s;
    }
    .form-control:focus {
        border-color: #0F172A;
    }
    .payment-methods-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .payment-option {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px;
        border: 1px solid #E2E8F0;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .payment-option.selected {
        border-color: #0F172A;
        background: #F8FAFC;
    }
    .payment-option input {
        margin-top: 4px;
    }
    .payment-name {
        display: block;
        font-size: 0.95rem;
        font-weight: 700;
        color: #0F172A;
        margin-bottom: 4px;
    }
    .payment-desc {
        display: block;
        font-size: 0.82rem;
        color: #64748B;
    }
    .summary-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 24px;
    }
    .summary-heading {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #E2E8F0;
    }
    .checkout-items-preview {
        max-height: 240px;
        overflow-y: auto;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #F1F5F9;
    }
    .preview-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        margin-bottom: 10px;
    }
    .preview-left {
        display: flex;
        gap: 6px;
        color: #334155;
    }
    .preview-qty { font-weight: 700; color: #0F172A; }
    .preview-name { font-weight: 600; }
    .preview-variant { color: #64748B; font-size: 0.8rem; }
    .preview-price { font-weight: 700; color: #0F172A; }
    .voucher-box {
        margin-bottom: 20px;
        padding: 16px;
        background: #F8FAFC;
        border-radius: 6px;
        border: 1px dashed #CBD5E1;
    }
    .voucher-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
    }
    .voucher-input-row {
        display: flex;
        gap: 8px;
    }
    .input-voucher {
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.05em;
    }
    .btn-apply-voucher {
        background: #0F172A;
        color: #FFFFFF;
        border: none;
        padding: 0 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 800;
        cursor: pointer;
        transition: background 0.2s;
        white-space: nowrap;
    }
    .btn-apply-voucher:hover:not(:disabled) {
        background: #E11D48;
    }
    .btn-apply-voucher:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .voucher-message {
        font-size: 0.82rem;
        margin-top: 8px;
        font-weight: 600;
    }
    .voucher-message.success { color: #059669; }
    .voucher-message.error { color: #DC2626; }
    .calc-section {
        margin-bottom: 24px;
    }
    .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 0.92rem;
        color: #475569;
    }
    .calc-val { font-weight: 700; color: #0F172A; }
    .discount-row { color: #E11D48; }
    .text-sale { color: #E11D48; }
    .vip-row { color: #D97706; }
    .text-vip { color: #D97706; }
    .calc-divider {
        height: 1px;
        background: #E2E8F0;
        margin: 14px 0;
    }
    .final-total-row {
        font-size: 1.1rem;
        margin-bottom: 0;
    }
    .final-label { font-weight: 800; color: #0F172A; }
    .final-val {
        font-size: 1.4rem;
        font-weight: 800;
        color: #E11D48;
    }
    .btn-submit-order {
        width: 100%;
        background: #E11D48;
        color: #FFFFFF;
        border: none;
        padding: 15px;
        border-radius: 6px;
        font-size: 1.05rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-submit-order:hover:not(:disabled) {
        background: #BE123C;
    }
    .btn-submit-order:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .form-row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 768px) {
        .checkout-page-wrapper {
            padding: 8px 0 85px 0 !important;
            background: #F8FAFC !important;
        }
        .checkout-breadcrumb {
            font-size: 0.74rem !important;
            margin-bottom: 6px !important;
            gap: 4px !important;
        }
        .checkout-page-title {
            font-size: 1.15rem !important;
            font-weight: 800 !important;
            margin-bottom: 10px !important;
            letter-spacing: -0.01em !important;
        }
        .checkout-grid {
            display: flex !important;
            flex-direction: column !important;
            gap: 8px !important;
        }
        .checkout-form-column {
            gap: 8px !important;
        }
        .form-section, .summary-box {
            padding: 12px 14px !important;
            border-radius: 8px !important;
            border: 1px solid #E2E8F0 !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03) !important;
        }
        .section-title, .summary-heading {
            font-size: 0.86rem !important;
            font-weight: 700 !important;
            margin-bottom: 8px !important;
            padding-bottom: 6px !important;
            border-bottom: 1px solid #F1F5F9 !important;
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            letter-spacing: 0.01em !important;
            color: #0F172A !important;
        }
        .form-row-2col {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
        }
        .form-group {
            margin-bottom: 8px !important;
