@page "/order-success/{OrderId:int?}"
@namespace Frontend.Pages
@inject NavigationManager Navigation

<div class="order-success-page">
    <div class="yame-container">
        <div class="success-card">
            <div class="success-icon-badge">
                <span class="badge-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </span>
            </div>

            <h1 class="success-title">ĐẶT HÀNG THÀNH CÔNG!</h1>
            <p class="success-subtitle">Cảm ơn bạn đã tin tưởng và mua sắm tại <strong>Fashion Store</strong>.</p>

            <div class="order-reference-box">
                <span class="ref-label">MÃ ĐƠN HÀNG CỦA BẠN:</span>
                <span class="ref-code">#DH-@(OrderId.HasValue ? OrderId.Value.ToString() : "10025")</span>
            </div>

            <div class="delivery-steps-box">
                <div class="step-item active">
                    <span class="step-num">1</span>
                    <span class="step-text">Đã tiếp nhận đơn</span>
                </div>
                <div class="step-line"></div>
                <div class="step-item">
                    <span class="step-num">2</span>
                    <span class="step-text">Đóng gói hàng</span>
                </div>
                <div class="step-line"></div>
                <div class="step-item">
                    <span class="step-num">3</span>
                    <span class="step-text">Giao hàng (1-3 ngày)</span>
                </div>
            </div>

            <div class="pledge-reminder">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <strong>Chính sách QF:</strong> Đổi trả miễn phí trong vòng 14 ngày & Bảo hành sản phẩm 365 ngày trên toàn hệ thống.
            </div>

            <div class="action-buttons-group">
                <a href="/catalog" class="btn-continue-shopping">
                    TIẾP TỤC MUA SẮM
                </a>
                <a href="/profile/orders" class="btn-view-orders">
                    XEM LỊCH SỬ ĐƠN HÀNG
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .order-success-page {
        padding: 50px 0 80px 0;
        background: #F8FAFC;
        min-height: 80vh;
        display: flex;
        align-items: center;
    }
    .success-card {
        max-width: 650px;
        margin: 0 auto;
        background: #FFFFFF;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 48px 36px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .success-icon-badge {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #D1FAE5;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px auto;
    }
    .badge-icon {
        font-size: 2.5rem;
    }
    .success-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0F172A;
        letter-spacing: -0.02em;
        margin-bottom: 8px;
    }
    .success-subtitle {
        font-size: 0.95rem;
        color: #64748B;
        margin-bottom: 28px;
    }
    .order-reference-box {
        background: #F8FAFC;
        border: 1px dashed #CBD5E1;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 32px;
    }
    .ref-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748B;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }
    .ref-code {
        font-size: 1.5rem;
        font-weight: 800;
        color: #E11D48;
        letter-spacing: 0.03em;
    }
    .delivery-steps-box {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 32px;
        padding: 0 10px;
    }
    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }
    .step-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #E2E8F0;
        color: #64748B;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
    .step-item.active .step-num {
        background: #10B981;
        color: #FFFFFF;
    }
    .step-text {
        font-size: 0.78rem;
        color: #64748B;
        font-weight: 600;
    }
    .step-line {
        flex: 1;
        height: 2px;
        background: #E2E8F0;
        margin: 0 12px 20px 12px;
    }
    .pledge-reminder {
        background: #FEF3C7;
        color: #92400E;
        padding: 12px 18px;
        border-radius: 6px;
        font-size: 0.85rem;
        margin-bottom: 32px;
        text-align: left;
    }
    .action-buttons-group {
        display: flex;
        gap: 14px;
        justify-content: center;
    }
    .btn-continue-shopping {
        background: #000000;
        color: #FFFFFF !important;
        padding: 13px 28px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.92rem;
        border: 1px solid #000000;
        text-decoration: none !important;
        letter-spacing: 0.04em;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }
    .btn-continue-shopping:hover {
        background: #000000 !important;
        color: #FFFFFF !important;
        text-decoration: none !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    }
    .btn-continue-shopping:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    .btn-view-orders {
        background: transparent;
        color: #0F172A;
        border: 1px solid #CBD5E1;
        padding: 13px 24px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-view-orders:hover {
        background: #F1F5F9;
        border-color: #94A3B8;
    }
</style>

@code {
    [Parameter] public int? OrderId { get; set; }
}
