    }
    .ref-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748B;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }
    .ref-code {
        font-size: 1.5rem;
        font-weight: 800;
        color: #E11D48;
        letter-spacing: 0.03em;
    }

    /* QR Payment Block */
    .qr-payment-wrapper {
        background: #FFFFFF;
        border: 2px solid #E2E8F0;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 32px;
        text-align: left;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
