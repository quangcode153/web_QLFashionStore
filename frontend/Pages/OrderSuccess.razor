@page "/order-success/{OrderId:int?}"
@namespace Frontend.Pages
@using global::Shared.DTOs.Payment
@using Frontend.Services
@inject NavigationManager Navigation
@inject IOrderApiClient OrderApiClient
@inject IToastService ToastService
@inject IJSRuntime JS

<div class="order-success-page">
    <div class="yame-container">
        <div class="success-card">
            <div class="success-icon-badge">
                <span class="badge-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </span>
            </div>

            <h1 class="success-title">ĐẶT HÀNG THÀNH CÔNG!</h1>
            <p class="success-subtitle">Cảm ơn bạn đã tin tưởng và mua sắm tại <strong>QF Noir Fashion Store</strong>.</p>

            <div class="order-reference-box">
                <span class="ref-label">MÃ ĐƠN HÀNG CỦA BẠN:</span>
                <span class="ref-code">#DH-@(OrderId.HasValue ? OrderId.Value.ToString() : "10025")</span>
            </div>

            @if (IsQrPayment)
            {
                <div class="qr-payment-wrapper">
                    <div class="qr-payment-header">
                        <div class="qr-payment-title-group">
                            <h2 class="qr-payment-title">QUÉT MÃ THANH TOÁN TRỰC TIẾP</h2>
                            <p class="qr-payment-desc">Mở ứng dụng ngân hàng hoặc MoMo quét mã QR dưới đây để hoàn tất thanh toán.</p>
                        </div>
                        <div class="qr-tabs-group">
                            <button type="button" class="btn-qr-tab @(_selectedMethod == "MOMO" ? "active-momo" : "")" @onclick='() => ChangePaymentMethod("MOMO")'>
                                <span class="tab-icon-momo">M</span>
                                <span>Ví MoMo</span>
                            </button>
                            <button type="button" class="btn-qr-tab @(_selectedMethod == "VIETQR" ? "active-vietqr" : "")" @onclick='() => ChangePaymentMethod("VIETQR")'>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                    <line x1="2" y1="10" x2="22" y2="10"></line>
                                </svg>
                                <span>VietQR (Ngân hàng MB)</span>
                            </button>
                        </div>
                    </div>

                    @if (_isLoadingQr)
                    {
                        <div class="qr-loading-box">
                            <div class="qr-spinner"></div>
                            <span>Đang khởi tạo mã QR thanh toán bảo mật...</span>
                        </div>
                    }
                    else if (_qrData != null)
                    {
                        <div class="qr-card-body">
                            <div class="qr-visual-col">
                                <div class="qr-frame @(_selectedMethod == "MOMO" ? "frame-momo" : "frame-vietqr")">
                                    @if (!string.IsNullOrEmpty(_qrData.QrDataUrl))
                                    {
                                        <img src="@_qrData.QrDataUrl" alt="Mã QR thanh toán" class="qr-image" />
                                    }
                                </div>
                                <span class="qr-hint-text">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    Mã QR tự động điền đúng số tiền & nội dung
                                </span>
                            </div>

                            <div class="qr-details-col">
                                <div class="payment-info-list">
                                    <div class="info-row">
                                        <span class="info-label">Kênh thanh toán:</span>
                                        <span class="info-value font-bold">@_qrData.BankName</span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Chủ tài khoản:</span>
                                        <span class="info-value font-bold">@_qrData.AccountName</span>
                                    </div>
                                    <div class="info-row highlight-row">
                                        <span class="info-label">@(_selectedMethod == "MOMO" ? "Số điện thoại MoMo" : "Số tài khoản nhận"):</span>
                                        <div class="copyable-group">
                                            <span class="info-value text-primary font-bold">@_qrData.AccountNumber</span>
                                            <button type="button" class="btn-copy-chip" @onclick='() => CopyToClipboard(_qrData.AccountNumber, "Số tài khoản")' title="Sao chép">
                                                Sao chép
                                            </button>
                                        </div>
                                    </div>
                                    <div class="info-row highlight-row">
                                        <span class="info-label">Số tiền cần chuyển:</span>
                                        <div class="copyable-group">
                                            <span class="info-value text-danger font-bold">@_qrData.Amount.ToString("N0") ₫</span>
                                            <button type="button" class="btn-copy-chip" @onclick='() => CopyToClipboard(_qrData.Amount.ToString("0"), "Số tiền")' title="Sao chép">
                                                Sao chép
                                            </button>
                                        </div>
                                    </div>
                                    <div class="info-row highlight-row">
                                        <span class="info-label">Nội dung chuyển tiền:</span>
                                        <div class="copyable-group">
                                            <span class="info-value text-dark font-bold">@_qrData.TransferContent</span>
                                            <button type="button" class="btn-copy-chip" @onclick='() => CopyToClipboard(_qrData.TransferContent, "Nội dung chuyển khoản")' title="Sao chép">
                                                Sao chép
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="qr-action-box">
                                    @if (_isPaidConfirmed)
                                    {
                                        <div class="paid-success-alert-card">
                                            <div class="paid-alert-header">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                                </svg>
                                                <span class="paid-alert-title">BẠN ĐÃ XÁC NHẬN CHUYỂN KHOẢN THÀNH CÔNG</span>
                                            </div>
                                            <p class="paid-alert-desc">Hệ thống đã ghi nhận thanh toán (Thu hộ 0đ). Bộ phận kho đang chuẩn bị đóng gói và giao hàng đến bạn sớm nhất!</p>
                                            <button type="button" class="btn-paid-disabled" disabled>
                                                ✓ ĐÃ XÁC NHẬN CHUYỂN KHOẢN (ĐÃ KHÓA NÚT)
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-confirm-paid" @onclick="ConfirmPaidAsync" disabled="@_isConfirming">
                                            @if (_isConfirming)
                                            {
                                                <span>ĐANG XÁC NHẬN...</span>
                                            }
                                            else
                                            {
                                                <span>✓ TÔI ĐÃ CHUYỂN KHOẢN THÀNH CÔNG</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="delivery-steps-box">
                <div class="step-item active">
                    <span class="step-num">1</span>
                    <span class="step-text">Đã tiếp nhận đơn</span>
                </div>
                <div class="step-line"></div>
                <div class="step-item">
                    <span class="step-num">2</span>
                    <span class="step-text">Đóng gói hàng</span>
                </div>
                <div class="step-line"></div>
                <div class="step-item">
                    <span class="step-num">3</span>
                    <span class="step-text">Giao hàng (1-3 ngày)</span>
                </div>
            </div>

            <div class="pledge-reminder">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <strong>Chính sách QF:</strong> Đổi trả miễn phí trong vòng 14 ngày & Bảo hành sản phẩm 365 ngày trên toàn hệ thống.
            </div>

            <div class="action-buttons-group">
                <a href="/catalog" class="btn-continue-shopping">
                    TIẾP TỤC MUA SẮM
                </a>
                <a href="/profile/orders" class="btn-view-orders">
                    XEM LỊCH SỬ ĐƠN HÀNG
                </a>
            </div>
        </div>
    </div>
</div>

<style>
