@code {
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = "categoryId")]
    public int? CategoryIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sale")]
    public bool? SaleQuery { get; set; }

    private ProductQueryParameters Query = new() { PageNumber = 1, PageSize = 12, SortBy = "newest" };
    private PagedResult<ProductListItemDto>? PagedResult;
    private IEnumerable<CategoryDto> Categories = Enumerable.Empty<CategoryDto>();
    private IEnumerable<BrandDto> Brands = Enumerable.Empty<BrandDto>();
    private IEnumerable<BannerDto> Banners = Enumerable.Empty<BannerDto>();
    private int _currentBannerIndex = 0;
    private System.Threading.Timer? _bannerAutoplayTimer;

    private BannerDto CurrentBanner
    {
        get
        {
            var list = Banners.ToList();
            if (list.Count == 0)
            {
                return new BannerDto
                {
                    TieuDe = "MẶC ĐẸP ĐI LÀM\nTAN TẦM ĐI QUẨY",
                    PhuDe = "MUA 2 GIẢM 25%",
                    GiaNoiBat = "208K",
                    NhanBadge = "WORK TO WEEKEND",
                    HinhAnh = "images/hero-model.jpg",
                    NutChinhText = "XEM BỘ SƯU TẬP MỞ BÁN",
                    NutChinhLink = "#product-catalog",
                    NutPhuText = "Đặc quyền VIP 2026",
                    NutPhuLink = "/vip"
                };
            }
            if (_currentBannerIndex < 0 || _currentBannerIndex >= list.Count)
            {
                _currentBannerIndex = 0;
            }
            return list[_currentBannerIndex];
        }
    }

    private void StartBannerAutoplay()
    {
        _bannerAutoplayTimer?.Dispose();
        _bannerAutoplayTimer = new System.Threading.Timer(async _ =>
        {
            var count = Banners.Count();
            if (count > 1)
            {
                await InvokeAsync(() =>
                {
                    _currentBannerIndex = (_currentBannerIndex + 1) % count;
                    StateHasChanged();
                });
            }
        }, null, 4500, 4500);
    }

    private void NextBanner()
    {
        var count = Banners.Count();
        if (count > 1)
        {
            _currentBannerIndex = (_currentBannerIndex + 1) % count;
            StartBannerAutoplay();
        }
    }

    private void PrevBanner()
    {
        var count = Banners.Count();
        if (count > 1)
        {
            _currentBannerIndex = (_currentBannerIndex - 1 + count) % count;
            StartBannerAutoplay();
        }
    }

    private void SelectBanner(int index)
    {
        _currentBannerIndex = index;
        StartBannerAutoplay();
    }

    private bool IsLoading = true;
    private bool _metadataLoaded = false;
    private string? _lastAppliedCategoryQuery;
    private int? _lastAppliedCategoryIdQuery;
    private string? _lastAppliedSearchQuery;
    private bool? _lastAppliedSaleQuery;



    private string CurrentSort
    {
        get => Query.SortBy ?? "newest";
        set => Query.SortBy = value;
    }

    private bool IsDedicatedCategoryView
    {
        get
        {
            var uri = NavManager != null ? NavManager.ToAbsoluteUri(NavManager.Uri) : null;
            if (uri != null && uri.AbsolutePath == "/" && string.IsNullOrEmpty(uri.Query))
            {
                return false;
            }

            return !string.IsNullOrWhiteSpace(CategoryQuery) ||
                   CategoryIdQuery.HasValue ||
                   !string.IsNullOrWhiteSpace(SearchQuery) ||
                   SaleQuery == true ||
                   (uri != null && uri.AbsolutePath.Contains("/catalog") && !string.IsNullOrEmpty(uri.Query));
        }
    }

    private string GetActiveCollectionTitle()
    {
        if (SaleQuery == true)
        {
            var activeOpt = GetActiveOption();
            if (activeOpt != null && !activeOpt.IsParentAll)
            {
                return $"SALE - {activeOpt.Name}";
            }
            return "Sản Phẩm Khuyến Mãi (SALE)";
        }

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            return $"Kết quả tìm kiếm cho: \"{SearchQuery}\"";
        }

        var opt = GetActiveOption();
        if (opt != null)
        {
            if (opt.IsParentAll)
            {
                return CurrentBranch switch
                {
                    CatalogBranch.Shirt => "Bộ Sưu Tập Áo",
                    CatalogBranch.Pant => "Bộ Sưu Tập Quần",
                    CatalogBranch.Jean => "Bộ Sưu Tập Đồ Jean",
                    CatalogBranch.Accessory => "Bộ Sưu Tập Phụ Kiện",
                    _ => "Bộ Sưu Tập Sản Phẩm"
                };
            }
            return opt.Name;
        }

        if (Query.CategoryId.HasValue)
        {
            var cat = Categories.FirstOrDefault(c => c.MaDanhMuc == Query.CategoryId.Value);
            if (cat != null)
            {
                return cat.TenDanhMuc;
            }
        }

        return "Bộ Sưu Tập Sản Phẩm";
    }

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += HandleLocationChanged;
        await LoadMetadataAsync();
        _metadataLoaded = true;
        ApplyUrlParameters();
        await LoadProductsAsync();
    }

