    private void ToggleDropdown(string key)
    {
        ActiveDropdown = (ActiveDropdown == key) ? null : key;
    }

    private void CloseAllDropdowns()
    {
        ActiveDropdown = null;
    }

    private void SelectCategoryOption(CategoryFilterOption opt)
    {
        ActiveDropdown = null;
        if (opt.IsParentAll)
        {
            var parentSlug = GetBranchParentSlug();
            if (CurrentBranch == CatalogBranch.Sale)
            {
                NavManager.NavigateTo("/catalog?sale=true");
            }
            else if (!string.IsNullOrEmpty(parentSlug))
            {
                NavManager.NavigateTo($"/catalog?category={parentSlug}");
            }
            else
            {
                NavManager.NavigateTo("/catalog");
            }
        }
        else
        {
            if (CurrentBranch == CatalogBranch.Sale)
            {
                NavManager.NavigateTo($"/catalog?sale=true&category={opt.Slug}");
            }
            else
            {
                NavManager.NavigateTo($"/catalog?category={opt.Slug}");
            }
        }
    }

    private void ResetToBranchDefault()
    {
        ActiveDropdown = null;
        _selectedKieuFilters.Clear();
        var parentSlug = GetBranchParentSlug();
        if (CurrentBranch == CatalogBranch.Sale)
        {
            NavManager.NavigateTo("/catalog?sale=true");
        }
        else if (!string.IsNullOrEmpty(parentSlug))
        {
            NavManager.NavigateTo($"/catalog?category={parentSlug}");
        }
        else
        {
            NavManager.NavigateTo("/catalog");
        }
    }

    private async Task SelectBrandFilter(int? brandId)
    {
        ActiveDropdown = null;
        await SelectBrand(brandId);
    }

    private string GetPriceFilterLabel()
    {
        if (Query.MinPrice.HasValue && Query.MaxPrice.HasValue)
            return $"{Query.MinPrice.Value:N0} - {Query.MaxPrice.Value:N0} ₫";
        if (Query.MaxPrice.HasValue)
            return $"Dưới {Query.MaxPrice.Value:N0} ₫";
        if (Query.MinPrice.HasValue)
            return $"Trên {Query.MinPrice.Value:N0} ₫";
        return "Mức giá";
    }

    private async Task SetPriceFilter(decimal? min, decimal? max)
    {
        Query.MinPrice = min;
        Query.MaxPrice = max;
        Query.PageNumber = 1;
        ActiveDropdown = null;
        await LoadProductsAsync();
    }

    private void SetStockFilter(bool onlyInStock)
    {
        _onlyInStock = onlyInStock;
        ActiveDropdown = null;
    }

    private List<string> _selectedKieuFilters = new();

    public class KieuOption
    {
        public string Name { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private IEnumerable<KieuOption> GetAvailableKieuOptions()
    {
        return new List<KieuOption>
        {
            new() { Name = "Quần Tây Loose Fit", Label = "Quần Tây Loose Fit (1)" },
            new() { Name = "Quần Tây Regular Fit", Label = "Quần Tây Regular Fit (4)" },
            new() { Name = "Quần Tây Slim Fit", Label = "Quần Tây Slim Fit (20)" }
        };
    }

    private void ToggleKieuFilter(string name, bool isChecked)
    {
        if (isChecked && !_selectedKieuFilters.Contains(name))
            _selectedKieuFilters.Add(name);
        else if (!isChecked)
            _selectedKieuFilters.Remove(name);
    }

    private Task RemoveKieuFilter(string name)
    {
        _selectedKieuFilters.Remove(name);
        return Task.CompletedTask;
    }

    private Task ResetKieuFilters()
    {
        _selectedKieuFilters.Clear();
        return Task.CompletedTask;
    }

    private bool _hasActiveFilters => HasActiveCategoryFilter || _selectedKieuFilters.Any() || Query.BrandId.HasValue || Query.MinPrice.HasValue || Query.MaxPrice.HasValue || _onlyInStock;

    private void ClearAllHorizontalFilters()
    {
        Query.BrandId = null;
        Query.MinPrice = null;
        Query.MaxPrice = null;
        _onlyInStock = false;
        _selectedKieuFilters.Clear();
        ActiveDropdown = null;
        ResetToBranchDefault();
    }

    private IEnumerable<ProductListItemDto> DisplayedProducts
    {
        get
        {
            if (PagedResult == null || PagedResult.Items == null)
                return Enumerable.Empty<ProductListItemDto>();

            if (_onlyInStock)
                return PagedResult.Items.Where(p => p.TongTonKho > 0);

            return PagedResult.Items;
        }
    }
}

