                        <span class="quick-size-badge">CHỌN SIZE NHANH</span>
                        <h4 class="quick-size-title">@_quickSelectProduct.TenSanPham</h4>
                        <span class="quick-size-price">@_quickSelectProduct.GiaThapNhat.ToString("N0") ₫</span>
