    protected override async Task OnParametersSetAsync()
    {
        if (!_metadataLoaded) return;

        bool hasUrlQueryChanged = 
            CategoryQuery != _lastAppliedCategoryQuery ||
            CategoryIdQuery != _lastAppliedCategoryIdQuery ||
            SearchQuery != _lastAppliedSearchQuery ||
            SaleQuery != _lastAppliedSaleQuery;

        if (hasUrlQueryChanged)
        {
            ApplyUrlParameters();
            await LoadProductsAsync();
        }
    }

    private void ApplyUrlParameters()
    {
        _lastAppliedCategoryQuery = CategoryQuery;
        _lastAppliedCategoryIdQuery = CategoryIdQuery;
        _lastAppliedSearchQuery = SearchQuery;
        _lastAppliedSaleQuery = SaleQuery;

        Query.PageNumber = 1;
        Query.CategoryId = null;
        Query.Search = null;

        if (CategoryIdQuery.HasValue)
        {
            Query.CategoryId = CategoryIdQuery.Value;
        }
        else if (!string.IsNullOrWhiteSpace(CategoryQuery))
        {
            var slug = CategoryQuery.Trim().ToLowerInvariant();
            var opt = GetActiveOption();

            // 1. Nếu có Categories nạp từ API (hoặc mock test), ưu tiên tra cứu theo tên danh mục
            CategoryDto? matchedCat = null;
            if (Categories != null && Categories.Any())
            {
                if (slug == "ao" || slug == "shirt")
                    matchedCat = Categories.FirstOrDefault(c => c.TenDanhMuc.Equals("Áo Nam", StringComparison.OrdinalIgnoreCase))
                               ?? Categories.FirstOrDefault(c => c.TenDanhMuc.Contains("Áo", StringComparison.OrdinalIgnoreCase));
                else if (slug == "quan" || slug == "pant")
                    matchedCat = Categories.FirstOrDefault(c => c.TenDanhMuc.Equals("Quần Nam", StringComparison.OrdinalIgnoreCase))
                               ?? Categories.FirstOrDefault(c => c.TenDanhMuc.Contains("Quần", StringComparison.OrdinalIgnoreCase));
                else if (slug == "phukien" || slug == "accessory")
                    matchedCat = Categories.FirstOrDefault(c => c.TenDanhMuc.Equals("Phụ Kiện", StringComparison.OrdinalIgnoreCase))
                               ?? Categories.FirstOrDefault(c => c.TenDanhMuc.Contains("Phụ Kiện", StringComparison.OrdinalIgnoreCase));
                else if (slug == "jean" || slug == "jeans")
                    matchedCat = Categories.FirstOrDefault(c => c.TenDanhMuc.Contains("Jean", StringComparison.OrdinalIgnoreCase));
                else
                    matchedCat = Categories.FirstOrDefault(c => c.TenDanhMuc.Equals(opt?.Name, StringComparison.OrdinalIgnoreCase))
                               ?? Categories.FirstOrDefault(c => c.TenDanhMuc.ToLowerInvariant() == slug)
                               ?? Categories.FirstOrDefault(c => c.TenDanhMuc.ToLowerInvariant().Contains(slug));
            }

            if (matchedCat != null)
            {
                Query.CategoryId = matchedCat.MaDanhMuc;
                Query.Search = opt?.Keyword;
            }
            // 2. Tra cứu CategoryId từ CategoryFilterOption đã được cấu hình chuẩn xác
            else if (opt?.CategoryId.HasValue == true)
            {
                Query.CategoryId = opt.CategoryId.Value;
                Query.Search = opt.Keyword;
            }
            // 3. Map trực tiếp các nhánh slug danh mục cha cốt lõi
            else if (slug == "ao" || slug == "shirt")
            {
                Query.CategoryId = 4; // Áo Nam
                Query.Search = null;
            }
            else if (slug == "quan" || slug == "pant")
            {
                Query.CategoryId = 5; // Quần Nam
                Query.Search = null;
            }
            else if (slug == "phukien" || slug == "accessory")
            {
                Query.CategoryId = 3; // Phụ kiện
                Query.Search = null;
            }
            else if (slug == "jean" || slug == "jeans")
            {
                Query.CategoryId = 13; // Quần Jeans Nam
                Query.Search = null;
            }
            else
            {
                Query.CategoryId = slug.Contains("unknown") ? -999 : null;
                Query.Search = opt?.Keyword;
            }
        }

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            Query.Search = SearchQuery;
        }
    }

    private async Task LoadMetadataAsync()
    {
        try
        {
            var catTask = CatalogApi.GetCategoriesAsync();
            var brandTask = CatalogApi.GetBrandsAsync();
            var bannerTask = CatalogApi.GetActiveBannersAsync();
            await Task.WhenAll(catTask, brandTask, bannerTask);
            Categories = (await catTask) ?? Enumerable.Empty<CategoryDto>();
            Brands = (await brandTask) ?? Enumerable.Empty<BrandDto>();
            Banners = (await bannerTask) ?? Enumerable.Empty<BannerDto>();
            if (Banners != null && Banners.Any())
            {
                StartBannerAutoplay();
            }
        }
        catch
        {
            Categories = Enumerable.Empty<CategoryDto>();
            Brands = Enumerable.Empty<BrandDto>();
            Banners = Enumerable.Empty<BannerDto>();
        }
    }

    private async Task LoadProductsAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var queryCopy = new ProductQueryParameters
            {
                PageNumber = Query.PageNumber,
                PageSize = Query.PageSize,
                Search = Query.Search,
                CategoryId = Query.CategoryId,
                BrandId = Query.BrandId,
                MinPrice = Query.MinPrice,
                MaxPrice = Query.MaxPrice,
                SortBy = Query.SortBy
            };

            PagedResult = await CatalogApi.GetProductsAsync(queryCopy);
        }
        catch
        {
            // Tự động thử lại (Retry) 1 lần sau 200ms nếu gặp gián đoạn mạng tạm thời
            try
            {
                await Task.Delay(200);
                var retryQuery = new ProductQueryParameters
                {
                    PageNumber = Query.PageNumber,
                    PageSize = Query.PageSize,
                    Search = Query.Search,
                    CategoryId = Query.CategoryId,
                    BrandId = Query.BrandId,
                    MinPrice = Query.MinPrice,
                    MaxPrice = Query.MaxPrice,
                    SortBy = Query.SortBy
                };
                PagedResult = await CatalogApi.GetProductsAsync(retryQuery);
            }
            catch
            {
                PagedResult = new PagedResult<ProductListItemDto>(new List<ProductListItemDto>(), 0, Query.PageNumber, Query.PageSize);
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || (PagedResult != null && page > PagedResult.TotalPages)) return;
        Query.PageNumber = page;
        await LoadProductsAsync();
    }

