    public enum CatalogBranch
    {
        All,
        Shirt,
        Pant,
        Jean,
        Accessory,
        Sale
    }

    public class CategoryFilterOption
    {
        public string Slug { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int? CategoryId { get; set; }
        public string? Keyword { get; set; }
        public bool IsParentAll { get; set; }
    }

    private CatalogBranch CurrentBranch
    {
        get
        {
            if (SaleQuery == true) return CatalogBranch.Sale;

            var slug = (CategoryQuery ?? string.Empty).Trim().ToLowerInvariant();
            if (!string.IsNullOrEmpty(slug))
            {
                if (slug.StartsWith("phukien") || slug.Contains("that-lung") || slug == "vo" || slug.Contains("gang") || slug.Contains("balo") || slug.Contains("vi") || slug.Contains("non") || slug.Contains("tui"))
                {
                    return CatalogBranch.Accessory;
                }

                if (slug.StartsWith("jean") || slug.Contains("jeans"))
                {
                    return CatalogBranch.Jean;
                }

                if (slug.StartsWith("quan") || slug.Contains("kaki") || slug.Contains("tay") || slug.Contains("short") || slug.Contains("lot") || slug.Contains("dai"))
                {
                    return CatalogBranch.Pant;
                }

                if (slug.StartsWith("ao") || slug.Contains("so-mi") || slug.Contains("polo") || slug.Contains("thun") || slug.Contains("tanktop") || slug.Contains("khoac"))
                {
                    return CatalogBranch.Shirt;
                }
            }

            if (CategoryIdQuery.HasValue)
            {
                var catId = CategoryIdQuery.Value;
                if (catId == 3 || catId == 9 || catId == 10) return CatalogBranch.Accessory;
                if (catId == 13 || catId == 16) return CatalogBranch.Jean;
                if (catId == 5 || catId == 7 || catId == 14) return CatalogBranch.Pant;
                if (catId == 4 || catId == 6 || catId == 11 || catId == 12 || catId == 15) return CatalogBranch.Shirt;
            }

            if (Query.CategoryId.HasValue)
            {
                var catId = Query.CategoryId.Value;
                if (catId == 3 || catId == 9 || catId == 10) return CatalogBranch.Accessory;
                if (catId == 13 || catId == 16) return CatalogBranch.Jean;
                if (catId == 5 || catId == 7 || catId == 14) return CatalogBranch.Pant;
                if (catId == 4 || catId == 6 || catId == 11 || catId == 12 || catId == 15) return CatalogBranch.Shirt;
            }

            return CatalogBranch.All;
        }
    }

