                    <div class="quick-size-grid">
                        @foreach (var variant in GetQuickVariantsForSelectedColor())
                        {
                            var inStock = variant.SoLuongTon > 0;
                            <button type="button" 
                                    class="quick-size-pill @(inStock ? "in-stock" : "out-of-stock")" 
                                    disabled="@(!inStock)" 
                                    @onclick="() => SelectQuickSizeAndAdd(variant)">
                                <span class="size-val">@variant.KichCo</span>
