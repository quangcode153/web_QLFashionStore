@page "/catalog"
@page "/"
@namespace Frontend.Pages
@inject ICatalogApiClient CatalogApi
@inject ICartService CartService
@inject IToastService Toast
@inject NavigationManager NavManager
@implements IDisposable

<div class="catalog-page-container">
@if (!IsDedicatedCategoryView)
    {
        <!-- =========================================================================
             1. HERO ASYMMETRIC BANNER (SCREENSHOT 1: WORK TO WEEKEND / MẶC ĐẸP ĐI LÀM TAN TẦM ĐI QUẨY)
             ========================================================================= -->
        <section class="yame-hero-section">
            <div class="hero-split-container">
                <!-- Left Side: Editorial Model Photography -->
                <div class="hero-media-panel">
                    <img src="@(string.IsNullOrEmpty(CurrentBanner.HinhAnh) ? "images/hero-model.jpg" : CurrentBanner.HinhAnh)" 
                         alt="@CurrentBanner.TieuDe" 
                         class="hero-media-img" 
                         onerror="this.onerror=null;this.src='images/hero-model.jpg';" />

                    @if (!string.IsNullOrWhiteSpace(CurrentBanner.NhanBadge))
                    {
                        var badgeWords = CurrentBanner.NhanBadge.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        <div class="hero-stamp-badge">
                            @if (badgeWords.Length >= 3)
                            {
                                <span class="stamp-sub">@badgeWords[0]</span>
                                <span class="stamp-main">@badgeWords[1]</span>
                                <span class="stamp-sub">@string.Join(" ", badgeWords.Skip(2))</span>
                            }
                            else
                            {
                                <span class="stamp-main">@CurrentBanner.NhanBadge</span>
                            }
                        </div>
                    }

                    <!-- Carousel Controls (Left Side Overlay) -->
                    @if (Banners.Count() > 1)
                    {
                        <div class="hero-carousel-nav">
                            <button type="button" class="carousel-arrow-btn prev-btn" @onclick="PrevBanner" aria-label="Banner trước">
                                ‹
                            </button>
                            <button type="button" class="carousel-arrow-btn next-btn" @onclick="NextBanner" aria-label="Banner kế tiếp">
                                ›
                            </button>
                        </div>
                    }
                </div>

                <!-- Right Side: Dark Slate Charcoal Statement Panel -->
                <div class="hero-statement-panel">
                    <div class="hero-statement-content">
                        <h1 class="hero-headline">
                            @((MarkupString)CurrentBanner.TieuDe.Replace("\n", "<br />"))
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(CurrentBanner.PhuDe) || !string.IsNullOrWhiteSpace(CurrentBanner.GiaNoiBat))
                        {
                            <div class="hero-deal-block">
                                @if (!string.IsNullOrWhiteSpace(CurrentBanner.PhuDe))
                                {
                                    <div class="deal-header">
                                        <span class="deal-dash"></span>
                                        <span class="deal-tagline">@CurrentBanner.PhuDe</span>
                                        <span class="deal-dash"></span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(CurrentBanner.GiaNoiBat))
                                {
                                    <div class="deal-price-spot">
                                        <span class="deal-price-value">@CurrentBanner.GiaNoiBat.Replace("K", "").Replace("k", "").Replace("đ", "").Replace("₫", "").Trim()</span><span class="deal-price-unit">K</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="hero-cta-wrapper">
                            @if (!string.IsNullOrWhiteSpace(CurrentBanner.NutChinhText))
                            {
                                <a href="@(string.IsNullOrEmpty(CurrentBanner.NutChinhLink) ? "#product-catalog" : CurrentBanner.NutChinhLink)" class="hero-btn-cta">
                                    @CurrentBanner.NutChinhText
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(CurrentBanner.NutPhuText))
                            {
                                @if (CurrentBanner.NutPhuLink == "#ai-advisor")
                                {
                                    <button type="button" class="hero-btn-sub-cta" @onclick="ToggleAiModal" title="Mở trợ lý gợi ý phối đồ & tư vấn size">
                                        @CurrentBanner.NutPhuText
                                    </button>
                                }
                                else
                                {
                                    <a href="@(string.IsNullOrEmpty(CurrentBanner.NutPhuLink) ? "/catalog?category=jean" : CurrentBanner.NutPhuLink)" class="hero-btn-sub-cta">
                                        @CurrentBanner.NutPhuText
                                    </a>
                                }
                            }
                        </div>

                        <!-- Dots Carousel Indicators -->
                        @if (Banners.Count() > 1)
                        {
                            <div class="hero-carousel-dots">
                                @for (int i = 0; i < Banners.Count(); i++)
                                {
                                    var idx = i;
                                    <button type="button" 
                                            class="carousel-dot @(idx == _currentBannerIndex ? "active" : "")" 
                                            @onclick="() => SelectBanner(idx)"
                                            aria-label="@($"Chuyển banner {idx + 1}")"></button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Floating Size Support Widget (Hỗ trợ chọn size chuẩn phom QF) -->
            <div class="yame-ai-size-floating" @onclick="ToggleAiModal" title="Hỗ trợ chọn size">
                <div class="ai-advisor-badge">
                    <span class="ai-badge-title">Hỗ trợ chọn size</span>
                    <button type="button" class="ai-badge-btn">Gợi ý nhanh</button>
                </div>
                <div class="ai-avatar-wrapper size-advisor-avatar-wrapper">
                    <div class="size-avatar-icon-btn">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================================
             2. CONTINUOUS TICKER / RUNNING MARQUEE BAR (SCREENSHOT 2: BLACK REPEATING RIBBON)
             ========================================================================= -->
        <section class="yame-marquee-strip" aria-label="QF Cam kết uy tín">
            <div class="marquee-track">
                <div class="marquee-group">
                    <span class="marquee-item">BẢO HÀNH 365 NGÀY</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">MIỄN PHÍ SHIP*</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">14 NGÀY ĐỔI TRẢ LINH HOẠT</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">BẢO HÀNH 365 NGÀY</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">MIỄN PHÍ SHIP*</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">VẢI BỀN - MỀM - TÔN DÁNG</span>
                    <span class="marquee-sep">•</span>
                </div>
                <div class="marquee-group" aria-hidden="true">
                    <span class="marquee-item">BẢO HÀNH 365 NGÀY</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">MIỄN PHÍ SHIP*</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">14 NGÀY ĐỔI TRẢ LINH HOẠT</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">BẢO HÀNH 365 NGÀY</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">MIỄN PHÍ SHIP*</span>
                    <span class="marquee-sep">•</span>
                    <span class="marquee-item">VẢI BỀN - MỀM - TÔN DÁNG</span>
                    <span class="marquee-sep">•</span>
                </div>
            </div>
        </section>

        <!-- =========================================================================
             3. SECTION TITLE & CATEGORY PILL TABS (SCREENSHOT 2: YAME.VN - THỜI TRANG NAM...)
             ========================================================================= -->
        <div id="product-catalog" class="section-title-wrapper" style="padding-top: 3rem; margin-bottom: 1.5rem;">
            <h2 class="yame-section-heading">QF - THỜI TRANG BỀN, MỀM, KHÔNG LỖI MỐT</h2>
        </div>

        <!-- Category Filter Pills (Áo, Quần, Phụ kiện) -->
        <div class="yame-pill-nav">
            <button type="button" 
                    class="pill-tab-btn @(!Query.CategoryId.HasValue ? "active" : "")"
                    @onclick="() => SelectCategory(null)">
                Tất cả
            </button>
            <button type="button" 
                    class="pill-tab-btn @(IsCategoryPillActive("ao") ? "active" : "")"
                    @onclick='() => SelectQuickPill("ao")'>
                Áo
            </button>
            <button type="button" 
                    class="pill-tab-btn @(IsCategoryPillActive("quan") ? "active" : "")"
                    @onclick='() => SelectQuickPill("quan")'>
                Quần
            </button>
            <button type="button" 
                    class="pill-tab-btn @(IsCategoryPillActive("phukien") ? "active" : "")"
                    @onclick='() => SelectQuickPill("phukien")'>
                Phụ kiện
            </button>
        </div>
    }
    else
    {
        <!-- =========================================================================
             DEDICATED CATEGORY / COLLECTION HEADER (SCREENSHOT: TRANG CHỦ > TÊN DANH MỤC)
             ========================================================================= -->
        <div class="dedicated-category-header" style="padding-top: 1.5rem; margin-bottom: 1.75rem;">
            <nav class="dedicated-breadcrumb" aria-label="Đường dẫn" style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.75rem;">
                <a href="/" style="color: #64748B; text-decoration: none;" @onclick="NavigateToCleanHome" @onclick:preventDefault="true">Trang chủ</a>
                <span style="margin: 0 0.5rem; color: #CBD5E1;">&gt;</span>
                <span style="color: #0F172A; font-weight: 600;">@GetActiveCollectionTitle()</span>
            </nav>
            <h1 class="dedicated-category-title" style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; letter-spacing: -0.025em; color: #0F172A; margin: 0;">
                @GetActiveCollectionTitle()
            </h1>
        </div>

        <!-- Floating Size Support Widget (available on dedicated collection too) -->
        <div class="yame-ai-size-floating" @onclick="ToggleAiModal" title="Hỗ trợ chọn size">
            <div class="ai-advisor-badge">
                <span class="ai-badge-title">Hỗ trợ chọn size</span>
                <button type="button" class="ai-badge-btn">Gợi ý nhanh</button>
            </div>
            <div class="ai-avatar-wrapper size-advisor-avatar-wrapper">
                <div class="size-avatar-icon-btn">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                    </svg>
                </div>
            </div>
        </div>
    }


    <div class="catalog-main-layout @(IsDedicatedCategoryView ? "is-dedicated" : "")">
        @if (!IsDedicatedCategoryView)
        {
            <!-- SIDEBAR FILTERS (Chỉ hiển thị cho Trang chủ / Catalog tổng hợp) -->
            <aside class="catalog-sidebar">
                <div class="filter-header">
                    <h3>Bộ Lọc Sản Phẩm</h3>
                    <button type="button" class="btn-reset-filters" @onclick="ResetFilters">Đặt lại</button>
                </div>

                <!-- DANH MỤC -->
                <div class="filter-group">
                    <h4 class="filter-group-title">Danh Mục</h4>
                    <div class="filter-options">
                        <button type="button" 
                                class="filter-chip @(!Query.CategoryId.HasValue ? "active" : "")" 
                                @onclick="() => SelectCategory(null)">
                            Tất cả
                        </button>
                        @foreach (var opt in GetAvailableCategoryOptions().Where(o => o.CategoryId.HasValue))
                        {
                            <button type="button" 
                                    class="filter-chip @(Query.CategoryId == opt.CategoryId ? "active" : "")" 
                                    @onclick="() => SelectCategory(opt.CategoryId)">
                                @opt.Name.Replace("— ", "")
                            </button>
                        }
                    </div>
                </div>

                <!-- THƯƠNG HIỆU -->
                <div class="filter-group">
                    <h4 class="filter-group-title">Thương Hiệu</h4>
                    <div class="filter-options">
                        <button type="button" 
                                class="filter-chip @(!Query.BrandId.HasValue ? "active" : "")" 
                                @onclick="() => SelectBrand(null)">
                            Tất cả
                        </button>
                        @foreach (var brand in Brands)
                        {
                            <button type="button" 
                                    class="filter-chip @(Query.BrandId == brand.MaThuongHieu ? "active" : "")" 
                                    @onclick="() => SelectBrand(brand.MaThuongHieu)">
                                @brand.TenThuongHieu
                            </button>
                        }
                    </div>
                </div>

                <!-- KHOẢNG GIÁ -->
                <div class="filter-group">
                    <h4 class="filter-group-title">Khoảng Giá</h4>
                    <div class="price-filter-inputs">
                        <input type="number" class="price-input" placeholder="Từ" @bind="Query.MinPrice" />
                        <span>—</span>
                        <input type="number" class="price-input" placeholder="Đến" @bind="Query.MaxPrice" />
                    </div>
                    <button type="button" class="btn-apply-filters" @onclick="ApplyFilters">Áp dụng giá</button>
                </div>
            </aside>
        }

        <!-- MAIN PRODUCT SECTION -->
        <main class="catalog-content @(IsDedicatedCategoryView ? "is-dedicated-content" : "")">
            @if (IsDedicatedCategoryView)
            {
                <!-- DEDICATED HORIZONTAL TOOLBAR 100% REAL DATABASE DATA (SCOPED TO CURRENT HEADER BRANCH) -->
                <div class="dedicated-horizontal-toolbar">
                    <div class="dedicated-filter-tags">
                        <span class="filter-lead">Bộ lọc:</span>

                        <!-- 1. Danh mục sản phẩm (Được giới hạn theo chuyên mục Header đã chọn) -->
                        <div class="filter-dropdown-wrapper">
                            <button type="button" 
                                    class="filter-tag-chip @(ActiveDropdown == "cat" ? "active-open" : "") @(HasActiveCategoryFilter ? "has-val" : "")" 
                                    @onclick='() => ToggleDropdown("cat")'>
                                @GetSelectedCategoryChipLabel()
                                <svg class="dropdown-chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            @if (ActiveDropdown == "cat")
                            {
                                <div class="filter-dropdown-menu">
                                    <div class="dropdown-header-row">
                                        <span class="dropdown-selected-count">Chọn danh mục</span>
                                        <button type="button" class="dropdown-reset-btn" @onclick="ResetToBranchDefault">Tất cả</button>
                                    </div>
                                    <div class="dropdown-options-list">
                                        @foreach (var opt in GetAvailableCategoryOptions())
                                        {
                                            <label class="dropdown-option-item" @onclick="() => SelectCategoryOption(opt)">
                                                <input type="radio" name="cat_filter" checked="@(IsActiveCategoryOption(opt))" />
                                                <span class="option-label @(IsActiveCategoryOption(opt) ? "selected-underline" : "")">
                                                    @opt.Name
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Kiểu sản phẩm (Chuyên mục chuẩn YaMe) -->
                        <div class="filter-dropdown-wrapper">
                            <button type="button" 
                                    class="filter-tag-chip @(ActiveDropdown == "kieu" ? "active-open" : "") @(_selectedKieuFilters.Any() ? "has-val" : "")" 
                                    @onclick='() => ToggleDropdown("kieu")'>
                                Kiểu sản phẩm
                                <svg class="dropdown-chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            @if (ActiveDropdown == "kieu")
                            {
                                <div class="filter-dropdown-menu">
                                    <div class="dropdown-header-row">
                                        <span class="dropdown-selected-count">Đã chọn @_selectedKieuFilters.Count</span>
                                        <button type="button" class="dropdown-reset-btn" @onclick="ResetKieuFilters">Đặt lại</button>
                                    </div>
                                    <div class="dropdown-options-list">
                                        @foreach (var kieu in GetAvailableKieuOptions())
                                        {
                                            <label class="dropdown-option-item">
                                                <input type="checkbox" checked="@(_selectedKieuFilters.Contains(kieu.Name))" @onchange="(e) => ToggleKieuFilter(kieu.Name, (bool)e.Value!)" />
                                                <span class="option-label">@kieu.Label</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 2. Thương hiệu (Từ CSDL) -->
                        <div class="filter-dropdown-wrapper">
                            <button type="button" 
                                    class="filter-tag-chip @(ActiveDropdown == "brand" ? "active-open" : "") @(Query.BrandId.HasValue ? "has-val" : "")" 
                                    @onclick='() => ToggleDropdown("brand")'>
                                @(Brands.FirstOrDefault(b => b.MaThuongHieu == Query.BrandId)?.TenThuongHieu ?? "Thương hiệu")
                                <svg class="dropdown-chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            @if (ActiveDropdown == "brand")
                            {
                                <div class="filter-dropdown-menu">
                                    <div class="dropdown-header-row">
                                        <span class="dropdown-selected-count">Chọn thương hiệu</span>
                                        @if (Query.BrandId.HasValue)
                                        {
                                            <button type="button" class="dropdown-reset-btn" @onclick="() => SelectBrandFilter(null)">Tất cả</button>
                                        }
                                    </div>
                                    <div class="dropdown-options-list">
                                        <label class="dropdown-option-item" @onclick="() => SelectBrandFilter(null)">
                                            <input type="radio" name="brand_filter" checked="@(!Query.BrandId.HasValue)" />
                                            <span class="option-label">Tất cả thương hiệu</span>
                                        </label>
                                        @foreach (var b in Brands)
                                        {
                                            <label class="dropdown-option-item" @onclick="() => SelectBrandFilter(b.MaThuongHieu)">
                                                <input type="radio" name="brand_filter" checked="@(Query.BrandId == b.MaThuongHieu)" />
                                                <span class="option-label @(Query.BrandId == b.MaThuongHieu ? "selected-underline" : "")">
                                                    @b.TenThuongHieu
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 3. Mức giá (Theo SQL MinPrice / MaxPrice) -->
                        <div class="filter-dropdown-wrapper">
                            <button type="button" 
                                    class="filter-tag-chip @(ActiveDropdown == "price" ? "active-open" : "") @(Query.MinPrice.HasValue || Query.MaxPrice.HasValue ? "has-val" : "")" 
                                    @onclick='() => ToggleDropdown("price")'>
                                @GetPriceFilterLabel()
                                <svg class="dropdown-chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            @if (ActiveDropdown == "price")
                            {
                                <div class="filter-dropdown-menu">
                                    <div class="dropdown-header-row">
                                        <span class="dropdown-selected-count">Khoảng giá</span>
                                        @if (Query.MinPrice.HasValue || Query.MaxPrice.HasValue)
                                        {
                                            <button type="button" class="dropdown-reset-btn" @onclick="() => SetPriceFilter(null, null)">Đặt lại</button>
                                        }
                                    </div>
                                    <div class="dropdown-options-list">
                                        <label class="dropdown-option-item" @onclick="() => SetPriceFilter(null, null)">
                                            <input type="radio" name="price_range" checked="@(!Query.MinPrice.HasValue && !Query.MaxPrice.HasValue)" />
                                            <span class="option-label">Tất cả mức giá</span>
                                        </label>
                                        <label class="dropdown-option-item" @onclick="() => SetPriceFilter(null, 200000)">
                                            <input type="radio" name="price_range" checked="@(Query.MaxPrice == 200000 && !Query.MinPrice.HasValue)" />
                                            <span class="option-label">Dưới 200.000 ₫</span>
                                        </label>
                                        <label class="dropdown-option-item" @onclick="() => SetPriceFilter(200000, 350000)">
                                            <input type="radio" name="price_range" checked="@(Query.MinPrice == 200000 && Query.MaxPrice == 350000)" />
                                            <span class="option-label">200.000 ₫ - 350.000 ₫</span>
                                        </label>
                                        <label class="dropdown-option-item" @onclick="() => SetPriceFilter(350000, 500000)">
                                            <input type="radio" name="price_range" checked="@(Query.MinPrice == 350000 && Query.MaxPrice == 500000)" />
                                            <span class="option-label">350.000 ₫ - 500.000 ₫</span>
                                        </label>
                                        <label class="dropdown-option-item" @onclick="() => SetPriceFilter(500000, null)">
                                            <input type="radio" name="price_range" checked="@(Query.MinPrice == 500000 && !Query.MaxPrice.HasValue)" />
                                            <span class="option-label">Trên 500.000 ₫</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 4. Tình trạng hàng tồn kho -->
                        <div class="filter-dropdown-wrapper">
                            <button type="button" 
                                    class="filter-tag-chip @(ActiveDropdown == "stock" ? "active-open" : "") @(_onlyInStock ? "has-val" : "")" 
                                    @onclick='() => ToggleDropdown("stock")'>
                                @(_onlyInStock ? "Chỉ còn hàng" : "Kho hàng")
                                <svg class="dropdown-chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            @if (ActiveDropdown == "stock")
                            {
                                <div class="filter-dropdown-menu">
                                    <div class="dropdown-options-list">
                                        <label class="dropdown-option-item" @onclick="() => SetStockFilter(false)">
                                            <input type="radio" name="stock_filter" checked="@(!_onlyInStock)" />
                                            <span class="option-label">Tất cả sản phẩm</span>
                                        </label>
                                        <label class="dropdown-option-item" @onclick="() => SetStockFilter(true)">
                                            <input type="radio" name="stock_filter" checked="@(_onlyInStock)" />
                                            <span class="option-label">Chỉ sản phẩm còn hàng</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="dedicated-sort-wrap">
                        <label for="dedicated-sort-select" class="sort-lead">Sắp xếp theo:</label>
                        <select id="dedicated-sort-select" class="sort-select" @bind="CurrentSort" @bind:after="OnSortChanged">
                            <option value="newest">Ngày (từ mới đến cũ)</option>
                            <option value="price_asc">Giá: Thấp đến Cao</option>
                            <option value="price_desc">Giá: Cao đến Thấp</option>
                        </select>
                        <span class="product-count-summary dedicated-count-val"><strong>@(PagedResult?.TotalCount ?? 0) sản phẩm</strong></span>
                    </div>
                </div>

                @if (_hasActiveFilters)
                {
                    <!-- ACTIVE FILTER CHIPS (DỮ LIỆU THẬT) -->
                    <div class="active-horizontal-chips-bar">
                        <div class="active-chips-list">
                            @if (HasActiveCategoryFilter)
                            {
                                <span class="active-chip-pill">
                                    Danh mục: @GetSelectedCategoryChipLabel()
                                    <button type="button" class="chip-remove-btn" @onclick="ResetToBranchDefault">✕</button>
                                </span>
                            }
                            @foreach (var kieu in _selectedKieuFilters.ToList())
                            {
                                var kieuName = kieu;
                                <span class="active-chip-pill">
                                    Kiểu : @kieuName
                                    <button type="button" class="chip-remove-btn" @onclick="() => RemoveKieuFilter(kieuName)">✕</button>
                                </span>
                            }
                            @if (Query.BrandId.HasValue)
                            {
                                <span class="active-chip-pill">
                                    Thương hiệu: @(Brands.FirstOrDefault(b => b.MaThuongHieu == Query.BrandId)?.TenThuongHieu)
                                    <button type="button" class="chip-remove-btn" @onclick="() => SelectBrandFilter(null)">✕</button>
                                </span>
                            }
                            @if (Query.MinPrice.HasValue || Query.MaxPrice.HasValue)
                            {
                                <span class="active-chip-pill">
                                    Giá: @GetPriceFilterLabel()
                                    <button type="button" class="chip-remove-btn" @onclick="() => SetPriceFilter(null, null)">✕</button>
                                </span>
                            }
                            @if (_onlyInStock)
                            {
                                <span class="active-chip-pill">
                                    Còn hàng
                                    <button type="button" class="chip-remove-btn" @onclick="() => SetStockFilter(false)">✕</button>
                                </span>
                            }
                            <button type="button" class="clear-all-chips-btn" style="text-decoration: none !important; background: #F1F5F9; border: 1px solid #E2E8F0; border-radius: 9999px; padding: 0.25rem 0.75rem; font-size: 0.82rem; font-weight: 500; color: #64748B;" @onclick="ClearAllHorizontalFilters">Đặt lại tất cả</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ActiveDropdown))
                {
                    <div class="filter-dropdown-backdrop" @onclick="CloseAllDropdowns"></div>
                }
            }
            else
            {
                <!-- TOP BAR: COUNT & SORT (Cho Trang Chủ) -->
                <div class="catalog-top-bar">
                    <div class="product-count-summary">
                        <span>Tìm thấy <strong>@(PagedResult?.TotalCount ?? 0) sản phẩm</strong></span>
                    </div>

                    <div class="sort-selector-wrapper">
                        <label for="sort-select">Sắp xếp:</label>
                        <select id="sort-select" class="sort-select" @bind="CurrentSort" @bind:after="OnSortChanged">
                            <option value="newest">Mới nhất</option>
                            <option value="price_asc">Giá: Thấp đến Cao</option>
                            <option value="price_desc">Giá: Cao đến Thấp</option>
                        </select>
                    </div>
                </div>
            }

            <!-- PRODUCT GRID OR EMPTY STATE -->
            @if (IsLoading || PagedResult == null)
            {
                <div class="luxury-loading-container">
                    <div class="luxury-loading-header">
                        <div class="luxury-spinner-ring"></div>
                        <div class="luxury-loading-text-group">
                            <h4 class="luxury-loading-title">QF FASHION</h4>
                            <p class="luxury-loading-subtitle">Đang tải dữ liệu sản phẩm QF...</p>
                        </div>
                    </div>

                    <div class="product-grid skeleton-grid">
                        @for (int s = 0; s < 8; s++)
                        {
                            <div class="skeleton-card">
                                <div class="skeleton-img shimmer"></div>
                                <div class="skeleton-info">
                                    <div class="skeleton-line skeleton-brand shimmer"></div>
                                    <div class="skeleton-line skeleton-title shimmer"></div>
                                    <div class="skeleton-line skeleton-price shimmer"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (!PagedResult.Items.Any())
            {
                <div class="catalog-empty">
                    <div class="empty-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                    </div>
                    <p class="empty-text">Không tìm thấy sản phẩm phù hợp</p>
                    <button type="button" class="btn-reset-filters" @onclick="ResetFilters">Xóa bộ lọc để xem tất cả</button>
                </div>
            }
            else
            {
                @if (_hasActiveFilters && !DisplayedProducts.Any())
                {
                    <div class="catalog-empty">
                        <div class="empty-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </div>
                        <p class="empty-text">Không tìm thấy sản phẩm nào khớp với các lựa chọn lọc</p>
                        <button type="button" class="btn-reset-filters" @onclick="ClearAllHorizontalFilters">Đặt lại bộ lọc để xem tất cả</button>
                    </div>
                }
                else
                {
                    <div class="product-grid">
                        @foreach (var item in DisplayedProducts)
                        {
                            <ProductCard Product="@item" OnAddToCart="@HandleAddToCart" />
                        }
                    </div>
                }

                <!-- PAGINATION BAR -->
                @if (PagedResult.TotalPages > 1)
                {
                    <div class="pagination-bar">
                        <button type="button" 
                                class="page-nav-btn prev" 
                                disabled="@(!PagedResult.HasPreviousPage)" 
                                @onclick="() => ChangePage(PagedResult.PageNumber - 1)">
                            ← Trước
                        </button>

                        <div class="page-numbers">
                            @for (int p = 1; p <= PagedResult.TotalPages; p++)
                            {
                                var pageIdx = p;
                                <button type="button" 
                                        class="page-btn @(pageIdx == PagedResult.PageNumber ? "active" : "")" 
                                        @onclick="() => ChangePage(pageIdx)">
                                    @pageIdx
                                </button>
                            }
                        </div>

                        <button type="button" 
                                class="page-nav-btn next" 
                                disabled="@(!PagedResult.HasNextPage)" 
                                @onclick="() => ChangePage(PagedResult.PageNumber + 1)">
                            Sau →
                        </button>
                    </div>
                }
            }
        </main>
    </div>

