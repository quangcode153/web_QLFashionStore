    /* Quick Size Selector State */
    private ProductListItemDto? _quickSelectProduct;
    private List<ProductVariantDto> _quickSelectVariants = new();
    private bool _isQuickSizeOpen = false;
    private string? _selectedQuickColor;

    private async Task HandleAddToCart(ProductListItemDto product)
    {
        if (product == null) return;
        try
        {
            var variants = (await CatalogApi.GetProductVariantsAsync(product.MaSanPham))?.ToList() ?? new();
            if (!variants.Any())
            {
                NavManager.NavigateTo($"/product/{product.MaSanPham}");
                return;
            }

            // Kiểm tra xem sản phẩm có nhiều size khác nhau không
            var distinctSizes = variants.Select(v => v.KichCo).Distinct().ToList();
            if (distinctSizes.Count <= 1)
            {
                // Chỉ có 1 size (Freesize hoặc phụ kiện ví/thắt lưng/balo): Thêm ngay biến thể còn hàng
                var singleVariant = variants.FirstOrDefault(v => v.SoLuongTon > 0) ?? variants.First();
                await AddVariantToCart(product, singleVariant);
                return;
            }

            // Có nhiều size: Mở thanh chọn size nhanh để khách tự chọn đúng size
            _quickSelectProduct = product;
            _quickSelectVariants = variants;
            var availableColor = variants.FirstOrDefault(v => v.SoLuongTon > 0)?.MauSac ?? variants.First().MauSac;
            _selectedQuickColor = availableColor;
            _isQuickSizeOpen = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Không thể tải danh sách size: {ex.Message}");
        }
    }

    private void SelectQuickColor(string color)
    {
        _selectedQuickColor = color;
    }

    private IEnumerable<string> GetQuickColors()
    {
        return _quickSelectVariants.Select(v => v.MauSac).Distinct();
    }

    private IEnumerable<ProductVariantDto> GetQuickVariantsForSelectedColor()
    {
        if (string.IsNullOrEmpty(_selectedQuickColor))
            return _quickSelectVariants;
        return _quickSelectVariants.Where(v => v.MauSac == _selectedQuickColor);
    }

    private async Task SelectQuickSizeAndAdd(ProductVariantDto variant)
    {
        if (variant == null || variant.SoLuongTon <= 0 || _quickSelectProduct == null) return;

        await AddVariantToCart(_quickSelectProduct, variant);
        _isQuickSizeOpen = false;
    }

    private async Task AddVariantToCart(ProductListItemDto product, ProductVariantDto variant)
    {
        await CartService.AddItemAsync(new CartItemDto
        {
            MaSanPham = product.MaSanPham,
            TenSanPham = product.TenSanPham,
            HinhAnh = !string.IsNullOrEmpty(variant.HinhAnh) ? variant.HinhAnh : product.AnhDaiDien,
            MaBienThe = variant.MaBienThe,
            MaSKU = variant.MaSku,
            MauSac = variant.MauSac,
            KichCo = variant.KichCo,
            DonGia = variant.GiaBan > 0 ? variant.GiaBan : product.GiaThapNhat,
            SoLuong = 1,
            SoLuongTon = variant.SoLuongTon
        });
        CartService.SetDrawerOpen(true);
        Toast.ShowSuccess($"Đã thêm '{product.TenSanPham}' ({variant.MauSac} / Size {variant.KichCo}) vào giỏ hàng!");
    }

    private void CloseQuickSize()
    {
        _isQuickSizeOpen = false;
        _quickSelectProduct = null;
        _quickSelectVariants.Clear();
    }

    /* AI Size Consultant & Quick Pills */
    private bool IsAiModalOpen = false;
    private int UserHeight = 172;
    private int UserWeight = 68;
    private string UserFitPreference = "F3";
    private SizeRecommendation? ComputedSizeResult;

    public class SizeRecommendation
    {
        public string RecommendedSize { get; set; } = "L";
        public string FitName { get; set; } = "Phom Vừa Vặn F3";
        public string Advice { get; set; } = string.Empty;
    }

    private void ToggleAiModal()
    {
        IsAiModalOpen = !IsAiModalOpen;
        if (!IsAiModalOpen) ComputedSizeResult = null;
    }

    private void CalculateSizeRecommendation()
    {
        if (UserHeight <= 0 || UserWeight <= 0)
        {
            Toast.ShowWarning("Vui lòng nhập chiều cao và cân nặng hợp lệ.");
            return;
        }

        string size = "M";
        if (UserWeight < 55) size = "S";
        else if (UserWeight <= 64) size = "M";
        else if (UserWeight <= 74) size = "L";
        else if (UserWeight <= 85) size = "XL";
        else size = "2XL";

        if (UserHeight > 178 && size == "M") size = "L";
        if (UserHeight > 182 && size == "L") size = "XL";

        string fitName = UserFitPreference switch
        {
            "F2" => "Phom Ôm Vừa (F2 - Bodyfit)",
            "F4" => "Phom Rộng Thoáng (F4 - Relaxed Fit)",
            "F5" => "Phom Hộp Rộng (F5 - Boxy Streetwear)",
            _ => "Phom Tiêu Chuẩn (F3 - Regular Fit)"
        };

        ComputedSizeResult = new SizeRecommendation
        {
            RecommendedSize = size,
            FitName = fitName,
            Advice = $"Với chiều cao {UserHeight}cm và cân nặng {UserWeight}kg theo gu {fitName}, Size {size} sẽ giúp bạn tôn dáng bờ vai, cử động thoải mái và không bị căng chật vùng ngực hay eo."
        };
    }

    private void ResetAiCalculator()
    {
        ComputedSizeResult = null;
    }

    private void ShopRecommendedSize()
    {
        IsAiModalOpen = false;
        Toast.ShowSuccess($"Stylist AI đã gợi ý chuẩn Size {ComputedSizeResult?.RecommendedSize}!");
    }

    private bool IsCategoryPillActive(string pillType)
    {
        if (!Query.CategoryId.HasValue) return false;
        var cat = Categories.FirstOrDefault(c => c.MaDanhMuc == Query.CategoryId.Value);
        if (cat == null) return false;
        var lower = cat.TenDanhMuc.ToLower();
        return pillType switch
        {
            "ao" => lower.Contains("áo") || lower.Contains("ao"),
            "quan" => lower.Contains("quần") || lower.Contains("quan"),
            "phukien" => lower.Contains("phụ kiện") || lower.Contains("phu kien"),
            _ => false
        };
    }

