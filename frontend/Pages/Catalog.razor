    private CategoryFilterOption? GetActiveOption()
    {
        var slug = (CategoryQuery ?? string.Empty).Trim().ToLowerInvariant();
        var options = GetAvailableCategoryOptions().ToList();
        if (string.IsNullOrEmpty(slug))
        {
            return options.FirstOrDefault(o => o.IsParentAll);
        }
        var matched = options.FirstOrDefault(o => o.Slug == slug);
        if (matched != null) return matched;
        return options.FirstOrDefault(o => o.IsParentAll);
    }

    private bool IsActiveCategoryOption(CategoryFilterOption opt)
    {
        var active = GetActiveOption();
        if (active == null) return opt.IsParentAll;
        return opt.Slug == active.Slug;
    }

