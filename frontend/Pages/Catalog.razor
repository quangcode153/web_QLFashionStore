                                    @color
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="quick-option-row">
                    <div class="quick-size-title-row">
                        <span class="quick-option-label">Kích cỡ (Size):</span>
                        <span class="quick-size-hint">Chạm size để thêm ngay vào giỏ</span>
