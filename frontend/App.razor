<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>404 - Không tìm thấy trang | QF Fashion</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div style="text-align: center; padding: 5rem 1rem; min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <h1 style="font-size: 5rem; font-weight: 900; color: #0F172A; margin: 0; line-height: 1;">404</h1>
                <h2 style="font-size: 1.5rem; font-weight: 700; color: #334155; margin: 1rem 0 0.5rem 0;">Không tìm thấy trang yêu cầu</h2>
                <p style="color: #64748B; font-size: 0.95rem; max-width: 460px; margin-bottom: 2rem;">
                    Địa chỉ liên kết có thể đã bị thay đổi, xóa hoặc tạm thời không khả dụng. Vui lòng quay lại trang chủ hoặc khám phá các sản phẩm hot nhất.
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/" style="background: #000000; color: #FFFFFF; padding: 0.75rem 1.75rem; border-radius: 4px; font-weight: 700; text-decoration: none;">Về Trang Chủ</a>
                    <a href="/catalog" style="background: #F1F5F9; color: #0F172A; padding: 0.75rem 1.75rem; border-radius: 4px; font-weight: 700; text-decoration: none;">Xem Sản Phẩm</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
