@namespace Frontend.Components
@implements IDisposable
@inject NavigationManager Navigation

<div class="notification-bell-wrapper">
    <button type="button" class="notification-bell-btn" @onclick="ToggleDropdown" title="Thông báo & Chỉ thị từ cấp trên">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>

        @if (UnreadCount > 0)
        {
            <span class="notification-badge @(HasUrgent ? "urgent-pulse" : "")">
                @(UnreadCount > 99 ? "99+" : UnreadCount.ToString())
            </span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="notification-dropdown dropdown-align-@(DropdownAlign.ToLowerInvariant())">
            <div class="dropdown-header">
                <div class="bell-header-left">
                    <span class="dropdown-title">Thông báo từ cấp trên</span>
                    <span class="notif-count-pill">@NotificationList.Count</span>
                </div>
                @if (UnreadCount > 0)
                {
                    <button type="button" class="btn-mark-read" @onclick="HandleMarkAllAsRead">
                        Đánh dấu đã đọc
                    </button>
                }
            </div>

            <div class="dropdown-body">
                @if (!NotificationList.Any())
                {
                    <div class="dropdown-empty">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span>Không có thông báo mới từ cấp trên</span>
                    </div>
                }
                else
                {
                    @foreach (var n in NotificationList)
                    {
                        var isUrgent = n.Priority?.IndexOf("khẩn cấp", StringComparison.OrdinalIgnoreCase) >= 0;
                        var isImportant = n.Priority?.IndexOf("quan trọng", StringComparison.OrdinalIgnoreCase) >= 0;

                        <div class="notification-item @(n.IsRead ? "read" : "unread") @(isUrgent ? "item-urgent" : (isImportant ? "item-important" : ""))" 
                             @onclick="() => HandleItemClick(n)">
                            <div class="notif-icon-col">
                                <span class="badge-icon icon-announcement @(isUrgent ? "icon-urgent" : (isImportant ? "icon-important" : "icon-normal"))">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                    </svg>
                                </span>
                            </div>
                            <div class="notif-content-col">
                                <div class="notif-meta-tags">
                                    <span class="chip-priority @(isUrgent ? "chip-urgent" : (isImportant ? "chip-important" : "chip-normal"))">
                                        @(string.IsNullOrWhiteSpace(n.Priority) ? "Thông báo" : n.Priority)
                                    </span>
                                    <span class="chip-scope">@(string.IsNullOrWhiteSpace(n.Scope) ? "Toàn hệ thống" : n.Scope)</span>
                                </div>
                                <div class="notif-title">@n.Title</div>
                                <div class="notif-message">@n.Message</div>
                                <div class="notif-time">@n.Timestamp.ToString("HH:mm - dd/MM/yyyy")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@if (_showDetailModal && _selectedItem != null)
{
    var modalUrgent = _selectedItem.Priority?.IndexOf("khẩn cấp", StringComparison.OrdinalIgnoreCase) >= 0;
    var modalImportant = _selectedItem.Priority?.IndexOf("quan trọng", StringComparison.OrdinalIgnoreCase) >= 0;

    <div class="modal-backdrop-custom" @onclick="CloseDetailModal">
        <div class="modal-card-custom" @onclick:stopPropagation="true">
            <div class="modal-top">
                <div class="modal-tags">
                    <span class="chip-priority @(modalUrgent ? "chip-urgent" : (modalImportant ? "chip-important" : "chip-normal"))">
                        @_selectedItem.Priority
                    </span>
                    <span class="chip-scope">@_selectedItem.Scope</span>
                </div>
                <button type="button" class="btn-close-custom" @onclick="CloseDetailModal">&times;</button>
            </div>

            <h3 class="modal-ann-title">@_selectedItem.Title</h3>
            <div class="modal-ann-time">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-1px; margin-right:4px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Thời gian phát: @_selectedItem.Timestamp.ToString("HH:mm:ss - dd/MM/yyyy")
            </div>

            <div class="modal-ann-body">
                @_selectedItem.Message
            </div>

            <div class="modal-actions-footer">
                <button type="button" class="btn-modal-dismiss" @onclick="CloseDetailModal">
                    Đã hiểu & Đóng
                </button>
            </div>
        </div>
    </div>
}

<style>
    .notification-bell-wrapper {
        position: relative;
        display: inline-block;
    }

    .notification-bell-btn {
        position: relative;
        background: none;
        border: none;
        padding: 8px;
        border-radius: 50%;
        color: #334155;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .notification-bell-btn:hover {
        background-color: rgba(0, 0, 0, 0.06);
        transform: scale(1.05);
    }

    .notification-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        background: #ef4444;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 800;
        min-width: 18px;
        height: 18px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        border: 2px solid #ffffff;
        box-shadow: 0 2px 4px rgba(239, 68, 68, 0.3);
    }

    .urgent-pulse {
        animation: pulseUrgent 1.5s infinite;
    }

    @@keyframes pulseUrgent {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    .notification-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        width: 440px;
        max-width: min(440px, calc(100vw - 32px));
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        box-shadow: 0 14px 35px -5px rgba(0, 0, 0, 0.16), 0 8px 12px -6px rgba(0, 0, 0, 0.08);
        z-index: 9999;
        overflow: hidden;
    }

    .dropdown-align-right {
        right: 0;
        left: auto;
    }

    .dropdown-align-left {
        left: 0;
        right: auto;
    }

    .dropdown-align-center {
        left: 50%;
        transform: translateX(-50%);
        right: auto;
    }

    .dropdown-header {
        padding: 12px 16px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .bell-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dropdown-title {
        font-size: 0.85rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.01em;
    }

    .notif-count-pill {
        font-size: 0.68rem;
        font-weight: 700;
        background: #e2e8f0;
        color: #475569;
        padding: 1px 6px;
        border-radius: 10px;
    }

    .btn-mark-read {
        background: none;
        border: none;
        color: #0284c7;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
    }

    .btn-mark-read:hover {
        text-decoration: underline;
    }

    .dropdown-body {
        max-height: 380px;
        overflow-y: auto;
    }

    .dropdown-empty {
        padding: 32px 16px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-size: 0.82rem;
    }

    .notification-item {
        display: flex;
        padding: 12px 14px;
        border-bottom: 1px solid #f1f5f9;
        gap: 12px;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .notification-item:hover {
        background-color: #f8fafc;
    }

    .notification-item.unread {
        background-color: #f0fdf4;
    }

    .notification-item.item-urgent.unread {
        background-color: #fff1f2;
        border-left: 3px solid #ef4444;
    }

    .notification-item.item-important.unread {
        background-color: #fffbeb;
        border-left: 3px solid #f59e0b;
    }

    .badge-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-urgent {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-important {
        background: #fef3c7;
        color: #d97706;
    }

    .icon-normal {
        background: #eff6ff;
        color: #2563eb;
    }

    .notif-content-col {
        flex: 1;
        min-width: 0;
    }

    .notif-meta-tags {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 3px;
    }

    .chip-priority {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .chip-urgent { background: #fee2e2; color: #dc2626; }
    .chip-important { background: #fef3c7; color: #b45309; }
    .chip-normal { background: #eff6ff; color: #1d4ed8; }

    .chip-scope {
        font-size: 0.68rem;
        color: #64748b;
        background: #f1f5f9;
        padding: 1px 6px;
        border-radius: 4px;
    }

    .notif-title {
        font-size: 0.86rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
        line-height: 1.35;
        word-break: break-word;
    }

    .notif-message {
        font-size: 0.78rem;
        color: #475569;
        line-height: 1.45;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        word-break: break-word;
    }

    .notif-time {
        font-size: 0.68rem;
        color: #94a3b8;
        margin-top: 4px;
        font-family: var(--font-mono, monospace);
    }

    /* Modal hiển thị chi tiết thông báo */
    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 16px;
    }

    .modal-card-custom {
        background: #ffffff;
        border-radius: 12px;
        width: 100%;
        max-width: 520px;
        padding: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
        animation: scaleUp 0.18s ease-out;
    }

    @@keyframes scaleUp {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .btn-close-custom {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: #94a3b8;
        cursor: pointer;
        line-height: 1;
        padding: 0 4px;
    }

    .btn-close-custom:hover {
        color: #0f172a;
    }

    .modal-ann-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
        line-height: 1.35;
    }

    .modal-ann-time {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 16px;
    }

    .modal-ann-body {
        font-size: 0.9rem;
        color: #334155;
        line-height: 1.6;
        padding: 16px;
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        white-space: pre-wrap;
        margin-bottom: 20px;
    }

    .modal-actions-footer {
        display: flex;
        justify-content: flex-end;
    }

    .btn-modal-dismiss {
        padding: 8px 18px;
        background: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .btn-modal-dismiss:hover {
        background: #1e293b;
    }
</style>

@code {
    [Parameter] public string DropdownAlign { get; set; } = "right";
    [Inject] private IServiceProvider ServiceProvider { get; set; } = default!;
    private ISignalRNotificationService? SignalRService => ServiceProvider.GetService(typeof(ISignalRNotificationService)) as ISignalRNotificationService;

    private int UnreadCount => SignalRService?.UnreadCount ?? 0;
    private IReadOnlyList<RealtimeNotificationItem> NotificationList => SignalRService?.Notifications ?? Array.Empty<RealtimeNotificationItem>();

    private bool HasUrgent => NotificationList.Any(n => !n.IsRead && n.Priority?.IndexOf("khẩn cấp", StringComparison.OrdinalIgnoreCase) >= 0);

    private bool _isOpen = false;
    private bool _showDetailModal = false;
    private RealtimeNotificationItem? _selectedItem;

    protected override void OnInitialized()
    {
        if (SignalRService != null)
        {
            SignalRService.OnChange += OnServiceChanged;
        }
    }

    private void OnServiceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private async Task HandleMarkAllAsRead()
    {
        if (SignalRService != null)
        {
            await SignalRService.MarkAllAsReadAsync();
        }
    }

    private async Task HandleItemClick(RealtimeNotificationItem item)
    {
        item.IsRead = true;
        _isOpen = false;
        _selectedItem = item;
        _showDetailModal = true;
        if (SignalRService != null)
        {
            await SignalRService.MarkAsReadAsync(item.Id);
        }
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _selectedItem = null;
    }

    public void Dispose()
    {
        if (SignalRService != null)
        {
            SignalRService.OnChange -= OnServiceChanged;
        }
    }
}
