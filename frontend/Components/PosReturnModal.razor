@namespace Frontend.Components
@inject IPosApiClient PosApiClient
@inject IToastService ToastService

@if (IsVisible)
{
    <div class="pos-modal-overlay pos-return-modal" @onclick="HandleBackdropClick">
        <div class="pos-modal-card" @onclick:stopPropagation>
            <!-- Header -->
            <div class="modal-card-header">
                <div class="header-title-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-icon">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                    <h3 class="modal-card-title">NHẬP HÀNG TRẢ & ĐỔI TRẢ TẠI QUẦY (POS RETURN)</h3>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseModal" title="Đóng cửa sổ">×</button>
            </div>

            <!-- Body -->
            <div class="modal-card-body">
                <!-- Khung tra cứu hóa đơn -->
                <div class="lookup-section">
                    <label class="lookup-label">Nhập mã hóa đơn cần đổi trả:</label>
                    <div class="lookup-input-bar">
                        <div class="input-prefix-box">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </div>
                        <input type="text" 
                               class="pos-input input-lookup-order-id" 
                               placeholder="VD: 101 hoặc HD-101..." 
                               value="@_orderIdSearch" 
                               @onchange="OnOrderIdChanged" 
                               @onkeydown="OnKeyDownSearch" />
                        <button type="button" class="btn btn-primary btn-lookup-order" @onclick="LookupOrderAsync" disabled="@_isSearching">
                            @if (_isSearching)
                            {
                                <span>Đang tìm...</span>
                            }
                            else
                            {
                                <span>Tra cứu hóa đơn</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert-box alert-error">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (_order != null)
                {
                    <!-- Thẻ tóm tắt hóa đơn -->
                    <div class="order-summary-card">
                        <div class="summary-top">
                            <div class="order-code-badge">
                                <span class="order-code">#HD-@_order.MaHoaDon</span>
                                <span class="order-status-pill @(_order.IsEligibleForReturn ? "status-success" : "status-warning")">
                                    @_order.TrangThai
                                </span>
                            </div>
                            <div class="order-meta-info">
                                <span>Ngày lập: <strong>@_order.NgayLapHoaDon.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                <span class="sep">|</span>
                                <span>Thu ngân: <strong>@_order.ThuNgan</strong></span>
                            </div>
                        </div>
                        <div class="summary-bottom">
                            <div class="customer-info">
                                <span>Khách hàng: <strong>@_order.TenKhachHang</strong></span>
                                @if (!string.IsNullOrWhiteSpace(_order.SdtKhachHang))
                                {
                                    <span class="customer-phone">(@_order.SdtKhachHang)</span>
                                }
                            </div>
                            <div class="order-amounts">
                                <span>Tiền hàng: <strong>@_order.TienHang.ToString("N0") đ</strong></span>
                                @if (_order.TienGiamGia > 0)
                                {
                                    <span class="discount-txt"> - Giảm: @_order.TienGiamGia.ToString("N0") đ</span>
                                }
                                <span class="sep">|</span>
                                <span class="grand-total-txt">Thanh toán: <strong>@_order.TongThanhToan.ToString("N0") đ</strong></span>
                            </div>
                        </div>
                    </div>

                    <!-- Khung Địa Chỉ Nhận Hàng Lỗi Hoàn Về & Nơi Tiếp Nhận -->
                    <div class="return-address-card">
                        <div class="address-header">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="addr-icon">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span class="addr-title">ĐỊA CHỈ TIẾP NHẬN HÀNG LỖI HOÀN VỀ</span>
                        </div>
                        <div class="address-body">
                            <div class="addr-field">
                                <span class="field-label">Địa chỉ nhận hàng lỗi hoàn về:</span>
                                <span class="field-value highlight-dest return-destination-address">
                                    @(string.IsNullOrWhiteSpace(_order.DiaChiNhanHangHoanVe) 
                                        ? "772 Sư Vạn Hạnh, Phường 12, Quận 10, TP.HCM (Kho tiếp nhận QF)" 
                                        : _order.DiaChiNhanHangHoanVe)
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_order.DiaChiThuHoi))
                            {
                                <div class="addr-field">
                                    <span class="field-label">Địa chỉ thu hồi của khách (tại nhà):</span>
                                    <span class="field-value">@_order.DiaChiThuHoi</span>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_order.DiaChiGiaoHang))
                            {
                                <div class="addr-field">
                                    <span class="field-label">Địa chỉ giao hàng ban đầu:</span>
                                    <span class="field-value">@_order.DiaChiGiaoHang</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_order.HinhThucHoan))
                            {
                                <div class="addr-field">
                                    <span class="field-label">Phương thức đổi trả:</span>
                                    <span class="field-value font-semibold">@_order.HinhThucHoan</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!_order.IsEligibleForReturn)
                    {
                        <!-- Cảnh báo đơn không đủ điều kiện đổi trả -->
                        <div class="alert-box alert-warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            <div>
                                <strong>Đơn hàng không đủ điều kiện đổi trả:</strong>
                                <div>@(_order.IneligibilityReason ?? "Chỉ những đơn hàng ở trạng thái 'Đã hoàn thành' mới có thể tiếp nhận đổi trả.")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Bảng sản phẩm trong hóa đơn -->
                        <div class="return-items-section">
                            <div class="section-title">Danh sách sản phẩm trong hóa đơn:</div>
                            <table class="return-items-table">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;" class="text-center">Chọn</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-right">Đơn giá</th>
                                        <th class="text-center">Đã mua</th>
                                        <th class="text-center">Đã trả</th>
                                        <th class="text-center">Có thể trả</th>
                                        <th style="width: 90px;" class="text-center">SL Trả</th>
                                        <th style="min-width: 180px;">Lý do hàng lỗi</th>
                                        <th class="text-right">Hoàn tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _order.Items)
                                    {
                                        var isSelected = _selectedItems.ContainsKey(item.MaBienThe);
                                        var canReturn = item.SoLuongConLai > 0;
                                        <tr class="item-row @(isSelected ? "row-selected" : "") @(!canReturn ? "row-disabled" : "")">
                                            <td class="text-center">
                                                @if (canReturn)
                                                {
                                                    <input type="checkbox" 
                                                           data-variant-id="@item.MaBienThe"
                                                           checked="@isSelected"
                                                           @onchange="(e) => ToggleItemSelection(item, e)" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="item-name">@item.TenSanPham</div>
                                                <div class="item-variant-info">@item.MauSac - Size @item.KichCo</div>
                                            </td>
                                            <td class="text-right tabular-nums">@item.DonGia.ToString("N0") đ</td>
                                            <td class="text-center tabular-nums">@item.SoLuongMua</td>
                                            <td class="text-center tabular-nums">@item.SoLuongDaTra</td>
                                            <td class="text-center tabular-nums">
                                                @if (canReturn)
                                                {
                                                    <span class="badge-available">@item.SoLuongConLai</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-exhausted">Đã trả đủ</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (canReturn && isSelected)
                                                {
                                                    <input type="number" 
                                                           class="input-return-qty tabular-nums" 
                                                           data-variant-id="@item.MaBienThe"
                                                           min="1" 
                                                           max="@item.SoLuongConLai" 
                                                           value="@_selectedItems[item.MaBienThe].Quantity" 
                                                           @onchange="(e) => UpdateReturnQty(item, e)" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (canReturn && isSelected)
                                                {
                                                    <input type="text" 
                                                           class="input-return-reason" 
                                                           data-variant-id="@item.MaBienThe"
                                                           placeholder="Nhập lý do hàng lỗi..." 
                                                           value="@_selectedItems[item.MaBienThe].Reason" 
                                                           @onchange="(e) => UpdateReturnReason(item, e)" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-right tabular-nums font-bold">
                                                @if (canReturn && isSelected)
                                                {
                                                    <span>@((_selectedItems[item.MaBienThe].Quantity * item.DonGia).ToString("N0")) đ</span>
                                                }
                                                else
                                                {
                                                    <span>0 đ</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Khung tổng kết hoàn tiền -->
                        <div class="refund-summary-box">
                            <div class="refund-note">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span>Hàng đổi trả sẽ được nhập tự động vào <strong>KHO HÀNG LỖI</strong> (so_luong_loi) và ghi nhật ký TRA_HANG_LOI.</span>
                            </div>
                            <div class="refund-calc">
                                <span>TỔNG TIỀN HOÀN TRẢ KHÁCH:</span>
                                <span class="refund-amount tabular-nums">@TotalRefundAmount.ToString("N0") đ</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Footer Actions -->
            <div class="modal-card-footer">
                <button type="button" class="btn btn-outline" @onclick="CloseModal">Hủy bỏ</button>
                @if (_order != null && _order.IsEligibleForReturn)
                {
                    <button type="button" 
                            class="btn btn-primary btn-confirm-return" 
                            disabled="@(_selectedItems.Count == 0 || _isSubmitting)" 
                            @onclick="ConfirmReturnAsync">
                        @if (_isSubmitting)
                        {
                            <span>Đang xử lý trả hàng...</span>
                        }
                        else
                        {
                            <span>Xác nhận nhập trả & Hoàn tiền (@TotalRefundAmount.ToString("N0") đ)</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

