</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnReturnSuccess { get; set; }

    private string _orderIdSearch = string.Empty;
    private bool _isSearching = false;
    private bool _isSubmitting = false;
    private string? _errorMessage;
    private OrderReturnLookupDto? _order;

    private class ReturnItemSelection
    {
        public int VariantId { get; set; }
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Khách yêu cầu đổi trả tại quầy";
    }

    private Dictionary<int, ReturnItemSelection> _selectedItems = new();

    private decimal TotalRefundAmount
    {
        get
        {
            if (_order == null) return 0;
            decimal total = 0;
            foreach (var kvp in _selectedItems)
            {
                var item = _order.Items.FirstOrDefault(i => i.MaBienThe == kvp.Key);
                if (item != null)
                {
                    total += kvp.Value.Quantity * item.DonGia;
                }
            }
            return total;
        }
    }

    private void OnOrderIdChanged(ChangeEventArgs e)
    {
        _orderIdSearch = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LookupOrderAsync();
        }
    }

    private async Task LookupOrderAsync()
    {
        _errorMessage = null;
        _order = null;
        _selectedItems.Clear();

        if (string.IsNullOrWhiteSpace(_orderIdSearch))
        {
            _errorMessage = "Vui lòng nhập mã hóa đơn cần tra cứu.";
            return;
        }

        // Loại bỏ tiền tố "#HD-" hoặc "HD-" nếu người dùng gõ
        var cleaned = _orderIdSearch.Trim().Replace("#", "").Replace("HD-", "").Replace("DH-", "").Trim();
        if (!int.TryParse(cleaned, out var orderId) || orderId <= 0)
        {
            _errorMessage = "Mã hóa đơn không hợp lệ. Vui lòng nhập số hóa đơn (VD: 101).";
            return;
        }

        _isSearching = true;
        try
        {
            var res = await PosApiClient.GetOrderForReturnLookupAsync(orderId);
            if (res == null)
            {
                _errorMessage = $"Không tìm thấy đơn hàng #{orderId} hoặc đơn hàng chưa hoàn thành.";
            }
            else
            {
                _order = res;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi tra cứu: {ex.Message}";
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void ToggleItemSelection(OrderReturnLookupItemDto item, ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            if (!_selectedItems.ContainsKey(item.MaBienThe))
            {
                _selectedItems[item.MaBienThe] = new ReturnItemSelection
                {
                    VariantId = item.MaBienThe,
                    Quantity = 1,
                    Reason = "Hàng bị lỗi / Khách đổi trả tại quầy"
                };
            }
        }
        else
        {
            _selectedItems.Remove(item.MaBienThe);
        }
    }

    private void UpdateReturnQty(OrderReturnLookupItemDto item, ChangeEventArgs e)
    {
        if (_selectedItems.TryGetValue(item.MaBienThe, out var sel))
        {
            if (int.TryParse(e.Value?.ToString(), out var qty))
            {
                sel.Quantity = Math.Clamp(qty, 1, item.SoLuongConLai);
            }
        }
    }

    private void UpdateReturnReason(OrderReturnLookupItemDto item, ChangeEventArgs e)
    {
        if (_selectedItems.TryGetValue(item.MaBienThe, out var sel))
        {
            sel.Reason = e.Value?.ToString() ?? string.Empty;
        }
    }

    private async Task ConfirmReturnAsync()
    {
        if (_order == null || _selectedItems.Count == 0) return;

        _isSubmitting = true;
        try
        {
            int successCount = 0;
            foreach (var kvp in _selectedItems)
            {
                var req = new ReturnOrderRequestDto
                {
                    MaBienThe = kvp.Key,
                    SoLuongTra = kvp.Value.Quantity,
                    LyDoTra = string.IsNullOrWhiteSpace(kvp.Value.Reason) 
                        ? "Khách đổi trả tại quầy" 
                        : kvp.Value.Reason.Trim()
                };

                var res = await PosApiClient.ProcessReturnAsync(_order.MaHoaDon, req);
                if (res != null && res.Success)
                {
                    successCount++;
                }
                else
                {
                    ToastService.ShowError(res?.Message ?? "Không thể xử lý trả sản phẩm.");
                    return;
                }
            }

            ToastService.ShowSuccess($"Đã nhập hàng trả cho đơn #{_order.MaHoaDon} thành công! Đã hoàn {TotalRefundAmount:N0} đ cho khách.");
            await OnReturnSuccess.InvokeAsync(_order.MaHoaDon);
            await CloseModal();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi khi xử lý trả hàng: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CloseModal()
    {
        _order = null;
        _orderIdSearch = string.Empty;
        _errorMessage = null;
        _selectedItems.Clear();
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await CloseModal();
    }
}
