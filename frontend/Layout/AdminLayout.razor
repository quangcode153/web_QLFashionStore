@inherits LayoutComponentBase
@namespace Frontend.Layout
@inject NavigationManager Navigation
@inject Frontend.Services.IAuthStateService AuthStateService
@inject IServiceProvider ServiceProvider
@inject ISignalRNotificationService SignalRService
@inject IJSRuntime JS

<div class="admin-layout">
    <!-- Sidebar Tối Giản Cao Cấp Hỗ Trợ Drawer Mobile -->
    <aside class="admin-sidebar @(_isMobileSidebarOpen ? "sidebar-open" : "")">
        <div class="admin-brand">
            <a href="@GetBrandHomeUrl()" class="brand-link" @onclick="CloseMobileSidebar">
                <div class="brand-logo-frame">
                    <img src="images/logo.png" alt="QF Noir" class="brand-logo-img" />
                </div>
                <div class="brand-text">
                    <span class="brand-title">QF NOIR</span>
                    <span class="brand-sub">Quản Trị Hệ Thống</span>
                </div>
            </a>
            <button type="button" class="btn-sidebar-close" @onclick="CloseMobileSidebar" title="Đóng menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="18" x2="18" y2="6"></line>
                </svg>
            </button>
        </div>

        <!-- Role Context Banner nhỏ trên sidebar -->
        <div class="sidebar-role-indicator">
            <div class="role-icon-box @(_currentRoleClass)">
                @if (_currentRoleType == RoleType.ChainAdmin)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                }
                else if (_currentRoleType == RoleType.BranchManager)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="2" width="18" height="20" rx="2"></rect><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15" y2="6.01"></line><line x1="9" y1="12" x2="9" y2="12.01"></line><line x1="15" y1="12" x2="15" y2="12.01"></line></svg>
                }
                else if (_currentRoleType == RoleType.WarehouseKeeper)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                }
            </div>
            <div class="role-indicator-text">
                <span class="role-indicator-title">@_roleShortTitle</span>
                <span class="role-indicator-sub">@_scopeSubtitle</span>
            </div>
        </div>

        <nav class="admin-nav">
            @if (_currentRoleType == RoleType.ChainAdmin)
            {
                <!-- Nhóm: Báo Cáo & Tổng Quan (Chỉ Quản lý chuỗi) -->
                <div class="nav-group-label">BÁO CÁO & PHÂN TÍCH</div>
                <NavLink class="nav-item" href="/admin/dashboard" Match="NavLinkMatch.All">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                    </svg>
                    <span>Tổng quan & Báo cáo</span>
                </NavLink>

                <!-- Nhóm: Vận Hành Chuỗi & Chi Nhánh -->
                <div class="nav-group-label">VẬN HÀNH & KHO</div>
                <NavLink class="nav-item" href="/admin/orders">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Quản lý Đơn hàng</span>
                </NavLink>
                <NavLink class="nav-item" href="/staff/order-support">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 4v6h6"></path>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    <span>Quản lý Đổi trả & Hoàn kho lỗi</span>
                </NavLink>

                <NavLink class="nav-item" href="/warehouse">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    <span>Kho & Cảnh báo tồn</span>
                </NavLink>

                <!-- Nhóm: Danh Mục & Cấu Hình Chuỗi -->
                <div class="nav-group-label">HỆ THỐNG & NHẬT KÝ</div>
                <NavLink class="nav-item" href="/admin/products">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-7z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <span>Sản phẩm & Biến thể</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/banners">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <span>Banner & Chiến dịch</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/promotions">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span>Mã giảm giá & Voucher</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/accounts">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Tài khoản & Phân quyền</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/audit-logs">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Nhật ký & Sửa đổi</span>
                </NavLink>

                <!-- Nhóm: CSKH & Truyền Thông -->
                <div class="nav-group-label">CSKH & TRUYỀN THÔNG</div>
                <NavLink class="nav-item" href="/admin/customers">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Khách hàng & VIP</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/feedback">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        <line x1="9" y1="10" x2="15" y2="10"></line>
                        <line x1="12" y1="7" x2="12" y2="7.01"></line>
                    </svg>
                    <span>Khiếu nại & Góp ý</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/announcements">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span>Thông báo nội bộ</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/policies">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                    <span>Chính sách bán hàng</span>
                </NavLink>
            }
            else if (_currentRoleType == RoleType.BranchManager)
            {
                <!-- Nhóm: Vận Hành Chi Nhánh (Cửa hàng trưởng) -->
                <div class="nav-group-label">VẬN HÀNH CHI NHÁNH</div>
                <NavLink class="nav-item" href="/admin/orders">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Quản lý Đơn hàng</span>
                </NavLink>

                <NavLink class="nav-item" href="/staff/order-support">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 4v6h6"></path>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    <span>Quản lý Đổi trả & Hoàn kho lỗi</span>
                </NavLink>

                <NavLink class="nav-item" href="/warehouse">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    <span>Kho & Cảnh báo tồn</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/accounts">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Tài khoản nhân viên</span>
                </NavLink>

                <div class="nav-group-label">NHẬT KÝ & GIÁM SÁT</div>
                <NavLink class="nav-item" href="/admin/audit-logs">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Nhật ký & Sửa đổi</span>
                </NavLink>

                <div class="nav-group-label">CSKH & TRUYỀN THÔNG</div>
                <NavLink class="nav-item" href="/admin/customers">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Khách hàng & VIP</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/feedback">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        <line x1="9" y1="10" x2="15" y2="10"></line>
                        <line x1="12" y1="7" x2="12" y2="7.01"></line>
                    </svg>
                    <span>Khiếu nại & Góp ý</span>
                </NavLink>

                <NavLink class="nav-item" href="/admin/announcements">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span>Thông báo nội bộ</span>
                </NavLink>
            }
            else if (_currentRoleType == RoleType.WarehouseKeeper)
            {
                <!-- Nhóm: Nghiệp Vụ Thủ Kho Chuyên Trách -->
                <div class="nav-group-label">ĐIỀU HÀNH KHO</div>
                <NavLink class="nav-item" href="/warehouse" Match="NavLinkMatch.All">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    <span>Kho & Nhập hàng</span>
                </NavLink>
            }
            else if (_currentRoleType == RoleType.OrderCoordinator)
            {
                <!-- Nhóm: Điều Phối Giao Vận & Đổi Trả -->
                <div class="nav-group-label">ĐIỀU PHỐI ĐƠN HÀNG</div>
                <NavLink class="nav-item" href="/admin/orders" Match="NavLinkMatch.Prefix">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Quản lý & Điều phối đơn hàng</span>
                </NavLink>

                <NavLink class="nav-item" href="/staff/order-support">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 4v6h6"></path>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    <span>Quản lý Đổi trả & Hoàn kho lỗi</span>
                </NavLink>
            }
        </nav>

        <div class="sidebar-footer">
            @if (_currentRoleType != RoleType.WarehouseKeeper)
            {
                <a href="/pos" class="footer-link pos-shortcut-link" title="Mở máy tính tiền POS">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    <span>Mở quầy POS bán lẻ</span>
                    <span class="pos-status-dot" title="Máy POS sẵn sàng"></span>
                </a>
            }
            <a href="/" class="footer-link" target="_blank" title="Xem giao diện khách hàng ngoài trang chủ">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span>Cửa hàng Storefront</span>
            </a>
        </div>
    </aside>

    @if (_isMobileSidebarOpen)
    {
        <div class="sidebar-backdrop" @onclick="CloseMobileSidebar"></div>
    }

    <!-- Main Content Area -->
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="topbar-left">
                <!-- Hamburger Button Mở Sidebar Trên Mobile -->
                <button type="button" class="btn-sidebar-toggle" @onclick="ToggleMobileSidebar" title="Mở menu quản trị" aria-label="Mở menu điều hướng">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <!-- Role Badge Phân Biệt Cực Kỳ Tinh Tế -->
                <div class="role-badge-container">
                    <span class="role-badge @_currentRoleBadgeClass">
                        @if (_currentRoleType == RoleType.ChainAdmin)
                        {
                            <span class="badge-role-symbol">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            </span>
                            <span>QUẢN LÝ CHUỖI TOÀN HỆ THỐNG</span>
                        }
                        else if (_currentRoleType == RoleType.BranchManager)
                        {
                            <span class="badge-role-symbol">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                            </span>
                            <span>QUẢN LÝ CHI NHÁNH (QF Q10)</span>
                        }
                        else if (_currentRoleType == RoleType.WarehouseKeeper)
                        {
                            <span class="badge-role-symbol">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                            </span>
                            <span>THỦ KHO QUẢN LÝ TỒN & NHẬP HÀNG</span>
                        }
                        else if (_currentRoleType == RoleType.OrderCoordinator)
                        {
                            <span class="badge-role-symbol">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            </span>
                            <span>ĐIỀU PHỐI ĐƠN HÀNG (ORDER COORDINATOR)</span>
                        }
                        else
                        {
                            <span class="badge-role-symbol">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                            </span>
                            <span>NHÂN VIÊN (POS)</span>
                        }
                    </span>
                    <span class="branch-scope-tag">@_branchScopeText</span>
                </div>
            </div>

            <div class="topbar-right">
                <RealtimeNotificationBell />
                <div class="topbar-divider"></div>
                
                <div class="admin-profile">
                    <div class="avatar-squircle">@_avatarLetters</div>
                    <div class="profile-meta">
                        <span class="profile-name">@_profileName</span>
                        <span class="profile-role">@_profileSub</span>
                    </div>
                </div>

                <button type="button" class="btn-admin-logout" @onclick="HandleLogout" title="Đăng xuất khỏi hệ thống">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Thoát</span>
                </button>
            </div>
        </header>

        <main class="admin-body">
            @Body
        </main>
    </div>
</div>

<style>
    .admin-layout {
