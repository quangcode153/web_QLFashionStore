@code {
    private enum RoleType
    {
        ChainAdmin,        // 1. Quản lý chuỗi (Admin)
        BranchManager,     // 2. Quản lý chi nhánh
        WarehouseKeeper,   // 3. Thủ kho
        CashierStaff,      // 4. Nhân viên bán hàng
        OrderCoordinator   // 5. Điều phối viên đơn hàng & đổi trả
    }

    private RoleType _currentRoleType = RoleType.ChainAdmin;

    private string _currentRoleClass => _currentRoleType switch
    {
        RoleType.ChainAdmin => "chain-admin",
        RoleType.BranchManager => "branch-manager",
        RoleType.WarehouseKeeper => "warehouse-keeper",
        RoleType.OrderCoordinator => "coordinator-staff",
        _ => "cashier-staff"
    };

    private string _currentRoleBadgeClass => _currentRoleType switch
    {
        RoleType.ChainAdmin => "chain-badge",
        RoleType.BranchManager => "branch-badge",
        RoleType.WarehouseKeeper => "warehouse-badge",
        RoleType.OrderCoordinator => "coordinator-badge",
        _ => "staff-badge"
    };

    private int _totalBranchesCount = 0;
    private string? _userBranchName;

    private string _roleShortTitle => _currentRoleType switch
    {
        RoleType.ChainAdmin => "Quản Lý Chuỗi",
        RoleType.BranchManager => !string.IsNullOrEmpty(_userBranchName) ? $"QL {_userBranchName}" : "QL Chi Nhánh",
        RoleType.WarehouseKeeper => "Thủ Kho",
        RoleType.OrderCoordinator => "Điều Phối Viên",
        _ => "Nhân viên"
    };

    private string _scopeSubtitle => _currentRoleType switch
    {
        RoleType.ChainAdmin => _totalBranchesCount > 0 ? $"Toàn bộ {_totalBranchesCount} chi nhánh" : "Toàn bộ chi nhánh",
        RoleType.BranchManager => !string.IsNullOrEmpty(_userBranchName) ? _userBranchName : "Cửa hàng trưởng",
        RoleType.WarehouseKeeper => "Quản lý tồn & Nhập kho",
        RoleType.OrderCoordinator => "Điều phối bưu tá & Đổi trả",
        _ => "Ca trực tại quầy POS"
    };

    private string _branchScopeText => _currentRoleType switch
    {
        RoleType.ChainAdmin => _totalBranchesCount > 0 ? $"Phạm vi: Toàn chuỗi ({_totalBranchesCount} chi nhánh)" : "Phạm vi: Toàn chuỗi",
        RoleType.BranchManager => !string.IsNullOrEmpty(_userBranchName) ? $"Phạm vi: {_userBranchName}" : "Phạm vi: Chi nhánh được phân công",
        RoleType.WarehouseKeeper => !string.IsNullOrEmpty(_userBranchName) ? $"Phạm vi: Kho {_userBranchName}" : "Phạm vi: Kho hàng & Cảnh báo tồn",
        RoleType.OrderCoordinator => !string.IsNullOrEmpty(_userBranchName) ? $"Phạm vi: Điều phối {_userBranchName}" : "Phạm vi: Đơn trực tuyến & Đổi trả",
        _ => "Điểm bán: Quầy Thu Ngân 01"
    };

    private bool _isMobileSidebarOpen = false;

    private void ToggleMobileSidebar()
    {
        _isMobileSidebarOpen = !_isMobileSidebarOpen;
    }

    private void CloseMobileSidebar()
    {
        _isMobileSidebarOpen = false;
    }

    private string _avatarLetters = "QF";
    private string _profileName = "Đang kiểm tra quyền...";
    private string _profileSub = "Hệ thống quản trị";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await SignalRService.StartAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isMobileSidebarOpen)
        {
            _isMobileSidebarOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JS.InvokeAsync<string?>("localStorage.getItem", "userRole");
                var staff = await JS.InvokeAsync<string?>("localStorage.getItem", "staffName");

                // Route Guard Chặt Chẽ: Nếu chưa đăng nhập hoặc không có vai trò nhân sự hợp lệ -> Chặn và chuyển hướng ngay về /login
                if (string.IsNullOrWhiteSpace(role) || !global::Shared.Constants.RoleConstants.IsStaff(role))
                {
                    Navigation.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
                    return;
                }

                try
                {
                    _userBranchName = await JS.InvokeAsync<string?>("localStorage.getItem", "branchName");
                }
                catch { }

                try
                {
                    var adminApi = (Frontend.Services.IAdminApiClient?)ServiceProvider.GetService(typeof(Frontend.Services.IAdminApiClient));
                    if (adminApi != null)
                    {
                        var branchList = await adminApi.GetBranchesAsync();
                        if (branchList != null && branchList.Any())
                        {
                            _totalBranchesCount = branchList.Count;
                        }
                    }
                }
                catch { }

                if (!string.IsNullOrEmpty(role))
                {
                    var displayName = !string.IsNullOrWhiteSpace(staff) ? staff : "Quản trị viên";
                    var initials = displayName.Length >= 2 ? displayName.Substring(0, 2).ToUpper() : "QF";

                    if (role.Contains("Thủ kho", StringComparison.OrdinalIgnoreCase) ||
                        role.Contains("kho", StringComparison.OrdinalIgnoreCase))
                    {
                        _currentRoleType = RoleType.WarehouseKeeper;
                        _avatarLetters = "TK";
                        _profileName = displayName;
                        _profileSub = "Thủ kho hệ thống QF";
                    }
                    else if (role.Contains("chi nhánh", StringComparison.OrdinalIgnoreCase))
                    {
                        _currentRoleType = RoleType.BranchManager;
                        _avatarLetters = "QL";
                        _profileName = displayName;
                        _profileSub = "Cửa hàng trưởng chi nhánh QF";
                    }
                    else if (role.Contains("Order Coordinator", StringComparison.OrdinalIgnoreCase) ||
                             role.Contains("Điều phối", StringComparison.OrdinalIgnoreCase))
                    {
                        _currentRoleType = RoleType.OrderCoordinator;
                        _avatarLetters = "DP";
                        _profileName = displayName;
                        _profileSub = "Điều phối viên giao vận & đổi trả";
                    }
                    else if (role.Contains("ThuNgan", StringComparison.OrdinalIgnoreCase) || 
                             role.Contains("Thu ngân", StringComparison.OrdinalIgnoreCase) ||
                             role.Contains("Nhân viên", StringComparison.OrdinalIgnoreCase) ||
                             role.Contains("bán hàng", StringComparison.OrdinalIgnoreCase))
                    {
                        _currentRoleType = RoleType.CashierStaff;
                        _avatarLetters = "NV";
                        _profileName = displayName;
                        _profileSub = "Nhân viên làm việc tại quầy POS";
                    }
                    else
                    {
                        _currentRoleType = RoleType.ChainAdmin;
                        _avatarLetters = initials;
                        _profileName = displayName;
                        _profileSub = "Quản lý chuỗi toàn hệ thống QF";
                    }
                }
                StateHasChanged();
            }
            catch { }
        }
    }

    private string GetBrandHomeUrl() => _currentRoleType switch
    {
        RoleType.WarehouseKeeper => "/warehouse",
        RoleType.CashierStaff => "/pos",
        RoleType.OrderCoordinator => "/admin/orders",
        _ => "/admin/dashboard"
    };

    private async Task HandleLogout()
    {
        try
        {
            await AuthStateService.ClearAuthAsync();
        }
        catch { }
        Navigation.NavigateTo("/login");
    }
}
